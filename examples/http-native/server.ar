import Network from 'libNetwork.ar'
import EventLoop from 'libEventLoop.ar'
import System from 'libSystem.ar'
import Http from 'libHttp.ar'
import State from 'libState.ar'

entry {{
    member serviceName:string
    member store:State.Store

    __() -> i32 {
        System.enableProcessArena()
        local configuredName = System.environmentVariable("VALEN_SERVICE_NAME")
        if configuredName == null { self.serviceName = "Valen" } else { self.serviceName = configuredName! }
        local configuredPath = System.environmentVariable("VALEN_STATE_PATH")
        if configuredPath == null { self.store = new State.Store("/tmp/valen-value.state") } else { self.store = new State.Store(configuredPath!) }
        if !self.store.load() {
            System.writeError("valen-http: invalid or unreadable state; OS error ")
            System.writeError(self.store.errorCode.toString())
            System.writeError("\n")
            return 78
        }
        local listener = Network.listen(18080, 16)
        if listener == null {
            System.writeError("valen-http: listen failed\n")
            System.print(Network.lastError())
            return 1
        }
        if !Network.makeListenerNonblocking(listener!) {
            Network.closeListener(listener!)
            return 2
        }
        System.write("valen-http: ready on http://127.0.0.1:18080\n")
        local descriptors = new Array<i64>(0)
        local interests = new Array<i64>(0)
        descriptors.append(Network.listenerDescriptor(listener!))
        interests.append(1)
        local served:i64 = 0
        while served < 4 {
            if EventLoop.wait(descriptors, interests, -1) != 0 {
                Network.closeListener(listener!)
                return 3
            }
            local result = self.serve(listener!)
            if result != 0 {
                Network.closeListener(listener!)
                System.writeError("valen-http: request failed\n")
                System.print(result)
                return 4
            }
            served = served + 1
        }
        Network.closeListener(listener!)
        return 0
    }

    serve(listener:Network.Listener) -> i64 {
        local connection = Network.accept(listener)
        if connection == null { return Network.lastError() }
        local request = Network.receive(connection!, 4096)
        if request == null {
            Network.closeConnection(connection!)
            return Network.lastError()
        }
        local parsed = Http.parse(request!)
        local response:Http.Response
        if parsed == null {
            response = new Http.Response("400 Bad Request", "bad request\n")
        } else {
            response = self.route(parsed!)
        }
        local output = response.serialize()
        if Network.send(connection!, output) != output.length {
            Network.closeConnection(connection!)
            return Network.lastError()
        }
        Network.closeConnection(connection!)
        return 0
    }

    route(request:Http.Request) -> Http.Response {
        if request.method == "GET" && request.target == "/health" {
            return new Http.Response("200 OK", "ok\n")
        }
        if request.method == "GET" && request.target == "/config" {
            return new Http.Response("200 OK", "service=" + self.serviceName + "\n")
        }
        if request.method == "GET" && request.target == "/value" {
            return new Http.Response("200 OK", self.store.value.toString() + "\n")
        }
        if request.method == "PUT" && request.target == "/value" {
            local parsed = System.parseInteger(request.body)
            if !parsed.valid { return new Http.Response("400 Bad Request", "invalid value\n") }
            if !self.store.update(parsed.value) {
                System.writeError("valen-http: persistence failed; OS error ")
                System.writeError(self.store.errorCode.toString())
                System.writeError("\n")
                return new Http.Response("500 Internal Server Error", "persistence failed\n")
            }
            return new Http.Response("200 OK", self.store.value.toString() + "\n")
        }
        return new Http.Response("404 Not Found", "not found\n")
    }
}}
