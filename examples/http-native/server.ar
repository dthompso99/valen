import Network from 'libNetwork.ar'
import System from 'libSystem.ar'

entry {{
    __() -> i32 {
        local listener = Network.listen(8080, 16)
        if listener == null {
            System.writeError("argon-http: listen failed\n")
            return 1
        }
        System.write("argon-http: listening on http://127.0.0.1:8080\n")
        local connection = Network.accept(listener!)
        if connection == null {
            Network.closeListener(listener!)
            System.writeError("argon-http: accept failed\n")
            return 2
        }
        local request = Network.receive(connection!, 4096)
        if request == null {
            Network.closeConnection(connection!)
            Network.closeListener(listener!)
            return 3
        }
        local response = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 13\r\nConnection: close\r\n\r\nHello, Argon!"
        if Network.send(connection!, response) != response.length {
            Network.closeConnection(connection!)
            Network.closeListener(listener!)
            return 4
        }
        Network.closeConnection(connection!)
        Network.closeListener(listener!)
        return 0
    }
}}
