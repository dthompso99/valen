import Network from'libNetwork.ar'
import EventLoop from'libEventLoop.ar'
import System from'libSystem.ar'
import Json from'libJson.ar'
import Http from'./libHttp.ar'
import State from'./libState.ar'
import Service from'./libService.ar'
import Site from'./libSite.ar'

entry {{
    member serviceName:string
    member store:State.Store

    __() -> i32 {
        System.enableProcessArena()
        local configuredName = System.environmentVariable("VALEN_SERVICE_NAME")
        if configuredName == null { self.serviceName = "Valen" } else { self.serviceName = configuredName! }
        local configuredPath = System.environmentVariable("VALEN_STATE_PATH")
        if configuredPath == null { self.store = new State.Store("/tmp/valen-value.state") } else { self.store = new State.Store(configuredPath!) }
        if!self.store.load() {
            System.writeError("valen-http: invalid or unreadable state; OS error ")
            System.writeError(self.store.errorCode.toString())
            System.writeError("\n")
            return 78
        }
        local requestLimit:i64 = 4
        local configuredLimit = System.environmentVariable("VALEN_REQUEST_LIMIT")
        if configuredLimit != null {
            local parsedLimit = System.parseInteger(configuredLimit!)
            if!parsedLimit.valid || parsedLimit.value < 1 { return 64 }
            requestLimit = parsedLimit.value
        }
        local listener = Network.listen(18080, 16)
        if listener == null {
            System.writeError("valen-http: listen failed\n")
            System.print(Network.lastError())
            return 1
        }
        if!Network.makeListenerNonblocking(listener!) {
            Network.closeListener(listener!)
            return 2
        }
        System.write("valen-http: ready on http://127.0.0.1:18080\n")
        local loop = new Service.Loop()
        local completed:i64 = 0
        while completed < requestLimit {
            local descriptors = loop.descriptors(listener!)
            local interests = loop.interests()
            local ready = EventLoop.wait(descriptors, interests, 50)
            completed = completed + loop.expire(EventLoop.monotonicMilliseconds())
            if ready == 0 {
                if!loop.accept(listener!) { Network.closeListener(listener!); return 3 }
            } else {
                if ready > 0 {
                    local index = loop.clientAt(ready - 1)
                    if index >= 0 {
                        local client = loop.clients[index]!
                        local terminal:bool = false
                        if client.output.length == 0 {
                            local received = client.receive(loop.maximumRequest)
                            if received < 0 { terminal = true }
                            if received == 2 { client.respond(new Http.Response("413 Content Too Large", "request too large\n"), loop.maximumResponse) }
                            if received == 3 { client.respond(new Http.Response("400 Bad Request", "bad request\n"), loop.maximumResponse) }
                            if received == 1 {
                                local request = Http.parse(client.input)
                                if request == null { client.respond(new Http.Response("400 Bad Request", "bad request\n"), loop.maximumResponse) }
                                else { client.respond(self.route(request!), loop.maximumResponse) }
                            }
                        } else {
                            local flushed = client.flush()
                            if flushed != 0 { terminal = true }
                        }
                        if terminal { loop.close(index); completed = completed + 1 }
                    }
                }
            }
        }
        local index:i64 = 0
        while index < loop.clients.length { loop.close(index); index = index + 1 }
        Network.closeListener(listener!)
        return 0
    }

    route(request:Http.Request) -> Http.Response {
        if request.method == "GET" && request.target == "/" {
            local configuredRoot = System.environmentVariable("VALEN_DOCUMENT_ROOT")
            local documentRoot:string = "examples/site"
            if configuredRoot != null { documentRoot = configuredRoot! }
            local document = Site.loadIndex(documentRoot, 3072)
            if!document.valid {
                System.writeError("valen-http: invalid or unreadable document root; OS error ")
                System.writeError(document.error.toString())
                System.writeError("\n")
                return new Http.Response("500 Internal Server Error", "document root unavailable\n")
            }
            return new Http.Response("200 OK", document.content, "text/html; charset=utf-8")
        }
        if request.method == "GET" && request.target == "/health" { return new Http.Response("200 OK", "ok\n") }
        if request.method == "GET" && request.target == "/health.json" { return new Http.Response("200 OK", "{\"status\":\"ok\",\"service\":" + Json.quote(self.serviceName) + "}\n", "application/json") }
        if request.method == "GET" && request.target == "/config" { return new Http.Response("200 OK", "service=" + self.serviceName + "\n") }
        if request.method == "GET" && request.target == "/value" { return new Http.Response("200 OK", self.store.value.toString() + "\n") }
        if request.method == "PUT" && request.target == "/value" {
            local parsed = System.parseInteger(request.body)
            if!parsed.valid { return new Http.Response("400 Bad Request", "invalid value\n") }
            if!self.store.update(parsed.value) {
                System.writeError("valen-http: persistence failed; OS error ")
                System.writeError(self.store.errorCode.toString())
                System.writeError("\n")
                return new Http.Response("500 Internal Server Error", "persistence failed\n")
            }
            return new Http.Response("200 OK", self.store.value.toString() + "\n")
        }
        return new Http.Response("404 Not Found", "not found\n")
    }
}}
