import System from'std/libSystem.ar'

entry {{
    prime(value:i64) -> bool {
        if value < 2 { return false }
        local divisor:i64 = 2
        while divisor <= value / divisor {
            if value -(value / divisor) * divisor == 0 { return false }
            divisor = divisor + 1
        }
        return true
    }

    __() -> i32 {
        local count:i64 = 0
        local candidate:i64 = 2
        while candidate <= 10000 {
            if self.prime(candidate) { count = count + 1 }
            candidate = candidate + 1
        }
        System.write("primes through 10000: " + count.toString() + "\n")
        return 0
    }
}}
