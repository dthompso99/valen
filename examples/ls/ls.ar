import System from'std/libSystem.ar'

entry {{
    before(left:string, right:string) -> bool {
        local shared = left.length
        if right.length < shared { shared = right.length }
        local index:i64 = 0
        while index < shared {
            if left[index] < right[index] { return true }
            if left[index] > right[index] { return false }
            index = index + 1
        }
        return left.length < right.length
    }

    suffix(entry:System.DirectoryEntry) -> string {
        if entry.kind == System.DirectoryEntryKind.Directory { return"/" }
        if entry.kind == System.DirectoryEntryKind.SymbolicLink { return"@" }
        return""
    }

    list(path:string) -> bool {
        local listing = System.listDirectory(path)
        if!listing.valid {
            System.writeError("valen-ls: " + path + ": OS error " + listing.error.toString() + "\n")
            return false
        }
        local entries = listing.entries
        local emitted = new Array < bool >(entries.length)
        local count:i64 = 0
        while count < entries.length {
            local selected:i64 =- 1
            local index:i64 = 0
            while index < entries.length {
                if!emitted[index] {
                    if selected < 0 || self.before(entries[index].name, entries[selected].name) { selected = index }
                }
                index = index + 1
            }
            System.write(entries[selected].name + self.suffix(entries[selected]) + "\n")
            emitted[selected] = true
            count = count + 1
        }
        return true
    }

    __() -> i32 {
        local arguments = System.arguments()
        if arguments.length > 2 {
            System.writeError("usage: valen-ls [DIRECTORY]\n")
            return 64
        }
        local path = "."
        if arguments.length == 2 { path = arguments[1] }
        if!self.list(path) { return 1 }
        return 0
    }
}}
