library Page {{
    html() -> string {
        local output = new StringBuilder()
        output.append("<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Clippy</title>")
        output.append("<style>body{font-family:sans-serif;max-width:800px;margin:2rem auto;padding:0 1rem;background:#f5f5f5}.card{background:white;padding:1.5rem;border-radius:.5rem}textarea{box-sizing:border-box;width:100%;height:14rem}img{max-width:100%;max-height:24rem}.ok{color:green}.bad{color:red}</style></head>")
        output.append("<body><main class=\"card\"><h1>Clippy</h1><p>Share clipboard content inside the local network.</p><textarea id=\"text\"></textarea><img id=\"image\" hidden><p><button id=\"paste\">Paste</button> <button id=\"copy\">Copy</button> <button id=\"clear\">Clear</button></p><strong id=\"status\" class=\"bad\">Disconnected</strong></main>")
        output.append("<script>const text=document.getElementById('text'),image=document.getElementById('image'),status=document.getElementById('status');let socket;function show(v){if(v.type==='image'){image.src=v.data;image.hidden=false;text.hidden=true}else{text.value=v.data;text.hidden=false;image.hidden=true}}function send(v){if(socket&&socket.readyState===1)socket.send(JSON.stringify(v))}function connect(){socket=new WebSocket((location.protocol==='https:'?'wss://':'ws://')+location.host+'/ws');socket.onopen=()=>{status.textContent='Connected';status.className='ok'};socket.onclose=()=>{status.textContent='Disconnected';status.className='bad';setTimeout(connect,1000)};socket.onmessage=e=>{try{show(JSON.parse(e.data))}catch(_){}}}text.oninput=()=>send({type:'text',data:text.value});document.getElementById('clear').onclick=()=>{show({type:'text',data:''});send({type:'text',data:''})};document.getElementById('paste').onclick=async()=>{const items=await navigator.clipboard.read();for(const item of items){const kind=item.types.find(t=>t.startsWith('image/'));if(kind){const blob=await item.getType(kind),reader=new FileReader();reader.onload=()=>{const v={type:'image',data:reader.result};show(v);send(v)};reader.readAsDataURL(blob);return}if(item.types.includes('text/plain')){const v={type:'text',data:await(await item.getType('text/plain')).text()};show(v);send(v);return}}};document.getElementById('copy').onclick=async()=>{if(!text.hidden)await navigator.clipboard.writeText(text.value);else{const blob=await(await fetch(image.src)).blob();await navigator.clipboard.write([new ClipboardItem({[blob.type]:blob})])}};connect();</script></body></html>")
        return output.build()
    }
}}
