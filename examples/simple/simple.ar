import System from 'std/libSystem.ar'

// Objects use double braces. The object named entry is the program entry point.
entry {{
    // __ is the class entry point.
    __() -> i32 {
        System.print(self.add(10,4))
        self.count()
        System.write("Finished\n")
        return 0
    }
    add(a: i64, b: i64) -> i64 {
        return a + b
    }
    count() -> i64 {
       local value:i64 = 0

        while value < 5 {
            value = value + 1

            if value == 2 {
                continue
            }

            if value == 4 {
                break
            } else {
                System.print(value)
            }
        }

        if true {
            return 0
        } else {
            return 1
        }
    }
}}
