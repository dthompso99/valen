import System from './libSystem.ar'
import Compiler from './libCompiler.ar'
import Ast from './libAst.ar'
import Parsing from './libParser.ar'
import Diagnostics from './libDiagnostics.ar'

library ModuleLoading {{
    ModuleImport {{
        member name:string
        member declaration:Ast.ImportDeclaration
        member loadedModule:Module

        __(name:string, declaration:Ast.ImportDeclaration, loadedModule:Module) -> void {
            self.name = name
            self.declaration = declaration
            self.loadedModule = loadedModule
        }
    }}

    Module {{
        member path:string
        member owningRoot:string
        member source:Compiler.SourceFile
        member program:Ast.Program
        member imports:Array<ModuleImport>
        member loading:bool

        __(path:string, owningRoot:string, source:Compiler.SourceFile, program:Ast.Program) -> void {
            self.path = path
            self.owningRoot = owningRoot
            self.source = source
            self.program = program
            self.imports = new Array<ModuleImport>(0)
            self.loading = true
        }

        hasImport(name:string) -> bool {
            local index:i64 = 0
            while index < self.imports.length {
                if self.imports[index].name == name { return true }
                index = index + 1
            }
            return false
        }

        releaseImplementation() -> void {
            local declarationIndex:i64 = 0
            while declarationIndex < self.program.declarations.length {
                self.releaseMembers(self.program.declarations[declarationIndex].members)
                declarationIndex = declarationIndex + 1
            }
            self.source.content = ""
        }

        releaseMembers(members:Array<Ast.MemberDeclaration>) -> void {
            local index:i64 = 0
            while index < members.length {
                members[index].body = null
                if members[index].kind == "Field" { members[index].initializer = null }
                if members[index].kind == "Object" { self.releaseMembers(members[index].members) }
                index = index + 1
            }
        }
    }}

    ResolvedImport {{
        member path:string
        member root:string
        __(path:string, root:string) -> void { self.path = path; self.root = root }
    }}

    ModuleGraph {{
        member entry:Module?
        member modules:Array<Module>
        member diagnostics:Diagnostics.DiagnosticBag

        __(entry:Module?, modules:Array<Module>, diagnostics:Diagnostics.DiagnosticBag) -> void {
            self.entry = entry
            self.modules = modules
            self.diagnostics = diagnostics
        }
    }}

    ModuleLoader {{
        member sourceRoot:string
        member libraryPath:string?
        member modules:Array<Module>
        member diagnostics:Diagnostics.DiagnosticBag

        __(sourceRoot:string, libraryPath:string?=null) -> void {
            self.sourceRoot = self.normalizePath(sourceRoot)
            self.libraryPath = libraryPath
            self.modules = new Array<Module>(0)
            self.diagnostics = new Diagnostics.DiagnosticBag()
        }

        load(entryPath:string) -> ModuleGraph {
            local path = entryPath
            if entryPath.length == 0 {
                self.reportPath(entryPath, "Entry path cannot be empty")
                return new ModuleGraph(null, self.modules, self.diagnostics)
            }
            if entryPath[0] != 47 { path = self.sourceRoot + "/" + entryPath }
            local entry = self.loadModule(path, null, self.sourceRoot)
            return new ModuleGraph(entry, self.modules, self.diagnostics)
        }

        loadModule(path:string, importSpan:Compiler.SourceSpan?, owningRoot:string) -> ref Module? {
            local existing = self.find(path)
            if existing != null {
                if existing!.loading { self.report(path, "Circular import involving '" + path + "'", importSpan) }
                return existing
            }
            local source = Compiler.loadSource(path)
            if source == null {
                self.report(path, "Cannot load source file; OS error " + System.lastError().toString(), importSpan)
                return null
            }
            local tokenizer = new Compiler.Tokenizer(source!)
            local tokens = tokenizer.tokenize()
            if tokenizer.error != null {
                self.diagnostics.add(new Diagnostics.Diagnostic(1, tokenizer.error!, tokenizer.errorSpan!))
                return null
            }
            local parser = new Parsing.Parser(tokens)
            local program = parser.parse()
            if parser.error != null {
                self.diagnostics.add(new Diagnostics.Diagnostic(1, parser.error!, parser.errorSpan!))
                return null
            }
            local loaded = new Module(path, owningRoot, source!, program)
            self.modules.append(loaded)
            local index:i64 = 0
            while index < program.imports.length {
                local declaration = program.imports[index]
                local resolved = self.resolveImport(loaded, declaration.path, declaration.span)
                local imported:Module? = null
                if resolved != null { imported = self.loadModule(resolved!.path, declaration.span, resolved!.root) }
                if imported != null {
                    if loaded.hasImport(declaration.name) {
                        self.diagnostics.add(new Diagnostics.Diagnostic(1, "Duplicate import '" + declaration.name + "'", declaration.span))
                    } else {
                        loaded.imports.append(new ModuleImport(declaration.name, declaration, imported!))
                    }
                }
                index = index + 1
            }
            loaded.loading = false
            return loaded
        }

        resolveImport(importer:Module, specifier:string, span:Compiler.SourceSpan) -> ref ResolvedImport? {
            if specifier.length < 3 || specifier.slice(specifier.length - 3, 3) != ".ar" {
                self.diagnostics.add(new Diagnostics.Diagnostic(1, "Import '" + specifier + "' must include the .ar extension", span)); return null
            }
            if self.starts(specifier, "./") || self.starts(specifier, "../") {
                local localPath = self.normalizePath(System.resolvePath(self.sourceRoot, importer.path, specifier))
                if !self.within(importer.owningRoot, localPath) {
                    self.diagnostics.add(new Diagnostics.Diagnostic(1, "Import '" + specifier + "' escapes its owning root '" + importer.owningRoot + "'", span)); return null
                }
                if Compiler.loadSource(localPath) != null { return new ResolvedImport(localPath, importer.owningRoot) }
                self.diagnostics.add(new Diagnostics.Diagnostic(1, "Cannot resolve import '" + specifier + "'; searched: " + localPath, span)); return null
            }
            if specifier.length > 0 { if specifier[0] == 47 {
                local projectPath = self.normalizePath(System.resolvePath(self.sourceRoot, importer.path, specifier))
                if Compiler.loadSource(projectPath) != null { return new ResolvedImport(projectPath, self.sourceRoot) }
                self.diagnostics.add(new Diagnostics.Diagnostic(1, "Cannot resolve project import '" + specifier + "'; searched: " + projectPath, span)); return null
            } }
            if self.hasParentSegment(specifier) {
                self.diagnostics.add(new Diagnostics.Diagnostic(1, "Library import '" + specifier + "' cannot contain '..'", span)); return null
            }
            local searched = ""
            if self.libraryPath != null {
                local paths = self.libraryPath!
                local start:i64 = 0
                local index:i64 = 0
                while index <= paths.length {
                    local separator:bool = false
                    if index == paths.length { separator = true } else { if paths[index] == 58 { separator = true } }
                    if separator {
                        if index > start {
                            local root = self.normalizePath(paths.slice(start, index - start))
                            local candidate = root + "/" + specifier
                            if searched.length > 0 { searched = searched + ", " }; searched = searched + candidate
                            if Compiler.loadSource(candidate) != null { return new ResolvedImport(candidate, root) }
                        }
                        start = index + 1
                    }
                    index = index + 1
                }
            }
            if searched.length == 0 { searched = "<no VALEN_LIBRARY_PATH entries>" }
            self.diagnostics.add(new Diagnostics.Diagnostic(1, "Cannot resolve library import '" + specifier + "' from '" + importer.path + "'; searched: " + searched, span))
            return null
        }

        starts(value:string, prefix:string) -> bool {
            return value.length >= prefix.length && value.slice(0, prefix.length) == prefix
        }

        within(root:string, candidate:string) -> bool {
            if candidate == root { return true }
            if candidate.length <= root.length || candidate.slice(0, root.length) != root { return false }
            return candidate[root.length] == 47
        }

        hasParentSegment(specifier:string) -> bool {
            local start:i64 = 0
            local index:i64 = 0
            while index <= specifier.length {
                if index == specifier.length || specifier[index] == 47 {
                    if index - start == 2 { if specifier.slice(start, 2) == ".." { return true } }
                    start = index + 1
                }
                index = index + 1
            }
            return false
        }

        normalizePath(path:string) -> string {
            local segments = new Array<string>(0)
            local count:i64 = 0
            local start:i64 = 0
            local index:i64 = 0
            while index <= path.length {
                if index == path.length || path[index] == 47 {
                    local segment = path.slice(start, index - start)
                    if segment.length > 0 && segment != "." {
                        if segment == ".." { if count > 0 { count = count - 1 } }
                        else {
                            if count < segments.length { segments[count] = segment } else { segments.append(segment) }
                            count = count + 1
                        }
                    }
                    start = index + 1
                }
                index = index + 1
            }
            local output = ""
            if path.length > 0 { if path[0] == 47 { output = "/" } }
            index = 0
            while index < count {
                if output.length > 0 && output != "/" { output = output + "/" }
                output = output + segments[index]
                index = index + 1
            }
            if output.length == 0 { return "." }
            return output
        }

        find(path:string) -> ref Module? {
            local index:i64 = 0
            while index < self.modules.length {
                if self.modules[index].path == path { return self.modules[index] }
                index = index + 1
            }
            return null
        }

        report(path:string, message:string, span:Compiler.SourceSpan?) -> void {
            if span != null {
                self.diagnostics.add(new Diagnostics.Diagnostic(1, message, span!))
                return
            }
            self.reportPath(path, message)
        }

        reportPath(path:string, message:string) -> void {
            local source = new Compiler.SourceFile(path, "")
            local span = new Compiler.SourceSpan(source, 0, 0, 1, 1)
            self.diagnostics.add(new Diagnostics.Diagnostic(1, message, span))
        }
    }}
}}
