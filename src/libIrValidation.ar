import Ir from './libIr.ar'
import System from './libSystem.ar'

library IrValidation {{
    FoldedConstant {{
        member name:string
        member value:i64
        member typeName:string
        __(name:string, value:i64, typeName:string) -> void { self.name = name; self.value = value; self.typeName = typeName }
    }}

    PropagatedValue {{
        member name:string
        member value:Ir.Value
        member active:bool
        __(name:string, value:Ir.Value) -> void { self.name = name; self.value = value; self.active = true }
    }}

    TemporaryUseLocation {{
        member name:string
        member blockIndex:i64
        member crossesBlocks:bool
        __(name:string, blockIndex:i64) -> void { self.name = name; self.blockIndex = blockIndex; self.crossesBlocks = false }
    }}

    ExactType {{
        member name:string
        member typeName:string
        member invalid:bool
        __(name:string, typeName:string) -> void { self.name = name; self.typeName = typeName; self.invalid = false }
    }}

    Pass {{
        prepare(program:Ir.Program, optimize:bool=true, requireEntry:bool=true, scalarReplacement:bool=true) -> Array<string> {
            self.canonicalize(program, optimize, scalarReplacement)
            return self.validate(program, requireEntry)
        }

        canonicalize(program:Ir.Program, optimize:bool=true, scalarReplacement:bool=true) -> void {
            local functionIndex:i64 = 0
            while functionIndex < program.functions.length {
                local functionNode = program.functions[functionIndex]
                local blockIndex:i64 = 0
                while blockIndex < functionNode.blocks.length {
                    local block = functionNode.blocks[blockIndex]
                    local instructions = new Array<ref Ir.Instruction>(0)
                    local instructionIndex:i64 = 0
                    local terminated:bool = false
                    while instructionIndex < block.instructions.length {
                        if !terminated {
                            local instruction = block.instructions[instructionIndex]
                            instructions.append(instruction)
                            if self.isTerminator(instruction.op) { terminated = true }
                        }
                        instructionIndex = instructionIndex + 1
                    }
                    if !terminated && functionNode.returnType == "void" { instructions.append(new Ir.Instruction("return")) }
                    block.instructions = instructions
                    blockIndex = blockIndex + 1
                }
                if optimize {
                    self.foldConstants(functionNode)
                    self.simplifyControlFlow(functionNode)
                    self.removeUnreachable(functionNode)
                    self.splitCriticalEdges(functionNode)
                    self.promoteLoopLocals(functionNode)
                    self.propagateLocalValues(functionNode)
                    self.devirtualizeExactCalls(program, functionNode)
                    self.inlineLeafCalls(program, functionNode)
                    self.propagateLocalValues(functionNode)
                    if scalarReplacement { self.replaceLocalObjects(program, functionNode) }
                    self.removeDeadValues(functionNode)
                }
                functionIndex = functionIndex + 1
            }
        }

        predecessorCount(functionNode:Ir.Function, label:string) -> i64 {
            local count:i64 = 0
            local blockIndex:i64 = 0
            while blockIndex < functionNode.blocks.length {
                local block = functionNode.blocks[blockIndex]
                if block.instructions.length > 0 {
                    local end = block.instructions[block.instructions.length - 1]
                    if end.op == "jump" { if end.target! == label { count = count + 1 } }
                    if end.op == "branch" { if end.target! == label { count = count + 1 }; if end.alternateTarget! == label { count = count + 1 } }
                }
                blockIndex = blockIndex + 1
            }
            return count
        }

        splitCriticalEdges(functionNode:Ir.Function) -> void {
            local originalCount = functionNode.blocks.length
            local sequence:i64 = 0
            local blockIndex:i64 = 0
            while blockIndex < originalCount {
                local block = functionNode.blocks[blockIndex]
                if block.instructions.length > 0 {
                    local end = block.instructions[block.instructions.length - 1]
                    if end.op == "branch" {
                        if self.predecessorCount(functionNode, end.target!) > 1 {
                            local target = end.target!
                            local label = self.criticalEdgeLabel(functionNode, sequence); sequence = sequence + 1
                            local edge = new Ir.Block(label); local jump = new Ir.Instruction("jump"); jump.target = target; edge.instructions.append(jump); functionNode.blocks.append(edge); end.target = label
                        }
                        if self.predecessorCount(functionNode, end.alternateTarget!) > 1 {
                            local target = end.alternateTarget!
                            local label = self.criticalEdgeLabel(functionNode, sequence); sequence = sequence + 1
                            local edge = new Ir.Block(label); local jump = new Ir.Instruction("jump"); jump.target = target; edge.instructions.append(jump); functionNode.blocks.append(edge); end.alternateTarget = label
                        }
                    }
                }
                blockIndex = blockIndex + 1
            }
        }

        criticalEdgeLabel(functionNode:Ir.Function, start:i64) -> string {
            local sequence = start
            local label = "critical_edge_" + sequence.toString()
            while self.findBlock(functionNode, label) != null { sequence = sequence + 1; label = "critical_edge_" + sequence.toString() }
            return label
        }

        promoteLoopLocals(functionNode:Ir.Function) -> void {
            local headerIndex:i64 = 0
            while headerIndex < functionNode.blocks.length {
                local header = functionNode.blocks[headerIndex]
                if self.predecessorCount(functionNode, header.label) == 2 && header.instructions.length > 0 && header.instructions[header.instructions.length - 1].op == "branch" {
                    local branch = header.instructions[header.instructions.length - 1]
                    local bodyIndex = self.directBackedgeIndex(functionNode, header.label, branch.target!, branch.alternateTarget!)
                    local preheaderIndex = self.otherPredecessorIndex(functionNode, header.label, bodyIndex)
                    if bodyIndex >= 0 && preheaderIndex >= 0 {
                        local bodyLabel = functionNode.blocks[bodyIndex].label
                        local exitLabel = branch.target!; if exitLabel == bodyLabel { exitLabel = branch.alternateTarget! }
                        local exitIndex = self.blockIndex(functionNode, exitLabel)
                        if exitIndex >= 0 && self.predecessorCount(functionNode, bodyLabel) == 1 && self.predecessorCount(functionNode, exitLabel) == 1 {
                            local declarationIndex:i64 = 0
                            while declarationIndex < functionNode.blocks[preheaderIndex].instructions.length {
                                local declaration = functionNode.blocks[preheaderIndex].instructions[declarationIndex]
                                if declaration.op == "declare_local" && declaration.name != null && declaration.first != null && declaration.typeName != null && self.scalarPrimitive(declaration.typeName!) {
                                    if self.promoteLoopLocal(functionNode, preheaderIndex, headerIndex, bodyIndex, exitIndex, declaration) { declarationIndex = 0 } else { declarationIndex = declarationIndex + 1 }
                                } else { declarationIndex = declarationIndex + 1 }
                            }
                        }
                    }
                }
                headerIndex = headerIndex + 1
            }
        }

        directBackedgeIndex(functionNode:Ir.Function, header:string, first:string, second:string) -> i64 {
            local index:i64 = 0
            while index < functionNode.blocks.length { local block = functionNode.blocks[index]; if (block.label == first || block.label == second) && block.instructions.length > 0 { local end = block.instructions[block.instructions.length - 1]; if end.op == "jump" && end.target! == header { return index } }; index = index + 1 }
            return -1
        }

        otherPredecessorIndex(functionNode:Ir.Function, header:string, excluded:i64) -> i64 {
            local index:i64 = 0
            while index < functionNode.blocks.length { if index != excluded { local block = functionNode.blocks[index]; if block.instructions.length > 0 { local end = block.instructions[block.instructions.length - 1]; if end.op == "jump" && end.target! == header { return index } } }; index = index + 1 }
            return -1
        }

        blockIndex(functionNode:Ir.Function, label:string) -> i64 { local index:i64 = 0; while index < functionNode.blocks.length { if functionNode.blocks[index].label == label { return index }; index = index + 1 }; return -1 }

        promoteLoopLocal(functionNode:Ir.Function, preheaderIndex:i64, headerIndex:i64, bodyIndex:i64, exitIndex:i64, declaration:Ir.Instruction) -> bool {
            local stores:i64 = 0; local store:Ir.Instruction? = null; local valid:bool = true; local blockIndex:i64 = 0
            while blockIndex < functionNode.blocks.length { local instructionIndex:i64 = 0; while instructionIndex < functionNode.blocks[blockIndex].instructions.length { local instruction = functionNode.blocks[blockIndex].instructions[instructionIndex]; if instruction.name != null && instruction.name! == declaration.name! { if instruction.op == "store_local" { stores = stores + 1; store = instruction; if blockIndex != bodyIndex || instruction.first == null { valid = false } }; if instruction.op == "load_local" && blockIndex != headerIndex && blockIndex != bodyIndex && blockIndex != exitIndex { valid = false } }; instructionIndex = instructionIndex + 1 }; blockIndex = blockIndex + 1 }
            if !valid || stores != 1 || store == null { return false }
            local result = self.freshLoopValue(functionNode)
            local loopValue = new Ir.Value("temporary", result, declaration.typeName!)
            blockIndex = 0
            while blockIndex < functionNode.blocks.length { local retained = new Array<ref Ir.Instruction>(0); local instructionIndex:i64 = 0; while instructionIndex < functionNode.blocks[blockIndex].instructions.length { local instruction = functionNode.blocks[blockIndex].instructions[instructionIndex]; instruction.first = self.replaceLoopLoad(instruction.first, functionNode, declaration.name!, loopValue); instruction.second = self.replaceLoopLoad(instruction.second, functionNode, declaration.name!, loopValue); instruction.third = self.replaceLoopLoad(instruction.third, functionNode, declaration.name!, loopValue); local argumentIndex:i64 = 0; while argumentIndex < instruction.arguments.length { instruction.arguments[argumentIndex] = self.replaceLoopLoad(instruction.arguments[argumentIndex], functionNode, declaration.name!, loopValue)!; argumentIndex = argumentIndex + 1 }; local remove = instruction.name != null && instruction.name! == declaration.name! && (instruction.op == "load_local" || instruction.op == "store_local" || instruction.op == "declare_local"); if !remove { retained.append(instruction) }; instructionIndex = instructionIndex + 1 }; functionNode.blocks[blockIndex].instructions = retained; blockIndex = blockIndex + 1 }
            local loop = new Ir.Instruction("loop_value"); loop.result = loopValue; loop.typeName = declaration.typeName; loop.first = declaration.first; loop.second = store!.first; loop.target = functionNode.blocks[preheaderIndex].label; loop.alternateTarget = functionNode.blocks[bodyIndex].label
            local header = new Array<ref Ir.Instruction>(0); local index:i64 = 0; while index < functionNode.blocks[headerIndex].instructions.length && functionNode.blocks[headerIndex].instructions[index].op == "loop_value" { header.append(functionNode.blocks[headerIndex].instructions[index]); index = index + 1 }; header.append(loop); while index < functionNode.blocks[headerIndex].instructions.length { header.append(functionNode.blocks[headerIndex].instructions[index]); index = index + 1 }; functionNode.blocks[headerIndex].instructions = header
            return true
        }

        replaceLoopLoad(value:Ir.Value?, functionNode:Ir.Function, localName:string, replacement:Ir.Value) -> ref Ir.Value? {
            if value == null || value!.kind != "temporary" { return value }
            local blockIndex:i64 = 0; while blockIndex < functionNode.blocks.length { local instructionIndex:i64 = 0; while instructionIndex < functionNode.blocks[blockIndex].instructions.length { local instruction = functionNode.blocks[blockIndex].instructions[instructionIndex]; if instruction.op == "load_local" && instruction.name != null && instruction.name! == localName && instruction.result != null && instruction.result!.name == value!.name { return replacement }; instructionIndex = instructionIndex + 1 }; blockIndex = blockIndex + 1 }
            return value
        }

        freshLoopValue(functionNode:Ir.Function) -> string { local sequence:i64 = 0; local name = "%loop" + sequence.toString(); while self.hasResult(functionNode, name) { sequence = sequence + 1; name = "%loop" + sequence.toString() }; return name }
        hasResult(functionNode:Ir.Function, name:string) -> bool { local blockIndex:i64 = 0; while blockIndex < functionNode.blocks.length { local instructionIndex:i64 = 0; while instructionIndex < functionNode.blocks[blockIndex].instructions.length { local result = functionNode.blocks[blockIndex].instructions[instructionIndex].result; if result != null && result!.name == name { return true }; instructionIndex = instructionIndex + 1 }; blockIndex = blockIndex + 1 }; return false }

        devirtualizeExactCalls(program:Ir.Program, functionNode:Ir.Function) -> void {
            local exactTemporaries = new Array<ExactType>(0)
            local declarations = new Array<PropagatedValue>(0)
            local exactLocals = new Array<ExactType>(0)
            local blockIndex:i64 = 0
            while blockIndex < functionNode.blocks.length {
                local instructionIndex:i64 = 0
                while instructionIndex < functionNode.blocks[blockIndex].instructions.length {
                    local instruction = functionNode.blocks[blockIndex].instructions[instructionIndex]
                    if instruction.op == "allocate" && instruction.result != null { self.setExactType(exactTemporaries, instruction.result!.name, instruction.result!.typeName) }
                    if instruction.op == "declare_local" && instruction.name != null && instruction.first != null {
                        if self.findPropagated(declarations, instruction.name!) != null { self.invalidateExactType(exactLocals, instruction.name!) }
                        else { declarations.append(new PropagatedValue(instruction.name!, instruction.first!)) }
                    }
                    if instruction.op == "store_local" && instruction.name != null { self.invalidateExactType(exactLocals, instruction.name!) }
                    instructionIndex = instructionIndex + 1
                }
                blockIndex = blockIndex + 1
            }
            local changed:bool = true
            while changed {
                changed = false
                local declarationIndex:i64 = 0
                while declarationIndex < declarations.length {
                    local declaration = declarations[declarationIndex]
                    if self.findExactType(exactLocals, declaration.name) == null && !self.exactTypeInvalid(exactLocals, declaration.name) {
                        local typeName = self.findExactType(exactTemporaries, declaration.value.name)
                        if typeName != null { self.setExactType(exactLocals, declaration.name, typeName!); changed = true }
                    }
                    declarationIndex = declarationIndex + 1
                }
                blockIndex = 0
                while blockIndex < functionNode.blocks.length {
                    local instructionIndex:i64 = 0
                    while instructionIndex < functionNode.blocks[blockIndex].instructions.length {
                        local instruction = functionNode.blocks[blockIndex].instructions[instructionIndex]
                        if instruction.op == "load_local" && instruction.result != null && instruction.name != null && self.findExactType(exactTemporaries, instruction.result!.name) == null {
                            local typeName = self.findExactType(exactLocals, instruction.name!)
                            if typeName != null { self.setExactType(exactTemporaries, instruction.result!.name, typeName!); changed = true }
                        }
                        instructionIndex = instructionIndex + 1
                    }
                    blockIndex = blockIndex + 1
                }
            }
            blockIndex = 0
            while blockIndex < functionNode.blocks.length {
                local instructionIndex:i64 = 0
                while instructionIndex < functionNode.blocks[blockIndex].instructions.length {
                    local instruction = functionNode.blocks[blockIndex].instructions[instructionIndex]
                    if (instruction.op == "virtual_call" || instruction.op == "contract_call") && instruction.arguments.length > 0 {
                        local exactName = self.findExactType(exactTemporaries, instruction.arguments[0].name)
                        if exactName != null {
                            local typeNode = self.findType(program, exactName!)
                            local target:string? = null
                            if instruction.op == "virtual_call" {
                                if typeNode != null && instruction.slot >= 0 && instruction.slot < typeNode!.virtualMethods.length { target = typeNode!.virtualMethods[instruction.slot].target }
                            } else if typeNode != null && instruction.ownerType != null {
                                local contractIndex:i64 = 0
                                while contractIndex < typeNode!.contracts.length {
                                    if typeNode!.contracts[contractIndex].name == instruction.ownerType! && instruction.slot >= 0 && instruction.slot < typeNode!.contracts[contractIndex].methods.length { target = typeNode!.contracts[contractIndex].methods[instruction.slot].target }
                                    contractIndex = contractIndex + 1
                                }
                            }
                            if target != null { instruction.op = "call"; instruction.target = target; instruction.ownerType = null; instruction.slot = -1 }
                        }
                    }
                    instructionIndex = instructionIndex + 1
                }
                blockIndex = blockIndex + 1
            }
        }

        inlineLeafCalls(program:Ir.Program, functionNode:Ir.Function) -> void {
            local blockIndex:i64 = 0
            while blockIndex < functionNode.blocks.length {
                local retained = new Array<ref Ir.Instruction>(0)
                local instructionIndex:i64 = 0
                while instructionIndex < functionNode.blocks[blockIndex].instructions.length {
                    local instruction = functionNode.blocks[blockIndex].instructions[instructionIndex]
                    local callee:Ir.Function? = null
                    if instruction.op == "call" && instruction.target != null { callee = self.findDefinedFunction(program, instruction.target!) }
                    if callee == null || callee!.name == functionNode.name || callee!.modulePath != functionNode.modulePath || instruction.result == null || !self.scalarPrimitive(instruction.result!.typeName) || !self.inlineableLeaf(callee!) || callee!.parameters.length != instruction.arguments.length {
                        retained.append(instruction)
                    } else {
                        local values = new Array<PropagatedValue>(0)
                        local parameterIndex:i64 = 0
                        while parameterIndex < callee!.parameters.length { values.append(new PropagatedValue(callee!.parameters[parameterIndex].name, instruction.arguments[parameterIndex])); parameterIndex = parameterIndex + 1 }
                        local body = callee!.blocks[0].instructions
                        local bodyIndex:i64 = 0
                        while bodyIndex < body.length - 1 {
                            local clone = self.cloneInstruction(body[bodyIndex])
                            clone.first = self.resolveInlineValue(clone.first, values); clone.second = self.resolveInlineValue(clone.second, values); clone.third = self.resolveInlineValue(clone.third, values)
                            local argumentIndex:i64 = 0
                            while argumentIndex < clone.arguments.length { clone.arguments[argumentIndex] = self.resolveInlineValue(clone.arguments[argumentIndex], values)!; argumentIndex = argumentIndex + 1 }
                            if clone.result != null {
                                local oldName = clone.result!.name
                                if bodyIndex == body.length - 2 { clone.result = instruction.result }
                                else { clone.result = new Ir.Value("temporary", "%inline_" + blockIndex.toString() + "_" + instructionIndex.toString() + "_" + bodyIndex.toString(), clone.result!.typeName) }
                                self.setPropagated(values, oldName, clone.result!)
                            }
                            retained.append(clone)
                            bodyIndex = bodyIndex + 1
                        }
                    }
                    instructionIndex = instructionIndex + 1
                }
                functionNode.blocks[blockIndex].instructions = retained
                blockIndex = blockIndex + 1
            }
        }

        inlineableLeaf(functionNode:Ir.Function) -> bool {
            if functionNode.blocks.length != 1 || functionNode.blocks[0].instructions.length < 2 || functionNode.blocks[0].instructions.length > 6 { return false }
            local instructions = functionNode.blocks[0].instructions
            local returned = instructions[instructions.length - 1]
            local producer = instructions[instructions.length - 2]
            if returned.op != "return" || returned.first == null || returned.first!.kind != "temporary" || producer.result == null || producer.result!.name != returned.first!.name { return false }
            local index:i64 = 0
            while index < instructions.length - 1 { if !self.inlineableInstruction(instructions[index].op) { return false }; index = index + 1 }
            return true
        }
        inlineableInstruction(op:string) -> bool { return op == "constant" || op == "float_constant" || op == "binary" || op == "unary" || op == "convert" }
        cloneInstruction(source:Ir.Instruction) -> ref Ir.Instruction {
            local clone = new Ir.Instruction(source.op)
            if source.result != null { clone.result = new Ir.Value(source.result!.kind, source.result!.name, source.result!.typeName) }
            clone.first = source.first; clone.second = source.second; clone.third = source.third
            local index:i64 = 0
            while index < source.arguments.length { clone.arguments.append(source.arguments[index]); index = index + 1 }
            clone.name = source.name; clone.target = source.target; clone.alternateTarget = source.alternateTarget; clone.operator = source.operator; clone.typeName = source.typeName; clone.ownerType = source.ownerType; clone.elementType = source.elementType; clone.elementOwnership = source.elementOwnership; clone.text = source.text; clone.slot = source.slot
            return clone
        }
        resolveInlineValue(value:Ir.Value?, values:Array<PropagatedValue>) -> ref Ir.Value? {
            if value == null { return null }
            local replacement = self.findPropagated(values, value!.name)
            if replacement != null { return replacement }
            return value
        }

        findExactType(values:Array<ExactType>, name:string) -> string? {
            local index:i64 = 0
            while index < values.length { if values[index].name == name && !values[index].invalid { return values[index].typeName }; index = index + 1 }
            return null
        }
        exactTypeInvalid(values:Array<ExactType>, name:string) -> bool {
            local index:i64 = 0
            while index < values.length { if values[index].name == name { return values[index].invalid }; index = index + 1 }
            return false
        }
        setExactType(values:Array<ExactType>, name:string, typeName:string) -> void {
            local index:i64 = 0
            while index < values.length { if values[index].name == name { if !values[index].invalid { values[index].typeName = typeName }; return }; index = index + 1 }
            values.append(new ExactType(name, typeName))
        }
        invalidateExactType(values:Array<ExactType>, name:string) -> void {
            local index:i64 = 0
            while index < values.length { if values[index].name == name { values[index].invalid = true; return }; index = index + 1 }
            local value = new ExactType(name, ""); value.invalid = true; values.append(value)
        }

        replaceLocalObjects(program:Ir.Program, functionNode:Ir.Function) -> void {
            local blockIndex:i64 = 0
            while blockIndex < functionNode.blocks.length {
                local changed:bool = true
                while changed {
                    changed = false
                    local allocationIndex:i64 = 0
                    while allocationIndex < functionNode.blocks[blockIndex].instructions.length && !changed {
                        if self.replaceLocalObject(program, functionNode, functionNode.blocks[blockIndex], allocationIndex) { changed = true }
                        allocationIndex = allocationIndex + 1
                    }
                }
                blockIndex = blockIndex + 1
            }
        }

        replaceLocalObject(program:Ir.Program, functionNode:Ir.Function, block:Ir.Block, allocationIndex:i64) -> bool {
            local allocation = block.instructions[allocationIndex]
            if allocation.op != "allocate" || allocation.result == null { return false }
            local typeNode = self.findType(program, allocation.result!.typeName)
            if typeNode == null || typeNode!.baseName != null || typeNode!.virtualMethods.length > 0 { return false }
            local fieldIndex:i64 = 0
            while fieldIndex < typeNode!.fields.length {
                if typeNode!.fields[fieldIndex].ownership != "value" || !self.scalarPrimitive(typeNode!.fields[fieldIndex].typeName) { return false }
                fieldIndex = fieldIndex + 1
            }
            local constructorName = typeNode!.name + ".__"
            if typeNode!.initializer != null { constructorName = typeNode!.initializer! }
            local constructor = self.findDefinedFunction(program, constructorName)
            if constructor == null || constructor!.blocks.length != 1 { return false }
            local constructorInstructionIndex:i64 = 0
            while constructorInstructionIndex < constructor!.blocks[0].instructions.length {
                local item = constructor!.blocks[0].instructions[constructorInstructionIndex]
                if item.op != "store_field" && item.op != "return" { return false }
                if item.op == "store_field" {
                    if item.first == null || item.second == null || item.first!.kind != "parameter" || item.first!.name != constructor!.parameters[0].name || item.second!.kind != "parameter" || self.constructorParameter(constructor!, item.second!.name) < 1 { return false }
                }
                constructorInstructionIndex = constructorInstructionIndex + 1
            }
            fieldIndex = 0
            while fieldIndex < typeNode!.fields.length { if self.constructorFieldParameter(constructor!, typeNode!.fields[fieldIndex].qualifiedName) < 1 { return false }; fieldIndex = fieldIndex + 1 }

            local removed = new Array<bool>(block.instructions.length)
            removed[allocationIndex] = true
            local objectTemporaries = new Array<string>(0); objectTemporaries.append(allocation.result!.name)
            local objectLocals = new Array<string>(0)
            local aliases = new Array<PropagatedValue>(0)
            local constructorArguments = new Array<ref Ir.Value>(0)
            local foundConstructor:bool = false
            local escaped:bool = false
            local instructionIndex:i64 = 0
            while instructionIndex < block.instructions.length && !escaped {
                if instructionIndex != allocationIndex {
                    local instruction = block.instructions[instructionIndex]
                    if instruction.op == "call" && instruction.target != null && instruction.target! == constructor!.name && instruction.arguments.length > 0 && self.namedValue(instruction.arguments[0], "temporary", allocation.result!.name) {
                        if foundConstructor { escaped = true } else { foundConstructor = true; constructorArguments = instruction.arguments; removed[instructionIndex] = true }
                    } else if instruction.op == "declare_local" && self.namedValue(instruction.first, "temporary", allocation.result!.name) {
                        objectLocals.append(instruction.name!); removed[instructionIndex] = true
                    } else if instruction.op == "load_local" && instruction.name != null && self.contains(objectLocals, instruction.name!) {
                        objectTemporaries.append(instruction.result!.name); removed[instructionIndex] = true
                    } else if instruction.op == "load_field" && instruction.first != null && self.contains(objectTemporaries, instruction.first!.name) {
                        local parameterIndex = self.constructorFieldParameter(constructor!, instruction.name!)
                        if !foundConstructor || parameterIndex < 1 || parameterIndex >= constructorArguments.length { escaped = true }
                        else { self.setPropagated(aliases, instruction.result!.name, constructorArguments[parameterIndex]); removed[instructionIndex] = true }
                    } else if instruction.op == "destroy_object" && instruction.first != null && ((instruction.first!.kind == "local" && self.contains(objectLocals, instruction.first!.name)) || (instruction.first!.kind == "temporary" && self.contains(objectTemporaries, instruction.first!.name))) {
                        removed[instructionIndex] = true
                    } else if self.instructionUsesNamed(instruction, objectTemporaries, objectLocals) || ((instruction.op == "load_local" || instruction.op == "store_local") && instruction.name != null && self.contains(objectLocals, instruction.name!)) { escaped = true }
                }
                instructionIndex = instructionIndex + 1
            }
            local otherBlockIndex:i64 = 0
            while otherBlockIndex < functionNode.blocks.length && !escaped {
                if functionNode.blocks[otherBlockIndex].label != block.label {
                    local otherInstructionIndex:i64 = 0
                    while otherInstructionIndex < functionNode.blocks[otherBlockIndex].instructions.length && !escaped {
                        local otherInstruction = functionNode.blocks[otherBlockIndex].instructions[otherInstructionIndex]
                        if self.instructionUsesNamed(otherInstruction, objectTemporaries, objectLocals) || ((otherInstruction.op == "load_local" || otherInstruction.op == "store_local") && otherInstruction.name != null && self.contains(objectLocals, otherInstruction.name!)) { escaped = true }
                        otherInstructionIndex = otherInstructionIndex + 1
                    }
                }
                otherBlockIndex = otherBlockIndex + 1
            }
            if escaped || !foundConstructor || aliases.length == 0 { return false }
            local retained = new Array<ref Ir.Instruction>(0)
            instructionIndex = 0
            while instructionIndex < block.instructions.length {
                local instruction = block.instructions[instructionIndex]
                instruction.first = self.resolvePropagated(instruction.first, aliases); instruction.second = self.resolvePropagated(instruction.second, aliases); instruction.third = self.resolvePropagated(instruction.third, aliases)
                local argumentIndex:i64 = 0
                while argumentIndex < instruction.arguments.length { instruction.arguments[argumentIndex] = self.resolvePropagated(instruction.arguments[argumentIndex], aliases)!; argumentIndex = argumentIndex + 1 }
                if !removed[instructionIndex] { retained.append(instruction) }
                instructionIndex = instructionIndex + 1
            }
            block.instructions = retained
            return true
        }

        constructorParameter(constructor:Ir.Function, name:string) -> i64 {
            local index:i64 = 0
            while index < constructor.parameters.length { if constructor.parameters[index].name == name { return index }; index = index + 1 }
            return -1
        }
        constructorFieldParameter(constructor:Ir.Function, fieldName:string) -> i64 {
            local index:i64 = 0
            while index < constructor.blocks[0].instructions.length {
                local instruction = constructor.blocks[0].instructions[index]
                if instruction.op == "store_field" && instruction.name != null && instruction.name! == fieldName && instruction.second != null { return self.constructorParameter(constructor, instruction.second!.name) }
                index = index + 1
            }
            return -1
        }
        instructionUsesNamed(instruction:Ir.Instruction, temporaries:Array<string>, locals:Array<string>) -> bool {
            if self.valueNamedIn(instruction.first, temporaries, locals) || self.valueNamedIn(instruction.second, temporaries, locals) || self.valueNamedIn(instruction.third, temporaries, locals) { return true }
            local index:i64 = 0
            while index < instruction.arguments.length { if self.valueNamedIn(instruction.arguments[index], temporaries, locals) { return true }; index = index + 1 }
            return false
        }
        valueNamedIn(value:Ir.Value?, temporaries:Array<string>, locals:Array<string>) -> bool {
            if value == null { return false }
            if value!.kind == "temporary" { return self.contains(temporaries, value!.name) }
            if value!.kind == "local" { return self.contains(locals, value!.name) }
            return false
        }
        namedValue(value:Ir.Value?, kind:string, name:string) -> bool { return value != null && value!.kind == kind && value!.name == name }
        scalarPrimitive(typeName:string) -> bool { return self.foldableInteger(typeName) || typeName == "u64" || typeName == "f32" || typeName == "f64" }

        propagateLocalValues(functionNode:Ir.Function) -> void {
            local useLocations = self.temporaryUseLocations(functionNode)
            local blockIndex:i64 = 0
            while blockIndex < functionNode.blocks.length {
                local locals = new Array<PropagatedValue>(0)
                local aliases = new Array<PropagatedValue>(0)
                local retained = new Array<ref Ir.Instruction>(0)
                local instructionIndex:i64 = 0
                while instructionIndex < functionNode.blocks[blockIndex].instructions.length {
                    local instruction = functionNode.blocks[blockIndex].instructions[instructionIndex]
                    instruction.first = self.resolvePropagated(instruction.first, aliases)
                    instruction.second = self.resolvePropagated(instruction.second, aliases)
                    instruction.third = self.resolvePropagated(instruction.third, aliases)
                    local argumentIndex:i64 = 0
                    while argumentIndex < instruction.arguments.length { instruction.arguments[argumentIndex] = self.resolvePropagated(instruction.arguments[argumentIndex], aliases)!; argumentIndex = argumentIndex + 1 }
                    local removed:bool = false
                    if instruction.op == "load_local" && instruction.result != null && self.foldableInteger(instruction.result!.typeName) && self.temporaryUsedOnlyInBlock(useLocations, instruction.result!.name, blockIndex) {
                        local value = self.findPropagated(locals, instruction.name!)
                        if value != null { self.setPropagated(aliases, instruction.result!.name, value!); removed = true }
                    }
                    if instruction.op == "declare_local" || instruction.op == "store_local" {
                        if instruction.first != null && self.foldableInteger(instruction.first!.typeName) { self.setPropagated(locals, instruction.name!, instruction.first!) }
                        else { self.removePropagated(locals, instruction.name!) }
                    }
                    if !removed { retained.append(instruction) }
                    instructionIndex = instructionIndex + 1
                }
                functionNode.blocks[blockIndex].instructions = retained
                blockIndex = blockIndex + 1
            }
        }

        temporaryUseLocations(functionNode:Ir.Function) -> Array<TemporaryUseLocation> {
            local locations = new Array<TemporaryUseLocation>(0)
            local blockIndex:i64 = 0
            while blockIndex < functionNode.blocks.length {
                local instructionIndex:i64 = 0
                while instructionIndex < functionNode.blocks[blockIndex].instructions.length {
                    local instruction = functionNode.blocks[blockIndex].instructions[instructionIndex]
                    self.recordTemporaryUse(locations, instruction.first, blockIndex); self.recordTemporaryUse(locations, instruction.second, blockIndex); self.recordTemporaryUse(locations, instruction.third, blockIndex)
                    local argumentIndex:i64 = 0
                    while argumentIndex < instruction.arguments.length { self.recordTemporaryUse(locations, instruction.arguments[argumentIndex], blockIndex); argumentIndex = argumentIndex + 1 }
                    instructionIndex = instructionIndex + 1
                }
                blockIndex = blockIndex + 1
            }
            return locations
        }

        recordTemporaryUse(locations:Array<TemporaryUseLocation>, value:Ir.Value?, blockIndex:i64) -> void {
            if value == null || value!.kind != "temporary" { return }
            local index:i64 = 0
            while index < locations.length {
                if locations[index].name == value!.name { if locations[index].blockIndex != blockIndex { locations[index].crossesBlocks = true }; return }
                index = index + 1
            }
            locations.append(new TemporaryUseLocation(value!.name, blockIndex))
        }

        temporaryUsedOnlyInBlock(locations:Array<TemporaryUseLocation>, name:string, blockIndex:i64) -> bool {
            local index:i64 = 0
            while index < locations.length { if locations[index].name == name { return !locations[index].crossesBlocks && locations[index].blockIndex == blockIndex }; index = index + 1 }
            return false
        }

        resolvePropagated(value:Ir.Value?, aliases:Array<PropagatedValue>) -> ref Ir.Value? {
            if value == null || value!.kind != "temporary" { return value }
            local current = value!
            local remaining = aliases.length + 1
            while remaining > 0 {
                local replacement = self.findPropagated(aliases, current.name)
                if replacement == null { return current }
                current = replacement!
                if current.kind != "temporary" { return current }
                remaining = remaining - 1
            }
            return current
        }

        findPropagated(values:Array<PropagatedValue>, name:string) -> ref Ir.Value? {
            local index = values.length
            while index > 0 { index = index - 1; if values[index].active && values[index].name == name { return values[index].value } }
            return null
        }

        setPropagated(values:Array<PropagatedValue>, name:string, value:Ir.Value) -> void {
            local index:i64 = 0
            while index < values.length { if values[index].name == name { values[index].value = value; values[index].active = true; return }; index = index + 1 }
            values.append(new PropagatedValue(name, value))
        }

        removePropagated(values:Array<PropagatedValue>, name:string) -> void {
            local index:i64 = 0
            while index < values.length { if values[index].name == name { values[index].active = false }; index = index + 1 }
        }

        simplifyControlFlow(functionNode:Ir.Function) -> void {
            local blockIndex:i64 = 0
            while blockIndex < functionNode.blocks.length {
                local block = functionNode.blocks[blockIndex]
                if block.instructions.length > 0 {
                    local end = block.instructions[block.instructions.length - 1]
                    if end.op == "jump" { end.target = self.resolveJumpTarget(functionNode, end.target!) }
                    if end.op == "branch" {
                        end.target = self.resolveJumpTarget(functionNode, end.target!)
                        end.alternateTarget = self.resolveJumpTarget(functionNode, end.alternateTarget!)
                        if end.target! == end.alternateTarget! {
                            end.op = "jump"; end.first = null; end.alternateTarget = null
                        }
                    }
                }
                blockIndex = blockIndex + 1
            }
        }

        resolveJumpTarget(functionNode:Ir.Function, start:string) -> string {
            local label = start
            local visited = new Array<string>(0)
            while !self.contains(visited, label) {
                visited.append(label)
                local block = self.findBlock(functionNode, label)
                if block == null || block!.instructions.length != 1 { return label }
                local instruction = block!.instructions[0]
                if instruction.op != "jump" { return label }
                label = instruction.target!
            }
            return label
        }

        foldConstants(functionNode:Ir.Function) -> void {
            local constants = new Array<FoldedConstant>(0)
            local blockIndex:i64 = 0
            while blockIndex < functionNode.blocks.length {
                local block = functionNode.blocks[blockIndex]
                local instructionIndex:i64 = 0
                while instructionIndex < block.instructions.length {
                    local instruction = block.instructions[instructionIndex]
                    local folded = self.foldInstruction(instruction, constants)
                    if folded != null {
                        instruction.op = "constant"
                        instruction.text = folded!.value.toString()
                        instruction.first = null
                        instruction.second = null
                        instruction.third = null
                        instruction.arguments = new Array<ref Ir.Value>(0)
                        instruction.operator = null
                    }
                    if instruction.op == "constant" && instruction.result != null && self.foldableInteger(instruction.result!.typeName) {
                        local parsed = System.parseInteger(instruction.text!)
                        if parsed.valid { constants.append(new FoldedConstant(instruction.result!.name, parsed.value, instruction.result!.typeName)) }
                    }
                    if instruction.op == "branch" && instruction.first != null {
                        local condition = self.findConstant(constants, instruction.first!.name)
                        if condition != null {
                            instruction.op = "jump"
                            if condition!.value == 0 { instruction.target = instruction.alternateTarget }
                            instruction.first = null
                            instruction.alternateTarget = null
                        }
                    }
                    instructionIndex = instructionIndex + 1
                }
                blockIndex = blockIndex + 1
            }
        }

        foldInstruction(instruction:Ir.Instruction, constants:Array<FoldedConstant>) -> ref FoldedConstant? {
            if instruction.result == null || !self.foldableInteger(instruction.result!.typeName) { return null }
            if instruction.op == "unary" && instruction.first != null {
                local operand = self.findConstant(constants, instruction.first!.name)
                if operand == null { return null }
                if instruction.operator! == "-" { return new FoldedConstant(instruction.result!.name, self.normalizeInteger(-operand!.value, instruction.result!.typeName), instruction.result!.typeName) }
                if instruction.operator! == "!" {
                    if operand!.value == 0 { return new FoldedConstant(instruction.result!.name, 1, instruction.result!.typeName) }
                    return new FoldedConstant(instruction.result!.name, 0, instruction.result!.typeName)
                }
                return null
            }
            if instruction.op == "convert" && instruction.first != null {
                local converted = self.findConstant(constants, instruction.first!.name)
                if converted != null && self.foldableInteger(converted!.typeName) {
                    return new FoldedConstant(instruction.result!.name, self.normalizeInteger(converted!.value, instruction.result!.typeName), instruction.result!.typeName)
                }
                return null
            }
            if instruction.op != "binary" || instruction.first == null || instruction.second == null { return null }
            local left = self.findConstant(constants, instruction.first!.name)
            local right = self.findConstant(constants, instruction.second!.name)
            if left == null || right == null { return null }
            local operator = instruction.operator!
            if operator == "+" { return self.foldedResult(instruction, left!.value + right!.value) }
            if operator == "-" { return self.foldedResult(instruction, left!.value - right!.value) }
            if operator == "*" { return self.foldedResult(instruction, left!.value * right!.value) }
            if operator == "/" {
                if right!.value == 0 || (instruction.result!.typeName == "i64" && left!.value == -9223372036854775808 && right!.value == -1) { return null }
                return self.foldedResult(instruction, left!.value / right!.value)
            }
            if operator == "&" { return self.foldedResult(instruction, left!.value & right!.value) }
            if operator == "|" { return self.foldedResult(instruction, left!.value | right!.value) }
            if operator == "^" { return self.foldedResult(instruction, left!.value ^ right!.value) }
            if operator == "<<" { return self.foldedResult(instruction, left!.value << (right!.value & 63)) }
            if operator == ">>" { return self.foldedResult(instruction, left!.value >> (right!.value & 63)) }
            if operator == "==" || operator == "===" { if left!.value == right!.value { return self.foldedResult(instruction, 1) }; return self.foldedResult(instruction, 0) }
            if operator == "!=" || operator == "!==" { if left!.value != right!.value { return self.foldedResult(instruction, 1) }; return self.foldedResult(instruction, 0) }
            if operator == "<" { if left!.value < right!.value { return self.foldedResult(instruction, 1) }; return self.foldedResult(instruction, 0) }
            if operator == "<=" { if left!.value <= right!.value { return self.foldedResult(instruction, 1) }; return self.foldedResult(instruction, 0) }
            if operator == ">" { if left!.value > right!.value { return self.foldedResult(instruction, 1) }; return self.foldedResult(instruction, 0) }
            if operator == ">=" { if left!.value >= right!.value { return self.foldedResult(instruction, 1) }; return self.foldedResult(instruction, 0) }
            return null
        }

        foldedResult(instruction:Ir.Instruction, value:i64) -> ref FoldedConstant {
            return new FoldedConstant(instruction.result!.name, self.normalizeInteger(value, instruction.result!.typeName), instruction.result!.typeName)
        }

        normalizeInteger(value:i64, typeName:string) -> i64 {
            if typeName == "bool" { if value == 0 { return 0 }; return 1 }
            if typeName == "u8" { return value & 255 }
            if typeName == "i8" { local result = value & 255; if result >= 128 { result = result - 256 }; return result }
            if typeName == "u16" { return value & 65535 }
            if typeName == "i16" { local result = value & 65535; if result >= 32768 { result = result - 65536 }; return result }
            if typeName == "u32" { return value & 4294967295 }
            if typeName == "i32" { local result = value & 4294967295; if result >= 2147483648 { result = result - 4294967296 }; return result }
            return value
        }

        findConstant(constants:Array<FoldedConstant>, name:string) -> ref FoldedConstant? {
            local index = constants.length
            while index > 0 { index = index - 1; if constants[index].name == name { return constants[index] } }
            return null
        }

        foldableInteger(typeName:string) -> bool {
            return typeName == "bool" || typeName == "u8" || typeName == "i8" || typeName == "u16" || typeName == "i16" || typeName == "u32" || typeName == "i32" || typeName == "i64"
        }

        removeDeadValues(functionNode:Ir.Function) -> void {
            local changed:bool = true
            while changed {
                changed = false
                local blockIndex:i64 = 0
                while blockIndex < functionNode.blocks.length {
                    local retained = new Array<ref Ir.Instruction>(0)
                    local instructionIndex:i64 = 0
                    while instructionIndex < functionNode.blocks[blockIndex].instructions.length {
                        local instruction = functionNode.blocks[blockIndex].instructions[instructionIndex]
                        local dead:bool = false
                        if instruction.result != null && self.pureInstruction(instruction) {
                            dead = self.temporaryUseCount(functionNode, instruction.result!.name) == 0
                        }
                        if dead { changed = true } else { retained.append(instruction) }
                        instructionIndex = instructionIndex + 1
                    }
                    functionNode.blocks[blockIndex].instructions = retained
                    blockIndex = blockIndex + 1
                }
            }
        }

        pureInstruction(instruction:Ir.Instruction) -> bool {
            if instruction.op == "constant" || instruction.op == "float_constant" || instruction.op == "string_constant" || instruction.op == "load_local" || instruction.op == "unary" { return true }
            if instruction.op == "binary" { return instruction.operator! != "/" }
            if instruction.op == "convert" && instruction.first != null && instruction.result != null {
                return self.foldableInteger(instruction.first!.typeName) && self.foldableInteger(instruction.result!.typeName)
            }
            return false
        }

        temporaryUseCount(functionNode:Ir.Function, name:string) -> i64 {
            local count:i64 = 0
            local blockIndex:i64 = 0
            while blockIndex < functionNode.blocks.length {
                local instructionIndex:i64 = 0
                while instructionIndex < functionNode.blocks[blockIndex].instructions.length {
                    local instruction = functionNode.blocks[blockIndex].instructions[instructionIndex]
                    count = count + self.valueUse(instruction.first, name) + self.valueUse(instruction.second, name) + self.valueUse(instruction.third, name)
                    local argumentIndex:i64 = 0
                    while argumentIndex < instruction.arguments.length { count = count + self.valueUse(instruction.arguments[argumentIndex], name); argumentIndex = argumentIndex + 1 }
                    instructionIndex = instructionIndex + 1
                }
                blockIndex = blockIndex + 1
            }
            return count
        }

        valueUse(value:Ir.Value?, name:string) -> i64 {
            if value != null { if value!.kind == "temporary" && value!.name == name { return 1 } }
            return 0
        }

        removeUnreachable(functionNode:Ir.Function) -> void {
            if functionNode.blocks.length == 0 { return }
            local pending = new Array<string>(0)
            local reachable = new Array<string>(0)
            pending.append(functionNode.blocks[0].label)
            while pending.length > 0 {
                local label = pending[pending.length - 1]
                local remaining = new Array<string>(pending.length - 1)
                local copyIndex:i64 = 0
                while copyIndex < remaining.length { remaining[copyIndex] = pending[copyIndex]; copyIndex = copyIndex + 1 }
                pending = remaining
                if !self.contains(reachable, label) {
                    local block = self.findBlock(functionNode, label)
                    if block != null {
                        reachable.append(label)
                        if block!.instructions.length > 0 {
                            local end = block!.instructions[block!.instructions.length - 1]
                            if end.op == "jump" { pending.append(end.target!) }
                            if end.op == "branch" { pending.append(end.target!); pending.append(end.alternateTarget!) }
                        }
                    }
                }
            }
            local blocks = new Array<ref Ir.Block>(0)
            local index:i64 = 0
            while index < functionNode.blocks.length {
                if self.contains(reachable, functionNode.blocks[index].label) { blocks.append(functionNode.blocks[index]) }
                index = index + 1
            }
            functionNode.blocks = blocks
        }

        validate(program:Ir.Program, requireEntry:bool=true) -> Array<string> {
            local errors = new Array<string>(0)
            local index:i64 = 0
            while index < program.types.length {
                local other:i64 = index + 1
                while other < program.types.length {
                    if program.types[index].name == program.types[other].name { errors.append("duplicate type '" + program.types[index].name + "'") }
                    other = other + 1
                }
                local typeNode = program.types[index]
                if typeNode.baseName != null { if !self.hasType(program, typeNode.baseName!) { errors.append("type '" + typeNode.name + "' has unknown base '" + typeNode.baseName! + "'") } }
                if typeNode.initializer != null { if !self.findFunction(program, typeNode.initializer!) { errors.append("type '" + typeNode.name + "' has unknown initializer") } }
                local virtualIndex:i64 = 0
                while virtualIndex < typeNode.virtualMethods.length {
                    if !self.findFunction(program, typeNode.virtualMethods[virtualIndex].target) { errors.append("type '" + typeNode.name + "' has unknown virtual target") }
                    virtualIndex = virtualIndex + 1
                }
                index = index + 1
            }
            index = 0
            while index < program.functions.length {
                local other:i64 = index + 1
                while other < program.functions.length {
                    if program.functions[index].name == program.functions[other].name { errors.append("duplicate function '" + program.functions[index].name + "'") }
                    other = other + 1
                }
                self.validateFunction(program, program.functions[index], errors)
                index = index + 1
            }
            if program.entry == null {
                if requireEntry { errors.append("program has no entry function") }
            } else if self.findDefinedFunction(program, program.entry!) == null { errors.append("entry is not a defined function") }
            return errors
        }

        validateFunction(program:Ir.Program, functionNode:Ir.Function, errors:Array<string>) -> void {
            local prefix = "function '" + functionNode.name + "'"
            if functionNode.returnType.length == 0 { errors.append(prefix + " has no return type") }
            if functionNode.parameters.length > 0 {
                if functionNode.parameters[0].name == "self" && !self.hasType(program, functionNode.ownerType) { errors.append(prefix + " has unknown owner type") }
            }
            if functionNode.blocks.length == 0 { errors.append(prefix + " has no blocks"); return }
            local blockIndex:i64 = 0
            while blockIndex < functionNode.blocks.length {
                local block = functionNode.blocks[blockIndex]
                local other:i64 = blockIndex + 1
                while other < functionNode.blocks.length {
                    if block.label == functionNode.blocks[other].label { errors.append(prefix + " has duplicate block '" + block.label + "'") }
                    other = other + 1
                }
                if block.instructions.length == 0 { errors.append(prefix + " block '" + block.label + "' is empty") }
                else {
                    local instructionIndex:i64 = 0
                    local ordinaryInstruction:bool = false
                    while instructionIndex < block.instructions.length {
                        local instruction = block.instructions[instructionIndex]
                        if instruction.op == "loop_value" { self.validateLoopValue(functionNode, block, instruction, ordinaryInstruction, errors) } else { ordinaryInstruction = true }
                        self.validateInstruction(program, functionNode, instruction, errors)
                        instructionIndex = instructionIndex + 1
                    }
                    if !self.isTerminator(block.instructions[block.instructions.length - 1].op) { errors.append(prefix + " block '" + block.label + "' has no terminator") }
                }
                blockIndex = blockIndex + 1
            }
        }

        validateLoopValue(functionNode:Ir.Function, block:Ir.Block, instruction:Ir.Instruction, afterOrdinary:bool, errors:Array<string>) -> void {
            local prefix = "function '" + functionNode.name + "' instruction 'loop_value'"
            if afterOrdinary { errors.append(prefix + " must appear before ordinary instructions") }
            if instruction.result == null || instruction.first == null || instruction.second == null || instruction.target == null || instruction.alternateTarget == null { errors.append(prefix + " is incomplete"); return }
            if instruction.target! == instruction.alternateTarget! || self.predecessorCount(functionNode, block.label) != 2 || !self.blockTargets(functionNode, instruction.target!, block.label) || !self.blockTargets(functionNode, instruction.alternateTarget!, block.label) { errors.append(prefix + " incoming blocks do not match block predecessors") }
            if !self.singleSuccessorTarget(functionNode, instruction.target!, block.label) || !self.singleSuccessorTarget(functionNode, instruction.alternateTarget!, block.label) { errors.append(prefix + " requires explicit single-successor incoming edges") }
            if instruction.first!.typeName != instruction.result!.typeName || instruction.second!.typeName != instruction.result!.typeName { errors.append(prefix + " incoming value types do not match result type") }
            if !self.scalarPrimitive(instruction.result!.typeName) { errors.append(prefix + " requires a primitive result type") }
        }

        blockTargets(functionNode:Ir.Function, source:string, target:string) -> bool {
            local block = self.findBlock(functionNode, source)
            if block == null || block!.instructions.length == 0 { return false }
            local end = block!.instructions[block!.instructions.length - 1]
            if end.op == "jump" { return end.target! == target }
            if end.op == "branch" { return end.target! == target || end.alternateTarget! == target }
            return false
        }
        singleSuccessorTarget(functionNode:Ir.Function, source:string, target:string) -> bool {
            local block = self.findBlock(functionNode, source)
            if block == null || block!.instructions.length == 0 { return false }
            local end = block!.instructions[block!.instructions.length - 1]
            return end.op == "jump" && end.target! == target
        }

        validateInstruction(program:Ir.Program, functionNode:Ir.Function, instruction:Ir.Instruction, errors:Array<string>) -> void {
            local prefix = "function '" + functionNode.name + "' instruction '" + instruction.op + "'"
            if !self.isSupported(instruction.op) { errors.append(prefix + " uses an unsupported opcode") }
            if instruction.result != null { if instruction.result!.typeName.length == 0 { errors.append(prefix + " has an untyped result") } }
            if instruction.op == "jump" { if instruction.target == null || self.findBlock(functionNode, instruction.target!) == null { errors.append(prefix + " targets an unknown block") } }
            if instruction.op == "branch" {
                if instruction.first == null { errors.append(prefix + " has no condition") }
                if instruction.target == null || self.findBlock(functionNode, instruction.target!) == null { errors.append(prefix + " has an unknown true target") }
                if instruction.alternateTarget == null || self.findBlock(functionNode, instruction.alternateTarget!) == null { errors.append(prefix + " has an unknown false target") }
            }
            if instruction.op == "call" || instruction.op == "virtual_call" || instruction.op == "contract_call" {
                local target:Ir.Function? = null
                local external:Ir.ExternalFunction? = null
                if instruction.target != null { target = self.findDefinedFunction(program, instruction.target!); external = self.findExternal(program, instruction.target!) }
                if target == null && instruction.target != null { target = self.findDeclaredFunction(program, instruction.target!) }
                if target == null && external == null { errors.append(prefix + " calls an unknown function") }
                else {
                    local expected:i64 = 0
                    local returnType = "void"
                    if target != null { expected = target!.parameters.length; returnType = target!.returnType }
                    else { expected = external!.parameters.length; returnType = external!.returnType }
                    if instruction.arguments.length != expected { errors.append(prefix + " has incorrect call arity") }
                    if instruction.result != null {
                        if instruction.result!.typeName != returnType { errors.append(prefix + " has an incorrect result type") }
                    } else if returnType != "void" { errors.append(prefix + " discards a non-void result") }
                }
            }
        }

        findBlock(functionNode:Ir.Function, name:string) -> ref Ir.Block? {
            local index:i64 = 0
            while index < functionNode.blocks.length { if functionNode.blocks[index].label == name { return functionNode.blocks[index] }; index = index + 1 }
            return null
        }

        findDefinedFunction(program:Ir.Program, name:string) -> ref Ir.Function? {
            local index:i64 = 0
            while index < program.functions.length { if program.functions[index].name == name { return program.functions[index] }; index = index + 1 }
            return null
        }

        findExternal(program:Ir.Program, name:string) -> ref Ir.ExternalFunction? {
            local index:i64 = 0
            while index < program.externals.length { if program.externals[index].name == name { return program.externals[index] }; index = index + 1 }
            return null
        }

        findDeclaredFunction(program:Ir.Program, name:string) -> ref Ir.Function? {
            local index:i64 = 0
            while index < program.functionDeclarations.length { if program.functionDeclarations[index].name == name { return program.functionDeclarations[index] }; index = index + 1 }
            return null
        }

        findFunction(program:Ir.Program, name:string) -> bool { return self.findDefinedFunction(program, name) != null || self.findDeclaredFunction(program, name) != null || self.findExternal(program, name) != null }
        findType(program:Ir.Program, name:string) -> ref Ir.Type? {
            local index:i64 = 0
            while index < program.types.length { if program.types[index].name == name { return program.types[index] }; index = index + 1 }
            return null
        }
        hasType(program:Ir.Program, name:string) -> bool {
            local index:i64 = 0
            while index < program.types.length { if program.types[index].name == name { return true }; index = index + 1 }
            return false
        }
        contains(values:Array<string>, value:string) -> bool {
            local index:i64 = 0
            while index < values.length { if values[index] == value { return true }; index = index + 1 }
            return false
        }
        isTerminator(op:string) -> bool { return op == "return" || op == "jump" || op == "branch" }
        isSupported(op:string) -> bool {
            if op == "loop_value" { return true }
            if op == "array_slice" { return true }
            return op == "allocate" || op == "array_append" || op == "array_capacity" || op == "array_insert" || op == "array_length" || op == "array_load" || op == "array_new" || op == "array_remove" || op == "array_reserve" || op == "array_shrink" || op == "array_store" || op == "binary" || op == "branch" || op == "builder_append_byte" || op == "builder_append_bytes" || op == "builder_append_string" || op == "builder_build" || op == "builder_length" || op == "builder_new" || op == "bytes_to_string" || op == "call" || op == "checked_cast" || op == "constant" || op == "float_constant" || op == "contract_call" || op == "convert" || op == "declare_local" || op == "destroy_array" || op == "destroy_object" || op == "integer_to_string" || op == "jump" || op == "load_field" || op == "load_local" || op == "optional_box" || op == "return" || op == "store_field" || op == "store_local" || op == "string_codepoint_at" || op == "string_codepoint_length" || op == "string_concat" || op == "string_constant" || op == "string_equal" || op == "string_grapheme_at" || op == "string_grapheme_length" || op == "string_length" || op == "string_load" || op == "string_slice" || op == "string_to_bytes" || op == "structural_copy" || op == "structural_equal" || op == "structural_hash" || op == "test_expect" || op == "test_failures" || op == "type_test" || op == "unary" || op == "unwrap" || op == "virtual_call"
        }
    }}
}}
