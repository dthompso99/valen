            self.writer.line("    mov r10, rax")
            self.writer.line("    neg r10")
            self.writer.line("    mov QWORD PTR [rip+argon_filesystem_error], r10")
            self.writer.line("    ret")
            self.writer.line("")
            self.writer.line(".globl argon_System_lastError")
            self.writer.line("argon_System_lastError:")
            self.writer.line("    mov rax, QWORD PTR [rip+argon_filesystem_error]")
            self.writer.line("    ret")
            self.writer.line("")
            self.writer.line(".globl argon_System_currentDirectory")
            self.writer.line("argon_System_currentDirectory:")
            self.writer.line("    push rbp")
            self.writer.line("    mov rbp, rsp")
            self.writer.line("    push rbx")
            self.writer.line("    push r12")
            self.writer.line("    mov edi, 4096")
            self.writer.line("    call argon_alloc")
            self.writer.line("    mov rbx, rax")
            self.writer.line("    mov rdi, rax")
            self.writer.line("    mov esi, 4096")
            self.writer.line("    mov eax, 79")
            self.writer.line("    syscall")
            self.writer.line("    test rax, rax")
            self.writer.line("    js .Lcurrent_directory_error")
            self.writer.line("    xor r12d, r12d")
            self.writer.line(".Lcurrent_directory_length:")
            self.writer.line("    cmp BYTE PTR [rbx+r12], 0")
            self.writer.line("    je .Lcurrent_directory_wrap")
            self.writer.line("    inc r12")
            self.writer.line("    jmp .Lcurrent_directory_length")
            self.writer.line(".Lcurrent_directory_wrap:")
            self.writer.line("    mov QWORD PTR [rip+argon_filesystem_error], 0")
            self.writer.line("    mov edi, 16")
            self.writer.line("    call argon_alloc")
            self.writer.line("    mov QWORD PTR [rax], rbx")
            self.writer.line("    mov QWORD PTR [rax+8], r12")
            self.writer.line("    jmp .Lcurrent_directory_done")
            self.writer.line(".Lcurrent_directory_error:")
            self.writer.line("    neg rax")
            self.writer.line("    mov QWORD PTR [rip+argon_filesystem_error], rax")
            self.writer.line("    xor eax, eax")
            self.writer.line(".Lcurrent_directory_done:")
            self.writer.line("    pop r12")
            self.writer.line("    pop rbx")
            self.writer.line("    leave")
            self.writer.line("    ret")
            self.writer.line("")
        }

        memoryRuntime() -> void {
            self.writer.line(".globl argon_System_memoryCopy")
            self.writer.line("argon_System_memoryCopy:")
            self.writer.line("    test rsi, rsi")
            self.writer.line("    js .Larray_bounds_error")
            self.writer.line("    test rcx, rcx")
            self.writer.line("    js .Larray_bounds_error")
            self.writer.line("    test r8, r8")
            self.writer.line("    js .Larray_bounds_error")
            self.writer.line("    mov r9, QWORD PTR [rdi]")
            self.writer.line("    sub r9, rsi")
            self.writer.line("    jb .Larray_bounds_error")
            self.writer.line("    cmp r8, r9")
            self.writer.line("    ja .Larray_bounds_error")
            self.writer.line("    mov r9, QWORD PTR [rdx]")
            self.writer.line("    sub r9, rcx")
            self.writer.line("    jb .Larray_bounds_error")
            self.writer.line("    cmp r8, r9")
            self.writer.line("    ja .Larray_bounds_error")
            self.writer.line("    add rsi, QWORD PTR [rdi+16]")
            self.writer.line("    mov rdi, rsi")
            self.writer.line("    add rcx, QWORD PTR [rdx+16]")
            self.writer.line("    mov rsi, rcx")
            self.writer.line("    mov rcx, r8")
            self.writer.line("    rep movsb")
            self.writer.line("    mov eax, 1")
            self.writer.line("    ret")
            self.writer.line("")
            self.writer.line(".globl argon_System_memoryCompare")
            self.writer.line("argon_System_memoryCompare:")
            self.writer.line("    test rsi, rsi")
            self.writer.line("    js .Larray_bounds_error")
            self.writer.line("    test rcx, rcx")
            self.writer.line("    js .Larray_bounds_error")
            self.writer.line("    test r8, r8")
            self.writer.line("    js .Larray_bounds_error")
            self.writer.line("    mov r9, QWORD PTR [rdi]")
            self.writer.line("    sub r9, rsi")
            self.writer.line("    jb .Larray_bounds_error")
            self.writer.line("    cmp r8, r9")
            self.writer.line("    ja .Larray_bounds_error")
            self.writer.line("    mov r9, QWORD PTR [rdx]")
            self.writer.line("    sub r9, rcx")
            self.writer.line("    jb .Larray_bounds_error")
            self.writer.line("    cmp r8, r9")
            self.writer.line("    ja .Larray_bounds_error")
            self.writer.line("    add rsi, QWORD PTR [rdi+16]")
            self.writer.line("    mov rdi, rsi")
            self.writer.line("    add rcx, QWORD PTR [rdx+16]")
            self.writer.line("    mov rsi, rcx")
            self.writer.line("    mov rcx, r8")
            self.writer.line("    repe cmpsb")
            self.writer.line("    je .Lmemory_compare_equal")
            self.writer.line("    mov eax, -1")
            self.writer.line("    mov r10d, 1")
            self.writer.line("    cmova eax, r10d")
            self.writer.line("    ret")
            self.writer.line(".Lmemory_compare_equal:")
            self.writer.line("    xor eax, eax")
            self.writer.line("    ret")
            self.writer.line("")
        }

        openRuntime(symbol:string, flags:i64) -> void {
            local label = ".L" + symbol + "_"
            self.writer.line(".globl " + symbol)
            self.writer.line(symbol + ":")
            self.writer.line("    push rbp")
            self.writer.line("    mov rbp, rsp")
            self.writer.line("    push rbx")
            self.writer.line("    push r12")
            self.writer.line("    push r13")
            self.writer.line("    sub rsp, 8")
            self.writer.line("    mov r12, QWORD PTR [rdi]")
            self.writer.line("    mov r13, QWORD PTR [rdi+8]")
            self.writer.line("    lea rdi, [r13+1]")
            self.writer.line("    call argon_alloc")
            self.writer.line("    mov rbx, rax")
            self.writer.line("    mov rdi, rax")
            self.writer.line("    mov rsi, r12")
            self.writer.line("    mov rcx, r13")
            self.writer.line("    rep movsb")
            self.writer.line("    mov BYTE PTR [rbx+r13], 0")
            self.writer.line("    mov eax, 257")
            self.writer.line("    mov rdi, -100")
            self.writer.line("    mov rsi, rbx")
            self.writer.line("    mov edx, " + flags.toString())
            self.writer.line("    mov r10d, 420")
            self.writer.line("    syscall")
            self.writer.line("    test rax, rax")
            self.writer.line("    js " + label + "error")
            self.writer.line("    mov QWORD PTR [rip+argon_filesystem_error], 0")
            self.writer.line("    mov r12, rax")
            self.writer.line("    mov edi, 8")
            self.writer.line("    call argon_alloc")
            self.writer.line("    mov QWORD PTR [rax], r12")
            self.writer.line("    jmp " + label + "done")
            self.writer.line(label + "error:")
            self.writer.line("    neg rax")
            self.writer.line("    mov QWORD PTR [rip+argon_filesystem_error], rax")
            self.writer.line("    xor eax, eax")
            self.writer.line(label + "done:")
            self.writer.line("    add rsp, 8")
            self.writer.line("    pop r13")
            self.writer.line("    pop r12")
            self.writer.line("    pop rbx")
            self.writer.line("    leave")
            self.writer.line("    ret")
            self.writer.line("")
        }

        stringData() -> void {
            if self.literals.length == 0 { return }
            self.writer.line(".section .rodata")
            local index:i64 = 0
            while index < self.literals.length {
                local literal = self.literals[index]
                self.writer.line(literal.dataLabel + ":")
                if literal.value.length == 0 {
                    self.writer.line("    .byte 0")
                } else {
                    local bytes = new StringBuilder()
                    bytes.append("    .byte ")
                    local byteIndex:i64 = 0
                    while byteIndex < literal.value.length {
                        if byteIndex > 0 { bytes.append(", ") }
                        bytes.append(literal.value[byteIndex].toString())
                        byteIndex = byteIndex + 1
                    }
                    self.writer.line(bytes.build())
                }
                index = index + 1
            }
            self.writer.line(".section .data.rel.ro.local")
            self.writer.line(".align 8")
            index = 0
            while index < self.literals.length {
                local literal = self.literals[index]
                self.writer.line(literal.descriptorLabel + ":")
                self.writer.line("    .quad " + literal.dataLabel)
                self.writer.line("    .quad " + literal.value.length.toString())
                index = index + 1
            }
            self.writer.line("")
        }

        runtimeData() -> void {
            self.writer.line(".section .bss")
            self.writer.line(".align 8")
            self.writer.line("argon_process_argc:")
            self.writer.line("    .zero 8")
            self.writer.line("argon_process_argv:")
            self.writer.line("    .zero 8")
            self.writer.line("argon_filesystem_error:")
            self.writer.line("    .zero 8")
            self.writer.line("")
        }

        typeLabel(typeName:string) -> string { return ".Largon_type_" + self.mangle(typeName) }

        typeData() -> void {
            self.writer.line(".section .data")
            self.writer.line(".align 8")
            local index:i64 = 0
            while index < self.program.types.length {
                local typeNode = self.program.types[index]
                self.writer.line(self.typeLabel(typeNode.name) + ":")
                if typeNode.baseName == null { self.writer.line("    .quad 0") } else { self.writer.line("    .quad " + self.typeLabel(typeNode.baseName!)) }
                local methodIndex:i64 = 0
                while methodIndex < typeNode.virtualMethods.length {
                    self.writer.line("    .quad " + self.functionSymbol(typeNode.virtualMethods[methodIndex].target))
                    methodIndex = methodIndex + 1
                }
                index = index + 1
            }
            self.writer.line("")
        }

        load(value:Ir.Value, register:string) -> void {
            if value.kind == "parameter" || value.kind == "local" { self.writer.line("    mov " + register + ", " + self.named(value.name)); return }
            if value.kind == "temporary" { self.writer.line("    mov " + register + ", " + self.temp(value.name)); return }
            self.writer.line("    xor " + self.register32(register) + ", " + self.register32(register))
        }

        storeResult(instruction:Ir.Instruction, register:string) -> void {
            self.writer.line("    mov " + self.temp(instruction.result!.name) + ", " + register)
        }

        loadMemory(address:string, typeName:string, register:string) -> void {
            if typeName == "u8" || typeName == "bool" { self.writer.line("    movzx " + self.register32(register) + ", BYTE PTR " + address); return }
            if typeName == "i32" { self.writer.line("    movsxd " + register + ", DWORD PTR " + address); return }
            self.writer.line("    mov " + register + ", QWORD PTR " + address)
        }

        normalize(register:string, typeName:string) -> void {
            if typeName == "u8" || typeName == "bool" { self.writer.line("    movzx " + self.register32(register) + ", " + self.register8(register)) }
            if typeName == "i32" { self.writer.line("    movsxd " + register + ", " + self.register32(register)) }
        }

        reserve(key:string) -> void {
            if self.findSlot(key) != null { return }
            self.slots.append(new Slot(key, (self.slots.length + 1) * 8))
        }

        slot(key:string) -> string { return "QWORD PTR [rbp-" + self.findSlot(key)!.offset.toString() + "]" }
        named(name:string) -> string { return self.slot("name:" + name) }
        temp(name:string) -> string { return self.slot("temp:" + name) }
        blockLabel(name:string) -> string { return self.currentFunctionSymbol + "__" + name }

        findSlot(key:string) -> Slot? {
            local index:i64 = 0
            while index < self.slots.length { if self.slots[index].key == key { return self.slots[index] }; index = index + 1 }
            return null
        }

        internString(value:string) -> void {
            if self.findLiteral(value) != null { return }
            local suffix = self.literals.length.toString()
            self.literals.append(new Literal(value, ".Largon_string_data_" + suffix, ".Largon_string_" + suffix))
        }

        findLiteral(value:string) -> Literal? {
            local index:i64 = 0
            while index < self.literals.length { if self.literals[index].value == value { return self.literals[index] }; index = index + 1 }
            return null
        }

        findField(name:string) -> FieldLayout? {
            local index:i64 = 0
            while index < self.fields.length { if self.fields[index].name == name { return self.fields[index] }; index = index + 1 }
            return null
        }

        findFunction(name:string) -> Ir.Function? {
            local index:i64 = 0
            while index < self.program.functions.length { if self.program.functions[index].name == name { return self.program.functions[index] }; index = index + 1 }
            return null
        }

        findProgramType(name:string) -> Ir.Type? {
            local index:i64 = 0
            while index < self.program.types.length { if self.program.types[index].name == name { return self.program.types[index] }; index = index + 1 }
            return null
        }

        findAssemblySymbol(name:string) -> FunctionSymbol? {
            local index:i64 = 0
            while index < self.functionSymbols.length { if self.functionSymbols[index].assemblyName == name { return self.functionSymbols[index] }; index = index + 1 }
            return null
        }

        functionSymbol(name:string) -> string {
            local index:i64 = 0
            while index < self.functionSymbols.length { if self.functionSymbols[index].name == name { return self.functionSymbols[index].assemblyName }; index = index + 1 }
            return self.mangle(name)
        }

        typeSize(name:string) -> i64 {
            local index:i64 = 0
            while index < self.types.length { if self.types[index].name == name { return self.types[index].size }; index = index + 1 }
            return 8
        }

        sizeOf(name:string) -> i64 {
            if name == "u8" || name == "bool" { return 1 }
            if name == "i32" { return 4 }
            return 8
        }

        memorySize(name:string) -> string {
            if self.sizeOf(name) == 1 { return "BYTE" }
            if self.sizeOf(name) == 4 { return "DWORD" }
            return "QWORD"
        }

        registerForSize(register:string, typeName:string) -> string {
            if self.sizeOf(typeName) == 1 { return self.register8(register) }
            if self.sizeOf(typeName) == 4 { return self.register32(register) }
            return register
        }

        register8(register:string) -> string {
            if register == "rax" { return "al" }
            if register == "rcx" { return "cl" }
            if register == "rdx" { return "dl" }
            if register == "rdi" { return "dil" }
            if register == "rsi" { return "sil" }
            if register == "r8" { return "r8b" }
            return "r9b"
        }

        register32(register:string) -> string {
            if register == "rax" { return "eax" }
            if register == "rcx" { return "ecx" }
            if register == "rdx" { return "edx" }
            if register == "rdi" { return "edi" }
            if register == "rsi" { return "esi" }
            if register == "r8" { return "r8d" }
            return "r9d"
        }

        argumentRegister(index:i64) -> string {
            if index == 0 { return "rdi" }
            if index == 1 { return "rsi" }
            if index == 2 { return "rdx" }
            if index == 3 { return "rcx" }
            if index == 4 { return "r8" }
            return "r9"
        }

        condition(operator:string, unsigned:bool) -> string {
            if operator == "==" || operator == "===" { return "sete" }
            if operator == "!=" || operator == "!==" { return "setne" }
            if operator == "<" { if unsigned { return "setb" }; return "setl" }
            if operator == "<=" { if unsigned { return "setbe" }; return "setle" }
            if operator == ">" { if unsigned { return "seta" }; return "setg" }
            if unsigned { return "setae" }
            return "setge"
        }

        isUnsigned(name:string) -> bool { return name == "u8" || name == "bool" }
        align(value:i64, alignment:i64) -> i64 { return ((value + alignment - 1) / alignment) * alignment }

        mangle(name:string) -> string {
            local builder = new StringBuilder()
            builder.append("argon_fn")
            local index:i64 = 0
            while index < name.length {
                builder.append("_")
                builder.append(name[index].toString())
                index = index + 1
            }
            return builder.build()
        }
    }}
}}
