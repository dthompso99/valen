                while methodIndex < typeNode.virtualMethods.length {
                    self.writer.line("    .quad " + self.functionSymbol(typeNode.virtualMethods[methodIndex].target))
                    methodIndex = methodIndex + 1
                }
                index = index + 1
            }
            index = 0
            while index < self.program.types.length {
                local typeNode = self.program.types[index]
                self.writer.line(self.contractListLabel(typeNode.name) + ":")
                self.writer.line("    .quad " + typeNode.contracts.length.toString())
                local contractIndex:i64 = 0
                while contractIndex < typeNode.contracts.length {
                    local contract = typeNode.contracts[contractIndex]
                    self.writer.line("    .quad " + self.typeLabel(contract.name))
                    self.writer.line("    .quad " + self.contractTableLabel(typeNode.name, contract.name))
                    contractIndex = contractIndex + 1
                }
                contractIndex = 0
                while contractIndex < typeNode.contracts.length {
                    local contract = typeNode.contracts[contractIndex]
                    self.writer.line(self.contractTableLabel(typeNode.name, contract.name) + ":")
                    local methodIndex:i64 = 0
                    while methodIndex < contract.methods.length {
                        self.writer.line("    .quad " + self.functionSymbol(contract.methods[methodIndex].target))
                        methodIndex = methodIndex + 1
                    }
                    contractIndex = contractIndex + 1
                }
                index = index + 1
            }
            self.writer.line("")
        }

        load(value:Ir.Value, register:string) -> void {
            if value.kind == "parameter" || value.kind == "local" { self.writer.line("    mov " + register + ", " + self.named(value.name)); return }
            if value.kind == "temporary" { self.writer.line("    mov " + register + ", " + self.temp(value.name)); return }
            self.writer.line("    xor " + self.register32(register) + ", " + self.register32(register))
        }

        storeResult(instruction:Ir.Instruction, register:string) -> void {
            self.writer.line("    mov " + self.temp(instruction.result!.name) + ", " + register)
        }

        loadMemory(address:string, typeName:string, register:string) -> void {
            if typeName == "u8" || typeName == "bool" { self.writer.line("    movzx " + self.register32(register) + ", BYTE PTR " + address); return }
            if typeName == "i32" { self.writer.line("    movsxd " + register + ", DWORD PTR " + address); return }
            self.writer.line("    mov " + register + ", QWORD PTR " + address)
        }

        normalize(register:string, typeName:string) -> void {
            if typeName == "u8" || typeName == "bool" { self.writer.line("    movzx " + self.register32(register) + ", " + self.register8(register)) }
            if typeName == "i32" { self.writer.line("    movsxd " + register + ", " + self.register32(register)) }
        }

        reserve(key:string, typeName:string) -> void {
            if self.findSlot(key) != null { return }
            self.slots.append(new Slot(key, (self.slots.length + 1) * 8, typeName))
        }

        slot(key:string) -> string { return "QWORD PTR [rbp-" + self.findSlot(key)!.offset.toString() + "]" }
        named(name:string) -> string { return self.slot("name:" + name) }
        temp(name:string) -> string { return self.slot("temp:" + name) }
        blockLabel(name:string) -> string { return self.currentFunctionSymbol + "__" + name }

        findSlot(key:string) -> ref Slot? {
            local index:i64 = 0
            while index < self.slots.length { if self.slots[index].key == key { return self.slots[index] }; index = index + 1 }
            return null
        }

        internString(value:string) -> void {
            if self.findLiteral(value) != null { return }
            local suffix = self.literals.length.toString()
            self.literals.append(new Literal(value, ".Largon_string_data_" + suffix, ".Largon_string_" + suffix))
        }

        findLiteral(value:string) -> ref Literal? {
            local index:i64 = 0
            while index < self.literals.length { if self.literals[index].value == value { return self.literals[index] }; index = index + 1 }
            return null
        }

        findField(name:string) -> ref FieldLayout? {
            local index:i64 = 0
            while index < self.fields.length { if self.fields[index].name == name { return self.fields[index] }; index = index + 1 }
            return null
        }

        findFunction(name:string) -> ref Ir.Function? {
            local index:i64 = 0
            while index < self.program.functions.length { if self.program.functions[index].name == name { return self.program.functions[index] }; index = index + 1 }
            return null
        }

        findProgramType(name:string) -> ref Ir.Type? {
            local index:i64 = 0
            while index < self.program.types.length { if self.program.types[index].name == name { return self.program.types[index] }; index = index + 1 }
            return null
        }

        findAssemblySymbol(name:string) -> ref FunctionSymbol? {
            local index:i64 = 0
            while index < self.functionSymbols.length { if self.functionSymbols[index].assemblyName == name { return self.functionSymbols[index] }; index = index + 1 }
            return null
        }

        functionSymbol(name:string) -> string {
            local index:i64 = 0
            while index < self.functionSymbols.length { if self.functionSymbols[index].name == name { return self.functionSymbols[index].assemblyName }; index = index + 1 }
            return self.mangle(name)
        }

        typeSize(name:string) -> i64 {
            local index:i64 = 0
            while index < self.types.length { if self.types[index].name == name { return self.types[index].size }; index = index + 1 }
            return 8
        }

        sizeOf(name:string) -> i64 {
            if name == "u8" || name == "bool" { return 1 }
            if name == "i32" { return 4 }
            return 8
        }

        memorySize(name:string) -> string {
            if self.sizeOf(name) == 1 { return "BYTE" }
            if self.sizeOf(name) == 4 { return "DWORD" }
            return "QWORD"
        }

        registerForSize(register:string, typeName:string) -> string {
            if self.sizeOf(typeName) == 1 { return self.register8(register) }
            if self.sizeOf(typeName) == 4 { return self.register32(register) }
            return register
        }

        register8(register:string) -> string {
            if register == "rax" { return "al" }
            if register == "rcx" { return "cl" }
            if register == "rdx" { return "dl" }
            if register == "rdi" { return "dil" }
            if register == "rsi" { return "sil" }
            if register == "r8" { return "r8b" }
            return "r9b"
        }

        register32(register:string) -> string {
            if register == "rax" { return "eax" }
            if register == "rcx" { return "ecx" }
            if register == "rdx" { return "edx" }
            if register == "rdi" { return "edi" }
            if register == "rsi" { return "esi" }
            if register == "r8" { return "r8d" }
            return "r9d"
        }

        argumentRegister(index:i64) -> string {
            if index == 0 { return "rdi" }
            if index == 1 { return "rsi" }
            if index == 2 { return "rdx" }
            if index == 3 { return "rcx" }
            if index == 4 { return "r8" }
            return "r9"
        }

        condition(operator:string, unsigned:bool) -> string {
            if operator == "==" || operator == "===" { return "sete" }
            if operator == "!=" || operator == "!==" { return "setne" }
            if operator == "<" { if unsigned { return "setb" }; return "setl" }
            if operator == "<=" { if unsigned { return "setbe" }; return "setle" }
            if operator == ">" { if unsigned { return "seta" }; return "setg" }
            if unsigned { return "setae" }
            return "setge"
        }

        isUnsigned(name:string) -> bool { return name == "u8" || name == "bool" }
        align(value:i64, alignment:i64) -> i64 { return ((value + alignment - 1) / alignment) * alignment }

        mangle(name:string) -> string {
            local builder = new StringBuilder()
            builder.append("argon_fn")
            local index:i64 = 0
            while index < name.length {
                builder.append("_")
                builder.append(name[index].toString())
                index = index + 1
            }
            return builder.build()
        }
    }}
}}
