        garbageCollectorRuntime() -> void {
            self.writer.line(".globl valen_gc_alloc"); self.writer.line("valen_gc_alloc:")
            self.writer.line("    push r12"); self.writer.line("    push r13"); self.writer.line("    push r14"); self.writer.line("    push r15")
            self.writer.line("    mov r12, rdi"); self.writer.line("    mov r13, rsi"); self.writer.line("    mov r14, rdx"); self.writer.line("    mov r15, rcx")
            self.writer.line("    sub rsp, 8"); self.writer.line("    call valen_gc_maybe_collect"); self.writer.line("    add rsp, 8"); self.writer.line("    mov rdi, r12")
            self.writer.line("    add rdi, 48"); self.writer.line("    cmp DWORD PTR [rip+valen_arena_enabled], 0"); self.writer.line("    je .Lgc_alloc_direct"); self.writer.line("    call valen_alloc"); self.writer.line("    jmp .Lgc_alloc_ready")
            self.writer.line(".Lgc_alloc_direct:"); self.writer.line("    mov rsi, rdi"); self.writer.line("    xor edi, edi"); self.writer.line("    mov edx, 3"); self.writer.line("    mov r10d, 34"); self.writer.line("    mov r8, -1"); self.writer.line("    xor r9d, r9d"); self.writer.line("    mov eax, 9"); self.writer.line("    syscall"); self.writer.line(".Lgc_alloc_ready:")
            self.writer.line("    cmp rax, -4095"); self.writer.line("    jae .Lallocation_error")
            self.writer.line("    lea rcx, [r12+48]"); self.writer.line("    mov QWORD PTR [rax+8], rcx"); self.writer.line("    mov QWORD PTR [rax+16], r13"); self.writer.line("    mov QWORD PTR [rax+24], r14"); self.writer.line("    mov QWORD PTR [rax+32], 0"); self.writer.line("    mov QWORD PTR [rax+40], r15"); self.writer.line("    push rax"); self.writer.line("    call valen_gc_heap_lock"); self.writer.line("    pop rax"); self.writer.line("    mov rdx, QWORD PTR [rip+valen_gc_heap]"); self.writer.line("    mov QWORD PTR [rax], rdx"); self.writer.line("    mov QWORD PTR [rip+valen_gc_heap], rax"); self.writer.line("    lock add QWORD PTR [rip+valen_gc_bytes], rcx")
            if self.runtimeMetrics { self.writer.line("    lock add QWORD PTR [rip+valen_gc_allocated_bytes], rcx"); self.writer.line("    lock inc QWORD PTR [rip+valen_gc_objects]") }
