            self.writer.line("    jmp .Lruntime_error")
            self.writer.line(".Loptional_unwrap_error:")
            self.writer.line("    mov edi, 71")
            self.writer.line("    jmp .Lruntime_error")
            self.writer.line(".Lcontract_dispatch_error:")
            self.writer.line("    mov edi, 75")
            self.writer.line("    jmp .Lruntime_error")
            self.writer.line(".Lfloat_conversion_error:")
