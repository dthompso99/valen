        typeLabel(typeName:string) -> string { return ".Lvalen_type_" + self.mangle(typeName) }
        objectEqualityLabel(typeName:string) -> string { return self.typeLabel(typeName) + "_equal" }
        objectHashLabel(typeName:string) -> string { return self.typeLabel(typeName) + "_hash" }
        objectCopyLabel(typeName:string) -> string { return self.typeLabel(typeName) + "_copy" }
        arrayEqualityLabel(typeName:string) -> string { return ".Lvalen_array_equal_" + self.mangle(typeName) }
        arrayHashLabel(typeName:string) -> string { return ".Lvalen_array_hash_" + self.mangle(typeName) }
        arrayCopyLabel(typeName:string) -> string { return ".Lvalen_array_copy_" + self.mangle(typeName) }
        arrayDestroyLabel(typeName:string) -> string { return ".Lvalen_array_destroy_" + self.mangle(typeName) }
        gcTraceLabel(typeName:string) -> string { return self.typeLabel(typeName) + "_gc_trace" }
        gcWeakLabel(typeName:string) -> string { return self.typeLabel(typeName) + "_gc_weak" }
        gcArrayTraceLabel(typeName:string) -> string { return ".Lvalen_gc_array_trace_" + self.mangle(typeName) }
        gcArrayWeakLabel(typeName:string) -> string { return ".Lvalen_gc_array_weak_" + self.mangle(typeName) }

        isManagedReferenceType(typeName:string) -> bool {
            if self.isPrimitiveOptional(typeName) { return true }
            local base = self.baseType(typeName)
            return base == "string" || base == "StringBuilder" || self.isArray(base) || self.findProgramType(base) != null
        }

        isPrimitiveOptional(typeName:string) -> bool {
            if typeName.length < 2 || typeName[typeName.length - 1] != 63 { return false }
            local base = typeName.slice(0, typeName.length - 1)
            return base == "bool" || base == "u8" || base == "i8" || base == "u16" || base == "i16" || base == "u32" || base == "i32" || base == "u64" || base == "i64" || base == "f32" || base == "f64"
        }

        baseType(typeName:string) -> string {
            if typeName.length > 0 { if typeName[typeName.length - 1] == 63 { return typeName.slice(0, typeName.length - 1) } }
            return typeName
        }

        equalityFunction(typeName:string) -> string {
            local base = self.baseType(typeName)
            if base == "string" { return "valen_string_equal_context" }
            if self.isArray(base) { return self.arrayEqualityLabel(base) }
            return "valen_object_equal"
        }

        hashFunction(typeName:string) -> string {
            local base = self.baseType(typeName)
            if base == "string" { return "valen_string_hash_context" }
            if self.isArray(base) { return self.arrayHashLabel(base) }
            return "valen_object_hash"
        }

        copyFunction(typeName:string) -> string {
            local base = self.baseType(typeName)
            if base == "string" { return "valen_string_copy_context" }
            if self.isArray(base) { return self.arrayCopyLabel(base) }
            return "valen_object_copy"
        }

        structuralRuntime() -> void {
            self.structuralCoreRuntime()
            local index:i64 = 0
            while index < self.program.types.length {
                self.objectEqualityFunction(self.program.types[index])
                self.objectHashFunction(self.program.types[index])
                self.objectCopyFunction(self.program.types[index])
                index = index + 1
            }
            local arrays = self.structuralArrayTypes()
            index = 0
            while index < arrays.length {
                self.arrayEqualityFunction(arrays[index])
                self.arrayHashFunction(arrays[index])
                self.arrayCopyFunction(arrays[index])
                index = index + 1
            }
        }

