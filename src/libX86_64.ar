        compareAddresses(left:string, right:string, typeName:string, fail:string) -> void {
            local base = self.baseType(typeName)
            if base == "string" || self.isArray(base) || self.findProgramType(base) != null {
                self.writer.line("    mov rdi, QWORD PTR [" + left + "]"); self.writer.line("    mov rsi, QWORD PTR [" + right + "]")
                self.writer.line("    mov rdx, r14"); self.writer.line("    call " + self.equalityFunction(base)); self.writer.line("    test eax, eax"); self.writer.line("    jz " + fail)
                return
