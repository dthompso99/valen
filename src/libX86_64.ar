        isArray(name:string) -> bool {
            if name.length <= 7 { return false }
            return name.slice(0, 6) == "Array<" && name[name.length - 1] == 62
        }

        containsType(types:Array<string>, name:string) -> bool {
            local index:i64 = 0
            while index < types.length { if types[index] == name { return true }; index = index + 1 }
            return false
        }

        addArrayType(types:Array<string>, typeName:string) -> void {
            local base = self.baseType(typeName)
            if !self.isArray(base) || self.containsType(types, base) { return }
            types.append(base)
            self.addArrayType(types, base.slice(6, base.length - 7))
        }

        structuralArrayTypes() -> Array<string> {
            local result = new Array<string>(0)
            local typeIndex:i64 = 0
            while typeIndex < self.program.types.length {
                local fieldIndex:i64 = 0
                while fieldIndex < self.program.types[typeIndex].fields.length {
                    self.addArrayType(result, self.program.types[typeIndex].fields[fieldIndex].typeName)
                    fieldIndex = fieldIndex + 1
                }
                typeIndex = typeIndex + 1
            }
            local functionIndex:i64 = 0
            while functionIndex < self.program.functions.length {
                local blockIndex:i64 = 0
                while blockIndex < self.program.functions[functionIndex].blocks.length {
                    local instructionIndex:i64 = 0
                    while instructionIndex < self.program.functions[functionIndex].blocks[blockIndex].instructions.length {
                        local instruction = self.program.functions[functionIndex].blocks[blockIndex].instructions[instructionIndex]
                        if instruction.ownerType != null { self.addArrayType(result, instruction.ownerType!) }
                        if instruction.typeName != null { self.addArrayType(result, instruction.typeName!) }
                        if instruction.result != null { self.addArrayType(result, instruction.result!.typeName) }
                        if instruction.first != null { self.addArrayType(result, instruction.first!.typeName) }
                        instructionIndex = instructionIndex + 1
                    }
                    blockIndex = blockIndex + 1
                }
                functionIndex = functionIndex + 1
            }
            return result
        }

