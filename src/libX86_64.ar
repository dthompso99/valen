            local spec = typeName.slice(6, typeName.length - 7)
            local ownership = "owned"
            local element = spec
            if spec.length > 4 { if spec.slice(0, 4) == "ref " { ownership = "ref"; element = spec.slice(4, spec.length - 4) } }
            if spec.length > 5 { if spec.slice(0, 5) == "weak " { ownership = "weak"; element = spec.slice(5, spec.length - 5) } }
            local label = self.arraySliceLabel(typeName); local loop = label + "_loop"; local done = label + "_done"; local size = self.sizeOf(element)
            if self.emissionModule != null && self.emissionModule! == "<llvm-runtime>" { self.writer.line(".globl " + label) }; self.writer.line(label + ":"); self.writer.line("    test rsi, rsi"); self.writer.line("    js .Larray_bounds_error"); self.writer.line("    test rdx, rdx"); self.writer.line("    js .Larray_bounds_error"); self.writer.line("    mov rax, rsi"); self.writer.line("    add rax, rdx"); self.writer.line("    jc .Larray_bounds_error"); self.writer.line("    cmp rax, QWORD PTR [rdi]"); self.writer.line("    ja .Larray_bounds_error")
            self.writer.line("    push rbp"); self.writer.line("    mov rbp, rsp"); self.writer.line("    push rbx"); self.writer.line("    push r12"); self.writer.line("    push r13"); self.writer.line("    push r14"); self.writer.line("    push r15"); self.writer.line("    sub rsp, 8"); self.writer.line("    mov rbx, rdi"); self.writer.line("    mov r12, rsi"); self.writer.line("    mov r13, rdx")
            self.writer.line("    mov rdi, " + size.toString()); self.writer.line("    mov rsi, r13"); self.writer.line("    lea rdx, [rip+" + self.gcArrayTraceLabel(typeName) + "]"); self.writer.line("    lea rcx, [rip+" + self.gcArrayWeakLabel(typeName) + "]"); self.writer.line("    call valen_gc_array_new"); self.writer.line("    mov r14, rax"); self.writer.line("    xor r15d, r15d"); self.writer.line(loop + ":"); self.writer.line("    cmp r15, r13"); self.writer.line("    jae " + done); self.writer.line("    mov rax, r12"); self.writer.line("    add rax, r15"); self.writer.line("    imul rax, " + size.toString()); self.writer.line("    add rax, QWORD PTR [rbx+16]")
            if ownership == "owned" && self.isManagedReferenceType(element) { self.writer.line("    mov rdi, QWORD PTR [rax]"); self.writer.line("    xor esi, esi"); self.writer.line("    call " + self.copyFunction(element)) } else { self.loadMemory("[rax]", element, "rax") }
            self.writer.line("    mov rcx, r15"); self.writer.line("    imul rcx, " + size.toString()); self.writer.line("    add rcx, QWORD PTR [r14+16]"); self.writer.line("    mov " + self.memorySize(element) + " PTR [rcx], " + self.registerForSize("rax", element)); self.writer.line("    inc r15"); self.writer.line("    jmp " + loop); self.writer.line(done + ":"); self.writer.line("    mov rax, r14"); self.writer.line("    add rsp, 8"); self.writer.line("    pop r15"); self.writer.line("    pop r14"); self.writer.line("    pop r13"); self.writer.line("    pop r12"); self.writer.line("    pop rbx"); self.writer.line("    leave"); self.writer.line("    ret")
        }

        arrayDestroyFunction(typeName:string) -> void {
            local element = typeName.slice(6, typeName.length - 7)
            local label = self.arrayDestroyLabel(typeName)
            local loop = label + "_loop"
            local next = label + "_next"
            local liveDone = label + "_live_done"
            local done = label + "_done"
            if self.emissionModule != null && self.emissionModule! == "<llvm-runtime>" { self.writer.line(".globl " + label) }; self.writer.line(label + ":"); self.writer.line("    test rdi, rdi"); self.writer.line("    jz " + done); self.writer.line("    push r12"); self.writer.line("    push r13"); self.writer.line("    mov r12, rdi"); self.writer.line("    xor r13d, r13d")
            self.writer.line(loop + ":"); self.writer.line("    cmp r13, QWORD PTR [r12]"); self.writer.line("    jae " + liveDone)
            if self.isArray(element) {
                self.writer.line("    imul rax, r13, " + self.sizeOf(element).toString()); self.writer.line("    add rax, QWORD PTR [r12+16]"); self.writer.line("    mov rdi, QWORD PTR [rax]"); self.writer.line("    call " + self.arrayDestroyLabel(element))
            } else {
                if self.findProgramType(self.baseType(element)) != null {
                    self.writer.line("    imul rax, r13, " + self.sizeOf(element).toString()); self.writer.line("    add rax, QWORD PTR [r12+16]"); self.writer.line("    mov rax, QWORD PTR [rax]"); self.writer.line("    test rax, rax"); self.writer.line("    jz " + next); self.writer.line("    mov QWORD PTR [rax+8], 0")
                }
            }
            self.writer.line(next + ":"); self.writer.line("    inc r13"); self.writer.line("    jmp " + loop); self.writer.line(liveDone + ":"); self.writer.line("    mov QWORD PTR [r12+32], 0"); self.writer.line("    pop r13"); self.writer.line("    pop r12"); self.writer.line(done + ":"); self.writer.line("    ret")
        }

        stableTypeHash(name:string) -> i64 {
            local hash:i64 = 1469598103934665603
            local index:i64 = 0
            while index < name.length { hash = hash * 31 + (name[index] as i64); index = index + 1 }
            return hash
        }
        contractListLabel(typeName:string) -> string { return self.typeLabel(typeName) + "_contracts" }
        contractTableLabel(typeName:string, contractName:string) -> string { return self.typeLabel(typeName) + "_as_" + self.mangle(contractName) }

        typeData() -> void {
            self.writer.line(".section .data")
            self.writer.line(".align 8")
            local index:i64 = 0
            while index < self.program.types.length {
                local typeNode = self.program.types[index]
                if self.emissionModule != null && self.emissionModule! == "<llvm-runtime>" { self.writer.line(".globl " + self.typeLabel(typeNode.name)) }
                self.writer.line(self.typeLabel(typeNode.name) + ":")
                if typeNode.baseName == null { self.writer.line("    .quad 0") } else { self.writer.line("    .quad " + self.typeLabel(typeNode.baseName!)) }
                self.writer.line("    .quad " + self.contractListLabel(typeNode.name))
                self.writer.line("    .quad " + self.objectEqualityLabel(typeNode.name))
                self.writer.line("    .quad " + self.objectHashLabel(typeNode.name))
                self.writer.line("    .quad " + self.objectCopyLabel(typeNode.name))
                local methodIndex:i64 = 0
                while methodIndex < typeNode.virtualMethods.length {
                    self.writer.line("    .quad " + self.functionSymbol(typeNode.virtualMethods[methodIndex].target))
                    methodIndex = methodIndex + 1
                }
                index = index + 1
            }
            index = 0
            while index < self.program.types.length {
                local typeNode = self.program.types[index]
                self.writer.line(self.contractListLabel(typeNode.name) + ":")
                self.writer.line("    .quad " + typeNode.contracts.length.toString())
                local contractIndex:i64 = 0
                while contractIndex < typeNode.contracts.length {
                    local contract = typeNode.contracts[contractIndex]
                    self.writer.line("    .quad " + self.typeLabel(contract.name))
                    self.writer.line("    .quad " + self.contractTableLabel(typeNode.name, contract.name))
                    contractIndex = contractIndex + 1
                }
                contractIndex = 0
                while contractIndex < typeNode.contracts.length {
                    local contract = typeNode.contracts[contractIndex]
                    self.writer.line(self.contractTableLabel(typeNode.name, contract.name) + ":")
                    local methodIndex:i64 = 0
                    while methodIndex < contract.methods.length {
                        self.writer.line("    .quad " + self.functionSymbol(contract.methods[methodIndex].target))
                        methodIndex = methodIndex + 1
                    }
                    contractIndex = contractIndex + 1
                }
                index = index + 1
            }
            self.writer.line("")
        }

        allocateRegisters(function:Ir.Function) -> void {
            self.allocations = new Array<Allocation>(0)
            self.allocationIndex = new StringIndex()
            local parameterIndex:i64 = 0
            while parameterIndex < function.parameters.length {
                local parameter = function.parameters[parameterIndex]
                if !self.isManagedReferenceType(parameter.typeName) {
                    local allocation = new Allocation("name:" + parameter.name, 0)
                    self.allocations.append(allocation); self.allocationIndex.set(allocation.name, self.allocations.length - 1)
                }
                parameterIndex = parameterIndex + 1
            }
            local localBlockIndex:i64 = 0
            while localBlockIndex < function.blocks.length {
                local localInstructionIndex:i64 = 0
                while localInstructionIndex < function.blocks[localBlockIndex].instructions.length {
                    local localInstruction = function.blocks[localBlockIndex].instructions[localInstructionIndex]
                    if localInstruction.op == "declare_local" && localInstruction.name != null && localInstruction.typeName != null {
                        local key = "name:" + localInstruction.name!
                        if self.findAllocation(key) == null && !self.isManagedReferenceType(localInstruction.typeName!) {
                            local allocation = new Allocation(key, 0)
                            self.allocations.append(allocation); self.allocationIndex.set(allocation.name, self.allocations.length - 1)
                        }
                    }
                    localInstructionIndex = localInstructionIndex + 1
                }
                localBlockIndex = localBlockIndex + 1
            }
            local position:i64 = 0
            local blockIndex:i64 = 0
            while blockIndex < function.blocks.length {
                local instructionIndex:i64 = 0
                while instructionIndex < function.blocks[blockIndex].instructions.length {
                    local instruction = function.blocks[blockIndex].instructions[instructionIndex]
                    if instruction.result != null {
                        if self.findImmediate(instruction.result!.name) == null && !self.isManagedReferenceType(instruction.result!.typeName) && !self.loopBackedgeTemporary(function, instruction.result!.name) { local allocation = new Allocation("temp:" + instruction.result!.name, position); self.allocations.append(allocation); self.allocationIndex.set(allocation.name, self.allocations.length - 1) }
                    }
                    self.recordAllocationUse(instruction.first, position)
                    self.recordAllocationUse(instruction.second, position)
                    self.recordAllocationUse(instruction.third, position)
                    local argumentIndex:i64 = 0
                    while argumentIndex < instruction.arguments.length {
                        self.recordAllocationUse(instruction.arguments[argumentIndex], position)
                        argumentIndex = argumentIndex + 1
                    }
                    position = position + 1
                    instructionIndex = instructionIndex + 1
                }
                blockIndex = blockIndex + 1
            }
            local namedIndex:i64 = 0
            while namedIndex < self.allocations.length {
                local named = self.allocations[namedIndex]
                if named.name.length >= 5 && named.name.slice(0, 5) == "name:" { named.end = position }
                namedIndex = namedIndex + 1
            }
            local allocationIndex:i64 = 0
            local namedRegisters:i64 = 0
            while allocationIndex < self.allocations.length {
                local allocation = self.allocations[allocationIndex]
                local namedAllocation = allocation.name.length >= 5 && allocation.name.slice(0, 5) == "name:"
                if allocation.end > allocation.start && (!namedAllocation || namedRegisters < 2) {
                    local registerIndex:i64 = 0
                    local assigned:bool = false
                    while registerIndex < 5 && !assigned {
                        local candidate = self.allocationRegister(registerIndex)
                        local available:bool = true
                        local priorIndex:i64 = 0
                        while priorIndex < allocationIndex {
                            local prior = self.allocations[priorIndex]
                            if prior.registerName == candidate && prior.end > allocation.start { available = false }
                            priorIndex = priorIndex + 1
                        }
                        if available { allocation.registerName = candidate; assigned = true }
                        registerIndex = registerIndex + 1
                    }
                    if namedAllocation && assigned { namedRegisters = namedRegisters + 1 }
                }
                allocationIndex = allocationIndex + 1
            }
        }

        loopBackedgeTemporary(function:Ir.Function, name:string) -> bool { local blockIndex:i64 = 0; while blockIndex < function.blocks.length { local instructionIndex:i64 = 0; while instructionIndex < function.blocks[blockIndex].instructions.length { local instruction = function.blocks[blockIndex].instructions[instructionIndex]; if instruction.op == "loop_value" && instruction.second != null && instruction.second!.kind == "temporary" && instruction.second!.name == name { return true }; instructionIndex = instructionIndex + 1 }; blockIndex = blockIndex + 1 }; return false }

        selectImmediateConstants(function:Ir.Function) -> void {
            self.immediates = new Array<Immediate>(0)
            self.immediateIndex = new StringIndex()
            local blockIndex:i64 = 0
            while blockIndex < function.blocks.length {
                local instructionIndex:i64 = 0
                while instructionIndex < function.blocks[blockIndex].instructions.length {
                    local instruction = function.blocks[blockIndex].instructions[instructionIndex]
                    if instruction.op == "constant" && instruction.result != null && !self.isFloat(instruction.result!.typeName) {
                        local parsed = System.parseInteger(instruction.text!)
                        if parsed.valid && parsed.value >= -2147483648 && parsed.value <= 2147483647 {
                            if self.immediateUsesEligible(function, instruction.result!.name) { local immediate = new Immediate(instruction.result!.name, parsed.value); self.immediates.append(immediate); self.immediateIndex.set(immediate.name, self.immediates.length - 1) }
                        }
                    }
                    instructionIndex = instructionIndex + 1
                }
                blockIndex = blockIndex + 1
            }
        }

        immediateUsesEligible(function:Ir.Function, name:string) -> bool {
            local found:bool = false
            local blockIndex:i64 = 0
            while blockIndex < function.blocks.length {
                local instructionIndex:i64 = 0
                while instructionIndex < function.blocks[blockIndex].instructions.length {
                    local instruction = function.blocks[blockIndex].instructions[instructionIndex]
                    local secondUse = instruction.second != null && instruction.second!.kind == "temporary" && instruction.second!.name == name
                    if secondUse {
                        found = true
                        if instruction.op != "binary" || !self.immediateOperator(instruction.operator!) { return false }
                    }
                    if instruction.first != null { if instruction.first!.kind == "temporary" && instruction.first!.name == name { return false } }
                    if instruction.third != null { if instruction.third!.kind == "temporary" && instruction.third!.name == name { return false } }
                    local argumentIndex:i64 = 0
                    while argumentIndex < instruction.arguments.length {
                        if instruction.arguments[argumentIndex].kind == "temporary" && instruction.arguments[argumentIndex].name == name { return false }
                        argumentIndex = argumentIndex + 1
                    }
                    instructionIndex = instructionIndex + 1
                }
                blockIndex = blockIndex + 1
            }
            return found
        }

        immediateOperator(operator:string) -> bool {
            return operator == "+" || operator == "-" || operator == "*" || operator == "/" || operator == "&" || operator == "|" || operator == "^" || operator == "<<" || operator == ">>" || operator == "==" || operator == "!=" || operator == "===" || operator == "!==" || operator == "<" || operator == "<=" || operator == ">" || operator == ">="
        }

        temporaryUseCount(function:Ir.Function, name:string) -> i64 {
            local allocation = self.findAllocation("temp:" + name)
            if allocation == null { return 0 }
            return allocation!.uses
        }

        branchHasBackedge(function:Ir.Function, currentBlock:i64, branch:Ir.Instruction) -> bool {
            local blockIndex:i64 = 0
            while blockIndex < function.blocks.length {
                local label = function.blocks[blockIndex].label
                if label == branch.target! || label == branch.alternateTarget! { if blockIndex <= currentBlock { return true } }
                blockIndex = blockIndex + 1
            }
            return false
        }

        findImmediate(name:string) -> ref Immediate? {
            local index:i64 = 0
            while index < self.immediates.length {
                if self.immediates[index].name == name { return self.immediates[index] }
                index = index + 1
            }
            return null
        }

        recordAllocationUse(value:Ir.Value?, position:i64) -> void {
            if value == null || value!.kind != "temporary" { return }
            local allocation = self.findAllocation("temp:" + value!.name)
            if allocation != null { allocation!.uses = allocation!.uses + 1; if position > allocation!.end { allocation!.end = position } }
        }

        allocationRegister(index:i64) -> string {
            if index == 0 { return "r12" }
            if index == 1 { return "r13" }
            if index == 2 { return "r14" }
            if index == 3 { return "r15" }
            return "rbx"
        }

        usesAllocationRegister(registerName:string) -> bool {
            local index:i64 = 0
            while index < self.allocations.length {
                if self.allocations[index].registerName == registerName { return true }
                index = index + 1
            }
            return false
        }

        findAllocation(name:string) -> ref Allocation? {
            local index = self.allocationIndex.get(name)
            if index < 0 { return null }
            return self.allocations[index]
        }

        load(value:Ir.Value, register:string) -> void {
            if value.kind == "parameter" || value.kind == "local" { self.writer.line("    mov " + register + ", " + self.named(value.name)); return }
            if value.kind == "temporary" { self.writer.line("    mov " + register + ", " + self.temp(value.name)); return }
            self.writer.line("    xor " + self.register32(register) + ", " + self.register32(register))
        }

        storeResult(instruction:Ir.Instruction, register:string) -> void {
            self.writer.line("    mov " + self.temp(instruction.result!.name) + ", " + register)
        }

        loadMemory(address:string, typeName:string, register:string) -> void {
            if typeName == "u8" || typeName == "bool" { self.writer.line("    movzx " + self.register32(register) + ", BYTE PTR " + address); return }
            if typeName == "i8" { self.writer.line("    movsx " + register + ", BYTE PTR " + address); return }
            if typeName == "u16" { self.writer.line("    movzx " + self.register32(register) + ", WORD PTR " + address); return }
            if typeName == "i16" { self.writer.line("    movsx " + register + ", WORD PTR " + address); return }
            if typeName == "u32" { self.writer.line("    mov " + self.register32(register) + ", DWORD PTR " + address); return }
            if typeName == "i32" { self.writer.line("    movsxd " + register + ", DWORD PTR " + address); return }
            if typeName == "f32" { self.writer.line("    mov " + self.register32(register) + ", DWORD PTR " + address); return }
            self.writer.line("    mov " + register + ", QWORD PTR " + address)
        }

        normalize(register:string, typeName:string) -> void {
            if typeName == "u8" || typeName == "bool" { self.writer.line("    movzx " + self.register32(register) + ", " + self.register8(register)) }
            if typeName == "i8" { self.writer.line("    movsx " + register + ", " + self.register8(register)) }
            if typeName == "u16" { self.writer.line("    movzx " + self.register32(register) + ", " + self.register16(register)) }
            if typeName == "i16" { self.writer.line("    movsx " + register + ", " + self.register16(register)) }
            if typeName == "u32" { self.writer.line("    mov " + self.register32(register) + ", " + self.register32(register)) }
            if typeName == "i32" { self.writer.line("    movsxd " + register + ", " + self.register32(register)) }
        }

        reserve(key:string, typeName:string) -> void {
            if self.findSlot(key) != null { return }
            local value = new Slot(key, (self.slots.length + 1) * 8, typeName)
            self.slots.append(value); self.slotIndex.set(key, self.slots.length - 1)
        }

        slot(key:string) -> string { return "QWORD PTR [rbp-" + self.findSlot(key)!.offset.toString() + "]" }
        named(name:string) -> string {
            local allocation = self.findAllocation("name:" + name)
            if allocation != null { if allocation!.registerName.length > 0 { return allocation!.registerName } }
            return self.slot("name:" + name)
        }
        temp(name:string) -> string {
            local allocation = self.findAllocation("temp:" + name)
            if allocation != null { if allocation!.registerName.length > 0 { return allocation!.registerName } }
            return self.slot("temp:" + name)
        }
        blockLabel(name:string) -> string { return self.currentFunctionSymbol + "__" + name }

        findSlot(key:string) -> ref Slot? {
            local index = self.slotIndex.get(key)
            if index < 0 { return null }
            return self.slots[index]
        }

        internString(value:string) -> void {
            if self.findLiteral(value) != null { return }
            local suffix = self.literals.length.toString()
            self.literals.append(new Literal(value, ".Lvalen_string_data_" + suffix, ".Lvalen_string_" + suffix))
        }

        internFloat(value:string, typeName:string) -> void {
            if self.findFloatLiteral(value, typeName) != null { return }
            self.floatLiterals.append(new Literal(value, ".Lvalen_float_" + self.floatLiterals.length.toString(), typeName))
        }

        findFloatLiteral(value:string, typeName:string) -> ref Literal? {
            local index:i64 = 0
            while index < self.floatLiterals.length {
                if self.floatLiterals[index].value == value && self.floatLiterals[index].descriptorLabel == typeName { return self.floatLiterals[index] }
                index = index + 1
            }
            return null
        }

        findLiteral(value:string) -> ref Literal? {
            local index:i64 = 0
            while index < self.literals.length { if self.literals[index].value == value { return self.literals[index] }; index = index + 1 }
            return null
        }

        findField(name:string) -> ref FieldLayout? {
            local index = self.fieldIndex.get(name)
            if index < 0 { return null }
            return self.fields[index]
        }

        findFunction(name:string) -> ref Ir.Function? {
            local index:i64 = 0
            while index < self.program.functions.length {
                if self.program.functions[index].name == name { return self.program.functions[index] }
                index = index + 1
            }
            return null
        }

        findProgramType(name:string) -> ref Ir.Type? {
            local index:i64 = 0
            while index < self.program.types.length {
                if self.program.types[index].name == name { return self.program.types[index] }
                index = index + 1
            }
            return null
        }

        findAssemblySymbol(name:string) -> ref FunctionSymbol? {
            local index = self.assemblyIndex.get(name)
            if index < 0 { return null }
            return self.functionSymbols[index]
        }

        functionSymbol(name:string) -> string {
            local index = self.functionIndex.get(name)
            if index >= 0 { return self.functionSymbols[index].assemblyName }
            return self.mangle(name)
        }

        typeSize(name:string) -> i64 {
            local index = self.typeIndex.get(name)
            if index >= 0 { return self.types[index].size }
            return 8
        }

        sizeOf(name:string) -> i64 {
            if name == "u8" || name == "i8" || name == "bool" { return 1 }
            if name == "u16" || name == "i16" { return 2 }
            if name == "u32" || name == "i32" || name == "f32" { return 4 }
            return 8
        }

        memorySize(name:string) -> string {
            if self.sizeOf(name) == 1 { return "BYTE" }
            if self.sizeOf(name) == 4 { return "DWORD" }
            return "QWORD"
        }

        registerForSize(register:string, typeName:string) -> string {
            if self.sizeOf(typeName) == 1 { return self.register8(register) }
            if self.sizeOf(typeName) == 2 { return self.register16(register) }
            if self.sizeOf(typeName) == 4 { return self.register32(register) }
            return register
        }

        register8(register:string) -> string {
            if register == "rax" { return "al" }
            if register == "rcx" { return "cl" }
            if register == "rdx" { return "dl" }
            if register == "rdi" { return "dil" }
            if register == "rsi" { return "sil" }
            if register == "r8" { return "r8b" }
            return "r9b"
        }

        register16(register:string) -> string {
            if register == "rax" { return "ax" }
            if register == "rcx" { return "cx" }
            if register == "rdx" { return "dx" }
            if register == "rdi" { return "di" }
            if register == "rsi" { return "si" }
            if register == "r8" { return "r8w" }
            return "r9w"
        }

        register32(register:string) -> string {
            if register == "rax" { return "eax" }
            if register == "rcx" { return "ecx" }
            if register == "rdx" { return "edx" }
            if register == "rdi" { return "edi" }
            if register == "rsi" { return "esi" }
            if register == "r8" { return "r8d" }
            return "r9d"
        }

        argumentRegister(index:i64) -> string {
            if index == 0 { return "rdi" }
            if index == 1 { return "rsi" }
            if index == 2 { return "rdx" }
            if index == 3 { return "rcx" }
            if index == 4 { return "r8" }
            return "r9"
        }

        condition(operator:string, unsigned:bool) -> string {
            if operator == "==" || operator == "===" { return "sete" }
            if operator == "!=" || operator == "!==" { return "setne" }
            if operator == "<" { if unsigned { return "setb" }; return "setl" }
            if operator == "<=" { if unsigned { return "setbe" }; return "setle" }
            if operator == ">" { if unsigned { return "seta" }; return "setg" }
            if unsigned { return "setae" }
            return "setge"
        }

        comparisonOperator(operator:string) -> bool { return operator == "==" || operator == "!=" || operator == "===" || operator == "!==" || operator == "<" || operator == "<=" || operator == ">" || operator == ">=" }

        branchCondition(operator:string, unsigned:bool) -> string {
            if operator == "==" || operator == "===" { return "je" }
            if operator == "!=" || operator == "!==" { return "jne" }
            if operator == "<" { if unsigned { return "jb" }; return "jl" }
            if operator == "<=" { if unsigned { return "jbe" }; return "jle" }
            if operator == ">" { if unsigned { return "ja" }; return "jg" }
            if unsigned { return "jae" }
            return "jge"
        }

        isUnsigned(name:string) -> bool { return name == "u8" || name == "u16" || name == "u32" || name == "u64" || name == "bool" }
        isFloat(name:string) -> bool { return name == "f32" || name == "f64" }
        align(value:i64, alignment:i64) -> i64 { return ((value + alignment - 1) / alignment) * alignment }

        mangle(name:string) -> string {
            local builder = new StringBuilder()
            builder.append("valen_fn")
            local index:i64 = 0
            while index < name.length {
                builder.append("_")
                builder.append(name[index].toString())
                index = index + 1
            }
            return builder.build()
        }
    }}
}}
