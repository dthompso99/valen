            self.loadMemory("[" + right + "]", base, "rax"); self.writer.line("    mov rcx, rax"); self.loadMemory("[" + left + "]", base, "rax")
            self.writer.line("    cmp rax, rcx"); self.writer.line("    jne " + fail)
        }

        hashAddress(address:string, typeName:string) -> void {
            local base = self.baseType(typeName)
            if base == "string" || self.isArray(base) || self.findProgramType(base) != null {
                self.writer.line("    mov rdi, QWORD PTR [" + address + "]"); self.writer.line("    mov rsi, r14"); self.writer.line("    call " + self.hashFunction(base)); return
