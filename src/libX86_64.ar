            self.writer.line("    ret")
            self.writer.line("")
            self.writer.line(".globl valen_System_enableShutdownSignals"); self.writer.line("valen_System_enableShutdownSignals:")
            self.writer.line("    sub rsp, 32"); self.writer.line("    lea rax, [rip+.Lshutdown_signal_handler]"); self.writer.line("    mov QWORD PTR [rsp], rax")
            self.writer.line("    mov QWORD PTR [rsp+8], 67108864"); self.writer.line("    lea rax, [rip+.Lshutdown_signal_return]"); self.writer.line("    mov QWORD PTR [rsp+16], rax"); self.writer.line("    mov QWORD PTR [rsp+24], 0")
            self.writer.line("    mov eax, 13"); self.writer.line("    mov edi, 2"); self.writer.line("    mov rsi, rsp"); self.writer.line("    xor edx, edx"); self.writer.line("    mov r10d, 8"); self.writer.line("    syscall"); self.writer.line("    test rax, rax"); self.writer.line("    js .Lshutdown_signal_failed")
            self.writer.line("    mov eax, 13"); self.writer.line("    mov edi, 15"); self.writer.line("    mov rsi, rsp"); self.writer.line("    xor edx, edx"); self.writer.line("    mov r10d, 8"); self.writer.line("    syscall"); self.writer.line("    test rax, rax"); self.writer.line("    js .Lshutdown_signal_failed")
            self.writer.line("    add rsp, 32"); self.writer.line("    mov eax, 1"); self.writer.line("    ret"); self.writer.line(".Lshutdown_signal_failed:"); self.writer.line("    add rsp, 32"); self.writer.line("    xor eax, eax"); self.writer.line("    ret")
            self.writer.line(".globl valen_System_shutdownRequested"); self.writer.line("valen_System_shutdownRequested:"); self.writer.line("    mov rax, QWORD PTR [rip+valen_shutdown_requested]"); self.writer.line("    ret")
            self.writer.line(".Lshutdown_signal_handler:"); self.writer.line("    mov QWORD PTR [rip+valen_shutdown_requested], 1"); self.writer.line("    ret")
            self.writer.line(".Lshutdown_signal_return:"); self.writer.line("    mov eax, 15"); self.writer.line("    syscall"); self.writer.line("")
            self.writer.line(".globl valen_alloc")
            self.writer.line("valen_alloc:")
            self.writer.line("    test rdi, rdi")
            self.writer.line("    jnz .Lalloc_size")
            self.writer.line("    mov edi, 1")
            self.writer.line(".Lalloc_size:")
            self.writer.line("    cmp DWORD PTR [rip+valen_arena_enabled], 0")
            self.writer.line("    je .Lalloc_direct")
            self.writer.line("    push r12")
            self.writer.line("    lea r12, [rdi+15]")
            self.writer.line("    and r12, -8")
            self.writer.line(".Lalloc_lock:")
            self.writer.line("    xor eax, eax")
            self.writer.line("    mov edx, 1")
            self.writer.line("    lock cmpxchg DWORD PTR [rip+valen_arena_lock], edx")
            self.writer.line("    je .Lalloc_locked")
            self.writer.line("    pause")
            self.writer.line("    jmp .Lalloc_lock")
            self.writer.line(".Lalloc_locked:")
            self.writer.line("    cmp QWORD PTR [rip+valen_arena_remaining], r12")
            self.writer.line("    jb .Lalloc_refill")
            self.writer.line("    mov rax, QWORD PTR [rip+valen_arena_cursor]")
            self.writer.line("    add QWORD PTR [rip+valen_arena_cursor], r12")
            self.writer.line("    sub QWORD PTR [rip+valen_arena_remaining], r12")
            self.writer.line("    mov DWORD PTR [rip+valen_arena_lock], 0")
            self.writer.line("    pop r12")
            self.writer.line("    ret")
            self.writer.line(".Lalloc_refill:")
            self.writer.line("    mov rsi, 1048576")
            self.writer.line("    cmp r12, rsi")
            self.writer.line("    cmova rsi, r12")
            self.writer.line("    xor edi, edi")
            self.writer.line("    mov edx, 3")
            self.writer.line("    mov r10d, 34")
            self.writer.line("    mov r8, -1")
            self.writer.line("    xor r9d, r9d")
            self.writer.line("    mov eax, 9")
            self.writer.line("    syscall")
            self.writer.line("    cmp rax, -4095")
            self.writer.line("    jae .Lallocation_error")
            self.writer.line("    lea rcx, [rax+r12]")
            self.writer.line("    mov QWORD PTR [rip+valen_arena_cursor], rcx")
            self.writer.line("    sub rsi, r12")
            self.writer.line("    mov QWORD PTR [rip+valen_arena_remaining], rsi")
            self.writer.line("    mov DWORD PTR [rip+valen_arena_lock], 0")
            self.writer.line("    pop r12")
            self.writer.line("    ret")
            self.writer.line(".Lalloc_direct:")
            self.writer.line("    mov rsi, rdi")
            self.writer.line("    xor edi, edi")
            self.writer.line("    mov edx, 3")
            self.writer.line("    mov r10d, 34")
            self.writer.line("    mov r8, -1")
            self.writer.line("    xor r9d, r9d")
            self.writer.line("    mov eax, 9")
            self.writer.line("    syscall")
            self.writer.line("    cmp rax, -4095")
            self.writer.line("    jae .Lallocation_error")
            self.writer.line("    ret")
            self.writer.line(".Lallocation_error:")
            self.writer.line("    mov edi, 72")
            self.writer.line("    jmp .Lruntime_error")
            self.writer.line("")
        }

        garbageCollectorRuntime() -> void {
            self.writer.line(".globl valen_gc_alloc"); self.writer.line("valen_gc_alloc:")
            self.writer.line("    push r12"); self.writer.line("    push r13"); self.writer.line("    push r14"); self.writer.line("    push r15")
            self.writer.line("    mov r12, rdi"); self.writer.line("    mov r13, rsi"); self.writer.line("    mov r14, rdx"); self.writer.line("    mov r15, rcx")
            self.writer.line("    sub rsp, 8"); self.writer.line("    call valen_gc_maybe_collect"); self.writer.line("    add rsp, 8"); self.writer.line("    mov rdi, r12")
            self.writer.line("    add rdi, 48"); self.writer.line("    cmp DWORD PTR [rip+valen_arena_enabled], 0"); self.writer.line("    je .Lgc_alloc_direct"); self.writer.line("    call valen_alloc"); self.writer.line("    jmp .Lgc_alloc_ready")
            self.writer.line(".Lgc_alloc_direct:"); self.writer.line("    mov rsi, rdi"); self.writer.line("    xor edi, edi"); self.writer.line("    mov edx, 3"); self.writer.line("    mov r10d, 34"); self.writer.line("    mov r8, -1"); self.writer.line("    xor r9d, r9d"); self.writer.line("    mov eax, 9"); self.writer.line("    syscall"); self.writer.line(".Lgc_alloc_ready:")
            self.writer.line("    cmp rax, -4095"); self.writer.line("    jae .Lallocation_error"); self.writer.line("    mov rcx, QWORD PTR [rip+valen_gc_heap]"); self.writer.line("    mov QWORD PTR [rax], rcx")
