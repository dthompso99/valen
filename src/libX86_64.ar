import Ir from 'libIr.ar'

library X86_64 {{
    Writer {{
        member builder:StringBuilder

        __() -> void { self.builder = new StringBuilder() }
        line(value:string) -> void { self.builder.append(value); self.builder.appendByte(10) }
        build() -> string { return self.builder.build() }
    }}

    FunctionSymbol {{
        member name:string
        member assemblyName:string
        __(name:string, assemblyName:string) -> void { self.name = name; self.assemblyName = assemblyName }
    }}

    FieldLayout {{
        member name:string
        member typeName:string
        member ownership:string
        member offset:i64
        __(name:string, typeName:string, ownership:string, offset:i64) -> void { self.name = name; self.typeName = typeName; self.ownership = ownership; self.offset = offset }
    }}

    TypeLayout {{
        member name:string
        member size:i64
        __(name:string, size:i64) -> void { self.name = name; self.size = size }
    }}

    Literal {{
        member value:string
        member dataLabel:string
        member descriptorLabel:string
        __(value:string, dataLabel:string, descriptorLabel:string) -> void {
            self.value = value
            self.dataLabel = dataLabel
            self.descriptorLabel = descriptorLabel
        }
    }}

    Slot {{
        member key:string
        member offset:i64
        member typeName:string
        __(key:string, offset:i64, typeName:string) -> void { self.key = key; self.offset = offset; self.typeName = typeName }
    }}

    Backend {{
        member program:Ir.Program
        member writer:Writer
        member functionSymbols:Array<FunctionSymbol>
        member fields:Array<FieldLayout>
        member types:Array<TypeLayout>
        member literals:Array<Literal>
        member slots:Array<Slot>
        member currentFunctionSymbol:string
        member nextLabel:i64
        member usesPrint:bool
        member usesWrite:bool
        member usesWriteError:bool

        __(program:Ir.Program) -> void {
            self.program = program
            self.writer = new Writer()
            self.functionSymbols = new Array<FunctionSymbol>(0)
            self.fields = new Array<FieldLayout>(0)
            self.types = new Array<TypeLayout>(0)
            self.literals = new Array<Literal>(0)
            self.slots = new Array<Slot>(0)
            self.currentFunctionSymbol = ""
            self.nextLabel = 0
            self.usesPrint = false
            self.usesWrite = false
            self.usesWriteError = false
        }

        generate() -> string {
            self.layoutTypes()
            self.declareSymbols()
            self.scanProgram()
            self.writer.line(".intel_syntax noprefix")
            self.writer.line(".text")
            local index:i64 = 0
            while index < self.program.functions.length {
                self.generateFunction(self.program.functions[index])
                index = index + 1
            }
            self.generateMain()
            self.structuralRuntime()
            if self.usesPrint { self.printRuntime() }
            if self.usesWrite { self.writeRuntime("argon_System_write", 1) }
            if self.usesWriteError { self.writeRuntime("argon_System_writeError", 2) }
            self.processRuntime()
            self.linkRuntime()
            self.filesystemRuntime()
            self.memoryRuntime()
            self.runtimeCore()
            self.garbageCollectorRuntime()
            self.arrayRuntime()
            self.gcTraceFunctions()
            self.stringRuntime()
            self.builderRuntime()
            self.stringData()
            self.runtimeData()
            self.typeData()
            self.writer.line(".section .rodata")
            self.writer.line("argon_test_failure_message:")
            self.writer.line("    .byte 116,101,115,116,32,102,97,105,108,101,100,10")
            self.writer.line(".comm argon_test_failures,8,8")
            self.writer.line(".section .note.GNU-stack,\"\",@progbits")
            return self.writer.build()
        }

        layoutTypes() -> void {
            local typeIndex:i64 = 0
            while typeIndex < self.program.types.length {
                local typeNode = self.program.types[typeIndex]
                local offset:i64 = 16
                local alignment:i64 = 1
                local fieldIndex:i64 = 0
                while fieldIndex < typeNode.fields.length {
                    local field = typeNode.fields[fieldIndex]
                    local size = self.sizeOf(field.typeName)
                    local fieldAlignment = size
                    if fieldAlignment > 8 { fieldAlignment = 8 }
                    offset = self.align(offset, fieldAlignment)
                    self.fields.append(new FieldLayout(field.qualifiedName, field.typeName, field.ownership, offset))
                    offset = offset + size
                    if fieldAlignment > alignment { alignment = fieldAlignment }
                    fieldIndex = fieldIndex + 1
                }
                local total = self.align(offset, alignment)
                if total < 8 { total = 8 }
                self.types.append(new TypeLayout(typeNode.name, total))
                typeIndex = typeIndex + 1
            }
        }

        declareSymbols() -> void {
            local index:i64 = 0
            while index < self.program.functions.length {
                local function = self.program.functions[index]
                local assemblyName = self.mangle(function.name)
                if self.findAssemblySymbol(assemblyName) != null { return }
                self.functionSymbols.append(new FunctionSymbol(function.name, assemblyName))
                index = index + 1
            }
            index = 0
            while index < self.program.externals.length {
                local external = self.program.externals[index]
                self.functionSymbols.append(new FunctionSymbol(external.name, external.runtimeName))
                index = index + 1
            }
        }

        scanProgram() -> void {
            local functionIndex:i64 = 0
            while functionIndex < self.program.functions.length {
                local blocks = self.program.functions[functionIndex].blocks
                local blockIndex:i64 = 0
                while blockIndex < blocks.length {
                    local instructions = blocks[blockIndex].instructions
                    local instructionIndex:i64 = 0
                    while instructionIndex < instructions.length {
                        local instruction = instructions[instructionIndex]
                        if instruction.op == "string_constant" { self.internString(instruction.text!) }
                        if instruction.op == "call" {
                            if instruction.target! == "System.print" { self.usesPrint = true }
                            if instruction.target! == "System.write" { self.usesWrite = true }
                            if instruction.target! == "System.writeError" { self.usesWriteError = true }
                        }
                        instructionIndex = instructionIndex + 1
                    }
                    blockIndex = blockIndex + 1
                }
                functionIndex = functionIndex + 1
            }
        }

        generateFunction(function:Ir.Function) -> void {
            self.currentFunctionSymbol = self.functionSymbol(function.name)
            self.slots = new Array<Slot>(0)
            local parameterIndex:i64 = 0
            while parameterIndex < function.parameters.length {
                self.reserve("name:" + function.parameters[parameterIndex].name, function.parameters[parameterIndex].typeName)
                parameterIndex = parameterIndex + 1
            }
            local blockIndex:i64 = 0
            while blockIndex < function.blocks.length {
                local instructions = function.blocks[blockIndex].instructions
                local index:i64 = 0
                while index < instructions.length {
                    local instruction = instructions[index]
                    if instruction.result != null { self.reserve("temp:" + instruction.result!.name, instruction.result!.typeName) }
                    if instruction.op == "declare_local" || instruction.op == "store_local" { self.reserve("name:" + instruction.name!, instruction.first!.typeName) }
                    index = index + 1
                }
                blockIndex = blockIndex + 1
            }
            local roots = new Array<ref Slot>(0)
            local slotIndex:i64 = 0
            while slotIndex < self.slots.length {
                local candidate = self.slots[slotIndex]
                if self.isManagedReferenceType(candidate.typeName) { roots.append(candidate) }
                slotIndex = slotIndex + 1
            }
            local rootRecordSize:i64 = 24
            local rootRecordOffset = self.slots.length * 8 + rootRecordSize
            local frameSize = self.align(rootRecordOffset, 16)
            local endLabel = self.currentFunctionSymbol + "__return"
            local rootTraceLabel = self.currentFunctionSymbol + "__gc_roots"
            self.writer.line(".globl " + self.currentFunctionSymbol)
            self.writer.line(self.currentFunctionSymbol + ":")
            self.writer.line("    push rbp")
            self.writer.line("    mov rbp, rsp")
            if frameSize > 0 { self.writer.line("    sub rsp, " + frameSize.toString()) }
            local clearOffset:i64 = 8
            while clearOffset <= frameSize {
                self.writer.line("    mov QWORD PTR [rbp-" + clearOffset.toString() + "], 0")
                clearOffset = clearOffset + 8
            }
            self.writer.line("    mov rax, QWORD PTR [rip+argon_gc_roots]")
            self.writer.line("    mov QWORD PTR [rbp-" + rootRecordOffset.toString() + "], rax")
            self.writer.line("    lea rax, [rip+" + rootTraceLabel + "]")
            self.writer.line("    mov QWORD PTR [rbp-" + (rootRecordOffset - 8).toString() + "], rax")
            self.writer.line("    mov QWORD PTR [rbp-" + (rootRecordOffset - 16).toString() + "], rbp")
            self.writer.line("    lea rax, [rbp-" + rootRecordOffset.toString() + "]")
            self.writer.line("    mov QWORD PTR [rip+argon_gc_roots], rax")
            parameterIndex = 0
            while parameterIndex < function.parameters.length {
                local destination = self.slot("name:" + function.parameters[parameterIndex].name)
                if parameterIndex < 6 {
                    self.writer.line("    mov " + destination + ", " + self.argumentRegister(parameterIndex))
                } else {
                    self.writer.line("    mov rax, QWORD PTR [rbp+" + (16 + (parameterIndex - 6) * 8).toString() + "]")
                    self.writer.line("    mov " + destination + ", rax")
                }
                parameterIndex = parameterIndex + 1
            }
            blockIndex = 0
            while blockIndex < function.blocks.length {
                local block = function.blocks[blockIndex]
                if block.label != "entry" { self.writer.line(self.blockLabel(block.label) + ":") }
                local index:i64 = 0
                while index < block.instructions.length {
                    self.generateInstruction(block.instructions[index], endLabel)
                    index = index + 1
                }
                blockIndex = blockIndex + 1
            }
            self.writer.line(endLabel + ":")
            self.writer.line("    mov rcx, QWORD PTR [rbp-" + rootRecordOffset.toString() + "]")
            self.writer.line("    mov QWORD PTR [rip+argon_gc_roots], rcx")
            self.writer.line("    leave")
            self.writer.line("    ret")
            self.writer.line(rootTraceLabel + ":")
            self.writer.line("    push rbx")
            self.writer.line("    mov rbx, rdi")
            slotIndex = 0
            while slotIndex < roots.length {
                self.writer.line("    mov rdi, QWORD PTR [rbx-" + roots[slotIndex].offset.toString() + "]")
                self.writer.line("    call argon_gc_mark")
                slotIndex = slotIndex + 1
            }
            self.writer.line("    pop rbx")
            self.writer.line("    ret")
            self.writer.line("")
        }

        generateInstruction(instruction:Ir.Instruction, endLabel:string) -> void {
            local op = instruction.op
            if op == "constant" {
                self.writer.line("    mov rax, " + instruction.text!)
                self.normalize("rax", instruction.typeName!)
                self.storeResult(instruction, "rax")
                return
            }
            if op == "string_constant" {
                local literal = self.findLiteral(instruction.text!)
                self.writer.line("    lea rax, [rip+" + literal!.descriptorLabel + "]")
                self.storeResult(instruction, "rax")
                return
            }
            if op == "declare_local" {
                if instruction.first == null {
                    self.writer.line("    mov QWORD PTR " + self.named(instruction.name!) + ", 0")
                } else {
                    self.load(instruction.first!, "rax")
                    self.writer.line("    mov " + self.named(instruction.name!) + ", rax")
                }
                return
            }
            if op == "load_local" {
                self.writer.line("    mov rax, " + self.named(instruction.name!))
                self.storeResult(instruction, "rax")
                return
            }
            if op == "store_local" {
                self.load(instruction.first!, "rax")
                self.writer.line("    mov " + self.named(instruction.name!) + ", rax")
                return
            }
            if op == "load_field" {
                local field = self.findField(instruction.name!)
                self.load(instruction.first!, "rax")
                self.loadMemory("[rax+" + field!.offset.toString() + "]", field!.typeName, "rax")
                if field!.ownership == "member-weak" {
                    local label = self.nextLabel
                    self.nextLabel = self.nextLabel + 1
                    self.writer.line("    test rax, rax")
                    self.writer.line("    jz .Lweak_done_" + label.toString())
                    self.writer.line("    cmp QWORD PTR [rax+8], 0")
                    self.writer.line("    jne .Lweak_done_" + label.toString())
                    self.writer.line("    xor eax, eax")
                    self.writer.line(".Lweak_done_" + label.toString() + ":")
                }
                self.storeResult(instruction, "rax")
                return
            }
            if op == "store_field" {
                local field = self.findField(instruction.name!)
                self.load(instruction.first!, "rax")
                self.load(instruction.second!, "rcx")
                self.writer.line("    mov " + self.memorySize(field!.typeName) + " PTR [rax+" + field!.offset.toString() + "], " + self.registerForSize("rcx", field!.typeName))
                return
            }
            if op == "unary" { self.generateUnary(instruction); return }
            if op == "binary" { self.generateBinary(instruction); return }
            if op == "allocate" {
                self.writer.line("    mov rdi, " + self.typeSize(instruction.ownerType!).toString())
                self.writer.line("    lea rsi, [rip+" + self.gcTraceLabel(instruction.ownerType!) + "]")
                self.writer.line("    lea rdx, [rip+" + self.gcWeakLabel(instruction.ownerType!) + "]")
                self.writer.line("    xor ecx, ecx")
                self.writer.line("    call argon_gc_alloc")
                self.writer.line("    lea rcx, [rip+" + self.typeLabel(instruction.ownerType!) + "]")
                self.writer.line("    mov QWORD PTR [rax], rcx")
                self.writer.line("    mov QWORD PTR [rax+8], 1")
                self.storeResult(instruction, "rax")
                return
            }
            if op == "destroy_object" {
                self.load(instruction.first!, "rax")
                local done = ".Ldestroy_null_" + self.nextLabel.toString(); self.nextLabel = self.nextLabel + 1
                self.writer.line("    test rax, rax"); self.writer.line("    je " + done)
                self.writer.line("    mov QWORD PTR [rax+8], 0"); self.writer.line(done + ":")
                return
            }
            if op == "destroy_array" {
                self.load(instruction.first!, "rdi")
                self.writer.line("    call " + self.arrayDestroyLabel(instruction.ownerType!))
                return
            }
            if op == "array_new" {
                self.writer.line("    mov rdi, " + self.sizeOf(instruction.elementType!).toString())
                self.load(instruction.first!, "rsi")
                self.writer.line("    lea rdx, [rip+" + self.gcArrayTraceLabel(instruction.result!.typeName) + "]")
                self.writer.line("    lea rcx, [rip+" + self.gcArrayWeakLabel(instruction.result!.typeName) + "]")
                self.writer.line("    call argon_gc_array_new")
                self.storeResult(instruction, "rax")
                return
            }
            if op == "array_length" {
                self.load(instruction.first!, "rax")
                self.writer.line("    mov rax, QWORD PTR [rax]")
                self.storeResult(instruction, "rax")
                return
            }
            if op == "array_load" || op == "string_load" {
                self.load(instruction.first!, "rdi")
                self.load(instruction.second!, "rsi")
                if op == "string_load" {
                    self.writer.line("    call argon_string_address")
                    self.writer.line("    movzx eax, BYTE PTR [rax]")
                } else {
                    self.writer.line("    mov rdx, " + self.sizeOf(instruction.elementType!).toString())
                    self.writer.line("    call argon_array_address")
                    self.loadMemory("[rax]", instruction.elementType!, "rax")
                    if instruction.elementOwnership != null { if instruction.elementOwnership! == "weak" {
                        local live = ".Lweak_array_live_" + self.nextLabel.toString(); self.nextLabel = self.nextLabel + 1
                        local done = ".Lweak_array_done_" + self.nextLabel.toString(); self.nextLabel = self.nextLabel + 1
                        self.writer.line("    test rax, rax"); self.writer.line("    je " + done)
                        self.writer.line("    cmp QWORD PTR [rax+8], 0"); self.writer.line("    jne " + live)
                        self.writer.line("    xor eax, eax"); self.writer.line("    jmp " + done)
                        self.writer.line(live + ":"); self.writer.line(done + ":")
                    } }
                }
                self.storeResult(instruction, "rax")
                return
            }
            if op == "array_store" {
                self.load(instruction.first!, "rdi")
                self.load(instruction.second!, "rsi")
                self.writer.line("    mov rdx, " + self.sizeOf(instruction.elementType!).toString())
                self.writer.line("    call argon_array_address")
                if instruction.elementOwnership != null { if instruction.elementOwnership! == "owned" {
                    local elementBase = self.baseType(instruction.elementType!)
                    if self.findProgramType(elementBase) != null {
                        local empty = ".Larray_replace_empty_" + self.nextLabel.toString(); self.nextLabel = self.nextLabel + 1
                        self.writer.line("    mov rdx, QWORD PTR [rax]"); self.writer.line("    test rdx, rdx"); self.writer.line("    je " + empty)
                        self.writer.line("    mov QWORD PTR [rdx+8], 0"); self.writer.line(empty + ":")
                    }
                } }
                self.load(instruction.third!, "rcx")
                self.writer.line("    mov " + self.memorySize(instruction.elementType!) + " PTR [rax], " + self.registerForSize("rcx", instruction.elementType!))
                return
            }
            if op == "array_append" {
                self.load(instruction.first!, "rdi")
                self.load(instruction.second!, "rsi")
                self.writer.line("    mov rdx, " + self.sizeOf(instruction.elementType!).toString())
                self.writer.line("    call argon_array_append")
                return
            }
            if op == "string_length" || op == "builder_length" {
                self.load(instruction.first!, "rax")
                if op == "string_length" { self.writer.line("    mov rax, QWORD PTR [rax+8]") } else { self.writer.line("    mov rax, QWORD PTR [rax]") }
                self.storeResult(instruction, "rax")
                return
            }
            if (op == "string_concat" || op == "string_equal") {
                self.load(instruction.first!, "rdi")
                self.load(instruction.second!, "rsi")
                if op == "string_concat" { self.writer.line("    call argon_string_concat") } else {
                    self.writer.line("    call argon_string_equal")
                    if instruction.operator! == "!=" { self.writer.line("    xor eax, 1") }
                }
                self.storeResult(instruction, "rax")
                return
            }
            if op == "structural_equal" {
                self.load(instruction.first!, "rdi")
                self.load(instruction.second!, "rsi")
                self.writer.line("    xor edx, edx")
                self.writer.line("    call " + self.equalityFunction(instruction.ownerType!))
                if instruction.operator! == "!=" { self.writer.line("    xor eax, 1") }
                self.storeResult(instruction, "rax")
                return
            }
            if op == "structural_hash" {
                self.load(instruction.first!, "rdi")
                self.writer.line("    xor esi, esi")
                self.writer.line("    call " + self.hashFunction(instruction.ownerType!))
                self.storeResult(instruction, "rax")
                return
            }
            if op == "structural_copy" {
                self.load(instruction.first!, "rdi")
                self.writer.line("    xor esi, esi")
                self.writer.line("    call " + self.copyFunction(instruction.ownerType!))
                self.storeResult(instruction, "rax")
                return
            }
            if op == "string_slice" {
                self.load(instruction.first!, "rdi")
                self.load(instruction.arguments[0], "rsi")
                self.load(instruction.arguments[1], "rdx")
                self.writer.line("    call argon_string_slice")
                self.storeResult(instruction, "rax")
                return
            }
            if op == "integer_to_string" {
                self.load(instruction.first!, "rdi")
                if self.isUnsigned(instruction.first!.typeName) { self.writer.line("    xor esi, esi") } else { self.writer.line("    mov esi, 1") }
                self.writer.line("    call argon_integer_to_string")
                self.storeResult(instruction, "rax")
                return
            }
            if op == "builder_new" {
                self.writer.line("    mov edi, 1")
                self.writer.line("    xor esi, esi")
                self.writer.line("    call argon_array_new")
                self.storeResult(instruction, "rax")
                return
            }
            if op == "builder_append_string" {
                self.load(instruction.first!, "rdi")
                self.load(instruction.second!, "rsi")
                self.writer.line("    call argon_builder_append_string")
                return
            }
            if op == "builder_append_byte" {
                self.load(instruction.first!, "rdi")
                self.load(instruction.second!, "rsi")
                self.writer.line("    mov edx, 1")
                self.writer.line("    call argon_array_append")
                return
            }
            if op == "builder_build" {
                self.load(instruction.first!, "rdi")
                self.writer.line("    call argon_builder_build")
                self.storeResult(instruction, "rax")
                return
            }
            if op == "call" { self.generateCall(instruction); return }
            if op == "virtual_call" { self.generateVirtualCall(instruction); return }
            if op == "contract_call" { self.generateContractCall(instruction); return }
            if op == "test_expect" {
                self.load(instruction.first!, "rax")
                local label = self.nextLabel
                self.nextLabel = self.nextLabel + 1
                self.writer.line("    test rax, rax")
                self.writer.line("    jnz .Ltest_pass_" + label.toString())
                self.writer.line("    inc QWORD PTR [rip+argon_test_failures]")
                self.writer.line("    mov eax, 1")
                self.writer.line("    mov edi, 2")
                self.writer.line("    lea rsi, [rip+argon_test_failure_message]")
                self.writer.line("    mov edx, 12")
                self.writer.line("    syscall")
                self.writer.line(".Ltest_pass_" + label.toString() + ":")
                return
            }
            if op == "test_failures" {
                self.writer.line("    mov rax, QWORD PTR [rip+argon_test_failures]")
                self.storeResult(instruction, "rax")
                return
            }
            if op == "type_test" || op == "checked_cast" {
                local label = self.nextLabel
                self.nextLabel = self.nextLabel + 1
                local loop = ".Ltype_test_" + label.toString()
                local matched = ".Ltype_match_" + label.toString()
                local done = ".Ltype_done_" + label.toString()
                local scan = ".Ltype_contract_" + label.toString()
                local next = ".Ltype_next_" + label.toString()
                self.load(instruction.first!, "rcx")
                self.writer.line("    xor eax, eax")
                self.writer.line("    test rcx, rcx")
                self.writer.line("    jz " + done)
                self.writer.line("    mov rdx, QWORD PTR [rcx]")
                self.writer.line("    lea r8, [rip+" + self.typeLabel(instruction.ownerType!) + "]")
                self.writer.line(loop + ":")
                self.writer.line("    test rdx, rdx")
                self.writer.line("    jz " + done)
                self.writer.line("    cmp rdx, r8")
                self.writer.line("    je " + matched)
                self.writer.line("    mov r9, QWORD PTR [rdx+8]")
                self.writer.line("    mov r10, QWORD PTR [r9]")
                self.writer.line("    add r9, 8")
                self.writer.line(scan + ":")
                self.writer.line("    test r10, r10")
                self.writer.line("    jz " + next)
                self.writer.line("    cmp QWORD PTR [r9], r8")
                self.writer.line("    je " + matched)
                self.writer.line("    add r9, 16")
                self.writer.line("    dec r10")
                self.writer.line("    jmp " + scan)
                self.writer.line(next + ":")
                self.writer.line("    mov rdx, QWORD PTR [rdx]")
                self.writer.line("    jmp " + loop)
                self.writer.line(matched + ":")
                if op == "type_test" { self.writer.line("    mov eax, 1") } else { self.writer.line("    mov rax, rcx") }
                self.writer.line(done + ":")
                self.storeResult(instruction, "rax")
                return
            }
            if op == "convert" {
                self.load(instruction.first!, "rax")
                self.normalize("rax", instruction.typeName!)
                self.storeResult(instruction, "rax")
                return
            }
            if op == "unwrap" {
                self.load(instruction.first!, "rax")
                self.writer.line("    test rax, rax")
                self.writer.line("    jz .Loptional_unwrap_error")
                self.storeResult(instruction, "rax")
                return
            }
            if op == "jump" { self.writer.line("    jmp " + self.blockLabel(instruction.target!)); return }
            if op == "branch" {
                self.load(instruction.first!, "rax")
                self.writer.line("    test rax, rax")
                self.writer.line("    jnz " + self.blockLabel(instruction.target!))
                self.writer.line("    jmp " + self.blockLabel(instruction.alternateTarget!))
                return
            }
            if op == "return" {
                if instruction.first == null { self.writer.line("    xor eax, eax") } else { self.load(instruction.first!, "rax") }
                self.writer.line("    jmp " + endLabel)
                return
            }
        }

        generateUnary(instruction:Ir.Instruction) -> void {
            self.load(instruction.first!, "rax")
            if instruction.operator! == "-" { self.writer.line("    neg rax") }
            if instruction.operator! == "!" {
                self.writer.line("    test rax, rax")
                self.writer.line("    sete al")
                self.writer.line("    movzx rax, al")
            }
            self.normalize("rax", instruction.typeName!)
            self.storeResult(instruction, "rax")
        }

        generateBinary(instruction:Ir.Instruction) -> void {
            self.load(instruction.first!, "rax")
            self.load(instruction.second!, "rcx")
            local operator = instruction.operator!
            if operator == "+" { self.writer.line("    add rax, rcx") }
            if operator == "-" { self.writer.line("    sub rax, rcx") }
            if operator == "*" { self.writer.line("    imul rax, rcx") }
            if operator == "&&" { self.writer.line("    and rax, rcx") }
            if operator == "||" { self.writer.line("    or rax, rcx") }
            if operator == "/" {
                self.writer.line("    test rcx, rcx")
                self.writer.line("    jz .Ldivision_by_zero_error")
                if self.isUnsigned(instruction.first!.typeName) { self.writer.line("    xor edx, edx"); self.writer.line("    div rcx") } else { self.writer.line("    cqo"); self.writer.line("    idiv rcx") }
            }
            if operator == "==" || operator == "!=" || operator == "===" || operator == "!==" || operator == "<" || operator == "<=" || operator == ">" || operator == ">=" {
                self.writer.line("    cmp rax, rcx")
                self.writer.line("    " + self.condition(operator, self.isUnsigned(instruction.first!.typeName)) + " al")
                self.writer.line("    movzx rax, al")
            }
            self.normalize("rax", instruction.typeName!)
            self.storeResult(instruction, "rax")
        }

        generateCall(instruction:Ir.Instruction) -> void {
            local index:i64 = 0
            while index < instruction.arguments.length {
                if index >= 6 { break }
                self.load(instruction.arguments[index], self.argumentRegister(index))
                index = index + 1
            }
            local stackCount = instruction.arguments.length - 6
            if stackCount < 0 { stackCount = 0 }
            local padding:i64 = 0
            if stackCount - (stackCount / 2) * 2 == 1 { padding = 8; self.writer.line("    sub rsp, 8") }
            index = instruction.arguments.length
            while index > 6 {
                index = index - 1
                self.load(instruction.arguments[index], "rax")
                self.writer.line("    push rax")
            }
            self.writer.line("    call " + self.functionSymbol(instruction.target!))
            local stackBytes = stackCount * 8 + padding
            if stackBytes > 0 { self.writer.line("    add rsp, " + stackBytes.toString()) }
            if instruction.result != null { self.storeResult(instruction, "rax") }
        }

        generateVirtualCall(instruction:Ir.Instruction) -> void {
            local index:i64 = 0
            while index < instruction.arguments.length {
                if index >= 6 { break }
                self.load(instruction.arguments[index], self.argumentRegister(index))
                index = index + 1
            }
            local stackCount = instruction.arguments.length - 6
            if stackCount < 0 { stackCount = 0 }
            local padding:i64 = 0
            if stackCount - (stackCount / 2) * 2 == 1 { padding = 8; self.writer.line("    sub rsp, 8") }
            index = instruction.arguments.length
            while index > 6 {
                index = index - 1
                self.load(instruction.arguments[index], "rax")
                self.writer.line("    push rax")
            }
            self.writer.line("    mov rax, QWORD PTR [rdi]")
            self.writer.line("    call QWORD PTR [rax+" + (40 + instruction.slot * 8).toString() + "]")
            local stackBytes = stackCount * 8 + padding
            if stackBytes > 0 { self.writer.line("    add rsp, " + stackBytes.toString()) }
            if instruction.result != null { self.storeResult(instruction, "rax") }
        }

        generateContractCall(instruction:Ir.Instruction) -> void {
            local index:i64 = 0
            while index < instruction.arguments.length {
                if index >= 6 { break }
                self.load(instruction.arguments[index], self.argumentRegister(index))
                index = index + 1
            }
            local stackCount = instruction.arguments.length - 6
            if stackCount < 0 { stackCount = 0 }
            local padding:i64 = 0
            if stackCount - (stackCount / 2) * 2 == 1 { padding = 8; self.writer.line("    sub rsp, 8") }
            index = instruction.arguments.length
            while index > 6 {
                index = index - 1
                self.load(instruction.arguments[index], "rax")
                self.writer.line("    push rax")
            }
            local label = self.nextLabel
            self.nextLabel = self.nextLabel + 1
            local loop = ".Lcontract_call_" + label.toString()
            local found = ".Lcontract_found_" + label.toString()
            self.writer.line("    mov rax, QWORD PTR [rdi]")
            self.writer.line("    mov rdx, QWORD PTR [rax+8]")
            self.writer.line("    mov rcx, QWORD PTR [rdx]")
            self.writer.line("    add rdx, 8")
            self.writer.line("    lea r8, [rip+" + self.typeLabel(instruction.ownerType!) + "]")
            self.writer.line(loop + ":")
            self.writer.line("    test rcx, rcx")
            self.writer.line("    jz .Lcontract_dispatch_error")
            self.writer.line("    cmp QWORD PTR [rdx], r8")
            self.writer.line("    je " + found)
            self.writer.line("    add rdx, 16")
            self.writer.line("    dec rcx")
            self.writer.line("    jmp " + loop)
            self.writer.line(found + ":")
            self.writer.line("    mov rax, QWORD PTR [rdx+8]")
            self.writer.line("    call QWORD PTR [rax+" + (instruction.slot * 8).toString() + "]")
            local stackBytes = stackCount * 8 + padding
            if stackBytes > 0 { self.writer.line("    add rsp, " + stackBytes.toString()) }
            if instruction.result != null { self.storeResult(instruction, "rax") }
        }

        generateMain() -> void {
            local entry = self.findFunction(self.program.entry!)
            local entrySize = self.typeSize(entry!.ownerType)
            self.writer.line(".globl main")
            self.writer.line("main:")
            self.writer.line("    push rbp")
            self.writer.line("    mov rbp, rsp")
            self.writer.line("    mov QWORD PTR [rip+argon_process_argc], rdi")
            self.writer.line("    mov QWORD PTR [rip+argon_process_argv], rsi")
            self.writer.line("    lea rax, [rsi+rdi*8+8]")
            self.writer.line("    mov QWORD PTR [rip+argon_process_envp], rax")
            self.writer.line("    sub rsp, 16")
            self.writer.line("    mov rdi, " + entrySize.toString())
            self.writer.line("    lea rsi, [rip+" + self.gcTraceLabel(entry!.ownerType) + "]")
            self.writer.line("    lea rdx, [rip+" + self.gcWeakLabel(entry!.ownerType) + "]")
            self.writer.line("    xor ecx, ecx")
            self.writer.line("    call argon_gc_alloc")
            self.writer.line("    lea rcx, [rip+" + self.typeLabel(entry!.ownerType) + "]")
            self.writer.line("    mov QWORD PTR [rax], rcx")
            self.writer.line("    mov QWORD PTR [rbp-8], rax")
            local typeNode = self.findProgramType(entry!.ownerType)
            if typeNode != null {
                if typeNode!.initializer != null {
                    self.writer.line("    mov rdi, QWORD PTR [rbp-8]")
                    self.writer.line("    call " + self.functionSymbol(typeNode!.initializer!))
                }
            }
            self.writer.line("    mov rdi, QWORD PTR [rbp-8]")
            self.writer.line("    call " + self.functionSymbol(entry!.name))
            self.writer.line("    leave")
            self.writer.line("    ret")
            self.writer.line("")
        }

        runtimeCore() -> void {
            self.writer.line(".Ldivision_by_zero_error:")
            self.writer.line("    mov edi, 73")
            self.writer.line("    jmp .Lruntime_error")
            self.writer.line(".Loptional_unwrap_error:")
            self.writer.line("    mov edi, 71")
            self.writer.line("    jmp .Lruntime_error")
            self.writer.line(".Lcontract_dispatch_error:")
            self.writer.line("    mov edi, 75")
            self.writer.line("    jmp .Lruntime_error")
            self.writer.line(".Lruntime_error:")
            self.writer.line("    mov eax, 60")
            self.writer.line("    syscall")
            self.writer.line("    ud2")
            self.writer.line("")
            self.writer.line(".globl argon_alloc")
            self.writer.line("argon_alloc:")
            self.writer.line("    test rdi, rdi")
            self.writer.line("    jnz .Lalloc_size")
            self.writer.line("    mov edi, 1")
            self.writer.line(".Lalloc_size:")
            self.writer.line("    mov rsi, rdi")
            self.writer.line("    xor edi, edi")
            self.writer.line("    mov edx, 3")
            self.writer.line("    mov r10d, 34")
            self.writer.line("    mov r8, -1")
            self.writer.line("    xor r9d, r9d")
            self.writer.line("    mov eax, 9")
            self.writer.line("    syscall")
            self.writer.line("    cmp rax, -4095")
            self.writer.line("    jae .Lallocation_error")
            self.writer.line("    ret")
            self.writer.line(".Lallocation_error:")
            self.writer.line("    mov edi, 72")
            self.writer.line("    jmp .Lruntime_error")
            self.writer.line("")
        }

        garbageCollectorRuntime() -> void {
            self.writer.line(".globl argon_gc_alloc"); self.writer.line("argon_gc_alloc:")
            self.writer.line("    push r12"); self.writer.line("    push r13"); self.writer.line("    push r14"); self.writer.line("    push r15")
            self.writer.line("    mov r12, rdi"); self.writer.line("    mov r13, rsi"); self.writer.line("    mov r14, rdx"); self.writer.line("    mov r15, rcx")
            self.writer.line("    add rdi, 48"); self.writer.line("    mov rsi, rdi"); self.writer.line("    xor edi, edi"); self.writer.line("    mov edx, 3"); self.writer.line("    mov r10d, 34"); self.writer.line("    mov r8, -1"); self.writer.line("    xor r9d, r9d"); self.writer.line("    mov eax, 9"); self.writer.line("    syscall")
            self.writer.line("    cmp rax, -4095"); self.writer.line("    jae .Lallocation_error"); self.writer.line("    mov rcx, QWORD PTR [rip+argon_gc_heap]"); self.writer.line("    mov QWORD PTR [rax], rcx")
            self.writer.line("    lea rcx, [r12+48]"); self.writer.line("    mov QWORD PTR [rax+8], rcx"); self.writer.line("    mov QWORD PTR [rax+16], r13"); self.writer.line("    mov QWORD PTR [rax+24], r14"); self.writer.line("    mov QWORD PTR [rax+32], 0"); self.writer.line("    mov QWORD PTR [rax+40], r15"); self.writer.line("    mov QWORD PTR [rip+argon_gc_heap], rax"); self.writer.line("    add QWORD PTR [rip+argon_gc_bytes], rcx"); self.writer.line("    add rax, 48")
            self.writer.line("    pop r15"); self.writer.line("    pop r14"); self.writer.line("    pop r13"); self.writer.line("    pop r12"); self.writer.line("    ret"); self.writer.line("")
            self.writer.line(".globl argon_gc_maybe_collect"); self.writer.line("argon_gc_maybe_collect:"); self.writer.line("    ret"); self.writer.line("")
            self.writer.line(".globl argon_gc_mark"); self.writer.line("argon_gc_mark:"); self.writer.line("    test rdi, rdi"); self.writer.line("    je .Lgc_mark_done"); self.writer.line("    cmp QWORD PTR [rdi+8], 0"); self.writer.line("    je .Lgc_mark_done"); self.writer.line("    push rbx"); self.writer.line("    mov rbx, rdi"); self.writer.line("    sub rbx, 48"); self.writer.line("    cmp QWORD PTR [rbx+32], 0"); self.writer.line("    jne .Lgc_mark_pop"); self.writer.line("    mov QWORD PTR [rbx+32], 1"); self.writer.line("    mov rax, QWORD PTR [rbx+16]"); self.writer.line("    test rax, rax"); self.writer.line("    je .Lgc_mark_pop"); self.writer.line("    call rax"); self.writer.line(".Lgc_mark_pop:"); self.writer.line("    pop rbx"); self.writer.line(".Lgc_mark_done:"); self.writer.line("    ret"); self.writer.line("")
            self.writer.line(".globl argon_gc_collect"); self.writer.line("argon_gc_collect:"); self.writer.line("    push rbp"); self.writer.line("    mov rbp, rsp"); self.writer.line("    push rbx"); self.writer.line("    push r12"); self.writer.line("    push r13"); self.writer.line("    push r14")
            self.writer.line("    mov r12, QWORD PTR [rip+argon_gc_roots]"); self.writer.line(".Lgc_root_frame:"); self.writer.line("    test r12, r12"); self.writer.line("    je .Lgc_weak_start"); self.writer.line("    mov rax, QWORD PTR [r12+8]"); self.writer.line("    mov rdi, QWORD PTR [r12+16]"); self.writer.line("    call rax"); self.writer.line("    mov r12, QWORD PTR [r12]"); self.writer.line("    jmp .Lgc_root_frame")
            self.writer.line(".Lgc_weak_start:"); self.writer.line("    mov r12, QWORD PTR [rip+argon_gc_heap]"); self.writer.line(".Lgc_weak_next:"); self.writer.line("    test r12, r12"); self.writer.line("    je .Lgc_sweep_start"); self.writer.line("    cmp QWORD PTR [r12+32], 0"); self.writer.line("    je .Lgc_weak_advance"); self.writer.line("    mov rax, QWORD PTR [r12+24]"); self.writer.line("    test rax, rax"); self.writer.line("    je .Lgc_weak_advance"); self.writer.line("    lea rdi, [r12+48]"); self.writer.line("    call rax"); self.writer.line(".Lgc_weak_advance:"); self.writer.line("    mov r12, QWORD PTR [r12]"); self.writer.line("    jmp .Lgc_weak_next")
            self.writer.line(".Lgc_sweep_start:"); self.writer.line("    lea r12, [rip+argon_gc_heap]"); self.writer.line("    mov QWORD PTR [rip+argon_gc_bytes], 0"); self.writer.line(".Lgc_sweep_next:"); self.writer.line("    mov rbx, QWORD PTR [r12]"); self.writer.line("    test rbx, rbx"); self.writer.line("    je .Lgc_done"); self.writer.line("    cmp QWORD PTR [rbx+32], 0"); self.writer.line("    je .Lgc_reclaim"); self.writer.line("    mov QWORD PTR [rbx+32], 0"); self.writer.line("    mov rax, QWORD PTR [rbx+8]"); self.writer.line("    add QWORD PTR [rip+argon_gc_bytes], rax"); self.writer.line("    mov r12, rbx"); self.writer.line("    jmp .Lgc_sweep_next")
            self.writer.line(".Lgc_reclaim:"); self.writer.line("    mov r14, QWORD PTR [rbx]"); self.writer.line("    mov QWORD PTR [r12], r14"); self.writer.line("    mov rax, QWORD PTR [rbx+40]"); self.writer.line("    test rax, rax"); self.writer.line("    je .Lgc_unmap"); self.writer.line("    lea rdi, [rbx+48]"); self.writer.line("    call rax"); self.writer.line(".Lgc_unmap:"); self.writer.line("    mov rsi, QWORD PTR [rbx+8]"); self.writer.line("    mov rdi, rbx"); self.writer.line("    mov eax, 11"); self.writer.line("    syscall"); self.writer.line("    jmp .Lgc_sweep_next")
            self.writer.line(".Lgc_done:"); self.writer.line("    mov rax, QWORD PTR [rip+argon_gc_bytes]"); self.writer.line("    shl rax, 1"); self.writer.line("    cmp rax, 1048576"); self.writer.line("    jae .Lgc_threshold_store"); self.writer.line("    mov eax, 1048576"); self.writer.line(".Lgc_threshold_store:"); self.writer.line("    mov QWORD PTR [rip+argon_gc_threshold], rax"); self.writer.line("    pop r14"); self.writer.line("    pop r13"); self.writer.line("    pop r12"); self.writer.line("    pop rbx"); self.writer.line("    leave"); self.writer.line("    ret"); self.writer.line("")
            self.writer.line(".globl argon_gc_array_new"); self.writer.line("argon_gc_array_new:"); self.writer.line("    push rbx"); self.writer.line("    push r12"); self.writer.line("    push r13"); self.writer.line("    push r14"); self.writer.line("    mov r12, rdi"); self.writer.line("    mov r13, rsi"); self.writer.line("    mov r14, rdx"); self.writer.line("    push rcx"); self.writer.line("    mov edi, 40"); self.writer.line("    mov rsi, r14"); self.writer.line("    mov rdx, QWORD PTR [rsp]"); self.writer.line("    lea rcx, [rip+argon_gc_array_finalize]"); self.writer.line("    call argon_gc_alloc"); self.writer.line("    add rsp, 8"); self.writer.line("    mov rbx, rax"); self.writer.line("    mov rax, r13"); self.writer.line("    cmp rax, 4"); self.writer.line("    jae .Lgc_array_capacity"); self.writer.line("    mov eax, 4"); self.writer.line(".Lgc_array_capacity:"); self.writer.line("    mov QWORD PTR [rbx], r13"); self.writer.line("    mov QWORD PTR [rbx+8], rax"); self.writer.line("    mov QWORD PTR [rbx+24], r12"); self.writer.line("    mov QWORD PTR [rbx+32], 1"); self.writer.line("    imul rax, r12"); self.writer.line("    mov rdi, rax"); self.writer.line("    call argon_alloc"); self.writer.line("    mov QWORD PTR [rbx+16], rax"); self.writer.line("    mov rax, rbx"); self.writer.line("    pop r14"); self.writer.line("    pop r13"); self.writer.line("    pop r12"); self.writer.line("    pop rbx"); self.writer.line("    ret"); self.writer.line("argon_gc_array_finalize:"); self.writer.line("    mov rsi, QWORD PTR [rdi+8]"); self.writer.line("    imul rsi, QWORD PTR [rdi+24]"); self.writer.line("    test rsi, rsi"); self.writer.line("    jne .Lgc_array_finalize_size"); self.writer.line("    mov esi, 1"); self.writer.line(".Lgc_array_finalize_size:"); self.writer.line("    mov rdi, QWORD PTR [rdi+16]"); self.writer.line("    mov eax, 11"); self.writer.line("    syscall"); self.writer.line("    ret"); self.writer.line("")
            self.writer.line(".globl argon_System_collectGarbage"); self.writer.line("argon_System_collectGarbage:"); self.writer.line("    jmp argon_gc_collect"); self.writer.line("")
        }

        gcTraceFunctions() -> void {
            local typeIndex:i64 = 0
            while typeIndex < self.program.types.length {
                local typeNode = self.program.types[typeIndex]
                self.writer.line(self.gcTraceLabel(typeNode.name) + ":"); self.writer.line("    push rbx"); self.writer.line("    mov rbx, rdi")
                local fieldIndex:i64 = 0
                while fieldIndex < typeNode.fields.length {
                    local field = typeNode.fields[fieldIndex]
                    if field.ownership != "member-weak" && self.isManagedReferenceType(field.typeName) {
                        local layout = self.findField(field.qualifiedName)
                        self.writer.line("    mov rdi, QWORD PTR [rbx+" + layout!.offset.toString() + "]"); self.writer.line("    call argon_gc_mark")
                    }
                    fieldIndex = fieldIndex + 1
                }
                self.writer.line("    pop rbx"); self.writer.line("    ret"); self.writer.line(self.gcWeakLabel(typeNode.name) + ":"); self.writer.line("    push rbx"); self.writer.line("    mov rbx, rdi")
                fieldIndex = 0
                while fieldIndex < typeNode.fields.length {
                    local field = typeNode.fields[fieldIndex]
                    if field.ownership == "member-weak" {
                        local layout = self.findField(field.qualifiedName)
                        local keep = ".Lgc_weak_keep_" + self.nextLabel.toString(); self.nextLabel = self.nextLabel + 1
                        self.writer.line("    mov rax, QWORD PTR [rbx+" + layout!.offset.toString() + "]"); self.writer.line("    test rax, rax"); self.writer.line("    je " + keep); self.writer.line("    sub rax, 48"); self.writer.line("    cmp QWORD PTR [rax+32], 0"); self.writer.line("    jne " + keep); self.writer.line("    mov QWORD PTR [rbx+" + layout!.offset.toString() + "], 0"); self.writer.line(keep + ":")
                    }
                    fieldIndex = fieldIndex + 1
                }
                self.writer.line("    pop rbx"); self.writer.line("    ret"); self.writer.line("")
                typeIndex = typeIndex + 1
            }
            local arrays = self.structuralArrayTypes()
            local arrayIndex:i64 = 0
            while arrayIndex < arrays.length {
                local arrayType = arrays[arrayIndex]
                local spec = arrayType.slice(6, arrayType.length - 7)
                local ownership = "owned"
                local element = spec
                if spec.length > 4 { if spec.slice(0, 4) == "ref " { ownership = "ref"; element = spec.slice(4, spec.length - 4) } }
                if spec.length > 5 { if spec.slice(0, 5) == "weak " { ownership = "weak"; element = spec.slice(5, spec.length - 5) } }
                local trace = self.gcArrayTraceLabel(arrayType)
                local traceLoop = trace + "_loop"
                local traceDone = trace + "_done"
                self.writer.line(trace + ":"); self.writer.line("    push rbx"); self.writer.line("    push r12"); self.writer.line("    xor ebx, ebx"); self.writer.line("    mov r12, rdi")
                if ownership != "weak" && self.isManagedReferenceType(element) {
                    self.writer.line(traceLoop + ":"); self.writer.line("    cmp rbx, QWORD PTR [r12]"); self.writer.line("    jae " + traceDone); self.writer.line("    imul rax, rbx, " + self.sizeOf(element).toString()); self.writer.line("    add rax, QWORD PTR [r12+16]"); self.writer.line("    mov rdi, QWORD PTR [rax]"); self.writer.line("    call argon_gc_mark"); self.writer.line("    inc rbx"); self.writer.line("    jmp " + traceLoop)
                }
                self.writer.line(traceDone + ":"); self.writer.line("    pop r12"); self.writer.line("    pop rbx"); self.writer.line("    ret")
                local weakLabel = self.gcArrayWeakLabel(arrayType)
                local weakLoop = weakLabel + "_loop"
                local weakNext = weakLabel + "_next"
                local weakDone = weakLabel + "_done"
                self.writer.line(weakLabel + ":"); self.writer.line("    push rbx"); self.writer.line("    push r12"); self.writer.line("    xor ebx, ebx"); self.writer.line("    mov r12, rdi")
                if ownership == "weak" && self.isManagedReferenceType(element) {
                    self.writer.line(weakLoop + ":"); self.writer.line("    cmp rbx, QWORD PTR [r12]"); self.writer.line("    jae " + weakDone); self.writer.line("    imul rax, rbx, " + self.sizeOf(element).toString()); self.writer.line("    add rax, QWORD PTR [r12+16]"); self.writer.line("    mov rcx, QWORD PTR [rax]"); self.writer.line("    test rcx, rcx"); self.writer.line("    je " + weakNext); self.writer.line("    sub rcx, 48"); self.writer.line("    cmp QWORD PTR [rcx+32], 0"); self.writer.line("    jne " + weakNext); self.writer.line("    mov QWORD PTR [rax], 0"); self.writer.line(weakNext + ":"); self.writer.line("    inc rbx"); self.writer.line("    jmp " + weakLoop); self.writer.line(weakDone + ":")
                }
                self.writer.line("    pop r12"); self.writer.line("    pop rbx"); self.writer.line("    ret"); self.writer.line("")
                arrayIndex = arrayIndex + 1
            }
        }

        arrayRuntime() -> void {
            self.writer.line(".globl argon_array_new")
            self.writer.line("argon_array_new:")
            self.writer.line("    push rbp")
            self.writer.line("    mov rbp, rsp")
            self.writer.line("    push rbx")
            self.writer.line("    push r12")
            self.writer.line("    push r13")
            self.writer.line("    sub rsp, 8")
            self.writer.line("    mov r12, rdi")
            self.writer.line("    mov rbx, rsi")
            self.writer.line("    test rbx, rbx")
            self.writer.line("    js .Larray_bounds_error")
            self.writer.line("    mov edi, 40")
            self.writer.line("    xor esi, esi")
            self.writer.line("    xor edx, edx")
            self.writer.line("    lea rcx, [rip+argon_gc_array_finalize]")
            self.writer.line("    call argon_gc_alloc")
            self.writer.line("    mov r13, rax")
            self.writer.line("    mov rax, rbx")
            self.writer.line("    cmp rax, 4")
            self.writer.line("    jae .Larray_new_capacity")
            self.writer.line("    mov eax, 4")
            self.writer.line(".Larray_new_capacity:")
            self.writer.line("    mov QWORD PTR [r13], rbx")
            self.writer.line("    mov QWORD PTR [r13+8], rax")
            self.writer.line("    mov QWORD PTR [r13+24], r12")
            self.writer.line("    mov QWORD PTR [r13+32], 1")
            self.writer.line("    imul rax, r12")
            self.writer.line("    mov rdi, rax")
