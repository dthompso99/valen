import Ir from './libIr.ar'
import System from './libSystem.ar'

library X86_64 {{
    Writer {{
        member builder:StringBuilder
        member optimize:bool

        __() -> void { self.builder = new StringBuilder(); self.optimize = false }
        line(value:string) -> void {
            if self.optimize {
                if value == "    add rax, 0" || value == "    sub rax, 0" || value == "    shl rax, 0" || value == "    shr rax, 0" || value == "    sar rax, 0" || value == "    imul rax, 1" { return }
                if self.redundantMove(value) { return }
            }
            self.builder.append(value); self.builder.appendByte(10)
        }
        build() -> string { return self.builder.build() }

        redundantMove(value:string) -> bool {
            if value.length < 14 || value.slice(0, 8) != "    mov " { return false }
            local comma:i64 = 8
            while comma < value.length && value[comma] != 44 { comma = comma + 1 }
            if comma == value.length || comma + 2 >= value.length { return false }
            local left = value.slice(8, comma - 8)
            local right = value.slice(comma + 2, value.length - comma - 2)
            if left != right { return false }
            return left == "rax" || left == "rbx" || left == "rcx" || left == "rdx" || left == "rsi" || left == "rdi" || left == "rbp" || left == "rsp" || left == "r8" || left == "r9" || left == "r10" || left == "r11" || left == "r12" || left == "r13" || left == "r14" || left == "r15"
        }
    }}

    FunctionSymbol {{
        member name:string
        member assemblyName:string
        __(name:string, assemblyName:string) -> void { self.name = name; self.assemblyName = assemblyName }
    }}

    FieldLayout {{
        member name:string
        member typeName:string
        member ownership:string
        member offset:i64
        __(name:string, typeName:string, ownership:string, offset:i64) -> void { self.name = name; self.typeName = typeName; self.ownership = ownership; self.offset = offset }
    }}

    TypeLayout {{
        member name:string
        member size:i64
        __(name:string, size:i64) -> void { self.name = name; self.size = size }
    }}

    Literal {{
        member value:string
        member dataLabel:string
        member descriptorLabel:string
        __(value:string, dataLabel:string, descriptorLabel:string) -> void {
            self.value = value
            self.dataLabel = dataLabel
            self.descriptorLabel = descriptorLabel
        }
    }}

    Slot {{
        member key:string
        member offset:i64
        member typeName:string
        __(key:string, offset:i64, typeName:string) -> void { self.key = key; self.offset = offset; self.typeName = typeName }
    }}

    Allocation {{
        member name:string
        member start:i64
        member end:i64
        member registerName:string
        __(name:string, start:i64) -> void { self.name = name; self.start = start; self.end = start; self.registerName = "" }
    }}

    Immediate {{
        member name:string
        member value:i64
        __(name:string, value:i64) -> void { self.name = name; self.value = value }
    }}

    Backend {{
        member program:Ir.Program
        member writer:Writer
        member functionSymbols:Array<FunctionSymbol>
        member fields:Array<FieldLayout>
        member types:Array<TypeLayout>
        member literals:Array<Literal>
        member floatLiterals:Array<Literal>
        member slots:Array<Slot>
        member allocations:Array<Allocation>
        member immediates:Array<Immediate>
        member currentFunctionSymbol:string
        member nextLabel:i64
        member usesPrint:bool
        member usesWrite:bool
        member usesWriteError:bool
        member optimize:bool

        __(program:Ir.Program, optimizationLevel:i64=1) -> void {
            self.program = program
            self.writer = new Writer()
            self.functionSymbols = new Array<FunctionSymbol>(0)
            self.fields = new Array<FieldLayout>(0)
            self.types = new Array<TypeLayout>(0)
            self.literals = new Array<Literal>(0)
            self.floatLiterals = new Array<Literal>(0)
            self.slots = new Array<Slot>(0)
            self.allocations = new Array<Allocation>(0)
            self.immediates = new Array<Immediate>(0)
            self.currentFunctionSymbol = ""
            self.nextLabel = 0
            self.usesPrint = false
            self.usesWrite = false
            self.usesWriteError = false
            self.optimize = optimizationLevel == 1
        }

        generate() -> string {
            self.layoutTypes()
            self.declareSymbols()
            self.scanProgram()
            self.writer.line(".intel_syntax noprefix")
            self.writer.line(".text")
            local index:i64 = 0
            while index < self.program.externals.length {
                if self.program.externals[index].foreignLibrary != null { self.writer.line(".extern " + self.program.externals[index].runtimeName) }
                index = index + 1
            }
            if self.hasRuntime("valen_Operations_threadStart") { self.writer.line(".extern pthread_create"); self.writer.line(".extern pthread_join") }
            self.writer.optimize = self.optimize
            index = 0
            while index < self.program.functions.length {
                self.generateFunction(self.program.functions[index])
                index = index + 1
            }
            self.writer.optimize = false
            self.generateMain()
            self.structuralRuntime()
            if self.usesPrint { self.printRuntime() }
            if self.usesWrite { self.writeRuntime("valen_System_write", 1) }
            if self.usesWriteError { self.writeRuntime("valen_System_writeError", 2) }
            self.processRuntime()
            self.linkRuntime()
            self.filesystemRuntime()
            self.networkRuntime()
            self.memoryRuntime()
            if self.hasRuntime("valen_EventLoop_available") { self.ioRuntime() }
            if self.hasRuntime("valen_Operations_threadAvailable") { self.operationsRuntime() }
            self.runtimeCore()
            self.garbageCollectorRuntime()
            self.arrayRuntime()
            self.gcTraceFunctions()
            self.stringRuntime()
            self.builderRuntime()
            self.stringData()
            self.floatData()
            self.floatConversionData()
            self.runtimeData()
            self.typeData()
            self.writer.line(".section .rodata")
            self.writer.line("valen_test_failure_message:")
            self.writer.line("    .byte 116,101,115,116,32,102,97,105,108,101,100,10")
            self.writer.line(".comm valen_test_failures,8,8")
            self.writer.line(".section .note.GNU-stack,\"\",@progbits")
            return self.writer.build()
        }

        hasRuntime(name:string) -> bool {
            local index:i64 = 0
            while index < self.program.externals.length {
                if self.program.externals[index].runtimeName == name { return true }
                index = index + 1
            }
            return false
        }

        validateRuntime() -> Array<string> {
            local errors = new Array<string>(0)
            local index:i64 = 0
            while index < self.program.externals.length {
                local external = self.program.externals[index]
                if external.foreignLibrary == null {
                    if !self.supportsRuntime(external.runtimeName) {
                        errors.append("x86_64-linux runtime does not provide " + external.runtimeName)
                    }
                }
                index = index + 1
            }
            return errors
        }

        supportsRuntime(name:string) -> bool {
            if name == "valen_System_print" || name == "valen_System_arguments" || name == "valen_System_exit" || name == "valen_System_write" || name == "valen_System_writeError" { return true }
            if name == "valen_System_openRead" || name == "valen_System_openWrite" || name == "valen_System_read" || name == "valen_System_writeFile" || name == "valen_System_writeBytes" || name == "valen_System_sync" { return true }
            if name == "valen_System_close" || name == "valen_System_replaceFile" || name == "valen_System_removeFile" { return true }
            if name == "valen_System_lastError" || name == "valen_System_currentDirectory" || name == "valen_System_environmentVariable" || name == "valen_System_collectGarbage" { return true }
            if name == "valen_System_enableProcessArena" || name == "valen_System_enableShutdownSignals" || name == "valen_System_shutdownRequested" { return true }
            if name == "valen_System_link" || name == "valen_System_memoryCopy" || name == "valen_System_memoryCompare" { return true }
            if name == "valen_System_fileDescriptor" || name == "valen_System_makeFileNonblocking" { return true }
            if name == "valen_Operations_threadAvailable" || name == "valen_Operations_threadStart" || name == "valen_Operations_threadJoin" { return true }
            if name == "valen_Operations_mutexLock" || name == "valen_Operations_mutexUnlock" || name == "valen_Operations_conditionWait" { return true }
            if name == "valen_Operations_conditionNotifyOne" || name == "valen_Operations_conditionNotifyAll" || name == "valen_Operations_atomicLoad" { return true }
            if name == "valen_Network_listen" || name == "valen_Network_accept" || name == "valen_Network_receive" || name == "valen_Network_send" || name == "valen_Network_sendSome" { return true }
            if name == "valen_Network_closeListener" || name == "valen_Network_closeConnection" || name == "valen_Network_lastError" { return true }
            if name == "valen_Network_listenerDescriptor" || name == "valen_Network_connectionDescriptor" { return true }
            if name == "valen_Network_makeListenerNonblocking" || name == "valen_Network_makeConnectionNonblocking" { return true }
            if name == "valen_EventLoop_available" || name == "valen_EventLoop_wait" || name == "valen_EventLoop_monotonicMilliseconds" { return true }
            return name == "valen_Operations_atomicStore" || name == "valen_Operations_atomicExchange" || name == "valen_Operations_atomicCompareExchange" || name == "valen_Operations_atomicAdd"
        }

        operationsRuntime() -> void {
            local mutex = ""
            local condition = ""
            local atomic = ""
            local handle = ""
            local index:i64 = 0
            while index < self.fields.length {
                local fieldName = self.fields[index].name
                if fieldName.length >= 11 { if fieldName.slice(fieldName.length - 11, 11) == "Mutex.state" { mutex = self.fields[index].offset.toString() } }
                if fieldName.length >= 18 { if fieldName.slice(fieldName.length - 18, 18) == "Condition.sequence" { condition = self.fields[index].offset.toString() } }
                if fieldName.length >= 12 { if fieldName.slice(fieldName.length - 12, 12) == "Atomic.value" { atomic = self.fields[index].offset.toString() } }
                if fieldName.length >= 22 { if fieldName.slice(fieldName.length - 22, 22) == "ThreadOperation.handle" { handle = self.fields[index].offset.toString() } }
                index = index + 1
            }
            local worker = ""
            index = 0
            while index < self.program.functions.length {
                local displayName = self.program.functions[index].displayName
                if displayName.length >= 10 {
                    if displayName.slice(displayName.length - 10, 10) == ".runWorker" { worker = self.functionSymbol(self.program.functions[index].name) }
                }
                index = index + 1
            }
            if mutex.length == 0 || condition.length == 0 || atomic.length == 0 || handle.length == 0 || worker.length == 0 { return }

            self.writer.line(".globl valen_Operations_threadAvailable"); self.writer.line("valen_Operations_threadAvailable:"); self.writer.line("    mov eax, 1"); self.writer.line("    ret"); self.writer.line("")
            self.writer.line(".globl valen_Operations_threadStart"); self.writer.line("valen_Operations_threadStart:"); self.writer.line("    push rbx"); self.writer.line("    mov rbx, rdi"); self.writer.line("    lea rdi, [rbx+" + handle + "]"); self.writer.line("    xor esi, esi"); self.writer.line("    lea rdx, [rip+valen_thread_worker]"); self.writer.line("    mov rcx, rbx"); self.writer.line("    call pthread_create"); self.writer.line("    test eax, eax"); self.writer.line("    sete al"); self.writer.line("    movzx eax, al"); self.writer.line("    pop rbx"); self.writer.line("    ret"); self.writer.line("")
            self.writer.line("valen_thread_worker:"); self.writer.line("    push rbx"); self.writer.line("    mov rbx, rdi"); self.writer.line("    mov rdi, rbx"); self.writer.line("    call " + worker); self.writer.line("    xor eax, eax"); self.writer.line("    pop rbx"); self.writer.line("    ret"); self.writer.line("")
            self.writer.line(".globl valen_Operations_threadJoin"); self.writer.line("valen_Operations_threadJoin:"); self.writer.line("    push rax"); self.writer.line("    mov rdi, QWORD PTR [rdi+" + handle + "]"); self.writer.line("    xor esi, esi"); self.writer.line("    call pthread_join"); self.writer.line("    pop rcx"); self.writer.line("    ret"); self.writer.line("")

            self.writer.line(".globl valen_Operations_mutexLock"); self.writer.line("valen_Operations_mutexLock:"); self.writer.line("    push r12"); self.writer.line("    lea r12, [rdi+" + mutex + "]"); self.writer.line(".Lvalen_mutex_retry:"); self.writer.line("    xor eax, eax"); self.writer.line("    mov ecx, 1"); self.writer.line("    lock cmpxchg DWORD PTR [r12], ecx"); self.writer.line("    je .Lvalen_mutex_locked"); self.writer.line("    mov eax, 202"); self.writer.line("    mov rdi, r12"); self.writer.line("    xor esi, esi"); self.writer.line("    mov edx, 1"); self.writer.line("    xor r10d, r10d"); self.writer.line("    xor r8d, r8d"); self.writer.line("    xor r9d, r9d"); self.writer.line("    syscall"); self.writer.line("    jmp .Lvalen_mutex_retry"); self.writer.line(".Lvalen_mutex_locked:"); self.writer.line("    pop r12"); self.writer.line("    ret"); self.writer.line("")
            self.writer.line(".globl valen_Operations_mutexUnlock"); self.writer.line("valen_Operations_mutexUnlock:"); self.writer.line("    lea rdi, [rdi+" + mutex + "]"); self.writer.line("    mov DWORD PTR [rdi], 0"); self.writer.line("    mov eax, 202"); self.writer.line("    mov esi, 1"); self.writer.line("    mov edx, 1"); self.writer.line("    xor r10d, r10d"); self.writer.line("    xor r8d, r8d"); self.writer.line("    xor r9d, r9d"); self.writer.line("    syscall"); self.writer.line("    ret"); self.writer.line("")

            self.writer.line(".globl valen_Operations_conditionWait"); self.writer.line("valen_Operations_conditionWait:"); self.writer.line("    push r12"); self.writer.line("    push r13"); self.writer.line("    push r14"); self.writer.line("    mov r12, rdi"); self.writer.line("    mov r13, rsi"); self.writer.line("    mov r14d, DWORD PTR [r12+" + condition + "]"); self.writer.line("    mov rdi, r13"); self.writer.line("    call valen_Operations_mutexUnlock"); self.writer.line("    mov eax, 202"); self.writer.line("    lea rdi, [r12+" + condition + "]"); self.writer.line("    xor esi, esi"); self.writer.line("    mov edx, r14d"); self.writer.line("    xor r10d, r10d"); self.writer.line("    xor r8d, r8d"); self.writer.line("    xor r9d, r9d"); self.writer.line("    syscall"); self.writer.line("    mov rdi, r13"); self.writer.line("    call valen_Operations_mutexLock"); self.writer.line("    pop r14"); self.writer.line("    pop r13"); self.writer.line("    pop r12"); self.writer.line("    ret"); self.writer.line("")
            self.writer.line(".globl valen_Operations_conditionNotifyOne"); self.writer.line("valen_Operations_conditionNotifyOne:"); self.conditionNotifyRuntime(condition, "1")
            self.writer.line(".globl valen_Operations_conditionNotifyAll"); self.writer.line("valen_Operations_conditionNotifyAll:"); self.conditionNotifyRuntime(condition, "2147483647")

            self.writer.line(".globl valen_Operations_atomicLoad"); self.writer.line("valen_Operations_atomicLoad:"); self.writer.line("    mov rax, QWORD PTR [rdi+" + atomic + "]"); self.writer.line("    ret"); self.writer.line("")
            self.writer.line(".globl valen_Operations_atomicStore"); self.writer.line("valen_Operations_atomicStore:"); self.writer.line("    xchg QWORD PTR [rdi+" + atomic + "], rsi"); self.writer.line("    ret"); self.writer.line("")
            self.writer.line(".globl valen_Operations_atomicExchange"); self.writer.line("valen_Operations_atomicExchange:"); self.writer.line("    mov rax, rsi"); self.writer.line("    xchg QWORD PTR [rdi+" + atomic + "], rax"); self.writer.line("    ret"); self.writer.line("")
            self.writer.line(".globl valen_Operations_atomicCompareExchange"); self.writer.line("valen_Operations_atomicCompareExchange:"); self.writer.line("    mov rax, rsi"); self.writer.line("    lock cmpxchg QWORD PTR [rdi+" + atomic + "], rdx"); self.writer.line("    sete al"); self.writer.line("    movzx eax, al"); self.writer.line("    ret"); self.writer.line("")
            self.writer.line(".globl valen_Operations_atomicAdd"); self.writer.line("valen_Operations_atomicAdd:"); self.writer.line("    mov rax, rsi"); self.writer.line("    lock xadd QWORD PTR [rdi+" + atomic + "], rax"); self.writer.line("    add rax, rsi"); self.writer.line("    ret"); self.writer.line("")
        }

        ioRuntime() -> void {
            self.writer.line(".globl valen_EventLoop_available"); self.writer.line("valen_EventLoop_available:"); self.writer.line("    mov eax, 1"); self.writer.line("    ret"); self.writer.line("")
            self.writer.line(".globl valen_EventLoop_wait"); self.writer.line("valen_EventLoop_wait:")
            self.writer.line("    push rbx"); self.writer.line("    push r12"); self.writer.line("    push r13"); self.writer.line("    push r14"); self.writer.line("    push r15")
            self.writer.line("    mov r12, QWORD PTR [rdi]"); self.writer.line("    cmp r12, QWORD PTR [rsi]"); self.writer.line("    jne .Lio_wait_early")
            self.writer.line("    test r12, r12"); self.writer.line("    je .Lio_wait_early"); self.writer.line("    mov r13, QWORD PTR [rdi+16]")
            self.writer.line("    mov r14, QWORD PTR [rsi+16]"); self.writer.line("    mov r15, rdx"); self.writer.line("    lea rdi, [r12*8]"); self.writer.line("    call valen_alloc")
            self.writer.line("    mov rbx, rax"); self.writer.line("    xor ecx, ecx"); self.writer.line(".Lio_wait_fill:"); self.writer.line("    cmp rcx, r12"); self.writer.line("    jae .Lio_wait_poll")
            self.writer.line("    mov rax, QWORD PTR [r13+rcx*8]"); self.writer.line("    mov DWORD PTR [rbx+rcx*8], eax")
            self.writer.line("    mov rax, QWORD PTR [r14+rcx*8]"); self.writer.line("    mov WORD PTR [rbx+rcx*8+4], ax"); self.writer.line("    mov WORD PTR [rbx+rcx*8+6], 0")
            self.writer.line("    inc rcx"); self.writer.line("    jmp .Lio_wait_fill"); self.writer.line(".Lio_wait_poll:")
            self.writer.line("    mov eax, 7"); self.writer.line("    mov rdi, rbx"); self.writer.line("    mov rsi, r12"); self.writer.line("    mov rdx, r15"); self.writer.line("    syscall")
            self.writer.line("    test rax, rax"); self.writer.line("    jle .Lio_wait_none"); self.writer.line("    xor ecx, ecx"); self.writer.line(".Lio_wait_scan:")
            self.writer.line("    cmp rcx, r12"); self.writer.line("    jae .Lio_wait_none"); self.writer.line("    cmp WORD PTR [rbx+rcx*8+6], 0"); self.writer.line("    jne .Lio_wait_ready")
            self.writer.line("    inc rcx"); self.writer.line("    jmp .Lio_wait_scan"); self.writer.line(".Lio_wait_ready:"); self.writer.line("    mov rax, rcx"); self.writer.line("    jmp .Lio_wait_cleanup")
            self.writer.line(".Lio_wait_none:"); self.writer.line("    mov rax, -1"); self.writer.line(".Lio_wait_cleanup:"); self.writer.line("    mov r13, rax")
            self.writer.line("    mov rdi, rbx"); self.writer.line("    lea rsi, [r12*8]"); self.writer.line("    mov eax, 11"); self.writer.line("    syscall"); self.writer.line("    mov rax, r13"); self.writer.line("    jmp .Lio_wait_done")
            self.writer.line(".Lio_wait_early:"); self.writer.line("    mov rax, -1"); self.writer.line(".Lio_wait_done:")
            self.writer.line("    pop r15"); self.writer.line("    pop r14"); self.writer.line("    pop r13"); self.writer.line("    pop r12"); self.writer.line("    pop rbx"); self.writer.line("    ret"); self.writer.line("")
            self.writer.line(".globl valen_EventLoop_monotonicMilliseconds")
            self.writer.line("valen_EventLoop_monotonicMilliseconds:")
            self.writer.line("    sub rsp, 24")
            self.writer.line("    mov eax, 228")
            self.writer.line("    mov edi, 1")
            self.writer.line("    mov rsi, rsp")
            self.writer.line("    syscall")
            self.writer.line("    test rax, rax")
            self.writer.line("    js .Lmonotonic_error")
            self.writer.line("    mov r8, QWORD PTR [rsp]")
            self.writer.line("    imul r8, r8, 1000")
            self.writer.line("    mov rax, QWORD PTR [rsp+8]")
            self.writer.line("    cqo")
            self.writer.line("    mov rcx, 1000000")
            self.writer.line("    idiv rcx")
            self.writer.line("    add rax, r8")
            self.writer.line("    add rsp, 24")
            self.writer.line("    ret")
            self.writer.line(".Lmonotonic_error:")
            self.writer.line("    mov rax, -1")
            self.writer.line("    add rsp, 24")
            self.writer.line("    ret")
            self.writer.line("")
        }

        conditionNotifyRuntime(offset:string, count:string) -> void {
            self.writer.line("    lea rdi, [rdi+" + offset + "]"); self.writer.line("    lock add DWORD PTR [rdi], 1"); self.writer.line("    mov eax, 202"); self.writer.line("    mov esi, 1"); self.writer.line("    mov edx, " + count); self.writer.line("    xor r10d, r10d"); self.writer.line("    xor r8d, r8d"); self.writer.line("    xor r9d, r9d"); self.writer.line("    syscall"); self.writer.line("    ret"); self.writer.line("")
        }

        layoutTypes() -> void {
            local typeIndex:i64 = 0
            while typeIndex < self.program.types.length {
                local typeNode = self.program.types[typeIndex]
                local offset:i64 = 16
                local alignment:i64 = 1
                local fieldIndex:i64 = 0
                while fieldIndex < typeNode.fields.length {
                    local field = typeNode.fields[fieldIndex]
                    local size = self.sizeOf(field.typeName)
                    local fieldAlignment = size
                    if fieldAlignment > 8 { fieldAlignment = 8 }
                    offset = self.align(offset, fieldAlignment)
                    self.fields.append(new FieldLayout(field.qualifiedName, field.typeName, field.ownership, offset))
                    offset = offset + size
                    if fieldAlignment > alignment { alignment = fieldAlignment }
                    fieldIndex = fieldIndex + 1
                }
                local total = self.align(offset, alignment)
                if total < 8 { total = 8 }
                self.types.append(new TypeLayout(typeNode.name, total))
                typeIndex = typeIndex + 1
            }
        }

        declareSymbols() -> void {
            local index:i64 = 0
            while index < self.program.functions.length {
                local function = self.program.functions[index]
                local assemblyName = self.mangle(function.name)
                if self.findAssemblySymbol(assemblyName) != null { return }
                self.functionSymbols.append(new FunctionSymbol(function.name, assemblyName))
                index = index + 1
            }
            index = 0
            while index < self.program.externals.length {
                local external = self.program.externals[index]
                self.functionSymbols.append(new FunctionSymbol(external.name, external.runtimeName))
                index = index + 1
            }
        }

        scanProgram() -> void {
            local functionIndex:i64 = 0
            while functionIndex < self.program.functions.length {
                local blocks = self.program.functions[functionIndex].blocks
                local blockIndex:i64 = 0
                while blockIndex < blocks.length {
                    local instructions = blocks[blockIndex].instructions
                    local instructionIndex:i64 = 0
                    while instructionIndex < instructions.length {
                        local instruction = instructions[instructionIndex]
                        if instruction.op == "string_constant" { self.internString(instruction.text!) }
                        if instruction.op == "float_constant" { self.internFloat(instruction.text!, instruction.typeName!) }
                        if instruction.op == "call" {
                            if instruction.target! == "System.print" { self.usesPrint = true }
                            if instruction.target! == "System.write" { self.usesWrite = true }
                            if instruction.target! == "System.writeError" { self.usesWriteError = true }
                        }
                        instructionIndex = instructionIndex + 1
                    }
                    blockIndex = blockIndex + 1
                }
                functionIndex = functionIndex + 1
            }
        }

        generateFunction(function:Ir.Function) -> void {
            self.currentFunctionSymbol = self.functionSymbol(function.name)
            self.slots = new Array<Slot>(0)
            self.immediates = new Array<Immediate>(0)
            self.allocations = new Array<Allocation>(0)
            if self.optimize { self.selectImmediateConstants(function); self.allocateRegisters(function) }
            local parameterIndex:i64 = 0
            while parameterIndex < function.parameters.length {
                self.reserve("name:" + function.parameters[parameterIndex].name, function.parameters[parameterIndex].typeName)
                parameterIndex = parameterIndex + 1
            }
            local blockIndex:i64 = 0
            while blockIndex < function.blocks.length {
                local instructions = function.blocks[blockIndex].instructions
                local index:i64 = 0
                while index < instructions.length {
                    local instruction = instructions[index]
                    if instruction.result != null {
                        local allocation = self.findAllocation(instruction.result!.name)
                        if self.findImmediate(instruction.result!.name) == null {
                            if allocation == null || allocation!.registerName.length == 0 { self.reserve("temp:" + instruction.result!.name, instruction.result!.typeName) }
                        }
                    }
                    if instruction.op == "declare_local" { self.reserve("name:" + instruction.name!, instruction.typeName!) }
                    if instruction.op == "store_local" { self.reserve("name:" + instruction.name!, instruction.first!.typeName) }
                    index = index + 1
                }
                blockIndex = blockIndex + 1
            }
            local registerIndex:i64 = 0
            while registerIndex < 4 {
                local registerName = self.allocationRegister(registerIndex)
                if self.usesAllocationRegister(registerName) { self.reserve("save:" + registerName, "") }
                registerIndex = registerIndex + 1
            }
            local roots = new Array<ref Slot>(0)
            local slotIndex:i64 = 0
            while slotIndex < self.slots.length {
                local candidate = self.slots[slotIndex]
                if self.isManagedReferenceType(candidate.typeName) { roots.append(candidate) }
                slotIndex = slotIndex + 1
            }
            local rootRecordSize:i64 = 24
            local rootRecordOffset = self.slots.length * 8 + rootRecordSize
            local frameSize = self.align(rootRecordOffset, 16)
            local endLabel = self.currentFunctionSymbol + "__return"
            local rootTraceLabel = self.currentFunctionSymbol + "__gc_roots"
            self.writer.line(".globl " + self.currentFunctionSymbol)
            self.writer.line(self.currentFunctionSymbol + ":")
            self.writer.line("    push rbp")
            self.writer.line("    mov rbp, rsp")
            if frameSize > 0 { self.writer.line("    sub rsp, " + frameSize.toString()) }
            local clearOffset:i64 = 8
            while clearOffset <= frameSize {
                self.writer.line("    mov QWORD PTR [rbp-" + clearOffset.toString() + "], 0")
                clearOffset = clearOffset + 8
            }
            registerIndex = 0
            while registerIndex < 4 {
                local registerName = self.allocationRegister(registerIndex)
                if self.usesAllocationRegister(registerName) { self.writer.line("    mov " + self.slot("save:" + registerName) + ", " + registerName) }
                registerIndex = registerIndex + 1
            }
            self.writer.line("    mov rax, QWORD PTR [rip+valen_gc_roots]")
            self.writer.line("    mov QWORD PTR [rbp-" + rootRecordOffset.toString() + "], rax")
            self.writer.line("    lea rax, [rip+" + rootTraceLabel + "]")
            self.writer.line("    mov QWORD PTR [rbp-" + (rootRecordOffset - 8).toString() + "], rax")
            self.writer.line("    mov QWORD PTR [rbp-" + (rootRecordOffset - 16).toString() + "], rbp")
            self.writer.line("    lea rax, [rbp-" + rootRecordOffset.toString() + "]")
            self.writer.line("    mov QWORD PTR [rip+valen_gc_roots], rax")
            parameterIndex = 0
            local gpIndex:i64 = 0
            local xmmIndex:i64 = 0
            local stackIndex:i64 = 0
            while parameterIndex < function.parameters.length {
                local parameter = function.parameters[parameterIndex]
                local destination = self.slot("name:" + parameter.name)
                if self.isFloat(parameter.typeName) && xmmIndex < 8 {
                    if parameter.typeName == "f32" { self.writer.line("    movd eax, xmm" + xmmIndex.toString()) } else { self.writer.line("    movq rax, xmm" + xmmIndex.toString()) }
                    self.writer.line("    mov " + destination + ", rax")
                    xmmIndex = xmmIndex + 1
                } else {
                    if !self.isFloat(parameter.typeName) && gpIndex < 6 {
                        self.writer.line("    mov " + destination + ", " + self.argumentRegister(gpIndex))
                        gpIndex = gpIndex + 1
                    } else {
                        self.writer.line("    mov rax, QWORD PTR [rbp+" + (16 + stackIndex * 8).toString() + "]")
                        self.writer.line("    mov " + destination + ", rax")
                        stackIndex = stackIndex + 1
                    }
                }
                parameterIndex = parameterIndex + 1
            }
            blockIndex = 0
            while blockIndex < function.blocks.length {
                local block = function.blocks[blockIndex]
                if block.label != "entry" { self.writer.line(self.blockLabel(block.label) + ":") }
                local index:i64 = 0
                while index < block.instructions.length {
                    self.generateInstruction(block.instructions[index], endLabel)
                    index = index + 1
                }
                blockIndex = blockIndex + 1
            }
            self.writer.line(endLabel + ":")
            self.writer.line("    mov rcx, QWORD PTR [rbp-" + rootRecordOffset.toString() + "]")
            self.writer.line("    mov QWORD PTR [rip+valen_gc_roots], rcx")
            registerIndex = 0
            while registerIndex < 4 {
                local registerName = self.allocationRegister(registerIndex)
                if self.usesAllocationRegister(registerName) { self.writer.line("    mov " + registerName + ", " + self.slot("save:" + registerName)) }
                registerIndex = registerIndex + 1
            }
            self.writer.line("    leave")
            self.writer.line("    ret")
            self.writer.line(rootTraceLabel + ":")
            self.writer.line("    push rbx")
            self.writer.line("    mov rbx, rdi")
            slotIndex = 0
            while slotIndex < roots.length {
                self.writer.line("    mov rdi, QWORD PTR [rbx-" + roots[slotIndex].offset.toString() + "]")
                self.writer.line("    call valen_gc_mark")
                slotIndex = slotIndex + 1
            }
            self.writer.line("    pop rbx")
            self.writer.line("    ret")
            self.writer.line("")
        }

        generateInstruction(instruction:Ir.Instruction, endLabel:string) -> void {
            local op = instruction.op
            if op == "constant" {
                if self.findImmediate(instruction.result!.name) != null { return }
                self.writer.line("    mov rax, " + instruction.text!)
                self.normalize("rax", instruction.typeName!)
                self.storeResult(instruction, "rax")
                return
            }
            if op == "string_constant" {
                local literal = self.findLiteral(instruction.text!)
                self.writer.line("    lea rax, [rip+" + literal!.descriptorLabel + "]")
                self.storeResult(instruction, "rax")
                return
            }
            if op == "float_constant" {
                local literal = self.findFloatLiteral(instruction.text!, instruction.typeName!)!
                if instruction.typeName! == "f32" {
                    self.writer.line("    movss xmm0, DWORD PTR [rip+" + literal.dataLabel + "]")
                    self.writer.line("    movd eax, xmm0")
                } else {
                    self.writer.line("    movsd xmm0, QWORD PTR [rip+" + literal.dataLabel + "]")
                    self.writer.line("    movq rax, xmm0")
                }
                self.storeResult(instruction, "rax")
                return
            }
            if op == "declare_local" {
                if instruction.first == null {
                    self.writer.line("    mov " + self.named(instruction.name!) + ", 0")
                } else {
                    self.load(instruction.first!, "rax")
                    self.writer.line("    mov " + self.named(instruction.name!) + ", rax")
                }
                return
            }
            if op == "load_local" {
                self.writer.line("    mov rax, " + self.named(instruction.name!))
                self.storeResult(instruction, "rax")
                return
            }
            if op == "store_local" {
                self.load(instruction.first!, "rax")
                self.writer.line("    mov " + self.named(instruction.name!) + ", rax")
                return
            }
            if op == "load_field" {
                local field = self.findField(instruction.name!)
                self.load(instruction.first!, "rax")
                self.loadMemory("[rax+" + field!.offset.toString() + "]", field!.typeName, "rax")
                if field!.ownership == "member-weak" {
                    local label = self.nextLabel
                    self.nextLabel = self.nextLabel + 1
                    self.writer.line("    test rax, rax")
                    self.writer.line("    jz .Lweak_done_" + label.toString())
                    self.writer.line("    cmp QWORD PTR [rax+8], 0")
                    self.writer.line("    jne .Lweak_done_" + label.toString())
                    self.writer.line("    xor eax, eax")
                    self.writer.line(".Lweak_done_" + label.toString() + ":")
                }
                self.storeResult(instruction, "rax")
                return
            }
            if op == "store_field" {
                local field = self.findField(instruction.name!)
                self.load(instruction.first!, "rax")
                self.load(instruction.second!, "rcx")
                self.writer.line("    mov " + self.memorySize(field!.typeName) + " PTR [rax+" + field!.offset.toString() + "], " + self.registerForSize("rcx", field!.typeName))
                return
            }
            if op == "unary" { self.generateUnary(instruction); return }
            if op == "binary" { self.generateBinary(instruction); return }
            if op == "allocate" {
                self.writer.line("    mov rdi, " + self.typeSize(instruction.ownerType!).toString())
                self.writer.line("    lea rsi, [rip+" + self.gcTraceLabel(instruction.ownerType!) + "]")
                self.writer.line("    lea rdx, [rip+" + self.gcWeakLabel(instruction.ownerType!) + "]")
                self.writer.line("    xor ecx, ecx")
                self.writer.line("    call valen_gc_alloc")
                self.writer.line("    lea rcx, [rip+" + self.typeLabel(instruction.ownerType!) + "]")
                self.writer.line("    mov QWORD PTR [rax], rcx")
                self.writer.line("    mov QWORD PTR [rax+8], 1")
                self.storeResult(instruction, "rax")
                return
            }
            if op == "destroy_object" {
                self.load(instruction.first!, "rax")
                local done = ".Ldestroy_null_" + self.nextLabel.toString(); self.nextLabel = self.nextLabel + 1
                self.writer.line("    test rax, rax"); self.writer.line("    je " + done)
                self.writer.line("    mov QWORD PTR [rax+8], 0"); self.writer.line(done + ":")
                return
            }
            if op == "destroy_array" {
                self.load(instruction.first!, "rdi")
                self.writer.line("    call " + self.arrayDestroyLabel(instruction.ownerType!))
                return
            }
            if op == "array_new" {
                self.writer.line("    mov rdi, " + self.sizeOf(instruction.elementType!).toString())
                self.load(instruction.first!, "rsi")
                self.writer.line("    lea rdx, [rip+" + self.gcArrayTraceLabel(instruction.result!.typeName) + "]")
                self.writer.line("    lea rcx, [rip+" + self.gcArrayWeakLabel(instruction.result!.typeName) + "]")
                self.writer.line("    call valen_gc_array_new")
                self.storeResult(instruction, "rax")
                return
            }
            if op == "array_length" {
                self.load(instruction.first!, "rax")
                self.writer.line("    mov rax, QWORD PTR [rax]")
                self.storeResult(instruction, "rax")
                return
            }
            if op == "array_load" || op == "string_load" {
                self.load(instruction.first!, "rdi")
                self.load(instruction.second!, "rsi")
                if op == "string_load" {
                    self.writer.line("    call valen_string_address")
                    self.writer.line("    movzx eax, BYTE PTR [rax]")
                } else {
                    self.writer.line("    mov rdx, " + self.sizeOf(instruction.elementType!).toString())
                    self.writer.line("    call valen_array_address")
                    self.loadMemory("[rax]", instruction.elementType!, "rax")
                    if instruction.elementOwnership != null { if instruction.elementOwnership! == "weak" {
                        local live = ".Lweak_array_live_" + self.nextLabel.toString(); self.nextLabel = self.nextLabel + 1
                        local done = ".Lweak_array_done_" + self.nextLabel.toString(); self.nextLabel = self.nextLabel + 1
                        self.writer.line("    test rax, rax"); self.writer.line("    je " + done)
                        self.writer.line("    cmp QWORD PTR [rax+8], 0"); self.writer.line("    jne " + live)
                        self.writer.line("    xor eax, eax"); self.writer.line("    jmp " + done)
                        self.writer.line(live + ":"); self.writer.line(done + ":")
                    } }
                }
                self.storeResult(instruction, "rax")
                return
            }
            if op == "array_store" {
                self.load(instruction.first!, "rdi")
                self.load(instruction.second!, "rsi")
                self.writer.line("    mov rdx, " + self.sizeOf(instruction.elementType!).toString())
                self.writer.line("    call valen_array_address")
                if instruction.elementOwnership != null { if instruction.elementOwnership! == "owned" {
                    local elementBase = self.baseType(instruction.elementType!)
                    if self.findProgramType(elementBase) != null {
                        local empty = ".Larray_replace_empty_" + self.nextLabel.toString(); self.nextLabel = self.nextLabel + 1
                        self.writer.line("    mov rdx, QWORD PTR [rax]"); self.writer.line("    test rdx, rdx"); self.writer.line("    je " + empty)
                        self.writer.line("    mov QWORD PTR [rdx+8], 0"); self.writer.line(empty + ":")
                    }
                } }
                self.load(instruction.third!, "rcx")
                self.writer.line("    mov " + self.memorySize(instruction.elementType!) + " PTR [rax], " + self.registerForSize("rcx", instruction.elementType!))
                return
            }
            if op == "array_append" {
                self.load(instruction.first!, "rdi")
                self.load(instruction.second!, "rsi")
                self.writer.line("    mov rdx, " + self.sizeOf(instruction.elementType!).toString())
                self.writer.line("    call valen_array_append")
                return
            }
            if op == "array_insert" {
                self.load(instruction.first!, "rdi")
                self.load(instruction.arguments[0], "rsi")
                self.load(instruction.second!, "rdx")
                self.writer.line("    mov rcx, " + self.sizeOf(instruction.elementType!).toString())
                self.writer.line("    call valen_array_insert")
                return
            }
            if op == "array_remove" {
                self.load(instruction.first!, "rdi")
                self.load(instruction.second!, "rsi")
                self.writer.line("    mov rdx, " + self.sizeOf(instruction.elementType!).toString())
                self.writer.line("    call valen_array_remove")
                self.normalize("rax", instruction.typeName!)
                self.storeResult(instruction, "rax")
                return
            }
            if op == "string_length" || op == "builder_length" {
                self.load(instruction.first!, "rax")
                if op == "string_length" { self.writer.line("    mov rax, QWORD PTR [rax+8]") } else { self.writer.line("    mov rax, QWORD PTR [rax]") }
                self.storeResult(instruction, "rax")
                return
            }
            if (op == "string_concat" || op == "string_equal") {
                self.load(instruction.first!, "rdi")
                self.load(instruction.second!, "rsi")
                if op == "string_concat" { self.writer.line("    call valen_string_concat") } else {
                    self.writer.line("    call valen_string_equal")
                    if instruction.operator! == "!=" { self.writer.line("    xor eax, 1") }
                }
                self.storeResult(instruction, "rax")
                return
            }
            if op == "structural_equal" {
                self.load(instruction.first!, "rdi")
                self.load(instruction.second!, "rsi")
                self.writer.line("    xor edx, edx")
                self.writer.line("    call " + self.equalityFunction(instruction.ownerType!))
                if instruction.operator! == "!=" { self.writer.line("    xor eax, 1") }
                self.storeResult(instruction, "rax")
                return
            }
            if op == "structural_hash" {
                self.load(instruction.first!, "rdi")
                self.writer.line("    xor esi, esi")
                self.writer.line("    call " + self.hashFunction(instruction.ownerType!))
                self.storeResult(instruction, "rax")
                return
            }
            if op == "structural_copy" {
                self.load(instruction.first!, "rdi")
                self.writer.line("    xor esi, esi")
                self.writer.line("    call " + self.copyFunction(instruction.ownerType!))
                self.storeResult(instruction, "rax")
                return
            }
            if op == "string_slice" {
                self.load(instruction.first!, "rdi")
                self.load(instruction.arguments[0], "rsi")
                self.load(instruction.arguments[1], "rdx")
                self.writer.line("    call valen_string_slice")
                self.storeResult(instruction, "rax")
                return
            }
            if op == "string_to_bytes" {
                self.load(instruction.first!, "rdi")
                self.writer.line("    call valen_string_to_bytes")
                self.storeResult(instruction, "rax")
                return
            }
            if op == "bytes_to_string" {
                self.load(instruction.first!, "rdi")
                self.writer.line("    call valen_bytes_to_string")
                self.storeResult(instruction, "rax")
                return
            }
            if op == "integer_to_string" {
                self.load(instruction.first!, "rdi")
                if self.isUnsigned(instruction.first!.typeName) { self.writer.line("    xor esi, esi") } else { self.writer.line("    mov esi, 1") }
                self.writer.line("    call valen_integer_to_string")
                self.storeResult(instruction, "rax")
                return
            }
            if op == "builder_new" {
                self.writer.line("    mov edi, 1")
                self.writer.line("    xor esi, esi")
                self.writer.line("    call valen_array_new")
                self.storeResult(instruction, "rax")
                return
            }
            if op == "builder_append_string" {
                self.load(instruction.first!, "rdi")
                self.load(instruction.second!, "rsi")
                self.writer.line("    call valen_builder_append_string")
                return
            }
            if op == "builder_append_bytes" {
                self.load(instruction.first!, "rdi")
                self.load(instruction.second!, "rsi")
                self.writer.line("    call valen_builder_append_bytes")
                return
            }
            if op == "builder_append_byte" {
                self.load(instruction.first!, "rdi")
                self.load(instruction.second!, "rsi")
                self.writer.line("    mov edx, 1")
                self.writer.line("    call valen_array_append")
                return
            }
            if op == "builder_build" {
                self.load(instruction.first!, "rdi")
                self.writer.line("    call valen_builder_build")
                self.storeResult(instruction, "rax")
                return
            }
            if op == "call" { self.generateCall(instruction); return }
            if op == "virtual_call" { self.generateVirtualCall(instruction); return }
            if op == "contract_call" { self.generateContractCall(instruction); return }
            if op == "test_expect" {
                self.load(instruction.first!, "rax")
                local label = self.nextLabel
                self.nextLabel = self.nextLabel + 1
                self.writer.line("    test rax, rax")
                self.writer.line("    jnz .Ltest_pass_" + label.toString())
                self.writer.line("    inc QWORD PTR [rip+valen_test_failures]")
                self.writer.line("    mov eax, 1")
                self.writer.line("    mov edi, 2")
                self.writer.line("    lea rsi, [rip+valen_test_failure_message]")
                self.writer.line("    mov edx, 12")
                self.writer.line("    syscall")
                self.writer.line(".Ltest_pass_" + label.toString() + ":")
                return
            }
            if op == "test_failures" {
                self.writer.line("    mov rax, QWORD PTR [rip+valen_test_failures]")
                self.storeResult(instruction, "rax")
                return
            }
            if op == "type_test" || op == "checked_cast" {
                local label = self.nextLabel
                self.nextLabel = self.nextLabel + 1
                local loop = ".Ltype_test_" + label.toString()
                local matched = ".Ltype_match_" + label.toString()
                local done = ".Ltype_done_" + label.toString()
                local scan = ".Ltype_contract_" + label.toString()
                local next = ".Ltype_next_" + label.toString()
                self.load(instruction.first!, "rcx")
                self.writer.line("    xor eax, eax")
                self.writer.line("    test rcx, rcx")
                self.writer.line("    jz " + done)
                self.writer.line("    mov rdx, QWORD PTR [rcx]")
                self.writer.line("    lea r8, [rip+" + self.typeLabel(instruction.ownerType!) + "]")
                self.writer.line(loop + ":")
                self.writer.line("    test rdx, rdx")
                self.writer.line("    jz " + done)
                self.writer.line("    cmp rdx, r8")
                self.writer.line("    je " + matched)
                self.writer.line("    mov r9, QWORD PTR [rdx+8]")
                self.writer.line("    mov r10, QWORD PTR [r9]")
                self.writer.line("    add r9, 8")
                self.writer.line(scan + ":")
                self.writer.line("    test r10, r10")
                self.writer.line("    jz " + next)
                self.writer.line("    cmp QWORD PTR [r9], r8")
                self.writer.line("    je " + matched)
                self.writer.line("    add r9, 16")
                self.writer.line("    dec r10")
                self.writer.line("    jmp " + scan)
                self.writer.line(next + ":")
                self.writer.line("    mov rdx, QWORD PTR [rdx]")
                self.writer.line("    jmp " + loop)
                self.writer.line(matched + ":")
                if op == "type_test" { self.writer.line("    mov eax, 1") } else { self.writer.line("    mov rax, rcx") }
                self.writer.line(done + ":")
                self.storeResult(instruction, "rax")
                return
            }
            if op == "convert" {
                self.load(instruction.first!, "rax")
                self.convertNumber(instruction.first!.typeName, instruction.typeName!)
                self.storeResult(instruction, "rax")
                return
            }
            if op == "optional_box" {
                self.writer.line("    mov edi, 24")
                self.writer.line("    xor esi, esi")
                self.writer.line("    xor edx, edx")
                self.writer.line("    xor ecx, ecx")
                self.writer.line("    call valen_gc_alloc")
                self.writer.line("    mov QWORD PTR [rax], 0")
                self.writer.line("    mov QWORD PTR [rax+8], 1")
                self.writer.line("    push rax")
                self.load(instruction.first!, "rcx")
                self.writer.line("    pop rax")
                self.writer.line("    mov QWORD PTR [rax+16], rcx")
                self.storeResult(instruction, "rax")
                return
            }
            if op == "unwrap" {
                self.load(instruction.first!, "rax")
                self.writer.line("    test rax, rax")
                self.writer.line("    jz .Loptional_unwrap_error")
                if instruction.ownerType != null { if self.isPrimitiveOptional(instruction.ownerType!) { self.writer.line("    mov rax, QWORD PTR [rax+16]"); self.normalize("rax", instruction.typeName!) } }
                self.storeResult(instruction, "rax")
                return
            }
            if op == "jump" { self.writer.line("    jmp " + self.blockLabel(instruction.target!)); return }
            if op == "branch" {
                self.load(instruction.first!, "rax")
                self.writer.line("    test rax, rax")
                self.writer.line("    jnz " + self.blockLabel(instruction.target!))
                self.writer.line("    jmp " + self.blockLabel(instruction.alternateTarget!))
                return
            }
            if op == "return" {
                if instruction.first == null { self.writer.line("    xor eax, eax") } else {
                    self.load(instruction.first!, "rax")
                    if self.isFloat(instruction.first!.typeName) {
                        if instruction.first!.typeName == "f32" { self.writer.line("    movd xmm0, eax") } else { self.writer.line("    movq xmm0, rax") }
                    }
                }
                self.writer.line("    jmp " + endLabel)
                return
            }
        }

        generateUnary(instruction:Ir.Instruction) -> void {
            self.load(instruction.first!, "rax")
            if instruction.operator! == "-" {
                if instruction.typeName! == "f32" { self.writer.line("    xor eax, 2147483648") } else {
                    if instruction.typeName! == "f64" { self.writer.line("    mov rcx, 0x8000000000000000"); self.writer.line("    xor rax, rcx") } else { self.writer.line("    neg rax") }
                }
            }
            if instruction.operator! == "!" {
                self.writer.line("    test rax, rax")
                self.writer.line("    sete al")
                self.writer.line("    movzx rax, al")
            }
            self.normalize("rax", instruction.typeName!)
            self.storeResult(instruction, "rax")
        }

        generateBinary(instruction:Ir.Instruction) -> void {
            if self.isFloat(instruction.first!.typeName) { self.generateFloatBinary(instruction); return }
            self.load(instruction.first!, "rax")
            local immediate = self.findImmediate(instruction.second!.name)
            local operand = "rcx"
            if immediate == null { self.load(instruction.second!, "rcx") } else { operand = immediate!.value.toString() }
            local operator = instruction.operator!
            if operator == "+" { self.writer.line("    add rax, " + operand) }
            if operator == "-" { self.writer.line("    sub rax, " + operand) }
            if operator == "*" { self.writer.line("    imul rax, " + operand) }
            if operator == "&&" { self.writer.line("    and rax, rcx") }
            if operator == "||" { self.writer.line("    or rax, rcx") }
            if operator == "&" { self.writer.line("    and rax, " + operand) }
            if operator == "|" { self.writer.line("    or rax, " + operand) }
            if operator == "^" { self.writer.line("    xor rax, " + operand) }
            if operator == "<<" { if immediate == null { self.writer.line("    shl rax, cl") } else { self.writer.line("    shl rax, " + (immediate!.value & 63).toString()) } }
            if operator == ">>" {
                local shift = "cl"
                if immediate != null { shift = (immediate!.value & 63).toString() }
                if self.isUnsigned(instruction.first!.typeName) { self.writer.line("    shr rax, " + shift) }
                else { self.writer.line("    sar rax, " + shift) }
            }
            if operator == "/" {
                self.writer.line("    test rcx, rcx")
                self.writer.line("    jz .Ldivision_by_zero_error")
                if self.isUnsigned(instruction.first!.typeName) { self.writer.line("    xor edx, edx"); self.writer.line("    div rcx") } else { self.writer.line("    cqo"); self.writer.line("    idiv rcx") }
            }
            if operator == "==" || operator == "!=" || operator == "===" || operator == "!==" || operator == "<" || operator == "<=" || operator == ">" || operator == ">=" {
                self.writer.line("    cmp rax, " + operand)
                self.writer.line("    " + self.condition(operator, self.isUnsigned(instruction.first!.typeName)) + " al")
                self.writer.line("    movzx rax, al")
            }
            self.normalize("rax", instruction.typeName!)
            self.storeResult(instruction, "rax")
        }

        generateFloatBinary(instruction:Ir.Instruction) -> void {
            self.load(instruction.first!, "rax")
            self.load(instruction.second!, "rcx")
            local suffix = "sd"
            if instruction.first!.typeName == "f32" { suffix = "ss"; self.writer.line("    movd xmm0, eax"); self.writer.line("    movd xmm1, ecx") } else { self.writer.line("    movq xmm0, rax"); self.writer.line("    movq xmm1, rcx") }
            local operator = instruction.operator!
            if operator == "+" || operator == "-" || operator == "*" || operator == "/" {
                local operation = "add"
                if operator == "-" { operation = "sub" }
                if operator == "*" { operation = "mul" }
                if operator == "/" { operation = "div" }
                self.writer.line("    " + operation + suffix + " xmm0, xmm1")
                if instruction.first!.typeName == "f32" { self.writer.line("    movd eax, xmm0") } else { self.writer.line("    movq rax, xmm0") }
            } else {
                self.writer.line("    ucomi" + suffix + " xmm0, xmm1")
                if operator == "!=" { self.writer.line("    setne al"); self.writer.line("    setp dl"); self.writer.line("    or al, dl") }
                if operator == "==" || operator == "<" || operator == "<=" {
                    if operator == "==" { self.writer.line("    sete al") }
                    if operator == "<" { self.writer.line("    setb al") }
                    if operator == "<=" { self.writer.line("    setbe al") }
                    self.writer.line("    setnp dl"); self.writer.line("    and al, dl")
                }
                if operator == ">" { self.writer.line("    seta al") }
                if operator == ">=" { self.writer.line("    setae al") }
                self.writer.line("    movzx rax, al")
            }
            self.storeResult(instruction, "rax")
        }

        convertNumber(fromType:string, toType:string) -> void {
            if fromType == toType { self.normalize("rax", toType); return }
            if self.isFloat(fromType) && self.isFloat(toType) {
                if fromType == "f32" { self.writer.line("    movd xmm0, eax"); self.writer.line("    cvtss2sd xmm0, xmm0"); self.writer.line("    movq rax, xmm0") }
                else { self.writer.line("    movq xmm0, rax"); self.writer.line("    cvtsd2ss xmm0, xmm0"); self.writer.line("    movd eax, xmm0") }
                return
            }
            if !self.isFloat(fromType) && self.isFloat(toType) {
                local suffix = "sd"
                if toType == "f32" { suffix = "ss" }
                if fromType == "u64" {
                    local label = self.nextLabel; self.nextLabel = self.nextLabel + 1
                    self.writer.line("    test rax, rax"); self.writer.line("    jns .Luint_float_" + label.toString())
                    self.writer.line("    mov rcx, rax"); self.writer.line("    and eax, 1"); self.writer.line("    shr rcx, 1"); self.writer.line("    or rcx, rax")
                    self.writer.line("    cvtsi2" + suffix + " xmm0, rcx"); self.writer.line("    add" + suffix + " xmm0, xmm0"); self.writer.line("    jmp .Luint_float_done_" + label.toString())
                    self.writer.line(".Luint_float_" + label.toString() + ":"); self.writer.line("    cvtsi2" + suffix + " xmm0, rax"); self.writer.line(".Luint_float_done_" + label.toString() + ":")
                } else { self.writer.line("    cvtsi2" + suffix + " xmm0, rax") }
                if toType == "f32" { self.writer.line("    movd eax, xmm0") } else { self.writer.line("    movq rax, xmm0") }
                return
            }
            if self.isFloat(fromType) {
                if fromType == "f32" { self.writer.line("    movd xmm0, eax"); self.writer.line("    cvtss2sd xmm0, xmm0") } else { self.writer.line("    movq xmm0, rax") }
                self.writer.line("    ucomisd xmm0, xmm0"); self.writer.line("    jp .Lfloat_conversion_error")
                if self.isUnsigned(toType) {
                    self.writer.line("    ucomisd xmm0, QWORD PTR [rip+.Lfloat_zero]"); self.writer.line("    jb .Lfloat_conversion_error")
                    self.writer.line("    ucomisd xmm0, QWORD PTR [rip+.Lfloat_" + toType + "_limit]"); self.writer.line("    jae .Lfloat_conversion_error")
                    if toType == "u64" {
                        self.writer.line("    ucomisd xmm0, QWORD PTR [rip+.Lfloat_i64_limit]"); self.writer.line("    jb 1f")
                        self.writer.line("    subsd xmm0, QWORD PTR [rip+.Lfloat_i64_limit]"); self.writer.line("    cvttsd2si rax, xmm0")
                        self.writer.line("    mov rcx, 0x8000000000000000"); self.writer.line("    add rax, rcx"); self.writer.line("    jmp 2f")
                        self.writer.line("1:"); self.writer.line("    cvttsd2si rax, xmm0"); self.writer.line("2:")
                    } else { self.writer.line("    cvttsd2si rax, xmm0"); self.normalize("rax", toType) }
                } else {
                    self.writer.line("    ucomisd xmm0, QWORD PTR [rip+.Lfloat_" + toType + "_minimum]"); self.writer.line("    jb .Lfloat_conversion_error")
                    self.writer.line("    ucomisd xmm0, QWORD PTR [rip+.Lfloat_" + toType + "_limit]"); self.writer.line("    jae .Lfloat_conversion_error")
                    self.writer.line("    cvttsd2si rax, xmm0"); self.normalize("rax", toType)
                }
                return
            }
            self.normalize("rax", toType)
        }

        generateCall(instruction:Ir.Instruction) -> void {
            self.loadRegisterArguments(instruction.arguments)
            local stackCount = self.stackArgumentCount(instruction.arguments)
            local padding:i64 = 0
            if stackCount - (stackCount / 2) * 2 == 1 { padding = 8; self.writer.line("    sub rsp, 8") }
            self.pushStackArguments(instruction.arguments)
            self.writer.line("    call " + self.functionSymbol(instruction.target!))
            local stackBytes = stackCount * 8 + padding
            if stackBytes > 0 { self.writer.line("    add rsp, " + stackBytes.toString()) }
            if instruction.result != null {
                if self.isFloat(instruction.typeName!) { if instruction.typeName! == "f32" { self.writer.line("    movd eax, xmm0") } else { self.writer.line("    movq rax, xmm0") } }
                self.normalize("rax", instruction.typeName!); self.storeResult(instruction, "rax")
            }
        }

        generateVirtualCall(instruction:Ir.Instruction) -> void {
            self.loadRegisterArguments(instruction.arguments)
            local stackCount = self.stackArgumentCount(instruction.arguments)
            local padding:i64 = 0
            if stackCount - (stackCount / 2) * 2 == 1 { padding = 8; self.writer.line("    sub rsp, 8") }
            self.pushStackArguments(instruction.arguments)
            self.writer.line("    mov rax, QWORD PTR [rdi]")
            self.writer.line("    call QWORD PTR [rax+" + (40 + instruction.slot * 8).toString() + "]")
            local stackBytes = stackCount * 8 + padding
            if stackBytes > 0 { self.writer.line("    add rsp, " + stackBytes.toString()) }
            if instruction.result != null {
                if self.isFloat(instruction.typeName!) { if instruction.typeName! == "f32" { self.writer.line("    movd eax, xmm0") } else { self.writer.line("    movq rax, xmm0") } }
                self.normalize("rax", instruction.typeName!); self.storeResult(instruction, "rax")
            }
        }

        generateContractCall(instruction:Ir.Instruction) -> void {
            self.load(instruction.arguments[0], "rdi")
            local label = self.nextLabel
            self.nextLabel = self.nextLabel + 1
            local loop = ".Lcontract_call_" + label.toString()
            local found = ".Lcontract_found_" + label.toString()
            self.writer.line("    mov rax, QWORD PTR [rdi]")
            self.writer.line("    mov rdx, QWORD PTR [rax+8]")
            self.writer.line("    mov rcx, QWORD PTR [rdx]")
            self.writer.line("    add rdx, 8")
            self.writer.line("    lea r8, [rip+" + self.typeLabel(instruction.ownerType!) + "]")
            self.writer.line(loop + ":")
            self.writer.line("    test rcx, rcx")
            self.writer.line("    jz .Lcontract_dispatch_error")
            self.writer.line("    cmp QWORD PTR [rdx], r8")
            self.writer.line("    je " + found)
            self.writer.line("    add rdx, 16")
            self.writer.line("    dec rcx")
            self.writer.line("    jmp " + loop)
            self.writer.line(found + ":")
            self.writer.line("    mov rax, QWORD PTR [rdx+8]")
            self.writer.line("    mov r11, QWORD PTR [rax+" + (instruction.slot * 8).toString() + "]")
            self.loadRegisterArguments(instruction.arguments)
            local stackCount = self.stackArgumentCount(instruction.arguments)
            local padding:i64 = 0
            if stackCount - (stackCount / 2) * 2 == 1 { padding = 8; self.writer.line("    sub rsp, 8") }
            self.pushStackArguments(instruction.arguments)
            self.writer.line("    call r11")
            local stackBytes = stackCount * 8 + padding
            if stackBytes > 0 { self.writer.line("    add rsp, " + stackBytes.toString()) }
            if instruction.result != null {
                if self.isFloat(instruction.typeName!) { if instruction.typeName! == "f32" { self.writer.line("    movd eax, xmm0") } else { self.writer.line("    movq rax, xmm0") } }
                self.normalize("rax", instruction.typeName!); self.storeResult(instruction, "rax")
            }
        }

        loadRegisterArguments(arguments:Array<ref Ir.Value>) -> void {
            local gp:i64 = 0
            local xmm:i64 = 0
            local index:i64 = 0
            while index < arguments.length {
                local argument = arguments[index]
                if self.isFloat(argument.typeName) {
                    if xmm < 8 {
                        self.load(argument, "rax")
                        if argument.typeName == "f32" { self.writer.line("    movd xmm" + xmm.toString() + ", eax") } else { self.writer.line("    movq xmm" + xmm.toString() + ", rax") }
                        xmm = xmm + 1
                    }
                } else {
                    if gp < 6 { self.load(argument, self.argumentRegister(gp)); gp = gp + 1 }
                }
                index = index + 1
            }
        }

        argumentOnStack(arguments:Array<ref Ir.Value>, target:i64) -> bool {
            local gp:i64 = 0
            local xmm:i64 = 0
            local index:i64 = 0
            while index <= target {
                local argument = arguments[index]
                local stacked:bool = false
                if self.isFloat(argument.typeName) { if xmm < 8 { xmm = xmm + 1 } else { stacked = true } }
                else { if gp < 6 { gp = gp + 1 } else { stacked = true } }
                if index == target { return stacked }
                index = index + 1
            }
            return false
        }

        stackArgumentCount(arguments:Array<ref Ir.Value>) -> i64 {
            local count:i64 = 0
            local index:i64 = 0
            while index < arguments.length { if self.argumentOnStack(arguments, index) { count = count + 1 }; index = index + 1 }
            return count
        }

        pushStackArguments(arguments:Array<ref Ir.Value>) -> void {
            local index = arguments.length
            while index > 0 {
                index = index - 1
                if self.argumentOnStack(arguments, index) { self.load(arguments[index], "rax"); self.writer.line("    push rax") }
            }
        }

        generateMain() -> void {
            local entry = self.findFunction(self.program.entry!)
            local entrySize = self.typeSize(entry!.ownerType)
            self.writer.line(".globl _start")
            self.writer.line("_start:")
            self.writer.line("    xor ebp, ebp")
            self.writer.line("    mov rdi, QWORD PTR [rsp]")
            self.writer.line("    lea rsi, [rsp+8]")
            self.writer.line("    and rsp, -16")
            self.writer.line("    call main")
            self.writer.line("    mov edi, eax")
            self.writer.line("    mov eax, 60")
            self.writer.line("    syscall")
            self.writer.line("    ud2")
            self.writer.line("")
            self.writer.line(".globl main")
            self.writer.line("main:")
            self.writer.line("    push rbp")
            self.writer.line("    mov rbp, rsp")
            self.writer.line("    mov QWORD PTR [rip+valen_process_argc], rdi")
            self.writer.line("    mov QWORD PTR [rip+valen_process_argv], rsi")
            self.writer.line("    lea rax, [rsi+rdi*8+8]")
            self.writer.line("    mov QWORD PTR [rip+valen_process_envp], rax")
            self.writer.line("    sub rsp, 32")
            self.writer.line("    mov QWORD PTR [rbp-8], 0"); self.writer.line("    mov rax, QWORD PTR [rip+valen_gc_roots]"); self.writer.line("    mov QWORD PTR [rbp-32], rax"); self.writer.line("    lea rax, [rip+main__gc_roots]"); self.writer.line("    mov QWORD PTR [rbp-24], rax"); self.writer.line("    mov QWORD PTR [rbp-16], rbp"); self.writer.line("    lea rax, [rbp-32]"); self.writer.line("    mov QWORD PTR [rip+valen_gc_roots], rax")
            self.writer.line("    mov rdi, " + entrySize.toString())
            self.writer.line("    lea rsi, [rip+" + self.gcTraceLabel(entry!.ownerType) + "]")
            self.writer.line("    lea rdx, [rip+" + self.gcWeakLabel(entry!.ownerType) + "]")
            self.writer.line("    xor ecx, ecx")
            self.writer.line("    call valen_gc_alloc")
            self.writer.line("    lea rcx, [rip+" + self.typeLabel(entry!.ownerType) + "]")
            self.writer.line("    mov QWORD PTR [rax], rcx")
            self.writer.line("    mov QWORD PTR [rax+8], 1")
            self.writer.line("    mov QWORD PTR [rbp-8], rax")
            local typeNode = self.findProgramType(entry!.ownerType)
            if typeNode != null {
                if typeNode!.initializer != null {
                    self.writer.line("    mov rdi, QWORD PTR [rbp-8]")
                    self.writer.line("    call " + self.functionSymbol(typeNode!.initializer!))
                }
            }
            self.writer.line("    mov rdi, QWORD PTR [rbp-8]")
            self.writer.line("    call " + self.functionSymbol(entry!.name))
            self.writer.line("    mov rcx, QWORD PTR [rbp-32]"); self.writer.line("    mov QWORD PTR [rip+valen_gc_roots], rcx")
            self.writer.line("    leave")
            self.writer.line("    ret")
            self.writer.line("main__gc_roots:"); self.writer.line("    mov rdi, QWORD PTR [rdi-8]"); self.writer.line("    jmp valen_gc_mark")
            self.writer.line("")
        }

        runtimeCore() -> void {
            self.writer.line(".Ldivision_by_zero_error:")
