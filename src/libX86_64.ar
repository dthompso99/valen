        copyAddress(address:string, typeName:string) -> void {
            local base = self.baseType(typeName)
            if base == "string" || self.isArray(base) || self.findProgramType(base) != null {
                self.writer.line("    mov rdi, QWORD PTR [" + address + "]"); self.writer.line("    mov rsi, r14"); self.writer.line("    call " + self.copyFunction(base)); return
            }
