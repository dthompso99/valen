        structuralTypeRuntime() -> void {
            local index:i64 = 0
            while index < self.program.types.length {
                local typeNode = self.program.types[index]
                if self.emissionModule == null || typeNode.modulePath == self.emissionModule! {
                    self.objectEqualityFunction(typeNode); self.objectHashFunction(typeNode); self.objectCopyFunction(typeNode)
