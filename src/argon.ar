import System from 'libSystem.ar'
import Compiler from 'libCompiler.ar'
import Ast from 'libAst.ar'
import Parsing from 'libParser.ar'
import Diagnostics from 'libDiagnostics.ar'
import ModuleLoading from 'libModuleLoader.ar'
import Semantics from 'libSemantic.ar'
import Ir from 'libIr.ar'
import IrValidation from 'libIrValidation.ar'
import X86_64 from 'libX86_64.ar'
import X86Object from 'libX86Object.ar'
import CompilerCache from 'libCompilerCache.ar'

entry {{
    __() -> i32 {
        System.enableProcessArena()
        local arguments = System.arguments()
        if arguments.length == 2 {
            if (arguments[1] == "--help") {
                self.writeUsage()
                return 0
            }
        }

        local sourcePath:string? = null
        local outputPath:string? = null
        local checkOnly:bool = false
        local emitIr:bool = false
        local emitObjectOnly:bool = false
        if arguments.length == 2 {
            sourcePath = arguments[1]
        } else {
            if arguments.length == 3 {
                if arguments[1] == "--check" {
                    checkOnly = true
                    sourcePath = arguments[2]
                } else {
                    if arguments[1] == "--emit-ir" {
                        emitIr = true
                        sourcePath = arguments[2]
                    }
                }
            } else {
                if arguments.length == 4 {
                    if arguments[2] == "-o" {
                        sourcePath = arguments[1]
                        outputPath = arguments[3]
                    }
                } else {
                    if arguments.length == 5 {
                        if arguments[1] == "--emit-object" && arguments[3] == "-o" {
                            emitObjectOnly = true; sourcePath = arguments[2]; outputPath = arguments[4]
                        }
                    }
                }
            }
        }
        if sourcePath == null {
            self.writeUsage()
            return 64
        }

        local cwd = System.currentDirectory()
        if cwd == null {
            System.writeError("argon: could not determine current directory\n")
            return 74
        }
        local loader = new ModuleLoading.ModuleLoader(cwd!, System.environmentVariable("ARGON_LIBRARY_PATH"))
        local graph = loader.load(sourcePath!)
        if graph.diagnostics.hasErrors() {
            Diagnostics.write(graph.diagnostics)
            return 65
        }
        local cache = new CompilerCache.Cache()
        if outputPath != null && cache.enabled() {
            local cached = cache.load(graph)
            if cached != null {
                if emitObjectOnly { return self.emitObject(cached!.assembly, outputPath!) }
                local cachedLinkResult = self.link(cached!.assembly, outputPath!, cached!.libraries)
                if cachedLinkResult != 0 {
                    System.writeError("argon: linker exited with status ")
                    System.writeError(cachedLinkResult.toString())
                    System.writeError("\n")
                    return 69
                }
                return 0
            }
        }
        local analyzer = new Semantics.Analyzer(graph)
        local analysis = analyzer.analyze()
        if !analysis.success() {
            Diagnostics.write(analysis.diagnostics)
            return 65
        }
        if checkOnly { return 0 }
        local generator = new Ir.Generator(analysis)
        local ir = generator.generate()
        local irPass = new IrValidation.Pass()
        local irErrors = irPass.prepare(ir)
        if irErrors.length > 0 {
            local errorIndex:i64 = 0
            while errorIndex < irErrors.length {
                System.writeError("argon: invalid IR: ")
                System.writeError(irErrors[errorIndex])
                System.writeError("\n")
                errorIndex = errorIndex + 1
            }
            return 70
        }
        if emitIr {
            local normalizer = new Ir.Normalizer()
            System.write(normalizer.format(ir))
            return 0
        }
        local backend = new X86_64.Backend(ir)
        local runtimeErrors = backend.validateRuntime()
        if runtimeErrors.length > 0 {
            local runtimeErrorIndex:i64 = 0
            while runtimeErrorIndex < runtimeErrors.length {
                System.writeError("argon: target: ")
                System.writeError(runtimeErrors[runtimeErrorIndex])
                System.writeError("\n")
                runtimeErrorIndex = runtimeErrorIndex + 1
            }
            return 69
        }
        local assembly = backend.generate()
        if outputPath != null {
            cache.store(graph, assembly, ir.foreignLibraries)
            if emitObjectOnly { return self.emitObject(assembly, outputPath!) }
            local linkResult = self.link(assembly, outputPath!, ir.foreignLibraries)
            if linkResult != 0 {
                System.writeError("argon: linker exited with status ")
                System.writeError(linkResult.toString())
                System.writeError("\n")
                return 69
            }
            return 0
        }
        System.write(assembly)
        return 0
    }

    emitObject(assembly:string, objectPath:string) -> i32 {
        local assembler = new X86Object.Assembler()
        local object = assembler.assemble(assembly)
        if object == null {
            System.writeError("argon: native object encoder does not support generated assembly: "); System.writeError(assembler.error); System.writeError("\n")
            return 69
        }
        if !self.writeObject(objectPath, object!) { return 74 }
        return 0
    }

    link(assembly:string, outputPath:string, libraries:Array<string>) -> i64 {
        local assembler = new X86Object.Assembler()
        local object = assembler.assemble(assembly)
        local inputPath = outputPath + ".o"
        if object != null {
            if !self.writeObject(inputPath, object!) { return 74 }
        } else {
            inputPath = outputPath + ".s"
            if !self.writeAssembly(inputPath, assembly) { return 74 }
        }
        return System.link(inputPath, outputPath, libraries)
    }

    writeObject(path:string, object:Array<u8>) -> bool {
        local output = System.openWrite(path)
        if output == null {
            System.writeError("argon: could not open object output; OS error "); System.writeError(System.lastError().toString()); System.writeError("\n"); return false
        }
        local written = System.writeBytes(output!, object)
        local closeResult = System.close(output!)
        if written != object.length || closeResult != 0 {
            System.writeError("argon: could not write object output; OS error "); System.writeError(System.lastError().toString()); System.writeError("\n"); return false
        }
        return true
    }

    writeAssembly(path:string, assembly:string) -> bool {
        local output = System.openWrite(path)
        if output == null {
            System.writeError("argon: could not open '")
            System.writeError(path)
            System.writeError("' for writing; OS error ")
            System.writeError(System.lastError().toString())
            System.writeError("\n")
            return false
        }
        local written = System.writeFile(output!, assembly)
        local closeResult = System.close(output!)
        if written != assembly.length || closeResult != 0 {
            System.writeError("argon: could not write assembly output; OS error ")
            System.writeError(System.lastError().toString())
            System.writeError("\n")
            return false
        }
        return true
    }

    writeUsage() -> void {
        System.write("usage:\n")
        System.write("  argon <source-file>\n")
        System.write("  argon <source-file> -o <executable>\n")
        System.write("  argon --check <source-file>\n")
        System.write("  argon --emit-ir <source-file>\n")
        System.write("  argon --emit-object <source-file> -o <object-file>\n")
    }
}}
