import Compiler from './libCompiler.ar'
import Ast from './libAst.ar'

library Parsing {{
    Parser {{
        member tokens:Array<Compiler.Token>
        member current:i64
        member error:string?
        member errorSpan:Compiler.SourceSpan?

        __(tokens:Array<Compiler.Token>) -> void {
            self.tokens = tokens
            self.current = 0
            self.error = null
            self.errorSpan = null
        }

        parse() -> Ast.Program {
            local imports = new Array<Ast.ImportDeclaration>(0)
            local declarations = new Array<Ast.Declaration>(0)
            self.skipSeparators()
            while !self.check("EOF") {
                if self.error != null { break }
                if self.check("IMPORT") {
                    imports.append(self.parseImport())
                } else {
                    if self.check("LIBRARY") {
                        declarations.append(self.parseDeclaration("Library"))
                    } else {
                        if self.check("TEST") { declarations.append(self.parseDeclaration("Test")) } else {
                            if self.check("ENUM") { declarations.append(self.parseDeclaration("Enum")) } else { declarations.append(self.parseDeclaration("Object")) }
                        }
                    }
                }
                self.skipSeparators()
            }
            return new Ast.Program(imports, declarations, self.span(self.tokens[0].span, self.peek(0).span))
        }

        parseImport() -> Ast.ImportDeclaration {
            local start = self.consume("IMPORT", "Expected 'import'")
            local name = self.consume("IDENTIFIER", "Expected a library name")
            self.consume("FROM", "Expected 'from' after imported name")
            local path = self.consume("STRING_LITERAL", "Expected an imported path")
            return new Ast.ImportDeclaration(name.lexeme, self.decodeString(path.lexeme), self.span(start.span, path.span))
        }

        parseDeclaration(kind:string) -> Ast.Declaration {
            local start = self.peek(0)
            if kind == "Library" { start = self.consume("LIBRARY", "Expected 'library'") }
            if kind == "Test" { start = self.consume("TEST", "Expected 'test'") }
            if kind == "Enum" { start = self.consume("ENUM", "Expected 'enum'") }
            local name = self.consume("IDENTIFIER", "Expected a declaration name")
            local typeParameters = new Array<string>(0)
            local typeConstraints = new Array<Ast.TypeReference?>(0)
            if kind == "Object" {
                if self.accept("LESS") {
                    typeParameters.append(self.consume("IDENTIFIER", "Expected a type parameter name").lexeme)
                    if self.accept("COLON") { typeConstraints.append(self.parseTypeReference()) } else { typeConstraints.append(null) }
                    while self.accept("COMMA") {
                        typeParameters.append(self.consume("IDENTIFIER", "Expected a type parameter name").lexeme)
                        if self.accept("COLON") { typeConstraints.append(self.parseTypeReference()) } else { typeConstraints.append(null) }
                    }
                    self.consume("GREATER", "Expected '>' after type parameters")
                }
            }
            local inheritedType:Ast.TypeReference? = null
            local implementedTypes = new Array<Ast.TypeReference>(0)
            if kind == "Object" {
                if self.accept("INHERITS") { inheritedType = self.parseTypeReference() }
                if self.accept("IMPLEMENTS") {
                    implementedTypes.append(self.parseTypeReference())
                    while self.accept("COMMA") { implementedTypes.append(self.parseTypeReference()) }
                }
            }
            self.consume("LEFT_BRACE", "Expected '{{' after declaration name")
            self.consume("LEFT_BRACE", "Expected '{{' after declaration name")
            local members = new Array<Ast.MemberDeclaration>(0)
            self.skipSeparators()
            while !self.atDeclarationEnd() {
                if self.error != null { break }
                if kind == "Enum" {
                    local enumCase = self.consume("IDENTIFIER", "Expected an enum case")
                    local caseNode = new Ast.MemberDeclaration("EnumCase", enumCase.lexeme, enumCase.span)
                    members.append(caseNode)
                    if self.accept("COMMA") {} else {
                        if !self.atSeparator() && !self.atDeclarationEnd() { self.fail("Expected a newline, ',' or ';' after enum case") }
                    }
                } else { members.append(self.parseMember(kind == "Library" || kind == "Test")) }
                self.skipSeparators()
            }
            self.consume("RIGHT_BRACE", "Expected '}}' after declaration")
            local end = self.consume("RIGHT_BRACE", "Expected '}}' after declaration")
            local declaration = new Ast.Declaration(kind, name.lexeme, members, self.span(start.span, end.span))
            declaration.inheritedType = inheritedType
            declaration.implementedTypes = implementedTypes
            declaration.typeParameters = typeParameters
            declaration.typeConstraints = typeConstraints
            return declaration
        }

        parseMember(inLibrary:bool) -> Ast.MemberDeclaration {
            local visibility = "public"
            if self.accept("PRIVATE") { visibility = "private" } else if self.accept("PUBLIC") { visibility = "public" }
            local nestedObject:bool = false
            if self.check("ENUM") {
                local declaration = self.parseDeclaration("Enum")
                local nested = new Ast.MemberDeclaration("Enum", declaration.name, declaration.span)
                nested.members = declaration.members
                nested.visibility = visibility
                return nested
            }
            if self.check("IDENTIFIER") {
                if self.peek(1).kind == "INHERITS" || self.peek(1).kind == "IMPLEMENTS" { nestedObject = true }
                if self.peek(1).kind == "LEFT_BRACE" {
                    if self.peek(2).kind == "LEFT_BRACE" { nestedObject = true }
                }
            }
            if nestedObject {
                local declaration = self.parseDeclaration("Object")
                local nested = new Ast.MemberDeclaration("Object", declaration.name, declaration.span)
                nested.members = declaration.members
                nested.inheritedType = declaration.inheritedType
                nested.implementedTypes = declaration.implementedTypes
                nested.typeParameters = declaration.typeParameters
                nested.typeConstraints = declaration.typeConstraints
                nested.visibility = visibility
                return nested
            }
            if self.accept("MEMBER") {
                local start = self.previous()
                local reference = self.accept("REF")
                local isWeak:bool = false
                if !reference { isWeak = self.accept("WEAK") }
                local name = self.consume("IDENTIFIER", "Expected a field name")
                self.consume("COLON", "Expected ':' after field name")
                local field = new Ast.MemberDeclaration("Field", name.lexeme, self.span(start.span, name.span))
                field.declaredType = self.parseTypeReference()
                if self.accept("EQUAL") { field.initializer = self.parseExpression() }
                field.span = self.span(start.span, self.previous().span)
                field.visibility = visibility
                field.reference = reference
                field.weakReference = isWeak
                return field
            }
            local isUnsafe = self.accept("UNSAFE")
            local isNative = self.accept("NATIVE")
            local start = self.peek(0)
            if isNative || isUnsafe { start = self.previous() }
            local name = self.consume("IDENTIFIER", "Expected a method name")
            local method = new Ast.MemberDeclaration("Method", name.lexeme, self.span(start.span, name.span))
            method.isNative = isNative
            method.isUnsafe = isUnsafe
            method.visibility = visibility
            self.consume("LEFT_PAREN", "Expected '(' after method name")
            if !self.check("RIGHT_PAREN") {
                local more:bool = true
                while more {
                    local owning = self.accept("OWN")
                    local parameterStart = self.peek(0).span
                    if owning { parameterStart = self.previous().span }
                    local parameterName = self.consume("IDENTIFIER", "Expected a parameter name")
                    self.consume("COLON", "Expected ':' after parameter name")
                    local parameterType = self.parseTypeReference()
                    local defaultValue:Ast.Expression? = null
                    if self.accept("EQUAL") { defaultValue = self.parseExpression() }
                    method.parameters.append(new Ast.Parameter(
                        parameterName.lexeme,
                        parameterType,
                        defaultValue,
                        self.span(parameterStart, self.previous().span),
                        owning
                    ))
                    more = self.accept("COMMA")
                }
            }
            self.consume("RIGHT_PAREN", "Expected ')' after parameters")
            self.consume("ARROW", "Expected '->' after parameters")
            local returnReference = self.accept("REF")
            method.returnType = self.parseTypeReference()
            method.returnReference = returnReference
            if isNative {
                if self.accept("FROM") {
                    local libraryToken = self.consume("STRING_LITERAL", "Expected a library name after 'from'")
                    method.foreignLibrary = self.decodeString(libraryToken.lexeme)
                    if self.accept("AS") {
                        local symbol = self.consume("STRING_LITERAL", "Expected a symbol name after 'as'")
                        method.foreignSymbol = self.decodeString(symbol.lexeme)
                    } else {
                        method.foreignSymbol = method.name
                    }
                }
            }
            if !isNative { method.body = self.parseBlock() }
            method.span = self.span(start.span, self.previous().span)
            return method
        }

        parseTypeReference() -> Ast.TypeReference {
            local ownership = "owned"
            if self.accept("REF") { ownership = "ref" } else if self.accept("WEAK") { ownership = "weak" }
            local start = self.consume("IDENTIFIER", "Expected a type name")
            local name = start.lexeme
            while self.accept("DOT") {
                local part = self.consume("IDENTIFIER", "Expected a qualified type name")
                name = name + "." + part.lexeme
            }
            local arguments = new Array<Ast.TypeReference>(0)
            if self.accept("LESS") {
                local more:bool = true
                while more {
                    arguments.append(self.parseTypeReference())
                    more = self.accept("COMMA")
                }
                self.consume("GREATER", "Expected '>' after type arguments")
            }
            local optional = self.accept("QUESTION")
            return new Ast.TypeReference(name, arguments, optional, self.span(start.span, self.previous().span), ownership)
        }

        parseBlock() -> Ast.Block {
            local start = self.consume("LEFT_BRACE", "Expected '{'")
            local statements = new Array<Ast.Statement>(0)
            self.skipSeparators()
            while !self.check("RIGHT_BRACE") {
                if self.check("EOF") { break }
                if self.error != null { break }
                statements.append(self.parseStatement())
                if !self.atSeparator() {
                    if !self.check("RIGHT_BRACE") { self.fail("Expected a statement delimiter") }
                }
                self.skipSeparators()
            }
            local end = self.consume("RIGHT_BRACE", "Expected '}' after block")
            return new Ast.Block(statements, self.span(start.span, end.span))
        }

        parseStatement() -> Ast.Statement {
            if self.accept("RETURN") {
                local start = self.previous()
                local statement = new Ast.Statement("Return", start.span)
                if !self.atSeparator() {
                    if !self.check("RIGHT_BRACE") { statement.expression = self.parseExpression() }
                }
                statement.span = self.span(start.span, self.previous().span)
                return statement
            }
            if self.accept("IF") {
                return self.parseIf(self.previous())
            }
            if self.accept("MATCH") { return self.parseMatch(self.previous()) }
            if self.accept("WHILE") {
                local start = self.previous()
                local statement = new Ast.Statement("While", start.span)
                statement.condition = self.parseExpression()
                statement.body = self.parseBlock()
                statement.span = self.span(start.span, self.previous().span)
                return statement
            }
            if self.accept("FOR") {
                local start = self.previous()
                local name = self.consume("IDENTIFIER", "Expected an iteration variable after 'for'")
                self.consume("IN", "Expected 'in' after iteration variable")
                local statement = new Ast.Statement("For", start.span)
                statement.name = name.lexeme
                statement.expression = self.parseExpression()
                statement.body = self.parseBlock()
                statement.span = self.span(start.span, statement.body!.span)
                return statement
            }
            if self.accept("BREAK") { return new Ast.Statement("Break", self.previous().span) }
            if self.accept("CONTINUE") { return new Ast.Statement("Continue", self.previous().span) }
            if self.accept("LOCAL") {
                local start = self.previous()
                local name = self.consume("IDENTIFIER", "Expected a local name")
                local statement = new Ast.Statement("Local", self.span(start.span, name.span))
                statement.name = name.lexeme
                if self.accept("COLON") { statement.declaredType = self.parseTypeReference() }
                if self.accept("EQUAL") { statement.expression = self.parseExpression() }
                statement.span = self.span(start.span, self.previous().span)
                return statement
            }
            if self.accept("UNSAFE") {
                local start = self.previous()
                local statement = new Ast.Statement("Unsafe", start.span)
                statement.body = self.parseBlock()
                statement.span = self.span(start.span, statement.body!.span)
                return statement
            }
            if self.check("LEFT_BRACE") {
                local block = self.parseBlock()
                local statement = new Ast.Statement("Block", block.span)
                statement.body = block
                return statement
            }
            local expression = self.parseExpression()
            local statement = new Ast.Statement("Expression", expression.span)
            statement.expression = expression
            return statement
        }

        parseIf(start:Compiler.Token) -> Ast.Statement {
            local statement = new Ast.Statement("If", start.span)
            statement.condition = self.parseExpression()
            statement.body = self.parseBlock()
            local saved = self.current
            self.skipNewlines()
            if self.accept("ELSE") {
                if self.accept("IF") {
                    local nested = self.parseIf(self.previous())
                    local statements = new Array<Ast.Statement>(0)
                    statements.append(nested)
                    statement.alternate = new Ast.Block(statements, nested.span)
                } else { statement.alternate = self.parseBlock() }
            } else { self.current = saved }
            statement.span = self.span(start.span, self.previous().span)
            return statement
        }

        parseMatch(start:Compiler.Token) -> Ast.Statement {
            local statement = new Ast.Statement("Match", start.span)
            statement.expression = self.parseExpression()
            self.consume("LEFT_BRACE", "Expected '{' after match expression")
            self.skipSeparators()
            while !self.check("RIGHT_BRACE") && !self.check("EOF") {
                if self.accept("CASE") {
                    local caseStart = self.previous()
                    local pattern = self.parseExpression()
                    local body = self.parseBlock()
                    statement.matchCases.append(new Ast.MatchCase(pattern, body, self.span(caseStart.span, body.span)))
                } else if self.accept("ELSE") {
                    if statement.alternate != null { self.fail("A match may only declare one else branch") }
                    statement.alternate = self.parseBlock()
                } else { self.fail("Expected 'case', 'else', or '}' in match") }
                self.skipSeparators()
            }
            local end = self.consume("RIGHT_BRACE", "Expected '}' after match")
            statement.span = self.span(start.span, end.span)
            return statement
        }

        parseExpression() -> ref Ast.Expression { return self.parseAssignment() }

        parseAssignment() -> ref Ast.Expression {
            local target = self.parseBinary(1)
            if !self.accept("EQUAL") { return target }
            local expression = new Ast.Expression("Assignment", self.span(target.span, self.peek(0).span))
            expression.left = target
            expression.right = self.parseAssignment()
            expression.span = self.span(target.span, expression.right!.span)
            return expression
        }

        parseBinary(minimum:i64) -> ref Ast.Expression {
            local left = self.parseUnary()
            while self.precedence(self.peek(0).kind) >= minimum {
                local operator = self.advanceToken()
                local right = self.parseBinary(self.precedence(operator.kind) + 1)
                local expression = new Ast.Expression("Binary", self.span(left.span, right.span))
                expression.operator = operator.lexeme
                expression.left = left
                expression.right = right
                left = expression
            }
            return left
        }

        parseUnary() -> ref Ast.Expression {
            if self.accept("BANG") || self.accept("MINUS") || self.accept("COPY") || self.accept("DELETE") {
                local operator = self.previous()
                local operand = self.parseUnary()
                local expression = new Ast.Expression("Unary", self.span(operator.span, operand.span))
                expression.operator = operator.lexeme
                expression.left = operand
                return expression
            }
            if self.accept("NEW") { return self.parseNew(self.previous()) }
            local expression = self.parsePostfix()
            while self.accept("AS") {
                local converted = new Ast.Expression("Conversion", self.span(expression.span, self.peek(0).span))
                converted.left = expression
                converted.typeArguments.append(self.parseTypeReference())
                converted.span = self.span(expression.span, self.previous().span)
                expression = converted
            }
            return expression
        }

        parseNew(start:Compiler.Token) -> Ast.Expression {
            local expression = new Ast.Expression("New", start.span)
            expression.left = self.parsePrimary()
            while self.accept("DOT") {
                local memberToken = self.consume("IDENTIFIER", "Expected a member name")
                local access = new Ast.Expression("Member", self.span(expression.left!.span, memberToken.span))
                access.left = expression.left
                access.name = memberToken.lexeme
                expression.left = access
            }
            if self.accept("LESS") {
                local more:bool = true
                while more {
                    expression.typeArguments.append(self.parseTypeReference())
                    more = self.accept("COMMA")
                }
                self.consume("GREATER", "Expected '>' after constructed type")
            }
            self.consume("LEFT_PAREN", "Expected '(' after constructed type")
            self.parseArguments(expression.arguments)
            expression.span = self.span(start.span, self.previous().span)
            return expression
        }

        parsePostfix() -> ref Ast.Expression {
            local expression = self.parsePrimary()
            local scanning:bool = true
            while scanning {
                if self.accept("LEFT_PAREN") {
                    local call = new Ast.Expression("Call", expression.span)
                    call.left = expression
                    self.parseArguments(call.arguments)
                    call.span = self.span(expression.span, self.previous().span)
                    expression = call
                } else {
                    if self.accept("DOT") {
                        local memberToken = self.consume("IDENTIFIER", "Expected a member name")
                        local access = new Ast.Expression("Member", self.span(expression.span, memberToken.span))
                        access.left = expression
                        access.name = memberToken.lexeme
                        expression = access
                    } else {
                        if self.accept("LEFT_BRACKET") {
                            local access = new Ast.Expression("Index", expression.span)
                            access.left = expression
                            access.right = self.parseExpression()
                            local end = self.consume("RIGHT_BRACKET", "Expected ']' after index")
                            access.span = self.span(expression.span, end.span)
                            expression = access
                        } else {
                            if self.accept("BANG") {
                                local unwrap = new Ast.Expression("Unwrap", self.span(expression.span, self.previous().span))
                                unwrap.left = expression
                                expression = unwrap
                            } else {
                                if self.accept("QUESTION") {
                                    local propagate = new Ast.Expression("Propagate", self.span(expression.span, self.previous().span))
                                    propagate.left = expression
                                    expression = propagate
                                } else { scanning = false }
                            }
                        }
                    }
                }
            }
            return expression
        }

        parseArguments(arguments:Array<Ast.Expression>) -> void {
            self.skipNewlines()
            if !self.check("RIGHT_PAREN") {
                local more:bool = true
                while more {
                    self.skipNewlines()
                    arguments.append(self.parseExpression())
                    self.skipNewlines()
                    more = self.accept("COMMA")
                }
            }
            self.consume("RIGHT_PAREN", "Expected ')' after arguments")
        }

        parsePrimary() -> ref Ast.Expression {
            local token = self.advanceToken()
            if token.kind == "IF" { return self.parseIfExpression(token) }
            if token.kind == "LEFT_BRACKET" {
                local literal = new Ast.Expression("ArrayLiteral", token.span)
                self.skipNewlines()
                if !self.check("RIGHT_BRACKET") {
                    local more:bool = true
                    while more {
                        self.skipNewlines()
                        literal.arguments.append(self.parseExpression())
                        self.skipNewlines()
                        more = self.accept("COMMA")
                    }
                }
                local end = self.consume("RIGHT_BRACKET", "Expected ']' after array literal")
                literal.span = self.span(token.span, end.span)
                return literal
            }
            local kind:string? = null
            if token.kind == "NULL" { kind = "Null" }
            if token.kind == "TRUE" || token.kind == "FALSE" { kind = "Boolean" }
            if token.kind == "INTEGER_LITERAL" { kind = "Integer" }
            if token.kind == "FLOAT_LITERAL" { kind = "Float" }
            if token.kind == "STRING_LITERAL" {
                if token.lexeme[0] == 34 && self.hasInterpolation(token.lexeme) { return self.parseInterpolatedString(token) }
                kind = "String"
            }
            if token.kind == "IDENTIFIER" { kind = "Identifier" }
            if token.kind == "LEFT_PAREN" {
                local expression = self.parseExpression()
                self.consume("RIGHT_PAREN", "Expected ')' after expression")
                return expression
            }
            if kind == null {
                self.fail("Expected an expression")
                return new Ast.Expression("Error", token.span)
            }
            local expression = new Ast.Expression(kind!, token.span)
            if token.kind == "IDENTIFIER" { expression.name = token.lexeme }
            if token.kind == "STRING_LITERAL" { expression.text = self.decodeString(token.lexeme) } else { expression.text = token.lexeme }
            return expression
        }

        parseIfExpression(start:Compiler.Token) -> Ast.Expression {
            local expression = new Ast.Expression("If", start.span)
            expression.left = self.parseExpression()
            expression.body = self.parseBlock()
            self.skipNewlines()
            self.consume("ELSE", "Expression-valued 'if' requires an 'else' branch")
            if self.accept("IF") {
                local nested = self.parseIfExpression(self.previous())
                local statement = new Ast.Statement("Expression", nested.span)
                statement.expression = nested
                local statements = new Array<Ast.Statement>(0)
                statements.append(statement)
                expression.alternate = new Ast.Block(statements, nested.span)
            } else { expression.alternate = self.parseBlock() }
            expression.span = self.span(start.span, expression.alternate!.span)
            return expression
        }

        decodeString(lexeme:string) -> string {
            local builder = new StringBuilder()
            local index:i64 = 1
            while index < lexeme.length - 1 {
                local character = lexeme[index]
                if character == 92 {
                    index = index + 1
                    character = lexeme[index]
                    if character == 110 { character = 10 }
                    if character == 114 { character = 13 }
                    if character == 116 { character = 9 }
                }
                builder.appendByte(character)
                index = index + 1
            }
            return builder.build()
        }

        hasInterpolation(lexeme:string) -> bool {
            local index:i64 = 1
            while index < lexeme.length - 1 {
                if lexeme[index] == 92 { index = index + 2 } else {
                    if lexeme[index] == 36 && lexeme[index + 1] == 123 { return true }
                    index = index + 1
                }
            }
            return false
        }

        parseInterpolatedString(token:Compiler.Token) -> Ast.Expression {
            local result = new Ast.Expression("InterpolatedString", token.span)
            local text = new StringBuilder()
            local index:i64 = 1
            while index < token.lexeme.length - 1 {
                local character = token.lexeme[index]
                if character == 92 {
                    index = index + 1
                    character = token.lexeme[index]
                    if character == 110 { character = 10 }
                    if character == 114 { character = 13 }
                    if character == 116 { character = 9 }
                    text.appendByte(character)
                    index = index + 1
                } else {
                    if character == 36 && token.lexeme[index + 1] == 123 {
                        local prefix = text.build()
                        if prefix.length > 0 {
                            local literal = new Ast.Expression("String", token.span)
                            literal.text = prefix
                            result.arguments.append(literal)
                        }
                        text = new StringBuilder()
                        local start = index + 2
                        local end = self.interpolationEnd(token.lexeme, start)
                        if end < 0 { self.fail("Unclosed interpolation expression"); return copy result }
                        local sourceText = token.lexeme.slice(start, end - start)
                        local source = new Compiler.SourceFile(token.span.source.path + ":interpolation", sourceText)
                        local tokenizer = new Compiler.Tokenizer(source)
                        local tokens = tokenizer.tokenize()
                        if tokenizer.error != null { self.fail(tokenizer.error!); return copy result }
                        local parser = new Parser(tokens)
                        local expression = parser.parseExpression()
                        parser.skipNewlines()
                        if parser.error != null { self.fail(parser.error!); return copy result }
                        if !parser.check("EOF") { self.fail("Expected '}' after interpolation expression"); return copy result }
                        result.arguments.append(copy expression)
                        index = end + 1
                    } else {
                        text.appendByte(character)
                        index = index + 1
                    }
                }
            }
            local suffix = text.build()
            if suffix.length > 0 {
                local literal = new Ast.Expression("String", token.span)
                literal.text = suffix
                result.arguments.append(literal)
            }
            return copy result
        }

        interpolationEnd(value:string, start:i64) -> i64 {
            local depth:i64 = 1
            local quote:u8 = 0
            local index = start
            while index < value.length - 1 {
                local character = value[index]
                if quote != 0 {
                    if character == 92 { index = index + 1 } else if character == quote { quote = 0 }
                } else {
                    if character == 34 || character == 39 { quote = character }
                    if character == 123 { depth = depth + 1 }
                    if character == 125 {
                        depth = depth - 1
                        if depth == 0 { return index }
                    }
                }
                index = index + 1
            }
            return -1
        }

        precedence(kind:string) -> i64 {
            if kind == "OR" { return 1 }
            if kind == "AND" { return 2 }
            if kind == "BIT_OR" { return 3 }
            if kind == "BIT_XOR" { return 4 }
            if kind == "BIT_AND" { return 5 }
            if kind == "EQUAL_EQUAL" || kind == "BANG_EQUAL" || kind == "EQUAL_EQUAL_EQUAL" || kind == "BANG_EQUAL_EQUAL" || kind == "IS" { return 6 }
            if kind == "LESS" || kind == "LESS_EQUAL" || kind == "GREATER" || kind == "GREATER_EQUAL" { return 7 }
            if kind == "SHIFT_LEFT" || kind == "SHIFT_RIGHT" { return 8 }
            if kind == "PLUS" || kind == "MINUS" { return 9 }
            if kind == "STAR" || kind == "SLASH" { return 10 }
            return 0
        }

        atDeclarationEnd() -> bool {
            return self.check("RIGHT_BRACE") && self.peek(1).kind == "RIGHT_BRACE"
        }
        atSeparator() -> bool { return self.check("NEWLINE") || self.check("SEMICOLON") }
        skipSeparators() -> void { while self.accept("NEWLINE") || self.accept("SEMICOLON") {} }
        skipNewlines() -> void { while self.accept("NEWLINE") {} }
        accept(kind:string) -> bool {
            if !self.check(kind) { return false }
            self.current = self.current + 1
            return true
        }
        check(kind:string) -> bool { return self.peek(0).kind == kind }
        consume(kind:string, message:string) -> ref Compiler.Token {
            if self.check(kind) { return self.advanceToken() }
            self.fail(message)
            return self.peek(0)
        }
        advanceToken() -> ref Compiler.Token {
            local token = self.peek(0)
            if token.kind != "EOF" { self.current = self.current + 1 }
            return token
        }
        peek(distance:i64) -> ref Compiler.Token {
            local index = self.current + distance
            if index >= self.tokens.length { index = self.tokens.length - 1 }
            return self.tokens[index]
        }
        previous() -> ref Compiler.Token { return self.tokens[self.current - 1] }
        span(first:Compiler.SourceSpan, last:Compiler.SourceSpan) -> Compiler.SourceSpan {
            return new Compiler.SourceSpan(first.source, first.start, last.end, first.line, first.column)
        }
        fail(message:string) -> void {
            if self.error != null { return }
            local token = self.peek(0)
            self.error = message
            self.errorSpan = token.span
        }
    }}
}}
