import System from './libSystem.ar'

library Compiler {{
    loadSource(path:string) -> SourceFile? {
        local file = System.openRead(path)
        if file == null {
            return null
        }

        local builder = new StringBuilder()
        while true {
            local chunk = System.read(file!, 4096)
            if chunk == null {
                System.close(file!)
                return null
            }
            local bytes = chunk!
            if bytes.length == 0 {
                break
            }
            builder.append(bytes)
        }
        if System.close(file!) != 0 {
            return null
        }
        return new SourceFile(path, builder.build())
    }

    SourceFile {{
        member path:string
        member content:string

        __(path:string, content:string) -> void {
            self.path = path
            self.content = content
        }
    }}

    SourceSpan {{
        member source:SourceFile
        member start:i64
        member end:i64
        member line:i64
        member column:i64

        __(source:SourceFile, start:i64, end:i64, line:i64, column:i64) -> void {
            self.source = source
            self.start = start
            self.end = end
            self.line = line
            self.column = column
        }

        length() -> i64 {
            return self.end - self.start
        }
    }}

    enum TokenKind {{
        EOF, NEWLINE, IDENTIFIER, INTEGER_LITERAL, FLOAT_LITERAL, STRING_LITERAL
        RETURN, NEW, COPY, OWN, REF, WEAK, DELETE
        IMPORT, FROM, MEMBER, LOCAL, LIBRARY, ENUM, TEST, NATIVE, UNSAFE, PUBLIC, PRIVATE
        INHERITS, IMPLEMENTS, IF, MATCH, CASE, ELSE, WHILE, FOR, IN, BREAK, CONTINUE
        TRUE, FALSE, AS, IS, NULL
        EQUAL, EQUAL_EQUAL, EQUAL_EQUAL_EQUAL, BANG, BANG_EQUAL, BANG_EQUAL_EQUAL
        MINUS, ARROW, LESS, SHIFT_LEFT, LESS_EQUAL, GREATER, SHIFT_RIGHT, GREATER_EQUAL
        BIT_AND, AND, BIT_OR, OR, BIT_XOR, PLUS, STAR, SLASH
        LEFT_PAREN, RIGHT_PAREN, LEFT_BRACE, RIGHT_BRACE, LEFT_BRACKET, RIGHT_BRACKET
        COMMA, DOT, COLON, QUESTION, SEMICOLON
    }}

    Token {{
        member kind:TokenKind
        member lexeme:string
        member span:SourceSpan

        __(kind:TokenKind, lexeme:string, span:SourceSpan) -> void {
            self.kind = kind
            self.lexeme = lexeme
            self.span = span
        }
    }}

    Tokenizer {{
        member source:SourceFile
        member tokens:Array<Token>
        member offset:i64
        member line:i64
        member column:i64
        member error:string?
        member errorSpan:SourceSpan?

        __(source:SourceFile) -> void {
            self.source = source
            self.tokens = new Array<Token>(0)
            self.offset = 0
            self.line = 1
            self.column = 1
            self.error = null
            self.errorSpan = null
        }

        tokenize() -> ref Array<Token> {
            while !self.atEnd() {
                if self.error != null {
                    break
                }
                local character = self.peek(0)
                if character == 10 {
                    self.scanNewline()
                } else {
                    if character == 32 || character == 9 || character == 13 {
                        self.advance()
                    } else {
                        if character == 47 && self.peek(1) == 47 {
                            self.scanComment()
                        } else {
                            if character == 34 || character == 39 {
                                self.scanString()
                            } else {
                                if self.isIdentifierStart(character) {
                                    self.scanIdentifier()
                                } else {
                                    if self.isDigit(character) {
                                        self.scanInteger()
                                    } else {
                                        self.scanSymbol()
                                    }
                                }
                            }
                        }
                    }
                }
            }
            self.tokens.append(new Token(
                Compiler.TokenKind.EOF,
                "",
                new SourceSpan(self.source, self.offset, self.offset, self.line, self.column)
            ))
            return self.tokens
        }

        scanNewline() -> void {
            local start = self.offset
            local tokenLine = self.line
            local tokenColumn = self.column
            self.advance()
            self.addToken(Compiler.TokenKind.NEWLINE, start, tokenLine, tokenColumn)
        }

        scanComment() -> void {
            while !self.atEnd() {
                if self.peek(0) == 10 {
                    break
                }
                self.advance()
            }
        }

        scanString() -> void {
            local start = self.offset
            local tokenLine = self.line
            local tokenColumn = self.column
            local quote = self.advance()
            local closed:bool = false
            while !self.atEnd() {
                local character = self.peek(0)
                if character == quote {
                    self.advance()
                    closed = true
                    break
                }
                if character == 92 {
                    self.advance()
                    if !self.atEnd() {
                        self.advance()
                    }
                } else {
                    if quote == 34 && character == 36 && self.peek(1) == 123 {
                        self.advance()
                        self.advance()
                        local depth:i64 = 1
                        local nestedQuote:u8 = 0
                        while !self.atEnd() && depth > 0 {
                            local nested = self.peek(0)
                            if nestedQuote != 0 {
                                if nested == 92 {
                                    self.advance()
                                    if !self.atEnd() { self.advance() }
                                } else {
                                    if nested == nestedQuote { nestedQuote = 0 }
                                    self.advance()
                                }
                            } else {
                                if nested == 34 || nested == 39 {
                                    nestedQuote = nested
                                } else {
                                    if nested == 123 { depth = depth + 1 }
                                    if nested == 125 { depth = depth - 1 }
                                }
                                self.advance()
                            }
                        }
                        if depth > 0 {
                            self.fail("Unclosed interpolation expression", tokenLine, tokenColumn)
                            return
                        }
                    } else {
                        self.advance()
                    }
                }
            }
            if !closed {
                self.fail("Unclosed string", tokenLine, tokenColumn)
                return
            }
            self.addToken(Compiler.TokenKind.STRING_LITERAL, start, tokenLine, tokenColumn)
        }

        scanIdentifier() -> void {
            local start = self.offset
            local tokenLine = self.line
            local tokenColumn = self.column
            self.advance()
            while self.isIdentifierPart(self.peek(0)) {
                self.advance()
            }
            local value = self.source.content.slice(start, self.offset - start)
            self.tokens.append(new Token(
                self.keywordKind(value),
                value,
                new SourceSpan(self.source, start, self.offset, tokenLine, tokenColumn)
            ))
        }

        scanInteger() -> void {
            local start = self.offset
            local tokenLine = self.line
            local tokenColumn = self.column
            self.advance()
            while self.isDigit(self.peek(0)) {
                self.advance()
            }
            local kind = Compiler.TokenKind.INTEGER_LITERAL
            if self.peek(0) == 46 && self.isDigit(self.peek(1)) {
                kind = Compiler.TokenKind.FLOAT_LITERAL
                self.advance()
                while self.isDigit(self.peek(0)) { self.advance() }
            }
            if self.peek(0) == 101 || self.peek(0) == 69 {
                local next = self.peek(1)
                local signedDigit = (next == 43 || next == 45) && self.isDigit(self.peek(2))
                if self.isDigit(next) || signedDigit {
                    kind = Compiler.TokenKind.FLOAT_LITERAL
                    self.advance()
                    if self.peek(0) == 43 || self.peek(0) == 45 { self.advance() }
                    while self.isDigit(self.peek(0)) { self.advance() }
                }
            }
            self.addToken(kind, start, tokenLine, tokenColumn)
        }

        scanSymbol() -> void {
            local start = self.offset
            local tokenLine = self.line
            local tokenColumn = self.column
            local character = self.advance()
            local kind:TokenKind? = null

            if character == 61 {
                kind = Compiler.TokenKind.EQUAL
                if self.matchByte(61) {
                    kind = Compiler.TokenKind.EQUAL_EQUAL
                    if self.matchByte(61) {
                        kind = Compiler.TokenKind.EQUAL_EQUAL_EQUAL
                    }
                }
            }
            if character == 33 {
                kind = Compiler.TokenKind.BANG
                if self.matchByte(61) {
                    kind = Compiler.TokenKind.BANG_EQUAL
                    if self.matchByte(61) {
                        kind = Compiler.TokenKind.BANG_EQUAL_EQUAL
                    }
                }
            }
            if character == 45 {
                kind = Compiler.TokenKind.MINUS
                if self.matchByte(62) {
                    kind = Compiler.TokenKind.ARROW
                }
            }
            if character == 60 {
                kind = Compiler.TokenKind.LESS
                if self.matchByte(60) { kind = Compiler.TokenKind.SHIFT_LEFT }
                else if self.matchByte(61) { kind = Compiler.TokenKind.LESS_EQUAL }
            }
            if character == 62 {
                kind = Compiler.TokenKind.GREATER
                if self.matchByte(62) { kind = Compiler.TokenKind.SHIFT_RIGHT }
                else if self.matchByte(61) { kind = Compiler.TokenKind.GREATER_EQUAL }
            }
            if character == 38 {
                kind = Compiler.TokenKind.BIT_AND
                if self.matchByte(38) { kind = Compiler.TokenKind.AND }
            }
            if character == 124 {
                kind = Compiler.TokenKind.BIT_OR
                if self.matchByte(124) { kind = Compiler.TokenKind.OR }
            }
            if character == 94 { kind = Compiler.TokenKind.BIT_XOR }
            if character == 43 { kind = Compiler.TokenKind.PLUS }
            if character == 42 { kind = Compiler.TokenKind.STAR }
            if character == 47 { kind = Compiler.TokenKind.SLASH }
            if character == 40 { kind = Compiler.TokenKind.LEFT_PAREN }
            if character == 41 { kind = Compiler.TokenKind.RIGHT_PAREN }
            if character == 123 { kind = Compiler.TokenKind.LEFT_BRACE }
            if character == 125 { kind = Compiler.TokenKind.RIGHT_BRACE }
            if character == 91 { kind = Compiler.TokenKind.LEFT_BRACKET }
            if character == 93 { kind = Compiler.TokenKind.RIGHT_BRACKET }
            if character == 44 { kind = Compiler.TokenKind.COMMA }
            if character == 46 { kind = Compiler.TokenKind.DOT }
            if character == 58 { kind = Compiler.TokenKind.COLON }
            if character == 63 { kind = Compiler.TokenKind.QUESTION }
            if character == 59 { kind = Compiler.TokenKind.SEMICOLON }

            if kind == null {
                self.fail("Unexpected byte " + character.toString(), tokenLine, tokenColumn)
                return
            }
            self.addToken(kind!, start, tokenLine, tokenColumn)
        }

        keywordKind(value:string) -> TokenKind {
            if value == "return" { return Compiler.TokenKind.RETURN }
            if value == "new" { return Compiler.TokenKind.NEW }
            if value == "copy" { return Compiler.TokenKind.COPY }
            if value == "own" { return Compiler.TokenKind.OWN }
            if value == "ref" { return Compiler.TokenKind.REF }
            if value == "weak" { return Compiler.TokenKind.WEAK }
            if value == "delete" { return Compiler.TokenKind.DELETE }
            if value == "import" { return Compiler.TokenKind.IMPORT }
            if value == "from" { return Compiler.TokenKind.FROM }
            if value == "member" { return Compiler.TokenKind.MEMBER }
            if value == "local" { return Compiler.TokenKind.LOCAL }
            if value == "library" { return Compiler.TokenKind.LIBRARY }
            if value == "enum" { return Compiler.TokenKind.ENUM }
            if value == "test" { return Compiler.TokenKind.TEST }
            if value == "native" { return Compiler.TokenKind.NATIVE }
            if value == "unsafe" { return Compiler.TokenKind.UNSAFE }
            if value == "public" { return Compiler.TokenKind.PUBLIC }
            if value == "private" { return Compiler.TokenKind.PRIVATE }
            if value == "inherits" { return Compiler.TokenKind.INHERITS }
            if value == "implements" { return Compiler.TokenKind.IMPLEMENTS }
            if value == "if" { return Compiler.TokenKind.IF }
            if value == "match" { return Compiler.TokenKind.MATCH }
            if value == "case" { return Compiler.TokenKind.CASE }
            if value == "else" { return Compiler.TokenKind.ELSE }
            if value == "while" { return Compiler.TokenKind.WHILE }
            if value == "for" { return Compiler.TokenKind.FOR }
            if value == "in" { return Compiler.TokenKind.IN }
            if value == "break" { return Compiler.TokenKind.BREAK }
            if value == "continue" { return Compiler.TokenKind.CONTINUE }
            if value == "true" { return Compiler.TokenKind.TRUE }
            if value == "false" { return Compiler.TokenKind.FALSE }
            if value == "as" { return Compiler.TokenKind.AS }
            if value == "is" { return Compiler.TokenKind.IS }
            if value == "null" { return Compiler.TokenKind.NULL }
            return Compiler.TokenKind.IDENTIFIER
        }

        addToken(kind:TokenKind, start:i64, tokenLine:i64, tokenColumn:i64) -> void {
            self.tokens.append(new Token(
                kind,
                self.source.content.slice(start, self.offset - start),
                new SourceSpan(self.source, start, self.offset, tokenLine, tokenColumn)
            ))
        }

        matchByte(expected:u8) -> bool {
            if self.peek(0) != expected {
                return false
            }
            self.advance()
            return true
        }

        advance() -> u8 {
            local character = self.source.content[self.offset]
            self.offset = self.offset + 1
            if character == 10 {
                self.line = self.line + 1
                self.column = 1
            } else {
                self.column = self.column + 1
            }
            return character
        }

        peek(distance:i64) -> u8 {
            local index = self.offset + distance
            if index >= self.source.content.length {
                return 0
            }
            return self.source.content[index]
        }

        atEnd() -> bool {
            return self.offset >= self.source.content.length
        }

        isDigit(character:u8) -> bool {
            return character >= 48 && character <= 57
        }

        isIdentifierStart(character:u8) -> bool {
            if character >= 65 && character <= 90 { return true }
            if character >= 97 && character <= 122 { return true }
            return character == 95
        }

        isIdentifierPart(character:u8) -> bool {
            if self.isIdentifierStart(character) { return true }
            return self.isDigit(character)
        }

        fail(message:string, errorLine:i64, errorColumn:i64) -> void {
            self.error = message
            self.errorSpan = new SourceSpan(
                self.source,
                self.offset,
                self.offset,
                errorLine,
                errorColumn
            )
        }
    }}
}}
