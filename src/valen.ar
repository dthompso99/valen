import System from './libSystem.ar'
import Compiler from './libCompiler.ar'
import Ast from './libAst.ar'
import Parsing from './libParser.ar'
import Diagnostics from './libDiagnostics.ar'
import ModuleLoading from './libModuleLoader.ar'
import Semantics from './libSemantic.ar'
import Ir from './libIr.ar'
import IrValidation from './libIrValidation.ar'
import X86_64 from './libX86_64.ar'
import X86Object from './libX86Object.ar'
import AArch64 from './libAArch64.ar'
import AArch64Object from './libAArch64Object.ar'
import LLVM from './libLLVM.ar'
import CompilerCache from './libCompilerCache.ar'
import Linking from './libLinker.ar'
import Elf from './libElf.ar'
import LibraryMetadata from './libLibraryMetadata.ar'
import ModuleInterfaces from './libModuleInterface.ar'
import Target from './libTarget.ar'
import BuildIdentity from './libBuildIdentity.ar'
import ProjectManifest from './libProjectManifest.ar'

entry {{
    __() -> i32 {
        System.enableProcessArena()
        local arguments = System.arguments()
        local compilerArguments = new Array<string>(0)
        compilerArguments.append(arguments[0])
        local optimizationLevel:i64 = 1
        local configuredSourceRoot:string? = null
        local linkerMode:string = "auto"
        local backendName:string = "native"
        local runtimeMetrics:bool = false
        local diagnosticFormat:string = "human"
        local targetName = self.hostTarget()
        local environmentTarget = System.environmentVariable("VALEN_TARGET")
        if environmentTarget != null { targetName = environmentTarget! }
        if arguments.length >= 3 && arguments[1] == "--validate-project" {
            if arguments.length == 3 { return self.validateProjectManifest(arguments[2], null, targetName) }
            if arguments.length == 4 && arguments[2] == "--locked" { return self.validateProjectManifest(arguments[3], self.directoryName(arguments[3]) + "/valen.lock", targetName) }
            if arguments.length == 5 && arguments[2] == "--locked" { return self.validateProjectManifest(arguments[3], arguments[4], targetName) }
            self.writeUsage(); return 64
        }
        local projectManifest:ProjectManifest.Manifest? = null
        local projectLock:ProjectManifest.Lock? = null
        local projectRoot:string? = null
        local projectManifestSource:string? = null
        local projectLockSource:string? = null
        local projectMode:bool = arguments.length >= 2 && arguments[1] == "--build-project"
        local libraryVersion:string? = null
        local argumentIndex:i64 = 1
        if projectMode {
            if arguments.length < 3 || arguments.length > 4 { self.writeUsage(); return 64 }
            local cwd = System.currentDirectory(); if cwd == null { System.writeError("valen: could not determine current directory\n"); return 74 }
            local manifestPath = arguments[2]; if manifestPath.length == 0 || manifestPath[0] != 47 { manifestPath = cwd! + "/" + manifestPath }
            projectRoot = self.directoryName(manifestPath)
            local lockPath = projectRoot! + "/valen.lock"; if arguments.length == 4 { lockPath = arguments[3]; if lockPath.length == 0 || lockPath[0] != 47 { lockPath = cwd! + "/" + lockPath } }
            local manifestSource = Compiler.loadSource(manifestPath); local lockSource = Compiler.loadSource(lockPath)
            if manifestSource == null { System.writeError("valen: project manifest is missing\n"); return 66 }
            if lockSource == null { System.writeError("valen: project lockfile is missing\n"); return 66 }
            local codec = new ProjectManifest.Codec(); local parsed = codec.parse(manifestSource!.content); local locked = codec.parseLock(lockSource!.content)
            if !parsed.valid { System.writeError("valen: project manifest: "); System.writeError(parsed.message); System.writeError("\n"); return 65 }
            if !locked.valid { System.writeError("valen: project lockfile: "); System.writeError(locked.message); System.writeError("\n"); return 65 }
            projectManifest = parsed.manifest!; projectLock = locked.lock!
            projectManifestSource = codec.serialize(projectManifest!); projectLockSource = codec.serializeLock(projectLock!)
            local stale = codec.verify(projectManifest!, projectLock!, targetName)
            if stale != null { System.writeError("valen: "); System.writeError(stale!); System.writeError("\n"); return 65 }
            local artifactError = self.validateLockedArtifacts(projectLock!, projectRoot!)
            if artifactError != null { System.writeError("valen: "); System.writeError(artifactError!); System.writeError("\n"); return 65 }
            local dependencyIndex:i64 = 0
            while dependencyIndex < projectManifest!.dependencies.length { if projectManifest!.dependencies[dependencyIndex].source == null { System.writeError("valen: project dependency '" + projectManifest!.dependencies[dependencyIndex].name + "' requires a source path for builds\n"); return 65 }; dependencyIndex = dependencyIndex + 1 }
            targetName = projectLock!.target; optimizationLevel = projectManifest!.optimization; configuredSourceRoot = projectRoot!
            compilerArguments.append(projectRoot! + "/" + projectManifest!.source)
            compilerArguments.append("-o"); compilerArguments.append(projectRoot! + "/" + projectManifest!.output)
            argumentIndex = arguments.length
        }
        while argumentIndex < arguments.length {
            local argument = arguments[argumentIndex]
            if argument == "--linker" {
                if argumentIndex + 1 >= arguments.length { System.writeError("valen: --linker requires auto, native, or system\n"); return 64 }
                linkerMode = arguments[argumentIndex + 1]
                if linkerMode != "auto" && linkerMode != "native" && linkerMode != "system" { System.writeError("valen: unsupported linker '"); System.writeError(linkerMode); System.writeError("'\n"); return 64 }
                argumentIndex = argumentIndex + 1
            } else if argument == "--backend" {
                if argumentIndex + 1 >= arguments.length { System.writeError("valen: --backend requires native or llvm\n"); return 64 }
                backendName = arguments[argumentIndex + 1]
                if backendName != "native" && backendName != "llvm" { System.writeError("valen: unsupported backend '"); System.writeError(backendName); System.writeError("'\n"); return 64 }
                argumentIndex = argumentIndex + 1
            } else if argument == "--source-root" {
                if argumentIndex + 1 >= arguments.length { System.writeError("valen: --source-root requires a directory\n"); return 64 }
                configuredSourceRoot = arguments[argumentIndex + 1]
                argumentIndex = argumentIndex + 1
            } else if argument == "--target" {
                if argumentIndex + 1 >= arguments.length { System.writeError("valen: --target requires a target triple\n"); return 64 }
                targetName = arguments[argumentIndex + 1]
                argumentIndex = argumentIndex + 1
            } else if argument == "--library-version" {
                if argumentIndex + 1 >= arguments.length { System.writeError("valen: --library-version requires a semantic version\n"); return 64 }
                libraryVersion = arguments[argumentIndex + 1]; argumentIndex = argumentIndex + 1
            } else if argument == "--runtime-metrics" {
                runtimeMetrics = true
            } else if argument == "--diagnostic-format" {
                if argumentIndex + 1 >= arguments.length { System.writeError("valen: --diagnostic-format requires human or json\n"); return 64 }
                diagnosticFormat = arguments[argumentIndex + 1]
                if diagnosticFormat != "human" && diagnosticFormat != "json" { System.writeError("valen: unsupported diagnostic format '${diagnosticFormat}'\n"); return 64 }
                argumentIndex = argumentIndex + 1
            } else if argument == "-O0" {
                optimizationLevel = 0
            } else if argument == "-O1" {
                optimizationLevel = 1
            } else {
                if argument.length >= 2 && argument.slice(0, 2) == "-O" {
                    System.writeError("valen: unsupported optimization level '${argument}'\n")
                    return 64
                }
                compilerArguments.append(argument)
            }
            argumentIndex = argumentIndex + 1
        }
        if compilerArguments.length == 2 {
            if compilerArguments[1] == "--help" {
                self.writeUsage()
                return 0
            }
        }
        if compilerArguments.length == 3 { if compilerArguments[1] == "--validate-library" { return self.validateCompiledLibrary(compilerArguments[2], targetName) } }

        local sourcePath:string? = null
        local outputPath:string? = null
        local checkOnly:bool = false
        local emitIr:bool = false
        local emitObjectOnly:bool = false
        local emitLibrary:bool = false
        if compilerArguments.length == 2 {
            sourcePath = compilerArguments[1]
        } else {
            if compilerArguments.length == 3 {
                if compilerArguments[1] == "--check" {
                    checkOnly = true
                    sourcePath = compilerArguments[2]
                } else {
                    if compilerArguments[1] == "--emit-ir" {
                        emitIr = true
                        sourcePath = compilerArguments[2]
                    }
                }
            } else {
                if compilerArguments.length == 4 {
                    if compilerArguments[2] == "-o" {
                        sourcePath = compilerArguments[1]
                        outputPath = compilerArguments[3]
                    }
                } else {
                    if compilerArguments.length == 5 {
                        if compilerArguments[1] == "--emit-object" && compilerArguments[3] == "-o" {
                            emitObjectOnly = true; sourcePath = compilerArguments[2]; outputPath = compilerArguments[4]
                        } else if compilerArguments[1] == "--emit-library" && compilerArguments[3] == "-o" {
                            emitLibrary = true; sourcePath = compilerArguments[2]; outputPath = compilerArguments[4]
                        }
                    }
                }
            }
        }
        if sourcePath == null {
            self.writeUsage()
            return 64
        }
        local targetResolver = new Target.Resolver()
        local target = targetResolver.resolve(targetName)
        if target == null {
            System.writeError("valen: unsupported target '"); System.writeError(targetName)
            System.writeError("'; supported targets: "); System.writeError(targetResolver.supported()); System.writeError("\n")
            return 64
        }
        targetName = target!.name
        if backendName == "llvm" && targetName != "x86_64-linux" { System.writeError("valen: LLVM backend currently supports only x86_64-linux\n"); return 64 }
        if emitLibrary && libraryVersion == null { System.writeError("valen: --emit-library requires --library-version <major.minor.patch>\n"); return 64 }

        local cwd = System.currentDirectory()
        if cwd == null {
            System.writeError("valen: could not determine current directory\n")
            return 74
        }
        local sourceRoot = cwd!
        if configuredSourceRoot != null {
            if configuredSourceRoot!.length > 0 { if configuredSourceRoot![0] == 47 { sourceRoot = configuredSourceRoot! } else { sourceRoot = cwd! + "/" + configuredSourceRoot! } }
        }
        local libraryPath = System.environmentVariable("VALEN_LIBRARY_PATH")
        if libraryPath == null { libraryPath = System.environmentVariable("ARGON_LIBRARY_PATH") }
        if projectMode {
            local dependencyIndex:i64 = 0
            while dependencyIndex < projectManifest!.dependencies.length {
                local dependencyRoot = self.directoryName(projectRoot! + "/" + projectManifest!.dependencies[dependencyIndex].source!)
                if libraryPath == null || libraryPath!.length == 0 { libraryPath = dependencyRoot } else { libraryPath = libraryPath! + ":" + dependencyRoot }
                dependencyIndex = dependencyIndex + 1
            }
        }
        local sysroot = System.environmentVariable("VALEN_SYSROOT")
        if sysroot == null {
            local executable = arguments[0]
            if executable.length > 0 {
                if executable[0] != 47 { executable = cwd! + "/" + executable }
                sysroot = self.directoryName(executable) + "/../lib/valen/current/" + targetName
            }
        }
        local loader = new ModuleLoading.ModuleLoader(sourceRoot, libraryPath, sysroot)
        local graph = loader.load(sourcePath!)
        if graph.diagnostics.hasErrors() {
            Diagnostics.write(graph.diagnostics, diagnosticFormat)
            return 65
        }
        if projectMode {
            local dependencyIndex:i64 = 0
            while dependencyIndex < projectManifest!.dependencies.length {
                local dependency = projectManifest!.dependencies[dependencyIndex]
                local expectedSource = loader.normalizePath(projectRoot! + "/" + dependency.source!)
                local module = loader.find(expectedSource)
                if module == null { System.writeError("valen: project dependency '" + dependency.name + "' source was not loaded by the executable graph\n"); return 65 }
                local metadataPath = loader.normalizePath(projectRoot! + "/" + dependency.metadata)
                local objectPath = metadataPath.slice(0, metadataPath.length - 6)
                module!.compiledObjectPath = objectPath; module!.compiledMetadataPath = metadataPath; module!.compiledInterfacePath = objectPath + ".vmi"
                dependencyIndex = dependencyIndex + 1
            }
        }
        if !self.validateCompiledArtifacts(graph, targetName) { return 65 }
        local cache = new CompilerCache.Cache(optimizationLevel, targetName)
        if backendName == "native" && !runtimeMetrics && cache.enabled() { cache.prepareInterfaces(graph) }
        if backendName == "native" && !runtimeMetrics && outputPath != null && cache.enabled() {
            local cached = cache.load(graph)
            if cached != null {
                if emitObjectOnly { return self.emitObject(cached!.assembly, outputPath!, targetName) }
                local cachedLinkResult = self.link(cached!.assembly, outputPath!, cached!.libraries, linkerMode, null, graph, optimizationLevel, null, null, targetName, false, projectManifestSource, projectLockSource)
                if cachedLinkResult != 0 {
                    System.writeError("valen: linker exited with status ")
                    System.writeError(cachedLinkResult.toString())
                    System.writeError("\n")
                    return 69
                }
                return 0
            }
        }
        local analyzer = new Semantics.Analyzer(graph)
        local analysis = analyzer.analyze()
        if !analysis.success() {
            Diagnostics.write(analysis.diagnostics, diagnosticFormat)
            return 65
        }
        if checkOnly { return 0 }
        local emissionModule:string? = null
        if backendName == "native" && outputPath != null && !emitObjectOnly && graph.modules.length > 1 && graph.entry != null { emissionModule = graph.entry!.path }
        local generator = new Ir.Generator(analysis, emissionModule)
        local ir = generator.generate()
        if emissionModule != null && (linkerMode == "system" || ir.foreignLibraries.length > 0 || ir.compiledModules.length > 0) {
            emissionModule = null
            generator = new Ir.Generator(analysis)
            ir = generator.generate()
        }
        local irPass = new IrValidation.Pass()
        local irErrors = irPass.prepare(ir, optimizationLevel == 1, !emitLibrary)
        if irErrors.length > 0 {
            for error in irErrors { System.writeError("valen: invalid IR: ${error}\n") }
            return 70
        }
        if emitIr {
            local normalizer = new Ir.Normalizer()
            System.write(normalizer.format(ir))
            return 0
        }
        if emitLibrary && backendName == "native" { return self.emitCompiledLibrary(graph, ir, outputPath!, libraryVersion!, optimizationLevel, targetName) }
        if backendName == "llvm" {
            if emitLibrary {
                local unsupported = self.unsupportedLlvmLibraryMetadata(ir, graph.entry!.path)
                if unsupported != null { System.writeError("valen: LLVM compiled library " + unsupported! + "\n"); return 69 }
            }
            local llvmEmissionModule = emissionModule
            if llvmEmissionModule == null && graph.entry != null { llvmEmissionModule = graph.entry!.path }
            local backend = new LLVM.Backend(ir, optimizationLevel, llvmEmissionModule)
            local llvm = backend.generate()
            if backend.error.length > 0 { System.writeError("valen: LLVM backend: "); System.writeError(backend.error); System.writeError("\n"); return 69 }
            if outputPath == null { System.write(llvm); return 0 }
            local llvmPath = outputPath! + ".ll"
            if !self.writeAssembly(llvmPath, llvm) { return 74 }
            local llvmObjectPath = outputPath! + ".llvm.o"
            if emitObjectOnly || emitLibrary { llvmObjectPath = outputPath! }
            local llvmResult = System.compileLlvm(llvmPath, llvmObjectPath, optimizationLevel, true)
            if llvmResult != 0 {
                System.writeError("valen: LLVM toolchain exited with status "); System.writeError(llvmResult.toString()); System.writeError("; expected /usr/bin/clang\n")
                return 69
            }
            if emitLibrary { return self.emitLlvmCompiledLibraryMetadata(graph, outputPath!, libraryVersion!, targetName) }
            if emitObjectOnly { return 0 }
            local runtimeBackend = new X86_64.Backend(ir, optimizationLevel, "<llvm-runtime>", true, false, runtimeMetrics)
            local runtimeErrors = runtimeBackend.validateRuntime()
            if runtimeErrors.length > 0 { for error in runtimeErrors { System.writeError("valen: target: ${error}\n") }; return 69 }
            local runtimeAssembly = runtimeBackend.generate()
            local runtimeObjectPath = outputPath! + ".runtime.o"
            if self.emitObject(runtimeAssembly, runtimeObjectPath, targetName) != 0 { return 69 }
            local llvmInputs = new Array<string>(0)
            llvmInputs.append("@" + llvmObjectPath)
            local compiledIndex:i64 = 0
            while compiledIndex < graph.modules.length {
                local compiledModule = graph.modules[compiledIndex]
                if compiledModule.compiledObjectPath != null { llvmInputs.append("@" + compiledModule.compiledObjectPath!) }
                compiledIndex = compiledIndex + 1
            }
            local llvmLibraryIndex:i64 = 0
            while llvmLibraryIndex < ir.foreignLibraries.length { llvmInputs.append(ir.foreignLibraries[llvmLibraryIndex]); llvmLibraryIndex = llvmLibraryIndex + 1 }
            local linkResult = System.link(runtimeObjectPath, outputPath!, llvmInputs)
            if linkResult != 0 { System.writeError("valen: LLVM linker exited with status "); System.writeError(linkResult.toString()); System.writeError("\n"); return 69 }
            local llvmIdentity = new BuildIdentity.Builder(graph, targetName, optimizationLevel, "llvm", "system", runtimeMetrics, ir.foreignLibraries)
            local llvmArtifact = Compiler.loadSource(outputPath!)
            if llvmArtifact == null || !llvmIdentity.write(outputPath!, llvmArtifact!.content) { System.writeError("valen: could not write build identity\n"); return 74 }
            return 0
        }
        local runtimeErrors = new Array<string>(0)
        local assembly = ""
        if targetName == "aarch64-linux" { local backend = new AArch64.Backend(ir, optimizationLevel, graph.entry!.path); runtimeErrors = backend.validateRuntime(); assembly = backend.generate(); if backend.error.length > 0 { runtimeErrors.append(backend.error) } }
        else { local backend = new X86_64.Backend(ir, optimizationLevel, null, true, false, runtimeMetrics); runtimeErrors = backend.validateRuntime(); assembly = backend.generate() }
        if runtimeErrors.length > 0 {
            for error in runtimeErrors { System.writeError("valen: target: ${error}\n") }
            return 69
        }
        if outputPath != null {
            if emissionModule == null && !runtimeMetrics { cache.store(graph, assembly, ir.foreignLibraries) }
            if emitObjectOnly { return self.emitObject(assembly, outputPath!, targetName) }
            local linkResult = self.link(assembly, outputPath!, ir.foreignLibraries, linkerMode, ir, graph, optimizationLevel, cache, analysis, targetName, runtimeMetrics, projectManifestSource, projectLockSource)
            if linkResult != 0 {
                System.writeError("valen: linker exited with status ")
                System.writeError(linkResult.toString())
                System.writeError("\n")
                return 69
            }
            return 0
        }
        System.write(assembly)
        return 0
    }

    hostTarget() -> string {
        local file = System.openRead("/proc/self/exe")
        if file != null {
            local header = System.read(file!, 20)
            System.close(file!)
            if header != null {
                if header!.length >= 20 && header![0] == 127 && header![1] == 69 && header![2] == 76 && header![3] == 70 {
                    local machine = (header![18] as i64) + (header![19] as i64) * 256
                    if machine == 62 { return "x86_64-linux" }
                    if machine == 183 { return "aarch64-linux" }
                }
            }
        }
        return "x86_64-linux"
    }

    emitObject(assembly:string, objectPath:string, targetName:string) -> i32 {
        local object:Array<u8>? = null
        local error = ""
        if targetName == "aarch64-linux" { local assembler = new AArch64Object.Assembler(); object = assembler.assemble(assembly); error = assembler.error }
        else { local assembler = new X86Object.Assembler(); object = assembler.assemble(assembly); error = assembler.error }
        if object == null {
            System.writeError("valen: native object encoder does not support generated assembly: "); System.writeError(error); System.writeError("\n")
            return 69
        }
        if !self.writeObject(objectPath, object!) { return 74 }
        return 0
    }

    emitCompiledLibrary(graph:ModuleLoading.ModuleGraph, ir:Ir.Program, objectPath:string, version:string, optimizationLevel:i64, targetName:string) -> i32 {
        if graph.entry == null { System.writeError("valen: compiled library has no source module\n"); return 65 }
        local libraryName:string? = null; local declarationIndex:i64 = 0
        while declarationIndex < graph.entry!.program.declarations.length {
            local declaration = graph.entry!.program.declarations[declarationIndex]
            if declaration.kind == "Library" { if libraryName != null { System.writeError("valen: compiled library source must declare exactly one library\n"); return 65 }; libraryName = declaration.name }
            declarationIndex = declarationIndex + 1
        }
        if libraryName == null { System.writeError("valen: compiled library source must declare exactly one library\n"); return 65 }
        local libraryAssembly = self.generateAssembly(ir, targetName, optimizationLevel, graph.entry!.path, false, true)
        local structured = self.assembleObject(libraryAssembly, targetName)
        if structured == null { System.writeError("valen: native library object encoder failed\n"); return 69 }
        local object = structured!.build()
        if !self.writeObject(objectPath, object) { return 74 }
        local interfaceBuilder = new ModuleInterfaces.Builder(); local artifact = interfaceBuilder.create(graph.entry!)
        local dependencies = new Array<LibraryMetadata.Dependency>(0); local importIndex:i64 = 0
        while importIndex < graph.entry!.imports.length {
            local imported = graph.entry!.imports[importIndex]
            local importedArtifact = interfaceBuilder.create(imported.loadedModule)
            dependencies.append(new LibraryMetadata.Dependency(imported.name, importedArtifact.interfaceFingerprint.toString()))
            importIndex = importIndex + 1
        }
        local codec = new LibraryMetadata.Codec(targetName)
        local metadata = codec.create(libraryName!, version, artifact.interfaceFingerprint.toString(), artifact.implementationFingerprint.toString(), object, dependencies)
        if metadata == null { System.writeError("valen: "); System.writeError(codec.error); System.writeError("\n"); return 64 }
        if !codec.write(objectPath + ".vmeta", metadata!) { System.writeError("valen: "); System.writeError(codec.error); System.writeError("\n"); return 74 }
        if !self.writeAssembly(objectPath + ".vmi", artifact.summary) { return 74 }
        return 0
    }

    unsupportedLlvmLibraryMetadata(ir:Ir.Program, modulePath:string) -> string? {
        local typeIndex:i64 = 0
        while typeIndex < ir.types.length {
            if ir.types[typeIndex].modulePath == modulePath { return "cannot yet own object GC/type/structural metadata" }
            typeIndex = typeIndex + 1
        }
        local referencedIndex:i64 = 0
        while referencedIndex < ir.referencedTypes.length {
            local referenced = ir.referencedTypes[referencedIndex]
            if referenced.length >= 7 && referenced.slice(0, 6) == "Array<" { return "cannot yet own specialized array metadata" }
            referencedIndex = referencedIndex + 1
        }
        return null
    }

    emitLlvmCompiledLibraryMetadata(graph:ModuleLoading.ModuleGraph, objectPath:string, version:string, targetName:string) -> i32 {
        local libraryName:string? = null; local declarationIndex:i64 = 0
        while declarationIndex < graph.entry!.program.declarations.length {
            local declaration = graph.entry!.program.declarations[declarationIndex]
            if declaration.kind == "Library" { if libraryName != null { System.writeError("valen: compiled library source must declare exactly one library\n"); return 65 }; libraryName = declaration.name }
            declarationIndex = declarationIndex + 1
        }
        if libraryName == null { System.writeError("valen: compiled library source must declare exactly one library\n"); return 65 }
        local object = Compiler.loadSource(objectPath)
        if object == null { System.writeError("valen: LLVM compiled library object is missing\n"); return 74 }
        local interfaceBuilder = new ModuleInterfaces.Builder(); local artifact = interfaceBuilder.create(graph.entry!)
        local dependencies = new Array<LibraryMetadata.Dependency>(0); local importIndex:i64 = 0
        while importIndex < graph.entry!.imports.length {
            local imported = graph.entry!.imports[importIndex]
            local importedArtifact = interfaceBuilder.create(imported.loadedModule)
            dependencies.append(new LibraryMetadata.Dependency(imported.name, importedArtifact.interfaceFingerprint.toString()))
            importIndex = importIndex + 1
        }
        local codec = new LibraryMetadata.Codec(targetName)
        local metadata = codec.createFromContent(libraryName!, version, artifact.interfaceFingerprint.toString(), artifact.implementationFingerprint.toString(), object!.content, dependencies)
        if metadata == null { System.writeError("valen: "); System.writeError(codec.error); System.writeError("\n"); return 64 }
        if !codec.write(objectPath + ".vmeta", metadata!) { System.writeError("valen: "); System.writeError(codec.error); System.writeError("\n"); return 74 }
        if !self.writeAssembly(objectPath + ".vmi", artifact.summary) { return 74 }
        return 0
    }

    validateCompiledArtifacts(graph:ModuleLoading.ModuleGraph, targetName:string) -> bool {
        local builder = new ModuleInterfaces.Builder()
        local moduleIndex:i64 = 0
        while moduleIndex < graph.modules.length {
            local module = graph.modules[moduleIndex]
            if module.compiledObjectPath != null {
                local objectSource = Compiler.loadSource(module.compiledObjectPath!)
                local metadataSource = Compiler.loadSource(module.compiledMetadataPath!)
                local interfaceSource = Compiler.loadSource(module.compiledInterfacePath!)
                if objectSource == null || metadataSource == null || interfaceSource == null {
                    System.writeError("valen: installed library artifact disappeared while loading '"); System.writeError(module.path); System.writeError("'\n"); return false
                }
                local codec = new LibraryMetadata.Codec(targetName); local metadata = codec.parse(metadataSource!.content)
                if metadata == null { System.writeError("valen: invalid installed library metadata for '"); System.writeError(module.path); System.writeError("': "); System.writeError(codec.error); System.writeError("\n"); return false }
                local artifact = builder.create(module)
                if artifact.interfaceFingerprint.toString() != metadata!.interfaceFingerprint || interfaceSource!.content != artifact.summary {
                    System.writeError("valen: installed library interface does not match source for '"); System.writeError(module.path); System.writeError("'\n"); return false
                }
                if codec.hashString(objectSource!.content).toString() != metadata!.objectFingerprint {
                    System.writeError("valen: installed library object fingerprint does not match metadata for '"); System.writeError(module.path); System.writeError("'\n"); return false
                }
                local dependencyIndex:i64 = 0
                while dependencyIndex < metadata!.dependencies.length {
                    local dependency = metadata!.dependencies[dependencyIndex]
                    local found:bool = false
                    local importIndex:i64 = 0
                    while importIndex < module.imports.length {
                        local imported = module.imports[importIndex]
                        if imported.name == dependency.name {
                            found = true
                            if builder.create(imported.loadedModule).interfaceFingerprint.toString() != dependency.interfaceFingerprint {
                                System.writeError("valen: installed library dependency interface mismatch for '"); System.writeError(dependency.name); System.writeError("'\n"); return false
                            }
                        }
                        importIndex = importIndex + 1
                    }
                    if !found { System.writeError("valen: installed library metadata names missing dependency '"); System.writeError(dependency.name); System.writeError("'\n"); return false }
                    dependencyIndex = dependencyIndex + 1
                }
            }
            moduleIndex = moduleIndex + 1
        }
        return true
    }

    validateCompiledLibrary(path:string, targetName:string) -> i32 {
        local source = Compiler.loadSource(path)
        if source == null { System.writeError("valen: cannot load library metadata; OS error "); System.writeError(System.lastError().toString()); System.writeError("\n"); return 66 }
        local resolver = new Target.Resolver()
        local target = resolver.resolve(targetName)
        if target == null { System.writeError("valen: unsupported target '"); System.writeError(targetName); System.writeError("'\n"); return 64 }
        local normalizedTarget = target!.name
        local codec = new LibraryMetadata.Codec(normalizedTarget); local metadata = codec.parse(source!.content)
        if metadata == null { System.writeError("valen: "); System.writeError(codec.error); System.writeError("\n"); return 65 }
        if path.length < 7 || path.slice(path.length - 6, 6) != ".vmeta" { System.writeError("valen: library metadata path must end in .vmeta\n"); return 65 }
        local objectSource = Compiler.loadSource(path.slice(0, path.length - 6))
        if objectSource == null { System.writeError("valen: compiled library object is missing\n"); return 66 }
        if codec.hashString(objectSource!.content).toString() != metadata!.objectFingerprint { System.writeError("valen: compiled library object fingerprint does not match metadata\n"); return 65 }
        System.write(metadata!.name); System.write(" "); System.write(metadata!.version); System.write("\n")
        return 0
    }

    validateProjectManifest(path:string, lockPath:string?, selectedTarget:string) -> i32 {
        local source = Compiler.loadSource(path)
        if source == null { System.writeError("valen: cannot load project manifest; OS error "); System.writeError(System.lastError().toString()); System.writeError("\n"); return 66 }
        local parsed = (new ProjectManifest.Codec()).parse(source!.content)
        if !parsed.valid {
            System.writeError("valen: project manifest"); if parsed.offset > 0 { System.writeError(" at byte "); System.writeError(parsed.offset.toString()) }
            System.writeError(": "); System.writeError(parsed.message); System.writeError("\n"); return 65
        }
        local manifest = parsed.manifest!
        if lockPath != null {
            local lockSource = Compiler.loadSource(lockPath!)
            if lockSource == null { System.writeError("valen: project lockfile is missing\n"); return 66 }
            local locked = (new ProjectManifest.Codec()).parseLock(lockSource!.content)
            if !locked.valid {
                System.writeError("valen: project lockfile"); if locked.offset > 0 { System.writeError(" at byte "); System.writeError(locked.offset.toString()) }
                System.writeError(": "); System.writeError(locked.message); System.writeError("\n"); return 65
            }
            local stale = (new ProjectManifest.Codec()).verify(manifest, locked.lock!, selectedTarget)
            if stale != null { System.writeError("valen: "); System.writeError(stale!); System.writeError("\n"); return 65 }
            local artifactError = self.validateLockedArtifacts(locked.lock!, self.directoryName(path))
            if artifactError != null { System.writeError("valen: "); System.writeError(artifactError!); System.writeError("\n"); return 65 }
        }
        System.write(manifest.name); System.write(" "); System.write(manifest.version); System.write(" "); System.write(manifest.source); System.write("\n")
        return 0
    }

    validateLockedArtifacts(lock:ProjectManifest.Lock, root:string) -> string? {
        local index:i64 = 0
        while index < lock.dependencies.length {
            local dependency = lock.dependencies[index]
            if dependency.metadata.length < 7 || dependency.metadata.slice(dependency.metadata.length - 6, 6) != ".vmeta" { return "project dependency '" + dependency.name + "' metadata path must end in .vmeta" }
            local metadataPath = root + "/" + dependency.metadata
            local objectPath = metadataPath.slice(0, metadataPath.length - 6)
            local interfacePath = objectPath + ".vmi"
            local metadataSource = Compiler.loadSource(metadataPath)
            local objectSource = Compiler.loadSource(objectPath)
            local interfaceSource = Compiler.loadSource(interfacePath)
            if metadataSource == null || objectSource == null || interfaceSource == null { return "project dependency '" + dependency.name + "' locked artifacts are missing" }
            local codec = new LibraryMetadata.Codec(lock.target)
            local metadata = codec.parse(metadataSource!.content)
            if metadata == null { return "invalid project dependency '" + dependency.name + "' metadata: " + codec.error }
            if metadata!.name != dependency.name || metadata!.version != dependency.version || metadata!.compiler != dependency.compiler || metadata!.target != dependency.target || metadata!.abi != dependency.abi || metadata!.interfaceFingerprint != dependency.interfaceFingerprint || metadata!.implementationFingerprint != dependency.implementationFingerprint || metadata!.objectFingerprint != dependency.objectFingerprint { return "project dependency '" + dependency.name + "' metadata does not match the lockfile" }
            if codec.hashString(objectSource!.content).toString() != dependency.objectFingerprint { return "project dependency '" + dependency.name + "' object fingerprint does not match the lockfile" }
            if codec.hashString(interfaceSource!.content).toString() != dependency.interfaceFingerprint { return "project dependency '" + dependency.name + "' interface fingerprint does not match the lockfile" }
            if dependency.source != null {
                local implementationSource = Compiler.loadSource(root + "/" + dependency.source!)
                if implementationSource == null { return "project dependency '" + dependency.name + "' source is missing" }
                if codec.hashString(implementationSource!.content).toString() != dependency.implementationFingerprint { return "project dependency '" + dependency.name + "' implementation fingerprint does not match the lockfile" }
            }
            index = index + 1
        }
        return null
    }

    link(assembly:string, outputPath:string, libraries:Array<string>, linkerMode:string, ir:Ir.Program?=null, graph:ModuleLoading.ModuleGraph?=null, optimizationLevel:i64=1, cache:CompilerCache.Cache?=null, analysis:Semantics.Analysis?=null, targetName:string="x86_64-linux", runtimeMetrics:bool=false, projectSource:string?=null, lockSource:string?=null) -> i64 {
        local identity:BuildIdentity.Builder? = null
        local structured = self.assembleObject(assembly, targetName)
        if structured == null {
            System.writeError("valen: native object encoder does not support generated assembly\n")
            return 69
        }
        local object = structured!.build()
        local inputPath = outputPath + ".o"
        if !self.writeObject(inputPath, object) { return 74 }
        local linkInputs = new Array<string>(0)
        local hasForeignExternal:bool = ir == null || targetName != "aarch64-linux"
        if ir != null { local externalIndex:i64 = 0; while externalIndex < ir!.externals.length { if ir!.externals[externalIndex].foreignLibrary != null { hasForeignExternal = true }; externalIndex = externalIndex + 1 } }
        local libraryIndex:i64 = 0
        while libraryIndex < libraries.length { if hasForeignExternal { linkInputs.append(libraries[libraryIndex]) }; libraryIndex = libraryIndex + 1 }
        if graph != null {
            local compiledIndex:i64 = 0
            while compiledIndex < graph!.modules.length {
                local compiledModule = graph!.modules[compiledIndex]
                if compiledModule.compiledObjectPath != null { linkInputs.append("@" + compiledModule.compiledObjectPath!) }
                compiledIndex = compiledIndex + 1
            }
        }
        local nativeLink:bool = linkerMode == "native" || (linkerMode == "auto" && linkInputs.length == 0)
        local selectedLinker = "system"
        if nativeLink { selectedLinker = "native" }
        if graph != null { identity = new BuildIdentity.Builder(graph!, targetName, optimizationLevel, "native", selectedLinker, runtimeMetrics, libraries); if projectSource != null && lockSource != null { identity!.setProject(projectSource!, lockSource!) } }
        if nativeLink {
            if linkInputs.length > 0 {
                System.writeError("valen: native linker cannot resolve external object inputs or foreign libraries; use --linker system\n")
                return 69
            }
            local linker = new Linking.Linker()
            local executable:Array<u8>? = null
            if ir != null && graph != null && graph!.modules.length > 1 {
                local objects = new Array<ref Elf.Object>(0)
                local moduleIndex:i64 = 0
                while moduleIndex < graph!.modules.length {
                    local module = graph!.modules[graph!.modules.length - moduleIndex - 1]
                    local includeRuntime = graph!.entry != null && module.path == graph!.entry!.path
                    local moduleAssembly:string? = null
                    if includeRuntime { moduleAssembly = assembly }
                    else if cache != null && !runtimeMetrics { moduleAssembly = cache!.loadModuleAssembly(module, false) }
                    if moduleAssembly == null {
                        local moduleIr = ir!
                        if analysis != null { local moduleGenerator = new Ir.Generator(analysis!, module.path); moduleIr = moduleGenerator.generate() }
                        local modulePass = new IrValidation.Pass()
                        local moduleErrors = modulePass.prepare(moduleIr, optimizationLevel == 1, includeRuntime)
                        if moduleErrors.length > 0 {
                            for error in moduleErrors { System.writeError("valen: invalid module IR: ${error}\n") }
                            return 70
                        }
                        moduleAssembly = self.generateAssembly(moduleIr, targetName, optimizationLevel, module.path, includeRuntime, false, runtimeMetrics)
                        if cache != null && !runtimeMetrics { cache!.storeModuleAssembly(module, false, moduleAssembly!) }
                    }
                    local moduleObject = self.assembleObject(moduleAssembly!, targetName)
                    if moduleObject == null { System.writeError("valen: native module object encoder failed\n"); return 69 }
                    objects.append(moduleObject!)
                    module.releaseImplementation()
                    moduleIndex = moduleIndex + 1
                }
                executable = linker.linkObjects(objects)
            } else { executable = linker.link(structured!) }
            if executable == null { System.writeError("valen: native linker: "); System.writeError(linker.error); System.writeError("\n"); return 69 }
            if !self.writeObject(outputPath, executable!) { return 74 }
            if System.makeExecutable(outputPath) != 0 { System.writeError("valen: could not make output executable; OS error "); System.writeError(System.lastError().toString()); System.writeError("\n"); return 74 }
            local nativeArtifact = Compiler.loadSource(outputPath)
            if identity != null { if nativeArtifact == null || !identity!.write(outputPath, nativeArtifact!.content) { System.writeError("valen: could not write build identity\n"); return 74 } }
            return 0
        }
        local result = System.link(inputPath, outputPath, linkInputs)
        if result == 0 && identity != null { local systemArtifact = Compiler.loadSource(outputPath); if systemArtifact == null || !identity!.write(outputPath, systemArtifact!.content) { System.writeError("valen: could not write build identity\n"); return 74 } }
        return result
    }

    generateAssembly(ir:Ir.Program, targetName:string, optimizationLevel:i64, emissionModule:string?, includeRuntime:bool, includeModuleMetadata:bool=false, runtimeMetrics:bool=false) -> string {
        if targetName == "aarch64-linux" { local backend = new AArch64.Backend(ir, optimizationLevel, emissionModule, includeRuntime, includeModuleMetadata); return backend.generate() }
        local backend = new X86_64.Backend(ir, optimizationLevel, emissionModule, includeRuntime, includeModuleMetadata, runtimeMetrics); return backend.generate()
    }

    assembleObject(assembly:string, targetName:string) -> Elf.Object? {
        if targetName == "aarch64-linux" { local assembler = new AArch64Object.Assembler(); local object = assembler.assembleObject(assembly); if object == null { System.writeError("valen: AArch64 object encoder: "); System.writeError(assembler.error); System.writeError("\n") }; return object }
        local assembler = new X86Object.Assembler(); local object = assembler.assembleObject(assembly); if object == null { System.writeError("valen: x86-64 object encoder: "); System.writeError(assembler.error); System.writeError("\n") }; return object
    }

    writeObject(path:string, object:Array<u8>) -> bool {
        local output = System.openWrite(path)
        if output == null {
            System.writeError("valen: could not open object output; OS error "); System.writeError(System.lastError().toString()); System.writeError("\n"); return false
        }
        local written = System.writeBytes(output!, object)
        local closeResult = System.close(output!)
        if written != object.length || closeResult != 0 {
            System.writeError("valen: could not write object output; OS error "); System.writeError(System.lastError().toString()); System.writeError("\n"); return false
        }
        return true
    }

    writeAssembly(path:string, assembly:string) -> bool {
        local output = System.openWrite(path)
        if output == null {
            System.writeError("valen: could not open '")
            System.writeError(path)
            System.writeError("' for writing; OS error ")
            System.writeError(System.lastError().toString())
            System.writeError("\n")
            return false
        }
        local written = System.writeFile(output!, assembly)
        local closeResult = System.close(output!)
        if written != assembly.length || closeResult != 0 {
            System.writeError("valen: could not write assembly output; OS error ")
            System.writeError(System.lastError().toString())
            System.writeError("\n")
            return false
        }
        return true
    }

    directoryName(path:string) -> string {
        local last:i64 = -1
        local index:i64 = 0
        while index < path.length { if path[index] == 47 { last = index }; index = index + 1 }
        if last < 0 { return "." }
        if last == 0 { return "/" }
        return path.slice(0, last)
    }

    writeUsage() -> void {
        System.write("usage:\n")
        System.write("  optimization: -O0 (no optional optimization), -O1 (default)\n")
        System.write("  source root: --source-root <directory>\n")
        System.write("  target: --target <x86_64-linux|aarch64-linux>\n")
        System.write("  backend: --backend native (default) or llvm (x86_64-linux)\n")
        System.write("  linker: --linker auto (default), native, or system\n")
        System.write("  instrumentation: --runtime-metrics\n")
        System.write("  diagnostics: --diagnostic-format human (default) or json (newline-delimited JSON)\n")
        System.write("  valen <source-file>\n")
        System.write("  valen <source-file> -o <executable>\n")
        System.write("  valen --check <source-file>\n")
        System.write("  valen --emit-ir <source-file>\n")
        System.write("  valen --emit-object <source-file> -o <object-file>\n")
        System.write("  valen --library-version <semver> --emit-library <source-file> -o <object-file>\n")
        System.write("  valen --validate-library <object-file>.vmeta\n")
        System.write("  valen --validate-project [--locked] <valen.project.json> [valen.lock]\n")
        System.write("  valen --build-project <valen.project.json> [valen.lock]\n")
    }
}}
