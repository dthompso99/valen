import EventLoop from './libEventLoop.ar'

library Operations {{
    native threadAvailable() -> bool
    native threadStart(operation:ThreadOperation) -> bool
    native threadJoin(operation:ThreadOperation) -> void
    native mutexLock(mutex:Mutex) -> void
    native mutexUnlock(mutex:Mutex) -> void
    native conditionWait(condition:Condition, mutex:Mutex) -> void
    native conditionNotifyOne(condition:Condition) -> void
    native conditionNotifyAll(condition:Condition) -> void
    native atomicLoad(atomic:Atomic) -> i64
    native atomicStore(atomic:Atomic, value:i64) -> void
    native atomicExchange(atomic:Atomic, value:i64) -> i64
    native atomicCompareExchange(atomic:Atomic, expected:i64, replacement:i64) -> bool
    native atomicAdd(atomic:Atomic, value:i64) -> i64

    OperationResult {{
        succeeded() -> bool { return false }
        failed() -> bool { return false }
        cancelled() -> bool { return false }
        code() -> i64 { return 0 }
        detail() -> string? { return null }
    }}

    Succeeded inherits OperationResult {{
        succeeded() -> bool { return true }
    }}

    Failed inherits OperationResult {{
        member failureCode:i64
        member failureDetail:string?

        __(code:i64, detail:string?) -> void {
            self.failureCode = code
            self.failureDetail = detail
        }

        failed() -> bool { return true }
        code() -> i64 { return self.failureCode }
        detail() -> string? { return self.failureDetail }
    }}

    Cancelled inherits OperationResult {{
        member cancellationDetail:string?

        __(detail:string?) -> void { self.cancellationDetail = detail }

        cancelled() -> bool { return true }
        detail() -> string? { return self.cancellationDetail }
    }}

    Operation {{
        complete() -> bool { return false }
        cancel() -> bool { return false }
        result() -> ref OperationResult? { return null }
        wait() -> ref OperationResult { return new OperationResult() }
    }}

    ProgressOperation inherits Operation {{
        completedUnits() -> i64 { return 0 }
        totalUnits() -> i64 { return 0 }
    }}

    Work {{
        run() -> OperationResult { return new OperationResult() }
    }}

    ReadyWork inherits Work {{
        descriptor() -> i64 { return -1 }
        interest() -> i64 { return 0 }
    }}

    Executor {{
        submit(own work:Work) -> Operation { return new Operation() }
    }}

    CompletedOperation implements Operation {{
        member terminal:OperationResult

        __(own terminal:OperationResult) -> void { self.terminal = terminal }

        complete() -> bool { return true }
        cancel() -> bool { return false }
        result() -> ref OperationResult? { return self.terminal }
        wait() -> ref OperationResult { return self.terminal }
    }}

    InlineExecutor implements Executor {{
        submit(own work:Work) -> Operation {
            local terminal = work.run()
            delete work
            return new CompletedOperation(terminal)
        }
    }}

    EventOperation implements Operation {{
        private member work:ReadyWork
        private member terminal:OperationResult?
        private member cancellationRequested:bool

        __(own work:ReadyWork) -> void {
            self.work = work
            self.terminal = null
            self.cancellationRequested = false
        }

        descriptor() -> i64 {
            return self.work.descriptor()
        }
        interest() -> i64 {
            return self.work.interest()
        }
        complete() -> bool { return self.terminal != null }
        cancel() -> bool {
            if self.terminal != null { return false }
            self.cancellationRequested = true
            self.terminal = new Cancelled("requested")
            return true
        }
        runReady() -> bool {
            if self.terminal != null { return false }
            if self.cancellationRequested {
                self.terminal = new Cancelled("requested")
            } else {
                self.terminal = self.work.run()
            }
            return true
        }
        result() -> ref OperationResult? { return self.terminal }
        wait() -> ref OperationResult {
            while self.terminal == null {
                local descriptors = new Array<i64>(0)
                local interests = new Array<i64>(0)
                descriptors.append(self.descriptor())
                interests.append(self.interest())
                if EventLoop.wait(descriptors, interests, -1) == 0 { self.runReady() }
            }
            return self.terminal!
        }
    }}

    EventOperationView implements Operation {{
        private member target:EventOperation

        __(own target:EventOperation) -> void { self.target = target }
        borrowTarget() -> ref EventOperation { return self.target }
        complete() -> bool { return self.target.complete() }
        cancel() -> bool { return self.target.cancel() }
        result() -> ref OperationResult? { return self.target.result() }
        wait() -> ref OperationResult { return self.target.wait() }
    }}

    EventLoopExecutor implements Executor {{
        private member pending:Array<weak EventOperation?>

        __() -> void { self.pending = new Array<weak EventOperation?>(0) }
        available() -> bool { return EventLoop.available() }

        submit(own work:Work) -> Operation {
            local terminal = work.run()
            delete work
            return new CompletedOperation(terminal)
        }

        submitReady(own work:ReadyWork) -> EventOperationView {
            local view = new EventOperationView(new EventOperation(work))
            local stored = view.borrowTarget()
            self.pending.append(stored)
            if !self.available() || stored.descriptor() < 0 || stored.interest() == 0 { stored.runReady() }
            return view
        }

        runOne(timeout:i64=-1) -> bool {
            local descriptors = new Array<i64>(0)
            local interests = new Array<i64>(0)
            local index:i64 = 0
            while index < self.pending.length {
                local operation = self.pending[index]
                if operation != null {
                    if !operation!.complete() {
                        descriptors.append(operation!.descriptor())
                        interests.append(operation!.interest())
                    }
                }
                index = index + 1
            }
            if descriptors.length == 0 { return false }
            local ready = EventLoop.wait(descriptors, interests, timeout)
            if ready < 0 { return false }
            local active:i64 = 0
            index = 0
            while index < self.pending.length {
                local operation = self.pending[index]
                if operation != null {
                    if !operation!.complete() {
                        if active == ready { return operation!.runReady() }
                        active = active + 1
                    }
                }
                index = index + 1
            }
            return false
        }
    }}

    Mutex {{
        private member state:i32

        __() -> void { self.state = 0 }
        lock() -> void { Operations.mutexLock(self) }
        unlock() -> void { Operations.mutexUnlock(self) }
    }}

    Condition {{
        private member sequence:i32

        __() -> void { self.sequence = 0 }
        wait(mutex:Mutex) -> void { Operations.conditionWait(self, mutex) }
        notifyOne() -> void { Operations.conditionNotifyOne(self) }
        notifyAll() -> void { Operations.conditionNotifyAll(self) }
    }}

    Atomic {{
        private member value:i64

        __(value:i64=0) -> void { self.value = value }
        load() -> i64 { return Operations.atomicLoad(self) }
        store(value:i64) -> void { Operations.atomicStore(self, value) }
        exchange(value:i64) -> i64 { return Operations.atomicExchange(self, value) }
        compareExchange(expected:i64, replacement:i64) -> bool { return Operations.atomicCompareExchange(self, expected, replacement) }
        add(value:i64) -> i64 { return Operations.atomicAdd(self, value) }
    }}

    ThreadOperation implements Operation {{
        private member work:Work
        private member terminal:OperationResult?
        private member handle:i64
        private member joined:bool

        __(own work:Work) -> void {
            self.work = work
            self.terminal = null
            self.handle = 0
            self.joined = false
        }

        private runWorker() -> void { self.terminal = self.work.run() }
        start() -> bool { return Operations.threadStart(self) }
        runInline() -> void { self.runWorker(); self.joined = true }
        complete() -> bool { return self.terminal != null }
        cancel() -> bool { return false }
        result() -> ref OperationResult? { return self.terminal }
        wait() -> ref OperationResult {
            if !self.joined { Operations.threadJoin(self); self.joined = true }
            return self.terminal!
        }
    }}

    ThreadExecutor implements Executor {{
        private member weak active:ThreadOperation?

        __() -> void { self.active = null }
        available() -> bool { return Operations.threadAvailable() }

        submit(own work:Work) -> Operation {
            local active = self.active
            if active != null { active!.wait() }
            local operation = new ThreadOperation(work)
            self.active = operation
            if !operation.start() { operation.runInline() }
            return operation
        }
    }}
}}
