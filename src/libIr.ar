import Ast from './libAst.ar'
import Symbols from './libSymbols.ar'
import Semantics from './libSemantic.ar'

library Ir {{
    Value {{
        member kind:string
        member name:string
        member typeName:string

        __(kind:string, name:string, typeName:string) -> void {
            self.kind = kind
            self.name = name
            self.typeName = typeName
        }
    }}

    Instruction {{
        member op:string
        member result:Value?
        member first:Value?
        member second:Value?
        member third:Value?
        member arguments:Array<ref Value>
        member name:string?
        member target:string?
        member alternateTarget:string?
        member operator:string?
        member typeName:string?
        member ownerType:string?
        member elementType:string?
        member elementOwnership:string?
        member text:string?
        member slot:i64

        __(op:string) -> void {
            self.op = op
            self.result = null
            self.first = null
            self.second = null
            self.third = null
            self.arguments = new Array<ref Value>(0)
            self.name = null
            self.target = null
            self.alternateTarget = null
            self.operator = null
            self.typeName = null
            self.ownerType = null
            self.elementType = null
            self.elementOwnership = null
            self.text = null
            self.slot = -1
        }
    }}

    Block {{
        member label:string
        member instructions:Array<ref Instruction>

        __(label:string) -> void {
            self.label = label
            self.instructions = new Array<ref Instruction>(0)
        }
    }}

    Parameter {{
        member name:string
        member typeName:string

        __(name:string, typeName:string) -> void {
            self.name = name
            self.typeName = typeName
        }
    }}

    Function {{
        member modulePath:string
        member name:string
        member displayName:string
        member ownerType:string
        member parameters:Array<ref Parameter>
        member returnType:string
        member blocks:Array<ref Block>

        __(name:string, displayName:string, ownerType:string, returnType:string) -> void {
            self.modulePath = ""
            self.name = name
            self.displayName = displayName
            self.ownerType = ownerType
            self.parameters = new Array<ref Parameter>(0)
            self.returnType = returnType
            self.blocks = new Array<ref Block>(0)
        }
    }}

    ExternalFunction {{
        member modulePath:string
        member name:string
        member displayName:string
        member runtimeName:string
        member parameters:Array<ref Parameter>
        member returnType:string
        member foreignLibrary:string?

        __(name:string, displayName:string, runtimeName:string, returnType:string) -> void {
            self.modulePath = ""
            self.name = name
            self.displayName = displayName
            self.runtimeName = runtimeName
            self.parameters = new Array<ref Parameter>(0)
            self.returnType = returnType
            self.foreignLibrary = null
        }
    }}

    Field {{
        member name:string
        member qualifiedName:string
        member typeName:string
        member ownership:string
        member index:i64

        __(name:string, qualifiedName:string, typeName:string, ownership:string, index:i64) -> void {
            self.name = name
            self.qualifiedName = qualifiedName
            self.typeName = typeName
            self.ownership = ownership
            self.index = index
        }
    }}

    VirtualMethod {{
        member name:string
        member target:string

        __(name:string, target:string) -> void {
            self.name = name
            self.target = target
        }
    }}

    ContractEntry {{
        member name:string
        member methods:Array<ref VirtualMethod>
        member isSelf:bool

        __(name:string, isSelf:bool) -> void {
            self.name = name
            self.methods = new Array<ref VirtualMethod>(0)
            self.isSelf = isSelf
        }
    }}

    Type {{
        member modulePath:string
        member name:string
        member displayName:string
        member initializer:string?
        member fields:Array<ref Field>
        member baseName:string?
        member virtualMethods:Array<ref VirtualMethod>
        member contracts:Array<ref ContractEntry>

        __(name:string, displayName:string) -> void {
            self.modulePath = ""
            self.name = name
            self.displayName = displayName
            self.initializer = null
            self.fields = new Array<ref Field>(0)
            self.baseName = null
            self.virtualMethods = new Array<ref VirtualMethod>(0)
            self.contracts = new Array<ref ContractEntry>(0)
        }
    }}

    Program {{
        member types:Array<ref Type>
        member functions:Array<ref Function>
        member functionDeclarations:Array<ref Function>
        member referencedTypes:Array<string>
        member externals:Array<ref ExternalFunction>
        member foreignLibraries:Array<string>
        member entry:string?

        __() -> void {
            self.types = new Array<ref Type>(0)
            self.functions = new Array<ref Function>(0)
            self.functionDeclarations = new Array<ref Function>(0)
            self.referencedTypes = new Array<string>(0)
            self.externals = new Array<ref ExternalFunction>(0)
            self.foreignLibraries = new Array<string>(0)
            self.entry = null
        }

        blockCount() -> i64 {
            local count:i64 = 0
            local index:i64 = 0
            while index < self.functions.length {
                count = count + self.functions[index].blocks.length
                index = index + 1
            }
            return count
        }

        instructionCount() -> i64 {
            local count:i64 = 0
            local functionIndex:i64 = 0
            while functionIndex < self.functions.length {
                local blocks = self.functions[functionIndex].blocks
                local blockIndex:i64 = 0
                while blockIndex < blocks.length {
                    count = count + blocks[blockIndex].instructions.length
                    blockIndex = blockIndex + 1
                }
                functionIndex = functionIndex + 1
            }
            return count
        }
    }}

    Normalizer {{
        format(program:Program) -> string {
            local output = new StringBuilder()
            self.record(output, "program"); self.optional(output, program.entry); self.line(output)
            self.record(output, "types"); self.number(output, program.types.length); self.line(output)
            local typeIndex:i64 = 0
            while typeIndex < program.types.length { self.typeNode(output, program.types[typeIndex]); typeIndex = typeIndex + 1 }
            self.record(output, "functions"); self.number(output, program.functions.length); self.line(output)
            local functionIndex:i64 = 0
            while functionIndex < program.functions.length { self.functionNode(output, program.functions[functionIndex]); functionIndex = functionIndex + 1 }
            self.record(output, "externals"); self.number(output, program.externals.length); self.line(output)
            local externalIndex:i64 = 0
            while externalIndex < program.externals.length { self.externalNode(output, program.externals[externalIndex]); externalIndex = externalIndex + 1 }
            self.record(output, "libraries"); self.number(output, program.foreignLibraries.length)
            local libraryIndex:i64 = 0
            while libraryIndex < program.foreignLibraries.length { self.text(output, program.foreignLibraries[libraryIndex]); libraryIndex = libraryIndex + 1 }
            self.line(output)
            return output.build()
        }

        typeNode(output:StringBuilder, node:Type) -> void {
            self.record(output, "type"); self.text(output, node.name); self.text(output, node.displayName); self.optional(output, node.baseName); self.optional(output, node.initializer)
            self.number(output, node.fields.length); self.number(output, node.virtualMethods.length); self.number(output, node.contracts.length); self.line(output)
            local fieldIndex:i64 = 0
            while fieldIndex < node.fields.length {
                local field = node.fields[fieldIndex]
                self.record(output, "field"); self.text(output, field.name); self.text(output, field.qualifiedName); self.text(output, field.typeName); self.text(output, field.ownership); self.number(output, field.index); self.line(output)
                fieldIndex = fieldIndex + 1
            }
            local virtualIndex:i64 = 0
            while virtualIndex < node.virtualMethods.length { self.virtualMethod(output, "virtual", node.virtualMethods[virtualIndex]); virtualIndex = virtualIndex + 1 }
            local contractIndex:i64 = 0
            while contractIndex < node.contracts.length {
                local contract = node.contracts[contractIndex]
                self.record(output, "contract"); self.text(output, contract.name); self.boolean(output, contract.isSelf); self.number(output, contract.methods.length); self.line(output)
                local methodIndex:i64 = 0
                while methodIndex < contract.methods.length { self.virtualMethod(output, "contract-method", contract.methods[methodIndex]); methodIndex = methodIndex + 1 }
                contractIndex = contractIndex + 1
            }
        }

        virtualMethod(output:StringBuilder, recordName:string, method:VirtualMethod) -> void {
            self.record(output, recordName); self.text(output, method.name); self.text(output, method.target); self.line(output)
        }

        functionNode(output:StringBuilder, node:Function) -> void {
            self.record(output, "function"); self.text(output, node.name); self.text(output, node.displayName); self.text(output, node.ownerType); self.text(output, node.returnType)
            self.number(output, node.parameters.length); self.number(output, node.blocks.length); self.line(output); self.parameters(output, node.parameters)
            local blockIndex:i64 = 0
            while blockIndex < node.blocks.length {
                local block = node.blocks[blockIndex]
                self.record(output, "block"); self.text(output, block.label); self.number(output, block.instructions.length); self.line(output)
                local instructionIndex:i64 = 0
                while instructionIndex < block.instructions.length { self.instruction(output, block.instructions[instructionIndex]); instructionIndex = instructionIndex + 1 }
                blockIndex = blockIndex + 1
            }
        }

        externalNode(output:StringBuilder, node:ExternalFunction) -> void {
            self.record(output, "external"); self.text(output, node.name); self.text(output, node.displayName); self.text(output, node.runtimeName); self.text(output, node.returnType)
            self.optional(output, node.foreignLibrary); self.number(output, node.parameters.length); self.line(output); self.parameters(output, node.parameters)
        }

        parameters(output:StringBuilder, values:Array<ref Parameter>) -> void {
            local index:i64 = 0
            while index < values.length {
                self.record(output, "parameter"); self.text(output, values[index].name); self.text(output, values[index].typeName); self.line(output)
                index = index + 1
            }
        }

        instruction(output:StringBuilder, node:Instruction) -> void {
            self.record(output, "instruction"); self.text(output, node.op); self.value(output, node.result); self.value(output, node.first); self.value(output, node.second); self.value(output, node.third)
            self.number(output, node.arguments.length)
            local argumentIndex:i64 = 0
            while argumentIndex < node.arguments.length { self.value(output, node.arguments[argumentIndex]); argumentIndex = argumentIndex + 1 }
            self.optional(output, node.name); self.optional(output, node.target); self.optional(output, node.alternateTarget); self.optional(output, node.operator); self.optional(output, node.typeName)
            self.optional(output, node.ownerType); self.optional(output, node.elementType); self.optional(output, node.elementOwnership); self.optional(output, node.text); self.number(output, node.slot); self.line(output)
        }

        value(output:StringBuilder, node:Value?) -> void {
            if node == null { output.append("N;"); return }
            output.append("V;"); self.text(output, node!.kind); self.text(output, node!.name); self.text(output, node!.typeName)
        }

        record(output:StringBuilder, name:string) -> void { output.append(name); output.append("|") }
        text(output:StringBuilder, value:string) -> void { output.append("S"); output.append(value.length.toString()); output.append(":"); output.append(value); output.append(";") }
        optional(output:StringBuilder, value:string?) -> void { if value == null { output.append("N;"); return }; self.text(output, value!) }
        number(output:StringBuilder, value:i64) -> void { output.append("I"); output.append(value.toString()); output.append(";") }
        boolean(output:StringBuilder, value:bool) -> void { if value { output.append("B1;") } else { output.append("B0;") } }
        line(output:StringBuilder) -> void { output.append("\n") }
    }}

    Binding {{
        member symbol:Symbols.Symbol
        member value:Value
        member lifetimeActive:bool

        __(symbol:Symbols.Symbol, value:Value) -> void {
            self.symbol = symbol
            self.value = value
            self.lifetimeActive = false
        }
    }}

    Loop {{
        member breakTarget:string
        member continueTarget:string

        __(breakTarget:string, continueTarget:string) -> void {
            self.breakTarget = breakTarget
            self.continueTarget = continueTarget
        }
    }}

    Generator {{
        member analysis:Semantics.Analysis
        member program:Program
        member currentFunction:Function?
        member currentBlock:Block?
        member bindings:Array<ref Binding>
        member loops:Array<ref Loop>
        member breakTarget:string?
        member continueTarget:string?
        member nextLocal:i64
        member nextTemporary:i64
        member nextBlock:i64
        member currentModulePath:string
        member emissionModule:string?

        __(analysis:Semantics.Analysis, emissionModule:string?=null) -> void {
            self.analysis = analysis
            self.program = new Program()
            self.currentFunction = null
            self.currentBlock = null
            self.bindings = new Array<ref Binding>(0)
            self.loops = new Array<ref Loop>(0)
            self.breakTarget = null
            self.continueTarget = null
            self.nextLocal = 0
            self.nextTemporary = 0
            self.nextBlock = 0
            self.currentModulePath = ""
            self.emissionModule = emissionModule
        }

        generate() -> ref Program {
            local moduleIndex:i64 = 0
            while moduleIndex < self.analysis.graph.modules.length {
                self.currentModulePath = self.analysis.graph.modules[moduleIndex].path
                local declarations = self.analysis.graph.modules[moduleIndex].program.declarations
                local index:i64 = 0
                while index < declarations.length {
                    if declarations[index].typeParameters.length == 0 { self.declareContainer(declarations[index]) }
                    index = index + 1
                }
                moduleIndex = moduleIndex + 1
            }
            moduleIndex = 0
            while moduleIndex < self.analysis.graph.modules.length {
                self.currentModulePath = self.analysis.graph.modules[moduleIndex].path
                local declarations = self.analysis.graph.modules[moduleIndex].program.declarations
                local index:i64 = 0
                if self.emissionModule == null || self.currentModulePath == self.emissionModule! {
                    while index < declarations.length {
                        if declarations[index].typeParameters.length == 0 { self.lowerContainer(declarations[index]) }
                        index = index + 1
                    }
                }
                moduleIndex = moduleIndex + 1
            }
            if self.analysis.graph.entry != null { self.currentModulePath = self.analysis.graph.entry!.path }
            if self.emissionModule == null || self.analysis.graph.entry != null && self.emissionModule! == self.analysis.graph.entry!.path { self.lowerTestRunner() }
            return self.program
        }

        lowerTestRunner() -> void {
            local testCount:i64 = 0
            local moduleIndex:i64 = 0
            while moduleIndex < self.analysis.graph.modules.length {
                local declarations = self.analysis.graph.modules[moduleIndex].program.declarations
                local index:i64 = 0
                while index < declarations.length { if declarations[index].kind == "Test" { testCount = testCount + 1 }; index = index + 1 }
                moduleIndex = moduleIndex + 1
            }
            if testCount == 0 { return }
            local owner = "$valen.test.runner"
            self.program.types.append(new Type(owner, owner))
            self.beginFunction("$valen.test.run", "$valen.test.run", owner, "i64")
            self.currentFunction!.parameters.append(new Parameter("self", owner))
            moduleIndex = 0
            while moduleIndex < self.analysis.graph.modules.length {
                local declarations = self.analysis.graph.modules[moduleIndex].program.declarations
                local declarationIndex:i64 = 0
                while declarationIndex < declarations.length {
                    local declaration = declarations[declarationIndex]
                    if declaration.kind == "Test" {
                        local memberIndex:i64 = 0
                        while memberIndex < declaration.members.length {
                            local method = declaration.members[memberIndex]
                            if method.kind == "Method" {
                                local call = new Instruction("call")
                                call.target = method.symbol!.qualifiedName
                                self.emit(call)
                            }
                            memberIndex = memberIndex + 1
                        }
                    }
                    declarationIndex = declarationIndex + 1
                }
                moduleIndex = moduleIndex + 1
            }
            local failures = self.temporary("test_failures", "i64")
            local returned = new Instruction("return")
            returned.first = failures.result
            self.emit(returned)
            self.program.entry = "$valen.test.run"
            self.finishFunction()
        }

        declareContainer(declaration:Ast.Declaration) -> void {
            if declaration.kind == "Object" { self.declareObject(declaration.name, declaration.members, declaration.symbol!) }
            self.declareFunctionSignatures(declaration.members, declaration.symbol!)
            self.collectMemberTypes(declaration.members)
            local index:i64 = 0
            while index < declaration.members.length {
                local memberNode = declaration.members[index]
                if memberNode.kind == "Object" { self.declareNestedObject(memberNode) }
                index = index + 1
            }
        }

        collectMemberTypes(members:Array<Ast.MemberDeclaration>) -> void {
            local index:i64 = 0
            while index < members.length {
                if members[index].initializer != null { self.collectExpressionType(members[index].initializer!) }
                local parameterIndex:i64 = 0
                while parameterIndex < members[index].parameters.length { if members[index].parameters[parameterIndex].defaultValue != null { self.collectExpressionType(members[index].parameters[parameterIndex].defaultValue!) }; parameterIndex = parameterIndex + 1 }
                if members[index].body != null { self.collectBlockTypes(members[index].body!) }
                if members[index].kind == "Object" { self.collectMemberTypes(members[index].members) }
                index = index + 1
            }
        }

        collectBlockTypes(block:Ast.Block) -> void {
            local index:i64 = 0
            while index < block.statements.length {
                local statement = block.statements[index]
                if statement.expression != null { self.collectExpressionType(statement.expression!) }
                if statement.condition != null { self.collectExpressionType(statement.condition!) }
                if statement.body != null { self.collectBlockTypes(statement.body!) }
                if statement.alternate != null { self.collectBlockTypes(statement.alternate!) }
                index = index + 1
            }
        }

        collectExpressionType(expression:Ast.Expression) -> void {
            if expression.inferredType != null { self.addReferencedType(expression.inferredType!) }
            if expression.left != null { self.collectExpressionType(expression.left!) }
            if expression.right != null { self.collectExpressionType(expression.right!) }
            local index:i64 = 0
            while index < expression.arguments.length { self.collectExpressionType(expression.arguments[index]); index = index + 1 }
        }

        addReferencedType(typeName:string) -> void {
            local index:i64 = 0
            while index < self.program.referencedTypes.length { if self.program.referencedTypes[index] == typeName { return }; index = index + 1 }
            self.program.referencedTypes.append(typeName)
        }

        declareFunctionSignatures(members:Array<Ast.MemberDeclaration>, owner:Symbols.Symbol) -> void {
            local index:i64 = 0
            while index < members.length {
                local memberNode = members[index]
                if memberNode.kind == "Method" {
                    if memberNode.isNative { self.lowerMethod(memberNode, owner) }
                    else {
                        local symbol = memberNode.symbol!
                        local declaration = new Function(symbol.qualifiedName, symbol.qualifiedName, owner.qualifiedName, symbol.returnType!)
                        if owner.kind == "Object" { declaration.parameters.append(new Parameter("self", owner.qualifiedName)) }
                        local parameterIndex:i64 = 0
                        while parameterIndex < symbol.parameters.length { declaration.parameters.append(new Parameter(symbol.parameters[parameterIndex].name, symbol.parameters[parameterIndex].typeName!)); parameterIndex = parameterIndex + 1 }
                        self.program.functionDeclarations.append(declaration)
                    }
                } else { if memberNode.kind == "Object" { self.declareFunctionSignatures(memberNode.members, memberNode.symbol!) } }
                index = index + 1
            }
        }

        declareNestedObject(declaration:Ast.MemberDeclaration) -> void {
            self.declareObject(declaration.name, declaration.members, declaration.symbol!)
            local index:i64 = 0
            while index < declaration.members.length {
                if declaration.members[index].kind == "Object" { self.declareNestedObject(declaration.members[index]) }
                index = index + 1
            }
        }

        declareObject(name:string, members:Array<Ast.MemberDeclaration>, symbol:Symbols.Symbol) -> void {
            local typeNode = new Type(symbol.qualifiedName, symbol.qualifiedName)
            typeNode.modulePath = self.currentModulePath
            if symbol.base != null { typeNode.baseName = symbol.base!.qualifiedName }
            self.appendFields(typeNode, symbol)
            self.appendVirtualMethods(typeNode, symbol)
            self.appendContractEntry(typeNode, symbol, symbol, true)
            self.appendImplementedContracts(typeNode, symbol, symbol)
            local index:i64 = 0
            local declaresInitializer:bool = false
            while index < members.length {
                local memberNode = members[index]
                if memberNode.kind == "Field" {
                    if memberNode.initializer != null { typeNode.initializer = symbol.qualifiedName + ".$initialize"; declaresInitializer = true }
                }
                index = index + 1
            }
            if declaresInitializer {
                local initializer = new Function(typeNode.initializer!, typeNode.initializer!, symbol.qualifiedName, "void")
                initializer.parameters.append(new Parameter("self", symbol.qualifiedName))
                self.program.functionDeclarations.append(initializer)
            }
            self.program.types.append(typeNode)
        }

        appendVirtualMethods(typeNode:Type, symbol:Symbols.Symbol) -> void {
            if symbol.base != null { self.appendVirtualMethods(typeNode, symbol.base!) }
            local index:i64 = 0
            while index < symbol.memberScope!.symbols.length {
                local method = symbol.memberScope!.symbols[index]
                if method.kind == "Method" && method.name != "__" && method.visibility != "private" {
                    local slot:i64 = -1
                    local search:i64 = 0
                    while search < typeNode.virtualMethods.length {
                        if typeNode.virtualMethods[search].name == self.methodKey(method) { slot = search; break }
                        search = search + 1
                    }
                    local entry = new VirtualMethod(self.methodKey(method), method.qualifiedName)
                    if slot < 0 { typeNode.virtualMethods.append(entry) } else { typeNode.virtualMethods[slot] = entry }
                }
                index = index + 1
            }
        }

        appendImplementedContracts(typeNode:Type, implementation:Symbols.Symbol, source:Symbols.Symbol) -> void {
            if source.base != null { self.appendImplementedContracts(typeNode, implementation, source.base!) }
            local index:i64 = 0
            while index < source.contracts.length {
                local contract:Symbols.Symbol? = source.contracts[index]
                while contract != null {
                    self.appendContractEntry(typeNode, implementation, contract!, false)
                    contract = contract!.base
                }
                index = index + 1
            }
        }

        appendContractEntry(typeNode:Type, implementation:Symbols.Symbol, contract:Symbols.Symbol, isSelf:bool) -> void {
            local entry = new ContractEntry(contract.qualifiedName, isSelf)
            self.appendContractMethods(entry, implementation, contract)
            local index:i64 = 0
            while index < typeNode.contracts.length {
                if typeNode.contracts[index].name == entry.name { typeNode.contracts[index] = entry; return }
                index = index + 1
            }
            typeNode.contracts.append(entry)
        }

        appendContractMethods(entry:ContractEntry, implementation:Symbols.Symbol, contract:Symbols.Symbol) -> void {
            if contract.base != null { self.appendContractMethods(entry, implementation, contract.base!) }
            local index:i64 = 0
            while index < contract.memberScope!.symbols.length {
                local required = contract.memberScope!.symbols[index]
                if required.kind == "Method" && required.name != "__" && required.visibility != "private" {
                    local actual = self.findSymbolMethod(implementation, required)
                    local slot:i64 = -1
                    local search:i64 = 0
                    while search < entry.methods.length {
                        if entry.methods[search].name == self.methodKey(required) { slot = search; break }
                        search = search + 1
                    }
                    local method = new VirtualMethod(self.methodKey(required), actual!.qualifiedName)
                    if slot < 0 { entry.methods.append(method) } else { entry.methods[slot] = method }
                }
                index = index + 1
            }
        }

        findSymbolMethod(owner:Symbols.Symbol, required:Symbols.Symbol) -> ref Symbols.Symbol? {
            local current:Symbols.Symbol? = owner
            while current != null {
                local index:i64 = 0
                while index < current!.memberScope!.symbols.length {
                    local method = current!.memberScope!.symbols[index]
                    if method.kind == "Method" && method.name == required.name && method.visibility != "private" {
                        if self.methodKey(method) == self.methodKey(required) { return method }
                    }
                    index = index + 1
                }
                current = current!.base
            }
            return null
        }

        appendFields(typeNode:Type, symbol:Symbols.Symbol) -> void {
            if symbol.base != null { self.appendFields(typeNode, symbol.base!) }
            local index:i64 = 0
            while index < symbol.memberScope!.symbols.length {
                local field = symbol.memberScope!.symbols[index]
                if field.kind == "Field" {
                    typeNode.fields.append(new Field(field.name, field.qualifiedName, field.typeName!, field.ownership, typeNode.fields.length))
                }
                index = index + 1
            }
        }

        lowerContainer(declaration:Ast.Declaration) -> void {
            if declaration.kind == "Object" { self.lowerFieldInitializers(declaration.members, declaration.symbol!) }
            self.lowerMembers(declaration.members, declaration.symbol!)
        }

        lowerMembers(members:Array<Ast.MemberDeclaration>, owner:Symbols.Symbol) -> void {
            local index:i64 = 0
            while index < members.length {
                local memberNode = members[index]
                if memberNode.kind == "Method" { self.lowerMethod(memberNode, owner) }
                if memberNode.kind == "Object" {
                    self.lowerFieldInitializers(memberNode.members, memberNode.symbol!)
                    self.lowerMembers(memberNode.members, memberNode.symbol!)
                }
                index = index + 1
            }
        }

        lowerFieldInitializers(members:Array<Ast.MemberDeclaration>, owner:Symbols.Symbol) -> void {
            local count:i64 = 0
            local index:i64 = 0
            while index < members.length { if members[index].kind == "Field" { if members[index].initializer != null { count = count + 1 } }; index = index + 1 }
            if count == 0 { return }
            self.beginFunction(owner.qualifiedName + ".$initialize", owner.qualifiedName + ".$initialize", owner.qualifiedName, "void")
            self.currentFunction!.parameters.append(new Parameter("self", owner.qualifiedName))
            local instance = new Value("parameter", "self", owner.qualifiedName)
            index = 0
            while index < members.length {
                local field = members[index]
                if field.kind == "Field" {
                    if field.initializer != null {
                        local value = self.boxOptional(self.lowerExpression(field.initializer!), field.symbol!.typeName!)
                        local instruction = new Instruction("store_field")
                        instruction.first = instance
                        instruction.second = value
                        instruction.name = field.symbol!.qualifiedName
                        self.emit(instruction)
                    }
                }
                index = index + 1
            }
            self.emit(new Instruction("return"))
            self.finishFunction()
        }

        lowerMethod(method:Ast.MemberDeclaration, owner:Symbols.Symbol) -> void {
            local symbol = method.symbol!
            if method.isNative {
                local existingIndex:i64 = 0
                while existingIndex < self.program.externals.length { if self.program.externals[existingIndex].name == symbol.qualifiedName { return }; existingIndex = existingIndex + 1 }
                local runtimeName = self.runtimeName(symbol)
                if method.foreignLibrary != null { runtimeName = method.foreignSymbol! }
                local external = new ExternalFunction(symbol.qualifiedName, symbol.qualifiedName, runtimeName, symbol.returnType!)
                external.modulePath = self.currentModulePath
                external.foreignLibrary = method.foreignLibrary
                if runtimeName == "valen_Operations_threadStart" {
                    self.addForeignLibrary("pthread")
                    self.addForeignLibrary("c")
                }
                if method.foreignLibrary != null {
                    local found:bool = false
                    local libraryIndex:i64 = 0
                    while libraryIndex < self.program.foreignLibraries.length {
                        if self.program.foreignLibraries[libraryIndex] == method.foreignLibrary! { found = true }
                        libraryIndex = libraryIndex + 1
                    }
                    if !found { self.program.foreignLibraries.append(method.foreignLibrary!) }
                }
                local parameterIndex:i64 = 0
                while parameterIndex < symbol.parameters.length {
                    local parameter = symbol.parameters[parameterIndex]
                    external.parameters.append(new Parameter(parameter.name, parameter.typeName!))
                    parameterIndex = parameterIndex + 1
                }
                self.program.externals.append(external)
                return
            }
            self.beginFunction(symbol.qualifiedName, symbol.qualifiedName, owner.qualifiedName, symbol.returnType!)
            if owner.kind == "Object" { self.currentFunction!.parameters.append(new Parameter("self", owner.qualifiedName)) }
            local index:i64 = 0
            while index < symbol.parameters.length {
                local parameter = symbol.parameters[index]
                self.currentFunction!.parameters.append(new Parameter(parameter.name, parameter.typeName!))
                self.bindings.append(new Binding(parameter, new Value("parameter", parameter.name, parameter.typeName!)))
                index = index + 1
            }
            if method.body != null { self.lowerBlock(method.body!) }
            if symbol.returnType! == "void" {
                if !self.isTerminated() { self.emit(new Instruction("return")) }
            }
            if owner.name == "entry" && method.name == "__" { self.program.entry = symbol.qualifiedName }
            self.finishFunction()
        }

        addForeignLibrary(name:string) -> void {
            local index:i64 = 0
            while index < self.program.foreignLibraries.length {
                if self.program.foreignLibraries[index] == name { return }
                index = index + 1
            }
            self.program.foreignLibraries.append(name)
        }

        beginFunction(name:string, displayName:string, ownerType:string, returnType:string) -> void {
            self.currentFunction = new Function(name, displayName, ownerType, returnType)
            self.currentFunction!.modulePath = self.currentModulePath
            self.currentBlock = new Block("entry")
            self.currentFunction!.blocks.append(self.currentBlock!)
            self.bindings = new Array<ref Binding>(0)
            self.loops = new Array<ref Loop>(0)
            self.breakTarget = null
            self.continueTarget = null
            self.nextLocal = 0
            self.nextTemporary = 0
            self.nextBlock = 0
        }

        finishFunction() -> void {
            self.program.functions.append(self.currentFunction!)
            self.currentFunction = null
            self.currentBlock = null
        }

        lowerBlock(block:Ast.Block) -> void {
            local lifetimeStart = self.bindings.length
            local index:i64 = 0
            while index < block.statements.length {
                if self.isTerminated() { return }
                self.lowerStatement(block.statements[index])
                index = index + 1
            }
            if !self.isTerminated() { self.destroyBindings(lifetimeStart) }
        }

        lowerStatement(statement:Ast.Statement) -> void {
            if statement.kind == "Local" {
                local value:Value? = null
                if statement.expression != null { value = self.boxOptional(self.lowerExpression(statement.expression!), statement.symbol!.typeName!) }
                local localName = statement.name! + "#" + self.nextLocal.toString()
                self.nextLocal = self.nextLocal + 1
                local localValue = new Value("local", localName, statement.symbol!.typeName!)
                self.bindings.append(new Binding(statement.symbol!, localValue))
                if statement.symbol!.declaredOwnership == "owned" && self.findType(localValue.typeName) != null { self.bindings[self.bindings.length - 1].lifetimeActive = true }
                local instruction = new Instruction("declare_local")
                instruction.name = localName
                instruction.typeName = localValue.typeName
                instruction.first = value
                self.emit(instruction)
                return
            }
            if statement.kind == "Return" {
                local instruction = new Instruction("return")
                if statement.expression != null {
                    instruction.first = self.boxOptional(self.lowerExpression(statement.expression!), self.currentFunction!.returnType)
                    if statement.ownership == "transfer" { self.consumeLifetime(statement.expression!) }
                }
                self.destroyBindingsForReturn()
                self.emit(instruction)
                return
            }
            if statement.kind == "If" { self.lowerIf(statement); return }
            if statement.kind == "Match" { self.lowerMatch(statement); return }
            if statement.kind == "While" { self.lowerWhile(statement); return }
            if statement.kind == "For" { self.lowerFor(statement); return }
            if statement.kind == "Break" {
                local instruction = new Instruction("jump")
                instruction.target = self.breakTarget
                self.emit(instruction)
                return
            }
            if statement.kind == "Continue" {
                local instruction = new Instruction("jump")
                instruction.target = self.continueTarget
                self.emit(instruction)
                return
            }
            if statement.kind == "Block" { self.lowerBlock(statement.body!); return }
            if statement.kind == "Unsafe" { self.lowerBlock(statement.body!); return }
            if statement.expression != null { self.lowerExpression(statement.expression!) }
        }

        lowerIf(statement:Ast.Statement) -> void {
            local condition = self.lowerExpression(statement.condition!)
            local thenBlock = self.newBlock("if_then")
            local elseBlock:Block? = null
            if statement.alternate != null { elseBlock = self.newBlock("if_else") }
            local endBlock = self.newBlock("if_end")
            local branch = new Instruction("branch")
            branch.first = condition
            branch.target = thenBlock.label
            branch.alternateTarget = endBlock.label
            if elseBlock != null { branch.alternateTarget = elseBlock!.label }
            self.emit(branch)
            self.currentBlock = thenBlock
            self.lowerBlock(statement.body!)
            self.jumpIfOpen(endBlock.label)
            if elseBlock != null {
                self.currentBlock = elseBlock
                self.lowerBlock(statement.alternate!)
                self.jumpIfOpen(endBlock.label)
            }
            self.currentBlock = endBlock
        }

        lowerMatch(statement:Ast.Statement) -> void {
            local value = self.lowerExpression(statement.expression!)
            local endBlock = self.newBlock("match_end")
            local caseBlocks = new Array<ref Block>(0)
            local index:i64 = 0
            while index < statement.matchCases.length { caseBlocks.append(self.newBlock("match_case")); index = index + 1 }
            local elseBlock = endBlock
            if statement.alternate != null { elseBlock = self.newBlock("match_else") }
            local testBlock = self.currentBlock!
            index = 0
            while index < statement.matchCases.length {
                self.currentBlock = testBlock
                local next = elseBlock
                if index + 1 < statement.matchCases.length { next = self.newBlock("match_test") }
                local comparison = self.temporary("binary", "bool")
                comparison.first = value
                comparison.second = self.lowerExpression(statement.matchCases[index].pattern)
                comparison.operator = "=="
                comparison.ownerType = value.typeName
                local branch = new Instruction("branch")
                branch.first = comparison.result
                branch.target = caseBlocks[index].label
                branch.alternateTarget = next.label
                self.emit(branch)
                testBlock = next
                index = index + 1
            }
            if statement.matchCases.length == 0 { self.jumpIfOpen(elseBlock.label) }
            index = 0
            while index < statement.matchCases.length {
                self.currentBlock = caseBlocks[index]
                self.lowerBlock(statement.matchCases[index].body)
                self.jumpIfOpen(endBlock.label)
                index = index + 1
            }
            if statement.alternate != null { self.currentBlock = elseBlock; self.lowerBlock(statement.alternate!); self.jumpIfOpen(endBlock.label) }
            self.currentBlock = endBlock
            if statement.ownership == "returns" { self.jumpIfOpen(endBlock.label) }
        }

        lowerWhile(statement:Ast.Statement) -> void {
            local conditionBlock = self.newBlock("while_condition")
            local bodyBlock = self.newBlock("while_body")
            local endBlock = self.newBlock("while_end")
            self.jumpIfOpen(conditionBlock.label)
            self.currentBlock = conditionBlock
            local branch = new Instruction("branch")
            branch.first = self.lowerExpression(statement.condition!)
            branch.target = bodyBlock.label
            branch.alternateTarget = endBlock.label
            self.emit(branch)
            self.currentBlock = bodyBlock
            local previousBreak = self.breakTarget
            local previousContinue = self.continueTarget
            self.breakTarget = endBlock.label
            self.continueTarget = conditionBlock.label
            self.lowerBlock(statement.body!)
            self.breakTarget = previousBreak
            self.continueTarget = previousContinue
            self.jumpIfOpen(conditionBlock.label)
            self.currentBlock = endBlock
        }

        lowerFor(statement:Ast.Statement) -> void {
            local iterable = self.lowerExpression(statement.expression!)
            local iterableName = "$iterable#" + self.nextLocal.toString()
            self.nextLocal = self.nextLocal + 1
            local indexName = "$index#" + self.nextLocal.toString()
            self.nextLocal = self.nextLocal + 1
            local declaredIterable = new Instruction("declare_local")
            declaredIterable.name = iterableName; declaredIterable.typeName = iterable.typeName; declaredIterable.first = iterable
            self.emit(declaredIterable)
            if statement.iteratorHasNext == null {
                local zero = self.temporary("constant", "i64")
                zero.text = "0"
                local declaredIndex = new Instruction("declare_local")
                declaredIndex.name = indexName; declaredIndex.typeName = "i64"; declaredIndex.first = zero.result
                self.emit(declaredIndex)
            }
            local conditionBlock = self.newBlock("for_condition")
            local bodyBlock = self.newBlock("for_body")
            local incrementBlock = self.newBlock("for_increment")
            local endBlock = self.newBlock("for_end")
            self.jumpIfOpen(conditionBlock.label)
            self.currentBlock = conditionBlock
            local loadedIterable = self.temporary("load_local", iterable.typeName); loadedIterable.name = iterableName
            local condition:Instruction? = null
            if statement.iteratorHasNext != null {
                condition = self.temporary("call", "bool")
                condition!.target = statement.iteratorHasNext!.qualifiedName
                condition!.arguments.append(loadedIterable.result!)
            } else {
                local loadedIndex = self.temporary("load_local", "i64"); loadedIndex.name = indexName
                local lengthOp = "array_length"
                if iterable.typeName == "string" { lengthOp = "string_length" }
                local length = self.temporary(lengthOp, "i64"); length.first = loadedIterable.result
                condition = self.temporary("binary", "bool")
                condition!.operator = "<"; condition!.first = loadedIndex.result; condition!.second = length.result
            }
            local branch = new Instruction("branch")
            branch.first = condition!.result; branch.target = bodyBlock.label; branch.alternateTarget = endBlock.label
            self.emit(branch)
            self.currentBlock = bodyBlock
            local bodyIterable = self.temporary("load_local", iterable.typeName); bodyIterable.name = iterableName
            local value:Instruction? = null
            if statement.iteratorNext != null {
                value = self.temporary("call", statement.symbol!.typeName!)
                value!.target = statement.iteratorNext!.qualifiedName
                value!.arguments.append(bodyIterable.result!)
            } else {
                local bodyIndex = self.temporary("load_local", "i64"); bodyIndex.name = indexName
                local loadOp = "array_load"
                if iterable.typeName == "string" { loadOp = "string_load" }
                value = self.temporary(loadOp, statement.symbol!.typeName!)
                value!.first = bodyIterable.result; value!.second = bodyIndex.result
                value!.elementType = statement.symbol!.typeName!
                if iterable.typeName == "string" { value!.elementOwnership = "value" } else { value!.elementOwnership = self.arrayElementOwnership(iterable.typeName) }
            }
            local localName = statement.name! + "#" + self.nextLocal.toString()
            self.nextLocal = self.nextLocal + 1
            local localValue = new Value("local", localName, statement.symbol!.typeName!)
            self.bindings.append(new Binding(statement.symbol!, localValue))
            local declaredValue = new Instruction("declare_local")
            declaredValue.name = localName; declaredValue.typeName = localValue.typeName; declaredValue.first = value!.result
            self.emit(declaredValue)
            local previousBreak = self.breakTarget; local previousContinue = self.continueTarget
            self.breakTarget = endBlock.label; self.continueTarget = incrementBlock.label
            self.lowerBlock(statement.body!)
            self.breakTarget = previousBreak; self.continueTarget = previousContinue
            self.jumpIfOpen(incrementBlock.label)
            self.currentBlock = incrementBlock
            if statement.iteratorHasNext == null {
                local oldIndex = self.temporary("load_local", "i64"); oldIndex.name = indexName
                local one = self.temporary("constant", "i64"); one.text = "1"
                local nextIndex = self.temporary("binary", "i64")
                nextIndex.operator = "+"; nextIndex.first = oldIndex.result; nextIndex.second = one.result
                local storedIndex = new Instruction("store_local")
                storedIndex.name = indexName; storedIndex.typeName = "i64"; storedIndex.first = nextIndex.result
                self.emit(storedIndex)
            }
            self.jumpIfOpen(conditionBlock.label)
            self.currentBlock = endBlock
        }

        jumpIfOpen(target:string) -> void {
            if self.isTerminated() { return }
            local instruction = new Instruction("jump")
            instruction.target = target
            self.emit(instruction)
        }

        newBlock(prefix:string) -> ref Block {
            local block = new Block(prefix + "_" + self.nextBlock.toString())
            self.nextBlock = self.nextBlock + 1
            self.currentFunction!.blocks.append(block)
            return block
        }

        isTerminated() -> bool {
            if self.currentBlock!.instructions.length == 0 { return false }
            local op = self.currentBlock!.instructions[self.currentBlock!.instructions.length - 1].op
            return op == "return" || op == "jump" || op == "branch"
        }

        emit(instruction:Instruction) -> void { self.currentBlock!.instructions.append(instruction) }

        temporary(op:string, typeName:string) -> Instruction {
            local instruction = new Instruction(op)
            instruction.result = new Value("temporary", "%" + self.nextTemporary.toString(), typeName)
            instruction.typeName = typeName
            self.nextTemporary = self.nextTemporary + 1
            self.emit(instruction)
            return instruction
        }

        runtimeName(symbol:Symbols.Symbol) -> string {
            return "valen_" + symbol.owner!.name + "_" + symbol.name
        }

        lowerExpression(expression:Ast.Expression) -> ref Value {
            if expression.kind == "Integer" { return self.constant(expression.text!, expression.inferredType!) }
            if expression.kind == "Float" {
                local instruction = self.temporary("float_constant", expression.inferredType!)
                instruction.text = expression.text
                self.emit(instruction)
                return instruction.result!
            }
            if expression.kind == "Boolean" {
                if expression.text! == "true" { return self.constant("1", "bool") }
                return self.constant("0", "bool")
            }
            if expression.kind == "Null" { return self.constant("0", expression.inferredType!) }
            if expression.kind == "String" {
                local instruction = self.temporary("string_constant", "string")
                instruction.text = expression.text
                return instruction.result!
            }
            if expression.kind == "InterpolatedString" {
                local builder = self.temporary("builder_new", "StringBuilder")
                local index:i64 = 0
                while index < expression.arguments.length {
                    local value = self.lowerExpression(expression.arguments[index])
                    if value.typeName != "string" {
                        local conversion = self.temporary("integer_to_string", "string")
                        conversion.first = value
                        value = conversion.result!
                    }
                    local append = new Instruction("builder_append_string")
                    append.first = builder.result
                    append.second = value
                    self.emit(append)
                    index = index + 1
                }
                local build = self.temporary("builder_build", "string")
                build.first = builder.result
                return build.result!
            }
            if expression.kind == "ArrayLiteral" { return self.lowerArrayLiteral(expression) }
            if expression.kind == "If" { return self.lowerIfExpression(expression) }
            if expression.kind == "Identifier" { return self.lowerIdentifier(expression) }
            if expression.kind == "Member" { return self.lowerMember(expression) }
            if expression.kind == "Index" { return self.lowerIndex(expression) }
            if expression.kind == "Assignment" { return self.lowerAssignment(expression) }
            if expression.kind == "Unary" {
                local operand = self.lowerExpression(expression.left!)
                if expression.operator! == "copy" {
                    local copied = self.temporary("structural_copy", expression.inferredType!)
                    copied.first = operand
                    copied.ownerType = expression.inferredType
                    return copied.result!
                }
                if expression.operator! == "delete" {
                    local destroyed = new Instruction("destroy_object")
                    destroyed.first = operand
                    self.emit(destroyed)
                    self.consumeLifetime(expression.left!)
                    return new Value("void", "", "void")
                }
                local instruction = self.temporary("unary", expression.inferredType!)
                instruction.operator = expression.operator
                instruction.first = operand
                return instruction.result!
            }
            if expression.kind == "Binary" { return self.lowerBinary(expression) }
            if expression.kind == "Conversion" {
                local value = self.lowerExpression(expression.left!)
                if expression.operator != null {
                    if expression.operator! == "reference" { return value }
                    if expression.operator! == "checked_reference" {
                        local checked = self.temporary("checked_cast", expression.inferredType!)
                        checked.first = value
                        checked.ownerType = expression.text
                        return checked.result!
                    }
                }
                local instruction = self.temporary("convert", expression.inferredType!)
                instruction.first = value
                return instruction.result!
            }
            if expression.kind == "Unwrap" {
                local value = self.lowerExpression(expression.left!)
                local instruction = self.temporary("unwrap", expression.inferredType!)
                instruction.first = value
                instruction.ownerType = value.typeName
                return instruction.result!
            }
            if expression.kind == "Propagate" { return self.lowerPropagation(expression) }
            if expression.kind == "Call" { return self.lowerCall(expression) }
            if expression.kind == "New" { return self.lowerNew(expression) }
            return new Value("error", "", "error")
        }

        constant(textValue:string, typeName:string) -> ref Value {
            local instruction = self.temporary("constant", typeName)
            instruction.text = textValue
            return instruction.result!
        }

        lowerIfExpression(expression:Ast.Expression) -> ref Value {
            local name = "$if#" + self.nextLocal.toString()
            self.nextLocal = self.nextLocal + 1
            local declared = new Instruction("declare_local"); declared.name = name; declared.typeName = expression.inferredType; self.emit(declared)
            local condition = self.lowerExpression(expression.left!)
            local thenBlock = self.newBlock("if_value_then"); local elseBlock = self.newBlock("if_value_else"); local endBlock = self.newBlock("if_value_end")
            local branch = new Instruction("branch"); branch.first = condition; branch.target = thenBlock.label; branch.alternateTarget = elseBlock.label; self.emit(branch)
            self.currentBlock = thenBlock
            self.storeConditionalValue(name, expression.inferredType!, self.lowerValueBlock(expression.body!))
            local jump = new Instruction("jump"); jump.target = endBlock.label; self.emit(jump)
            self.currentBlock = elseBlock
            self.storeConditionalValue(name, expression.inferredType!, self.lowerValueBlock(expression.alternate!))
            jump = new Instruction("jump"); jump.target = endBlock.label; self.emit(jump)
            self.currentBlock = endBlock
            local loaded = self.temporary("load_local", expression.inferredType!); loaded.name = name
            return loaded.result!
        }

        lowerValueBlock(block:Ast.Block) -> ref Value {
            local lifetimeStart = self.bindings.length
            local index:i64 = 0
            while index < block.statements.length - 1 { self.lowerStatement(block.statements[index]); index = index + 1 }
            local terminal = block.statements[block.statements.length - 1]
            local value = self.lowerExpression(terminal.expression!)
            self.consumeLifetime(terminal.expression!)
            self.destroyBindings(lifetimeStart)
            return value
        }

        storeConditionalValue(name:string, typeName:string, value:Value) -> void {
            local converted = self.boxOptional(value, typeName)
            if converted.typeName != typeName && self.isNumeric(converted.typeName) && self.isNumeric(typeName) {
                local conversion = self.temporary("convert", typeName); conversion.first = converted; converted = conversion.result!
            }
            local stored = new Instruction("store_local"); stored.name = name; stored.typeName = typeName; stored.first = converted; self.emit(stored)
        }

        lowerIdentifier(expression:Ast.Expression) -> ref Value {
            local symbol = expression.symbol!
            if symbol.name == "self" { return new Value("parameter", "self", expression.inferredType!) }
            if symbol.kind == "Field" {
                local instruction = self.temporary("load_field", expression.inferredType!)
                instruction.first = new Value("parameter", "self", symbol.owner!.qualifiedName)
                instruction.name = symbol.qualifiedName
                return instruction.result!
            }
            local binding = self.findBinding(symbol)
            if binding == null { return new Value("symbol", symbol.qualifiedName, expression.inferredType!) }
            if binding!.value.kind == "parameter" { return new Value("parameter", binding!.value.name, binding!.value.typeName) }
            local instruction = self.temporary("load_local", binding!.value.typeName)
            instruction.name = binding!.value.name
            return instruction.result!
        }

        lowerMember(expression:Ast.Expression) -> ref Value {
            if expression.symbol != null {
                if expression.symbol!.kind == "EnumCase" { return self.constant(expression.symbol!.enumValue.toString(), expression.symbol!.typeName!) }
            }
            if expression.name! == "length" {
                local owner = self.lowerExpression(expression.left!)
                local op = "array_length"
                if owner.typeName == "string" { op = "string_length" }
                if owner.typeName == "StringBuilder" { op = "builder_length" }
                local instruction = self.temporary(op, expression.inferredType!)
                instruction.first = owner
                return instruction.result!
            }
            if expression.name! == "capacity" {
                local owner = self.lowerExpression(expression.left!)
                local instruction = self.temporary("array_capacity", expression.inferredType!)
                instruction.first = owner
                return instruction.result!
            }
            if expression.name! == "codePointLength" || expression.name! == "graphemeLength" {
                local owner = self.lowerExpression(expression.left!)
                local op = "string_codepoint_length"
                if expression.name! == "graphemeLength" { op = "string_grapheme_length" }
                local instruction = self.temporary(op, "i64")
                instruction.first = owner
                return instruction.result!
            }
            if expression.symbol != null {
                if expression.symbol!.kind == "Field" {
                    local owner = self.lowerExpression(expression.left!)
                    local instruction = self.temporary("load_field", expression.symbol!.typeName!)
                    instruction.first = owner
                    instruction.name = expression.symbol!.qualifiedName
                    return instruction.result!
                }
            }
            return new Value("symbol", expression.name!, expression.inferredType!)
        }

        lowerIndex(expression:Ast.Expression) -> ref Value {
            local container = self.lowerExpression(expression.left!)
            local indexValue = self.lowerExpression(expression.right!)
            local op = "array_load"
            if container.typeName == "string" { op = "string_load" }
            local instruction = self.temporary(op, expression.inferredType!)
            instruction.first = container
            instruction.second = indexValue
            instruction.elementType = expression.inferredType
            instruction.elementOwnership = expression.text
            return instruction.result!
        }

        lowerAssignment(expression:Ast.Expression) -> ref Value {
            local value = self.lowerExpression(expression.right!)
            if expression.right!.ownership == "consume" { self.consumeLifetime(expression.right!) }
            local target = expression.left!
            value = self.boxOptional(value, target.inferredType!)
            if target.kind == "Index" {
                local instruction = new Instruction("array_store")
                instruction.first = self.lowerExpression(target.left!)
                instruction.second = self.lowerExpression(target.right!)
                instruction.third = value
                instruction.elementType = target.inferredType
                instruction.elementOwnership = target.text
                self.emit(instruction)
                return value
            }
            local symbol = target.symbol!
            if symbol.kind == "Field" {
                local instruction = new Instruction("store_field")
                if target.kind == "Member" { instruction.first = self.lowerExpression(target.left!) } else { instruction.first = new Value("parameter", "self", symbol.owner!.qualifiedName) }
                instruction.second = value
                instruction.name = symbol.qualifiedName
                self.emit(instruction)
                return value
            }
            local binding = self.findBinding(symbol)
            local instruction = new Instruction("store_local")
            instruction.name = binding!.value.name
            instruction.first = value
            self.emit(instruction)
            return value
        }

        lowerBinary(expression:Ast.Expression) -> ref Value {
            local left = self.lowerExpression(expression.left!)
            if expression.operator! == "is" {
                local tested = self.temporary("type_test", "bool")
                tested.first = left
                tested.ownerType = expression.text
                return tested.result!
            }
            if expression.operator! == "&&" || expression.operator! == "||" {
                local name = "$short#" + self.nextLocal.toString()
                self.nextLocal = self.nextLocal + 1
                local declared = new Instruction("declare_local")
                declared.name = name
                declared.typeName = "bool"
                declared.first = left
                self.emit(declared)
                local rightBlock = self.newBlock("short_right")
                local endBlock = self.newBlock("short_end")
                local branch = new Instruction("branch")
                branch.first = left
                if expression.operator! == "&&" { branch.target = rightBlock.label; branch.alternateTarget = endBlock.label }
                else { branch.target = endBlock.label; branch.alternateTarget = rightBlock.label }
                self.emit(branch)
                self.currentBlock = rightBlock
                local stored = new Instruction("store_local")
                stored.name = name
                stored.typeName = "bool"
                stored.first = self.lowerExpression(expression.right!)
                self.emit(stored)
                self.jumpIfOpen(endBlock.label)
                self.currentBlock = endBlock
                local loaded = self.temporary("load_local", "bool")
                loaded.name = name
                return loaded.result!
            }
            local right = self.lowerExpression(expression.right!)
            if expression.text != null {
                if left.typeName != expression.text! {
                    local convertedLeft = self.temporary("convert", expression.text!)
                    convertedLeft.first = left
                    left = convertedLeft.result!
                }
                if right.typeName != expression.text! && expression.operator! != "<<" && expression.operator! != ">>" {
                    local convertedRight = self.temporary("convert", expression.text!)
                    convertedRight.first = right
                    right = convertedRight.result!
                }
            }
            local op = "binary"
            if left.typeName == "string" {
                if expression.operator! == "+" { op = "string_concat" }
                if expression.operator! == "==" || expression.operator! == "!=" { op = "string_equal" }
            }
            if (expression.operator! == "==" || expression.operator! == "!=") && self.isReference(left.typeName) { op = "structural_equal" }
            local instruction = self.temporary(op, expression.inferredType!)
            instruction.first = left
            instruction.second = right
            instruction.operator = expression.operator
            instruction.ownerType = left.typeName
            return instruction.result!
        }

        lowerCall(expression:Ast.Expression) -> ref Value {
            local callee = expression.left!
            local name = ""
            if callee.kind == "Member" { name = callee.name! }
            if callee.symbol != null { name = callee.symbol!.name }
            if callee.symbol != null {
                if callee.symbol!.kind == "TestExpect" {
                    local expectation = new Instruction("test_expect")
                    expectation.first = self.lowerExpression(expression.arguments[0])
                    self.emit(expectation)
                    return new Value("void", "", "void")
                }
            }
            if callee.symbol != null {
                if callee.symbol!.kind == "Super" {
                    local superCall = new Instruction("call")
                    superCall.target = callee.symbol!.qualifiedName
                    if superCall.target!.length > 0 {
                        superCall.arguments.append(new Value("parameter", "self", self.currentFunction!.ownerType))
                        local superIndex:i64 = 0
                        while superIndex < expression.arguments.length { superCall.arguments.append(self.lowerExpression(expression.arguments[superIndex])); superIndex = superIndex + 1 }
                        self.emit(superCall)
                    }
                    return new Value("void", "", "void")
                }
            }
            local receiverType = ""
            if callee.kind == "Member" {
                if callee.left!.inferredType != null { receiverType = callee.left!.inferredType! }
            }
            if name == "hash" {
                local hashValue = self.lowerExpression(callee.left!)
                if callee.symbol != null {
                    if callee.symbol!.kind == "EnumHash" { hashValue.typeName = "i64"; return hashValue }
                }
                local hashed = self.temporary("structural_hash", "i64")
                hashed.first = hashValue
                hashed.ownerType = receiverType
                return hashed.result!
            }
            if (name == "append" || name == "appendByte" || name == "appendBytes" || name == "insert") && (receiverType == "StringBuilder" || self.isArray(receiverType)) {
                local op = "array_append"
                if name == "insert" { op = "array_insert" }
                if receiverType == "StringBuilder" {
                    if name == "appendByte" { op = "builder_append_byte" } else { if name == "appendBytes" { op = "builder_append_bytes" } else { op = "builder_append_string" } }
                }
                local instruction = new Instruction(op)
                instruction.first = self.lowerExpression(callee.left!)
                local valueIndex:i64 = 0
                if op == "array_insert" { instruction.arguments.append(self.lowerExpression(expression.arguments[0])); valueIndex = 1 }
                local appended = self.lowerExpression(expression.arguments[valueIndex])
                if op == "builder_append_string" {
                    if appended.typeName != "string" {
                        local conversion = self.temporary("integer_to_string", "string")
                        conversion.first = appended
                        appended = conversion.result!
                    }
                }
                instruction.second = appended
                instruction.elementType = self.arrayElementType(receiverType)
                instruction.elementOwnership = self.arrayElementOwnership(receiverType)
                if op == "array_append" || op == "array_insert" { instruction.second = self.boxOptional(appended, instruction.elementType!) }
                if expression.arguments[valueIndex].ownership == "consume" { self.consumeLifetime(expression.arguments[valueIndex]) }
                self.emit(instruction)
                return new Value("void", "", "void")
            }
            if name == "remove" && self.isArray(receiverType) {
                local array = self.lowerExpression(callee.left!)
                local index = self.lowerExpression(expression.arguments[0])
                local instruction = self.temporary("array_remove", expression.inferredType!)
                instruction.first = array
                instruction.second = index
                instruction.elementType = self.arrayElementType(receiverType)
                instruction.elementOwnership = self.arrayElementOwnership(receiverType)
                return instruction.result!
            }
            if name == "reserve" && self.isArray(receiverType) {
                local instruction = new Instruction("array_reserve")
                instruction.first = self.lowerExpression(callee.left!)
                instruction.second = self.lowerExpression(expression.arguments[0])
                instruction.elementType = self.arrayElementType(receiverType)
                self.emit(instruction)
                return new Value("void", "", "void")
            }
            if name == "shrinkToFit" && self.isArray(receiverType) {
                local instruction = new Instruction("array_shrink")
                instruction.first = self.lowerExpression(callee.left!)
                instruction.elementType = self.arrayElementType(receiverType)
                self.emit(instruction)
                return new Value("void", "", "void")
            }
            if name == "slice" && self.isArray(receiverType) {
                local array = self.lowerExpression(callee.left!)
                local start = self.lowerExpression(expression.arguments[0])
                local count = self.lowerExpression(expression.arguments[1])
                local instruction = self.temporary("array_slice", receiverType)
                instruction.first = array; instruction.second = start; instruction.arguments.append(count)
                instruction.elementType = self.arrayElementType(receiverType); instruction.elementOwnership = self.arrayElementOwnership(receiverType)
                return instruction.result!
            }
            if (name == "codePointAt" || name == "graphemeAt") && receiverType == "string" {
                local owner = self.lowerExpression(callee.left!)
                local indexValue = self.lowerExpression(expression.arguments[0])
                local op = "string_codepoint_at"
                local resultType = "i64"
                if name == "graphemeAt" { op = "string_grapheme_at"; resultType = "string" }
                local instruction = self.temporary(op, resultType)
                instruction.first = owner
                instruction.second = indexValue
                return instruction.result!
            }
            if (name == "slice" && receiverType == "string") || (name == "toString" && self.isInteger(receiverType)) || (name == "build" && receiverType == "StringBuilder") || (name == "toBytes" && receiverType == "string") || (name == "toString" && receiverType == "Array<u8>") {
                local op = "string_slice"
                if name == "toString" { op = "integer_to_string" }
                if name == "build" { op = "builder_build" }
                if name == "toBytes" { op = "string_to_bytes" }
                if name == "toString" && receiverType == "Array<u8>" { op = "bytes_to_string" }
                local owner = self.lowerExpression(callee.left!)
                local loweredArguments = new Array<ref Value>(0)
                local index:i64 = 0
                while index < expression.arguments.length { loweredArguments.append(self.lowerExpression(expression.arguments[index])); index = index + 1 }
                local instruction = self.temporary(op, expression.inferredType!)
                instruction.first = owner
                index = 0
                while index < loweredArguments.length { instruction.arguments.append(loweredArguments[index]); index = index + 1 }
                return instruction.result!
            }
            local instruction = new Instruction("call")
            if callee.symbol != null { instruction.target = callee.symbol!.qualifiedName }
            if callee.kind == "Member" {
                if callee.symbol != null {
                    if callee.symbol!.owner!.kind == "Object" {
                        if callee.text != null {
                            if callee.text! == "super" { instruction.arguments.append(new Value("parameter", "self", self.currentFunction!.ownerType)) } else { instruction.arguments.append(self.lowerExpression(callee.left!)) }
                        } else {
                            instruction.arguments.append(self.lowerExpression(callee.left!))
                        }
                    }
                }
            } else {
                if callee.symbol != null {
                    if callee.symbol!.owner!.kind == "Object" { instruction.arguments.append(new Value("parameter", "self", callee.symbol!.owner!.qualifiedName)) }
                }
            }
            local index:i64 = 0
            while index < expression.arguments.length {
                local argument = self.lowerExpression(expression.arguments[index])
                if callee.symbol != null { if index < callee.symbol!.parameters.length { argument = self.boxOptional(argument, callee.symbol!.parameters[index].typeName!) } }
                instruction.arguments.append(argument)
                index = index + 1
            }
            index = 0
            while index < expression.arguments.length { if expression.arguments[index].ownership == "consume" { self.consumeLifetime(expression.arguments[index]) }; index = index + 1 }
            if callee.symbol != null {
                if callee.symbol!.kind == "Method" && callee.symbol!.name != "__" && callee.symbol!.owner!.kind == "Object" && callee.text == null {
                    local ownerType = self.findType(callee.symbol!.owner!.qualifiedName)
                    if ownerType != null {
                        if self.isContractType(ownerType!.name) {
                            local contractIndex:i64 = 0
                            while contractIndex < ownerType!.contracts.length {
                                if ownerType!.contracts[contractIndex].name == ownerType!.name {
                                    local methodIndex:i64 = 0
                                    while methodIndex < ownerType!.contracts[contractIndex].methods.length {
                                        if ownerType!.contracts[contractIndex].methods[methodIndex].name == self.methodKey(callee.symbol!) {
                                            instruction.op = "contract_call"
                                            instruction.slot = methodIndex
                                            instruction.ownerType = ownerType!.name
                                            break
                                        }
                                        methodIndex = methodIndex + 1
                                    }
                                }
                                contractIndex = contractIndex + 1
                            }
                        } else {
                            local slotIndex:i64 = 0
                            while slotIndex < ownerType!.virtualMethods.length {
                                if ownerType!.virtualMethods[slotIndex].name == self.methodKey(callee.symbol!) { instruction.op = "virtual_call"; instruction.slot = slotIndex; break }
                                slotIndex = slotIndex + 1
                            }
                        }
                    }
                }
            }
            if expression.inferredType! == "void" { self.emit(instruction); return new Value("void", "", "void") }
            instruction.result = new Value("temporary", "%" + self.nextTemporary.toString(), expression.inferredType!)
            instruction.typeName = expression.inferredType
            self.nextTemporary = self.nextTemporary + 1
            self.emit(instruction)
            return instruction.result!
        }

        lowerNew(expression:Ast.Expression) -> ref Value {
            local typeName = expression.inferredType!
            if typeName == "StringBuilder" {
                local builder = self.temporary("builder_new", typeName)
                return builder.result!
            }
            if self.isArray(typeName) {
                local length = self.lowerExpression(expression.arguments[0])
                local instruction = self.temporary("array_new", typeName)
                instruction.first = length
                instruction.elementType = typeName.slice(6, typeName.length - 7)
                return instruction.result!
            }
            local instruction = self.temporary("allocate", typeName)
            instruction.ownerType = typeName
            local instance = instruction.result!
            self.lowerInitializers(expression.symbol!, instance)
            if expression.text != null {
                local call = new Instruction("call")
                call.target = expression.text!
                call.arguments.append(instance)
                local index:i64 = 0
                while index < expression.arguments.length { call.arguments.append(self.lowerExpression(expression.arguments[index])); index = index + 1 }
                self.emit(call)
            }
            return instance
        }

        lowerArrayLiteral(expression:Ast.Expression) -> ref Value {
            local length = self.constant(expression.arguments.length.toString(), "i64")
            local created = self.temporary("array_new", expression.inferredType!)
            created.first = length
            created.elementType = expression.text
            local array = created.result!
            local index:i64 = 0
            while index < expression.arguments.length {
                local element = expression.arguments[index]
                local value = self.lowerExpression(element)
                if value.typeName != expression.text! {
                    local converted = self.temporary("convert", expression.text!)
                    converted.first = value
                    value = converted.result!
                }
                local stored = new Instruction("array_store")
                stored.first = array
                stored.second = self.constant(index.toString(), "i64")
                stored.third = value
                stored.elementType = expression.text
                stored.elementOwnership = "owned"
                self.emit(stored)
                if element.ownership == "consume" { self.consumeLifetime(element) }
                index = index + 1
            }
            return array
        }

        lowerInitializers(owner:Symbols.Symbol, instance:Value) -> void {
            if owner.base != null { self.lowerInitializers(owner.base!, instance) }
            local typeNode = self.findType(owner.qualifiedName)
            if typeNode != null {
                if typeNode!.initializer != null {
                    local initialize = new Instruction("call")
                    initialize.target = typeNode!.initializer
                    initialize.arguments.append(instance)
                    self.emit(initialize)
                }
            }
        }

        lowerPropagation(expression:Ast.Expression) -> Value {
            local value = self.lowerExpression(expression.left!)
            local condition = value
            if expression.operator != null {
                if expression.operator! == "result" {
                    local loadValid = self.temporary("load_field", "bool")
                    loadValid.first = value
                    loadValid.name = expression.text
                    condition = loadValid.result!
                }
            }
            local nullBlock = self.newBlock("propagate_null")
            local valueBlock = self.newBlock("propagate_value")
            local branch = new Instruction("branch")
            branch.first = condition
            branch.target = valueBlock.label
            branch.alternateTarget = nullBlock.label
            self.emit(branch)
            self.currentBlock = nullBlock
            local returnInstruction = new Instruction("return")
            returnInstruction.first = value
            self.emit(returnInstruction)
            self.currentBlock = valueBlock
            if expression.operator != null {
                if expression.operator! == "result" {
                    local loadValue = self.temporary("load_field", expression.inferredType!)
                    loadValue.first = value
                    loadValue.name = expression.name
                    return new Value(loadValue.result!.kind, loadValue.result!.name, loadValue.result!.typeName)
                }
            }
            if self.isPrimitiveOptional(value.typeName) {
                local unwrapped = self.temporary("unwrap", expression.inferredType!)
                unwrapped.first = value
                unwrapped.ownerType = value.typeName
                return new Value(unwrapped.result!.kind, unwrapped.result!.name, unwrapped.result!.typeName)
            }
            return new Value(value.kind, value.name, expression.inferredType!)
        }

        isPrimitiveOptional(typeName:string) -> bool {
            if !self.isOptionalTypeName(typeName) { return false }
            local base = typeName.slice(0, typeName.length - 1)
            return base == "bool" || self.isIntegerTypeName(base) || base == "f32" || base == "f64"
        }

        isOptionalTypeName(typeName:string) -> bool { return typeName.length > 0 && typeName[typeName.length - 1] == 63 }
        isIntegerTypeName(typeName:string) -> bool { return typeName == "u8" || typeName == "i8" || typeName == "u16" || typeName == "i16" || typeName == "u32" || typeName == "i32" || typeName == "u64" || typeName == "i64" }

        boxOptional(value:Value, targetType:string) -> ref Value {
            if !self.isPrimitiveOptional(targetType) || value.typeName == targetType { return new Value(value.kind, value.name, value.typeName) }
            if value.typeName == "null" { return new Value(value.kind, value.name, targetType) }
            local boxed = self.temporary("optional_box", targetType)
            boxed.first = value
            boxed.elementType = targetType.slice(0, targetType.length - 1)
            return boxed.result!
        }

        findBinding(symbol:Symbols.Symbol) -> ref Binding? {
            local index = self.bindings.length
            while index > 0 {
                index = index - 1
                if self.bindings[index].symbol === symbol { return self.bindings[index] }
            }
            return null
        }

        consumeLifetime(expression:Ast.Expression) -> void {
            if expression.symbol == null { return }
            local binding = self.findBinding(expression.symbol!)
            if binding != null {
                binding!.lifetimeActive = false
            }
        }

        destroyBindings(start:i64) -> void {
            local index = self.bindings.length
            while index > start {
                index = index - 1
                local binding = self.bindings[index]
                if binding.lifetimeActive {
                    local op = "destroy_object"
                    if self.isArray(binding.value.typeName) { op = "destroy_array" }
                    local instruction = new Instruction(op)
                    instruction.first = binding.value
                    instruction.ownerType = binding.value.typeName
                    self.emit(instruction)
                    binding.lifetimeActive = false
                }
            }
        }

        destroyBindingsForReturn() -> void {
            local index = self.bindings.length
            while index > 0 {
                index = index - 1
                local binding = self.bindings[index]
                if binding.lifetimeActive {
                    local op = "destroy_object"
                    if self.isArray(binding.value.typeName) { op = "destroy_array" }
                    local instruction = new Instruction(op)
                    instruction.first = binding.value
                    instruction.ownerType = binding.value.typeName
                    self.emit(instruction)
                }
            }
        }

        findType(name:string) -> ref Type? {
            local index:i64 = 0
            while index < self.program.types.length { if self.program.types[index].name == name { return self.program.types[index] }; index = index + 1 }
            return null
        }

        isContractType(name:string) -> bool {
            local typeIndex:i64 = 0
            while typeIndex < self.program.types.length {
                local contractIndex:i64 = 0
                while contractIndex < self.program.types[typeIndex].contracts.length {
                    local entry = self.program.types[typeIndex].contracts[contractIndex]
                    if entry.name == name && !entry.isSelf { return true }
                    contractIndex = contractIndex + 1
                }
                typeIndex = typeIndex + 1
            }
            return false
        }

        findMethod(owner:Symbols.Symbol, name:string) -> ref Symbols.Symbol? {
            if owner.memberScope == null { return null }
            local symbol = owner.memberScope!.lookupLocal(name)
            if symbol != null { if symbol!.kind == "Method" { return symbol } }
            return null
        }

        methodKey(method:Symbols.Symbol) -> string {
            local key = method.name + "("
            local index:i64 = 0
            while index < method.parameters.length {
                if index > 0 { key = key + "," }
                key = key + method.parameters[index].typeName!
                index = index + 1
            }
            return key + ")"
        }

        isArray(name:string) -> bool {
            if name.length <= 7 { return false }
            if name.slice(0, 6) != "Array<" { return false }
            return name[name.length - 1] == 62
        }

        arrayElementOwnership(name:string) -> string {
            local element = name.slice(6, name.length - 7)
            if element.length > 4 { if element.slice(0, 4) == "ref " { return "ref" } }
            if element.length > 5 { if element.slice(0, 5) == "weak " { return "weak" } }
            return "owned"
        }

        arrayElementType(name:string) -> string {
            local element = name.slice(6, name.length - 7)
            if element.length > 4 { if element.slice(0, 4) == "ref " { return element.slice(4, element.length - 4) } }
            if element.length > 5 { if element.slice(0, 5) == "weak " { return element.slice(5, element.length - 5) } }
            return element
        }

        isReference(name:string) -> bool {
            local base = name
            if base.length > 0 { if base[base.length - 1] == 63 { base = base.slice(0, base.length - 1) } }
            return base == "string" || self.isArray(base) || self.findType(base) != null
        }

        isInteger(name:string) -> bool {
            return name == "u8" || name == "i8" || name == "u16" || name == "i16" || name == "u32" || name == "i32" || name == "u64" || name == "i64"
        }

        isNumeric(name:string) -> bool { return self.isInteger(name) || name == "f32" || name == "f64" }
    }}
}}
