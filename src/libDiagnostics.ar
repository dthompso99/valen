import System from './libSystem.ar'
import Compiler from './libCompiler.ar'

library Diagnostics {{
    enum DiagnosticSeverity {{ Error, Warning, Note }}

    DiagnosticLabel {{
        member span:Compiler.SourceSpan
        member message:string
        member primary:bool
        __(span:Compiler.SourceSpan, message:string, primary:bool) -> void { self.span = span; self.message = message; self.primary = primary }
    }}

    FixHint {{
        member span:Compiler.SourceSpan
        member message:string
        member replacement:string
        __(span:Compiler.SourceSpan, message:string, replacement:string) -> void { self.span = span; self.message = message; self.replacement = replacement }
    }}

    Diagnostic {{
        member severity:DiagnosticSeverity
        member message:string
        member span:Compiler.SourceSpan
        member labels:Array<DiagnosticLabel>
        member notes:Array<string>
        member fixes:Array<FixHint>

        __(severity:DiagnosticSeverity, message:string, span:Compiler.SourceSpan) -> void {
            self.severity = severity
            self.message = message
            self.span = span
            self.labels = new Array<DiagnosticLabel>(0)
            self.notes = new Array<string>(0)
            self.fixes = new Array<FixHint>(0)
            self.labels.append(new DiagnosticLabel(span, message, true))
        }

        addLabel(span:Compiler.SourceSpan, message:string) -> void { self.labels.append(new DiagnosticLabel(span, message, false)) }
        addNote(message:string) -> void { self.notes.append(message) }
        addFix(span:Compiler.SourceSpan, message:string, replacement:string) -> void { self.fixes.append(new FixHint(span, message, replacement)) }
    }}

    DiagnosticBag {{
        member diagnostics:Array<ref Diagnostic>

        __() -> void {
            self.diagnostics = new Array<ref Diagnostic>(0)
        }

        add(diagnostic:Diagnostic) -> void {
            self.diagnostics.append(diagnostic)
        }

        length() -> i64 {
            return self.diagnostics.length
        }

        hasErrors() -> bool {
            for diagnostic in self.diagnostics { if diagnostic.severity == Diagnostics.DiagnosticSeverity.Error { return true } }
            return false
        }
    }}

    severityName(severity:DiagnosticSeverity) -> string {
        local name = "note"
        match severity {
            case Diagnostics.DiagnosticSeverity.Error { name = "error" }
            case Diagnostics.DiagnosticSeverity.Warning { name = "warning" }
            case Diagnostics.DiagnosticSeverity.Note { name = "note" }
        }
        return name
    }

    format(diagnostic:Diagnostic) -> string {
        local builder = new StringBuilder()
        builder.append("${diagnostic.span.source.path}:${diagnostic.span.line}:${diagnostic.span.column}: ${severityName(diagnostic.severity)}: ${diagnostic.message}")
        for label in diagnostic.labels {
            if !label.primary { builder.append("\n  --> ${label.span.source.path}:${label.span.line}:${label.span.column}: ${label.message}") }
        }
        for note in diagnostic.notes { builder.append("\n  note: ${note}") }
        for fix in diagnostic.fixes {
            builder.append("\n  help: ${fix.message}")
            builder.append("\n  fix: ${fix.span.source.path}:${fix.span.line}:${fix.span.column}: replace with '${fix.replacement}'")
        }
        return builder.build()
    }

    jsonString(value:string) -> string {
        local builder = new StringBuilder()
        builder.append("\"")
        local index:i64 = 0
        while index < value.graphemeLength {
            local character = value.graphemeAt(index)
            local codePoint = character.codePointAt(0)
            if character == "\"" { builder.append("\\\"") }
            else if character == "\\" { builder.append("\\\\") }
            else if codePoint == 8 { builder.append("\\b") }
            else if codePoint == 9 { builder.append("\\t") }
            else if codePoint == 10 { builder.append("\\n") }
            else if codePoint == 12 { builder.append("\\f") }
            else if codePoint == 13 { builder.append("\\r") }
            else if codePoint < 32 { builder.append("\\u00"); builder.append(hexDigit(codePoint / 16)); builder.append(hexDigit(codePoint - (codePoint / 16) * 16)) }
            else { builder.append(character) }
            index = index + 1
        }
        builder.append("\"")
        return builder.build()
    }

    hexDigit(value:i64) -> string {
        local digits = "0123456789abcdef"
        return digits.slice(value, value + 1)
    }

    jsonSpan(span:Compiler.SourceSpan) -> string {
        return "{\"path\":" + jsonString(span.source.path) + ",\"start\":" + span.start.toString() + ",\"end\":" + span.end.toString() + ",\"line\":" + span.line.toString() + ",\"column\":" + span.column.toString() + "}"
    }

    formatJson(diagnostic:Diagnostic) -> string {
        local builder = new StringBuilder()
        builder.append("{\"severity\":"); builder.append(jsonString(severityName(diagnostic.severity)))
        builder.append(",\"message\":"); builder.append(jsonString(diagnostic.message))
        builder.append(",\"span\":"); builder.append(jsonSpan(diagnostic.span))
        builder.append(",\"labels\":[")
        local labelIndex:i64 = 0
        while labelIndex < diagnostic.labels.length {
            if labelIndex > 0 { builder.append(",") }
            local label = diagnostic.labels[labelIndex]
            builder.append("{\"message\":"); builder.append(jsonString(label.message)); builder.append(",\"primary\":")
            if label.primary { builder.append("true") } else { builder.append("false") }
            builder.append(",\"span\":"); builder.append(jsonSpan(label.span)); builder.append("}")
            labelIndex = labelIndex + 1
        }
        builder.append("],\"notes\":[")
        local noteIndex:i64 = 0
        while noteIndex < diagnostic.notes.length { if noteIndex > 0 { builder.append(",") }; builder.append(jsonString(diagnostic.notes[noteIndex])); noteIndex = noteIndex + 1 }
        builder.append("],\"fixes\":[")
        local fixIndex:i64 = 0
        while fixIndex < diagnostic.fixes.length {
            if fixIndex > 0 { builder.append(",") }
            local fix = diagnostic.fixes[fixIndex]
            builder.append("{\"message\":"); builder.append(jsonString(fix.message)); builder.append(",\"replacement\":"); builder.append(jsonString(fix.replacement)); builder.append(",\"span\":"); builder.append(jsonSpan(fix.span)); builder.append("}")
            fixIndex = fixIndex + 1
        }
        builder.append("]}")
        return builder.build()
    }

    write(bag:DiagnosticBag, outputFormat:string="human") -> void {
        for diagnostic in bag.diagnostics {
            if outputFormat == "json" { System.writeError(formatJson(diagnostic)) } else { System.writeError(format(diagnostic)) }
            System.writeError("\n")
        }
    }
}}
