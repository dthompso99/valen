        reserve(key:string, typeName:string, offset:i64) -> i64 { if self.slotIndex.get(key) >= 0 { return offset }; self.slotIndex.set(key, self.slots.length); self.slots.append(new Slot(key, offset, typeName)); return offset + 8 }
        findSlot(key:string) -> ref Slot? { local index = self.slotIndex.get(key); if index < 0 { return null }; return self.slots[index] }
        slot(key:string) -> string { local value = self.findSlot(key); if value == null { self.error = "missing slot '" + key + "'"; return "[sp, #0]" }; return "[sp, #" + value!.offset.toString() + "]" }
        named(name:string) -> string { local slot = self.findSlot("name:" + name); if slot == null { self.error = "missing parameter/local slot '" + name + "'"; return "[sp, #0]" }; return "[sp, #" + slot!.offset.toString() + "]" }
        temp(name:string) -> string { local slot = self.findSlot("temp:" + name); if slot == null { self.error = "missing temporary slot '" + name + "'"; return "[sp, #0]" }; return "[sp, #" + slot!.offset.toString() + "]" }
        blockLabel(name:string) -> string { return self.currentFunctionSymbol + "__" + self.mangle(name) }
        functionSymbol(name:string) -> string { local index = self.functionIndex.get(name); if index < 0 { return self.mangle(name) }; return self.functionSymbols[index].assemblyName }
        findFunction(name:string) -> ref Ir.Function? { local index:i64 = 0; while index < self.program.functions.length { if self.program.functions[index].name == name { return self.program.functions[index] }; index = index + 1 }; return null }
        findProgramType(name:string) -> ref Ir.Type? { local index:i64 = 0; while index < self.program.types.length { if self.program.types[index].name == name { return self.program.types[index] }; index = index + 1 }; return null }
