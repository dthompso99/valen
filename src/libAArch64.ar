        gcWeakLabel(name:string) -> string { return self.typeLabel(name) + "_gc_weak" }
        gcArrayTraceLabel(name:string) -> string { return ".Lvalen_array_" + self.mangle(name) + "_gc_trace" }
        gcArrayWeakLabel(name:string) -> string { return ".Lvalen_array_" + self.mangle(name) + "_gc_weak" }
        arraySliceLabel(name:string) -> string { return ".Lvalen_array_slice_" + self.mangle(name) }
        arrayDestroyLabel(name:string) -> string { return ".Lvalen_array_destroy_" + self.mangle(name) }
