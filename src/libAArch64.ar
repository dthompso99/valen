        load(value:Ir.Value, register:string) -> void { if value.kind == "constant" { self.constant(register, value.name) } else if value.kind == "local" || value.kind == "parameter" { self.writer.line("    ldr " + register + ", " + self.named(value.name)) } else { self.writer.line("    ldr " + register + ", " + self.temp(value.name)) } }
