import Ir from './libIr.ar'
import AArch64Runtime from './libAArch64Runtime.ar'
import X86Object from './libX86Object.ar'

library AArch64 {{
    StringIndex {{
        member keys:Array<string?>
        member values:Array<i64>
        member count:i64
        __() -> void { self.keys = new Array<string?>(16); self.values = new Array<i64>(16); self.count = 0 }
        bucketFor(key:string, capacity:i64) -> i64 { local value:i64 = 0; local index:i64 = 0; while index < key.length { value = value * 31 + key[index] as i64; if value < 0 { value = 0 - (value + 1) }; value = value - value / capacity * capacity; index = index + 1 }; return value }
        get(key:string) -> i64 { local capacity = self.keys.length; local bucket = self.bucketFor(key, capacity); local checked:i64 = 0; while checked < capacity { local existing = self.keys[bucket]; if existing == null { return -1 }; if existing! == key { return self.values[bucket] }; bucket = bucket + 1; if bucket == capacity { bucket = 0 }; checked = checked + 1 }; return -1 }
        set(key:string, value:i64) -> void { if (self.count + 1) * 4 >= self.keys.length * 3 { self.grow() }; self.insert(key, value) }
        insert(key:string, value:i64) -> void { local capacity = self.keys.length; local bucket = self.bucketFor(key, capacity); while self.keys[bucket] != null { if self.keys[bucket]! == key { self.values[bucket] = value; return }; bucket = bucket + 1; if bucket == capacity { bucket = 0 } }; self.keys[bucket] = key; self.values[bucket] = value; self.count = self.count + 1 }
        grow() -> void { local oldKeys = self.keys; local oldValues = self.values; self.keys = new Array<string?>(oldKeys.length * 2); self.values = new Array<i64>(oldValues.length * 2); self.count = 0; local index:i64 = 0; while index < oldKeys.length { if oldKeys[index] != null { self.insert(oldKeys[index]!, oldValues[index]) }; index = index + 1 } }
    }}

    Writer {{
        member builder:StringBuilder
        __() -> void { self.builder = new StringBuilder() }
        line(value:string) -> void { self.builder.append(value); self.builder.appendByte(10) }
        build() -> string { return self.builder.build() }
    }}

    FunctionSymbol {{
        member name:string
        member assemblyName:string
        __(name:string, assemblyName:string) -> void { self.name = name; self.assemblyName = assemblyName }
    }}

    FieldLayout {{
        member name:string
        member typeName:string
        member ownership:string
        member offset:i64
        __(name:string, typeName:string, ownership:string, offset:i64) -> void { self.name = name; self.typeName = typeName; self.ownership = ownership; self.offset = offset }
    }}

    TypeLayout {{
        member name:string
        member size:i64
        __(name:string, size:i64) -> void { self.name = name; self.size = size }
    }}

    Slot {{
        member key:string
        member offset:i64
        member typeName:string
        __(key:string, offset:i64, typeName:string) -> void { self.key = key; self.offset = offset; self.typeName = typeName }
    }}

    Literal {{
        member value:string
        member dataLabel:string
        member descriptorLabel:string
        __(value:string, dataLabel:string, descriptorLabel:string) -> void { self.value = value; self.dataLabel = dataLabel; self.descriptorLabel = descriptorLabel }
    }}

    Backend {{
        member program:Ir.Program
        member writer:Writer
        member functionSymbols:Array<FunctionSymbol>
        member fields:Array<FieldLayout>
        member types:Array<TypeLayout>
        member slots:Array<Slot>
        member literals:Array<Literal>
        member arrayTypes:Array<string>
        member functionIndex:StringIndex
        member fieldIndex:StringIndex
        member typeIndex:StringIndex
        member slotIndex:StringIndex
        member currentFunction:Ir.Function?
        member currentFunctionSymbol:string
        member nextLabel:i64
        member runtimeLabel:i64
        member outgoingSize:i64
        member optimizationLevel:i64
        member emissionModule:string?
        member includeRuntime:bool
        member includeModuleMetadata:bool
        member threading:bool
        member error:string
        member numericParser:X86Object.Parser

        __(program:Ir.Program, optimizationLevel:i64=1, emissionModule:string?=null, includeRuntime:bool=true, includeModuleMetadata:bool=false) -> void {
            self.program = program; self.writer = new Writer()
            self.functionSymbols = new Array<FunctionSymbol>(0); self.fields = new Array<FieldLayout>(0); self.types = new Array<TypeLayout>(0)
            self.slots = new Array<Slot>(0); self.literals = new Array<Literal>(0); self.arrayTypes = new Array<string>(0)
            self.functionIndex = new StringIndex(); self.fieldIndex = new StringIndex(); self.typeIndex = new StringIndex(); self.slotIndex = new StringIndex()
            self.currentFunction = null; self.currentFunctionSymbol = ""; self.nextLabel = 0; self.runtimeLabel = 0; self.outgoingSize = 0
            self.optimizationLevel = optimizationLevel; self.emissionModule = emissionModule; self.includeRuntime = includeRuntime; self.includeModuleMetadata = includeModuleMetadata
            self.threading = self.hasRuntime("valen_Operations_threadStart"); self.error = ""; self.numericParser = new X86Object.Parser()
        }

        generate() -> string {
            self.layoutTypes(); self.declareSymbols(); self.scanArrayTypes(); self.writer.line(".text")
            local externalIndex:i64 = 0
            while externalIndex < self.program.externals.length { if self.program.externals[externalIndex].foreignLibrary != null { self.writer.line(".extern " + self.program.externals[externalIndex].runtimeName) }; externalIndex = externalIndex + 1 }
            local functionIndex:i64 = 0
            while functionIndex < self.program.functions.length { if self.emits(self.program.functions[functionIndex]) { self.generateFunction(self.program.functions[functionIndex]) }; functionIndex = functionIndex + 1 }
            if self.includeRuntime { self.gcTypeFunctions(); self.gcArrayFunctions(); self.structuralTypeFunctions(); self.generateStart(); self.runtime(); self.metricRuntime(); self.typeData() }
            else { if self.includeModuleMetadata { self.gcTypeFunctions(); self.gcArrayFunctions(); self.structuralTypeFunctions(); self.typeData() }; self.localTrapRuntime() }
            self.stringData(); self.writer.line(".section .note.GNU-stack,\"\",@progbits")
            return self.writer.build()
        }

        validateRuntime() -> Array<string> {
            local errors = new Array<string>(0); local index:i64 = 0
            while index < self.program.externals.length {
                local external = self.program.externals[index]
                if external.foreignLibrary == null && !self.supportsRuntime(external.runtimeName) { errors.append("aarch64-linux runtime does not provide " + external.runtimeName) }
                index = index + 1
            }
            return copy errors
        }

        supportsRuntime(name:string) -> bool {
            if name == "valen_System_collectGarbage" || name == "valen_System_gcTrackedBytes" || name == "valen_System_gcTrackedAllocatedBytes" || name == "valen_System_gcHeapObjects" || name == "valen_System_gcRoots" || name == "valen_System_gcPeakRoots" || name == "valen_System_gcCollections" || name == "valen_System_gcReclaimedObjects" || name == "valen_System_gcTrackedReclaimedBytes" || name == "valen_System_gcWeakReferencesCleared" || name == "valen_System_gcWeakReferencesRetained" || name == "valen_System_gcNativeHandlesOpen" || name == "valen_System_gcNativeHandlesFinalized" || name == "valen_System_print" || name == "valen_System_write" || name == "valen_System_writeError" || name == "valen_System_exit" { return true }
            if name == "valen_System_openRead" || name == "valen_System_openWrite" || name == "valen_System_read" || name == "valen_System_readDirectory" || name == "valen_System_writeFile" || name == "valen_System_close" { return true }
            if name == "valen_System_lastError" || name == "valen_System_arguments" || name == "valen_System_currentDirectory" || name == "valen_System_environmentVariable" { return true }
            if name == "valen_System_enableProcessArena" || name == "valen_System_writeBytes" || name == "valen_System_sync" || name == "valen_System_replaceFile" || name == "valen_System_removeFile" || name == "valen_System_makeExecutable" || name == "valen_System_link" || name == "valen_System_compileLlvm" { return true }
            if name == "valen_System_memoryCopy" || name == "valen_System_memoryCompare" || name == "valen_System_fileDescriptor" || name == "valen_System_makeFileNonblocking" { return true }
            if name == "valen_System_enableShutdownSignals" || name == "valen_System_shutdownRequested" { return true }
            if name == "valen_Network_listen" || name == "valen_Network_accept" || name == "valen_Network_receive" || name == "valen_Network_send" || name == "valen_Network_sendSome" { return true }
            if name == "valen_Network_closeListener" || name == "valen_Network_closeConnection" || name == "valen_Network_lastError" || name == "valen_Network_listenerDescriptor" || name == "valen_Network_connectionDescriptor" { return true }
            if name == "valen_Network_makeListenerNonblocking" || name == "valen_Network_makeConnectionNonblocking" { return true }
            if name == "valen_EventLoop_available" || name == "valen_EventLoop_wait" || name == "valen_EventLoop_monotonicMilliseconds" { return true }
            if name == "valen_Operations_threadAvailable" || name == "valen_Operations_threadStart" || name == "valen_Operations_threadJoin" { return true }
            if name == "valen_Operations_mutexLock" || name == "valen_Operations_mutexUnlock" || name == "valen_Operations_conditionWait" || name == "valen_Operations_conditionNotifyOne" || name == "valen_Operations_conditionNotifyAll" { return true }
            return name == "valen_Operations_atomicLoad" || name == "valen_Operations_atomicStore" || name == "valen_Operations_atomicExchange" || name == "valen_Operations_atomicCompareExchange" || name == "valen_Operations_atomicAdd"
        }

        hasRuntime(name:string) -> bool { local index:i64 = 0; while index < self.program.externals.length { if self.program.externals[index].runtimeName == name { return true }; index = index + 1 }; return false }
        metricRuntime() -> void {
            local names = ["gcTrackedBytes", "gcTrackedAllocatedBytes", "gcHeapObjects", "gcRoots", "gcPeakRoots", "gcCollections", "gcReclaimedObjects", "gcTrackedReclaimedBytes", "gcWeakReferencesCleared", "gcWeakReferencesRetained", "gcNativeHandlesOpen", "gcNativeHandlesFinalized"]
            local index:i64 = 0
            while index < names.length {
                local symbol = "valen_System_" + names[index]
                if self.hasRuntime(symbol) { self.writer.line(".globl " + symbol); self.writer.line(symbol + ":"); self.writer.line("    mov x0, #0"); self.writer.line("    ret") }
                index = index + 1
            }
        }
        emits(function:Ir.Function) -> bool { if function.displayName == "Operations.ThreadOperation.runWorker" { return self.includeRuntime && self.threading }; local index:i64 = 0; while index < self.program.compiledModules.length { if function.modulePath == self.program.compiledModules[index] { return false }; index = index + 1 }; return self.emissionModule == null || function.modulePath == self.emissionModule! }

        layoutTypes() -> void {
            local typeNodeIndex:i64 = 0
            while typeNodeIndex < self.program.types.length {
                local typeNode = self.program.types[typeNodeIndex]; local offset:i64 = 16; local alignment:i64 = 1; local fieldIndex:i64 = 0
                while fieldIndex < typeNode.fields.length {
                    local field = typeNode.fields[fieldIndex]; local size = self.sizeOf(field.typeName); local fieldAlignment = size; if fieldAlignment > 8 { fieldAlignment = 8 }
                    offset = self.align(offset, fieldAlignment); self.fieldIndex.set(field.qualifiedName, self.fields.length); self.fields.append(new FieldLayout(field.qualifiedName, field.typeName, field.ownership, offset))
                    offset = offset + size; if fieldAlignment > alignment { alignment = fieldAlignment }; fieldIndex = fieldIndex + 1
                }
                self.typeIndex.set(typeNode.name, self.types.length); self.types.append(new TypeLayout(typeNode.name, self.align(offset, alignment))); typeNodeIndex = typeNodeIndex + 1
            }
        }

        declareSymbols() -> void {
            local index:i64 = 0
            while index < self.program.functions.length { local function = self.program.functions[index]; self.functionIndex.set(function.name, self.functionSymbols.length); self.functionSymbols.append(new FunctionSymbol(function.name, self.mangle(function.name))); index = index + 1 }
            index = 0
            while index < self.program.externals.length {
                local external = self.program.externals[index]
                if external.foreignLibrary == null && self.supportsRuntime(external.runtimeName) { self.functionIndex.set(external.name, self.functionSymbols.length); self.functionSymbols.append(new FunctionSymbol(external.name, external.runtimeName)) }
                index = index + 1
            }
        }

        generateFunction(function:Ir.Function) -> void {
            self.currentFunction = function; self.currentFunctionSymbol = self.functionSymbol(function.name); self.slots = new Array<Slot>(0); self.slotIndex = new StringIndex()
            self.outgoingSize = self.outgoingStackSize(function); local slotOffset = self.outgoingSize; local parameterIndex:i64 = 0
            while parameterIndex < function.parameters.length { slotOffset = self.reserve("name:" + function.parameters[parameterIndex].name, function.parameters[parameterIndex].typeName, slotOffset); parameterIndex = parameterIndex + 1 }
            local blockIndex:i64 = 0
            while blockIndex < function.blocks.length { local instructionIndex:i64 = 0; while instructionIndex < function.blocks[blockIndex].instructions.length { local instruction = function.blocks[blockIndex].instructions[instructionIndex]; if instruction.result != null { slotOffset = self.reserve("temp:" + instruction.result!.name, instruction.result!.typeName, slotOffset) }; if instruction.op == "declare_local" || instruction.op == "store_local" { local localType = "i64"; if instruction.typeName != null { localType = instruction.typeName! } else if instruction.first != null { localType = instruction.first!.typeName }; slotOffset = self.reserve("name:" + instruction.name!, localType, slotOffset) }; instructionIndex = instructionIndex + 1 }; blockIndex = blockIndex + 1 }
            local loopScratchCount:i64 = 0; blockIndex = 0
            while blockIndex < function.blocks.length { local count:i64 = 0; local index:i64 = 0; while index < function.blocks[blockIndex].instructions.length { if function.blocks[blockIndex].instructions[index].op == "loop_value" { count = count + 1 }; index = index + 1 }; if count > loopScratchCount { loopScratchCount = count }; blockIndex = blockIndex + 1 }
            local loopScratchIndex:i64 = 0; while loopScratchIndex < loopScratchCount { slotOffset = self.reserve("loop-scratch:" + loopScratchIndex.toString(), "", slotOffset); loopScratchIndex = loopScratchIndex + 1 }
            local rootOffset = self.align(slotOffset, 16); local frameSize = self.align(rootOffset + 32, 16); local total = frameSize + 16
            self.writer.line(".globl " + self.currentFunctionSymbol); self.writer.line(".type " + self.currentFunctionSymbol + ", %function"); self.writer.line(self.currentFunctionSymbol + ":")
            self.subtractStack(total); self.writer.line("    str x29, [sp, #" + frameSize.toString() + "]"); self.writer.line("    str x30, [sp, #" + (frameSize + 8).toString() + "]"); self.setFramePointer(frameSize)
            local clearOffset = self.outgoingSize; while clearOffset < slotOffset { self.writer.line("    str xzr, [sp, #" + clearOffset.toString() + "]"); clearOffset = clearOffset + 8 }
            self.storeParameters(function)
            local rootTrace = self.currentFunctionSymbol + "__gc_roots"; self.address("x10", rootTrace); self.writer.line("    str x10, [sp, #" + (rootOffset + 8).toString() + "]"); self.writer.line("    add x10, sp, #0"); self.writer.line("    str x10, [sp, #" + (rootOffset + 16).toString() + "]")
            if self.threading { self.address("x9", "valen_gc_workers"); self.writer.line("    ldr x10, [x9, #0]"); self.writer.line("    cbnz x10, " + self.currentFunctionSymbol + "__gc_push_slow"); self.address("x9", "valen_gc_roots"); self.writer.line("    ldr x10, [x9, #0]"); self.writer.line("    str x10, [sp, #" + rootOffset.toString() + "]"); self.stackAddress("x10", rootOffset); self.writer.line("    str x10, [x9, #0]"); self.writer.line("    b " + self.currentFunctionSymbol + "__gc_push_done"); self.writer.line(self.currentFunctionSymbol + "__gc_push_slow:"); self.stackAddress("x0", rootOffset); self.writer.line("    bl valen_gc_root_push"); self.writer.line(self.currentFunctionSymbol + "__gc_push_done:"); self.writer.line("    bl valen_gc_safepoint") }
            else { self.address("x9", "valen_gc_roots"); self.writer.line("    ldr x10, [x9, #0]"); self.writer.line("    str x10, [sp, #" + rootOffset.toString() + "]"); self.stackAddress("x10", rootOffset); self.writer.line("    str x10, [x9, #0]") }
            blockIndex = 0; local endLabel = self.currentFunctionSymbol + "__return"
            while blockIndex < function.blocks.length { local block = function.blocks[blockIndex]; if block.label != "entry" { self.writer.line(self.blockLabel(block.label) + ":") }; local instructionIndex:i64 = 0; while instructionIndex < block.instructions.length { local instruction = block.instructions[instructionIndex]; if self.threading && (instruction.op == "jump" || instruction.op == "branch") { self.writer.line("    bl valen_gc_safepoint") }; if instruction.op == "jump" { self.loopValueCopies(function, block.label, instruction.target!) }; self.generateInstruction(instruction, endLabel); instructionIndex = instructionIndex + 1 }; blockIndex = blockIndex + 1 }
            self.writer.line(endLabel + ":")
            if self.threading { self.address("x9", "valen_gc_workers"); self.writer.line("    ldr x10, [x9, #0]"); self.writer.line("    cbnz x10, " + self.currentFunctionSymbol + "__gc_pop_slow"); self.address("x9", "valen_gc_roots"); self.writer.line("    ldr x10, [sp, #" + rootOffset.toString() + "]"); self.writer.line("    str x10, [x9, #0]"); self.writer.line("    b " + self.currentFunctionSymbol + "__gc_pop_done"); self.writer.line(self.currentFunctionSymbol + "__gc_pop_slow:"); self.writer.line("    str x0, [sp, #" + (rootOffset + 24).toString() + "]"); self.stackAddress("x0", rootOffset); self.writer.line("    bl valen_gc_root_pop"); self.writer.line("    ldr x0, [sp, #" + (rootOffset + 24).toString() + "]"); self.writer.line(self.currentFunctionSymbol + "__gc_pop_done:") }
            else { self.address("x9", "valen_gc_roots"); self.writer.line("    ldr x10, [sp, #" + rootOffset.toString() + "]"); self.writer.line("    str x10, [x9, #0]") }
            self.writer.line("    ldr x29, [sp, #" + frameSize.toString() + "]"); self.writer.line("    ldr x30, [sp, #" + (frameSize + 8).toString() + "]"); self.addStack(total); self.writer.line("    ret"); self.writer.line(".size " + self.currentFunctionSymbol + ", .-" + self.currentFunctionSymbol); self.writer.line("")
            self.writer.line(".type " + rootTrace + ", %function"); self.writer.line(rootTrace + ":"); self.writer.line("    sub sp, sp, #32"); self.writer.line("    str x30, [sp, #24]"); self.writer.line("    str x0, [sp, #16]"); local rootIndex:i64 = 0; while rootIndex < self.slots.length { local root = self.slots[rootIndex]; if self.isManagedReferenceType(root.typeName) { self.writer.line("    ldr x9, [sp, #16]"); self.writer.line("    ldr x0, [x9, #" + root.offset.toString() + "]"); self.writer.line("    bl valen_gc_mark") }; rootIndex = rootIndex + 1 }; self.writer.line("    ldr x30, [sp, #24]"); self.writer.line("    add sp, sp, #32"); self.writer.line("    ret"); self.writer.line(".size " + rootTrace + ", .-" + rootTrace); self.writer.line("")
        }

        subtractStack(amount:i64) -> void { local remaining = amount; while remaining > 0 { local part = remaining; if part > 4095 { part = 4095 }; self.writer.line("    sub sp, sp, #" + part.toString()); remaining = remaining - part } }
        addStack(amount:i64) -> void { local remaining = amount; while remaining > 0 { local part = remaining; if part > 4095 { part = 4095 }; self.writer.line("    add sp, sp, #" + part.toString()); remaining = remaining - part } }
        setFramePointer(amount:i64) -> void { local first = amount; if first > 4095 { first = 4095 }; self.writer.line("    add x29, sp, #" + first.toString()); local remaining = amount - first; while remaining > 0 { local part = remaining; if part > 4095 { part = 4095 }; self.writer.line("    add x29, x29, #" + part.toString()); remaining = remaining - part } }
        stackAddress(register:string, amount:i64) -> void { local first = amount; if first > 4095 { first = 4095 }; self.writer.line("    add " + register + ", sp, #" + first.toString()); local remaining = amount - first; while remaining > 0 { local part = remaining; if part > 4095 { part = 4095 }; self.writer.line("    add " + register + ", " + register + ", #" + part.toString()); remaining = remaining - part } }

        storeParameters(function:Ir.Function) -> void {
            local integerRegister:i64 = 0; local floatRegister:i64 = 0; local stackIndex:i64 = 0; local index:i64 = 0
            while index < function.parameters.length {
                local parameter = function.parameters[index]
                if self.isFloat(parameter.typeName) && floatRegister < 8 { local width = "d"; local integerWidth = "x"; if parameter.typeName == "f32" { width = "s"; integerWidth = "w" }; self.writer.line("    fmov " + integerWidth + "9, " + width + floatRegister.toString()); self.writer.line("    str x9, " + self.named(parameter.name)); floatRegister = floatRegister + 1 }
                else if !self.isFloat(parameter.typeName) && integerRegister < 8 { self.writer.line("    str x" + integerRegister.toString() + ", " + self.named(parameter.name)); integerRegister = integerRegister + 1 }
                else { self.writer.line("    ldr x9, [x29, #" + (16 + stackIndex * 8).toString() + "]"); self.writer.line("    str x9, " + self.named(parameter.name)); stackIndex = stackIndex + 1 }
                index = index + 1
            }
        }

        generateInstruction(instruction:Ir.Instruction, endLabel:string) -> void {
            local op = instruction.op
            if op == "loop_value" { return }
            if op == "constant" { self.constant("x9", instruction.text!); self.normalize("x9", instruction.typeName!); self.storeResult(instruction, "x9"); return }
            if op == "string_constant" { local literal = self.internString(instruction.text!); self.address("x9", literal.descriptorLabel); self.storeResult(instruction, "x9"); return }
            if op == "float_constant" { self.floatConstant("x9", instruction.text!, instruction.typeName!); self.storeResult(instruction, "x9"); return }
            if instruction.op == "declare_local" { if instruction.first == null { self.writer.line("    str xzr, " + self.named(instruction.name!)) } else { self.load(instruction.first!, "x9"); self.writer.line("    str x9, " + self.named(instruction.name!)) }; return }
            if instruction.op == "load_local" { self.writer.line("    ldr x9, " + self.named(instruction.name!)); self.writer.line("    str x9, " + self.temp(instruction.result!.name)); return }
            if instruction.op == "store_local" { self.load(instruction.first!, "x9"); self.writer.line("    str x9, " + self.named(instruction.name!)); return }
            if op == "load_field" {
                local field = self.findField(instruction.name!); self.load(instruction.first!, "x9"); self.writer.line("    " + self.loadMnemonic(field!.typeName) + " " + self.valueRegister("x9", field!.typeName) + ", [x9, #" + field!.offset.toString() + "]")
                if field!.ownership == "member-weak" { self.weakLoad("x9", "field") }; self.normalize("x9", field!.typeName); self.storeResult(instruction, "x9"); return
            }
            if op == "store_field" { local field = self.findField(instruction.name!); self.load(instruction.first!, "x9"); self.load(instruction.second!, "x10"); self.writer.line("    " + self.storeMnemonic(field!.typeName) + " " + self.valueRegister("x10", field!.typeName) + ", [x9, #" + field!.offset.toString() + "]"); return }
            if op == "unary" { self.generateUnary(instruction); return }
            if instruction.op == "binary" { self.generateBinary(instruction); return }
            if op == "allocate" { self.constant("x0", self.typeSize(instruction.ownerType!).toString()); self.address("x1", self.gcTraceLabel(instruction.ownerType!)); self.address("x2", self.gcWeakLabel(instruction.ownerType!)); self.constant("x3", "0"); self.writer.line("    bl valen_gc_alloc"); self.address("x9", self.typeLabel(instruction.ownerType!)); self.writer.line("    str x9, [x0, #0]"); self.writer.line("    mov x9, #1"); self.writer.line("    str x9, [x0, #8]"); self.storeResult(instruction, "x0"); return }
            if op == "destroy_object" { local done = ".Ldestroy_null_" + self.nextLabel.toString(); self.nextLabel = self.nextLabel + 1; self.load(instruction.first!, "x9"); self.writer.line("    cbz x9, " + done); self.writer.line("    str xzr, [x9, #8]"); self.writer.line(done + ":"); return }
            if op == "destroy_array" { local done = ".Larray_destroy_done_" + self.nextLabel.toString(); self.nextLabel = self.nextLabel + 1; self.load(instruction.first!, "x9"); self.writer.line("    cbz x9, " + done); self.writer.line("    str xzr, [x9, #32]"); self.writer.line(done + ":"); return }
            if op == "array_new" { self.constant("x0", self.sizeOf(instruction.elementType!).toString()); self.load(instruction.first!, "x1"); self.gcArrayAddress("x2", instruction.result!.typeName, false); self.gcArrayAddress("x3", instruction.result!.typeName, true); self.writer.line("    bl valen_array_new"); self.storeResult(instruction, "x0"); return }
            if op == "array_length" || op == "array_capacity" || op == "string_length" || op == "builder_length" { self.load(instruction.first!, "x9"); local offset:i64 = 0; if op == "array_capacity" || op == "string_length" { offset = 8 }; self.writer.line("    ldr x9, [x9, #" + offset.toString() + "]"); self.storeResult(instruction, "x9"); return }
            if op == "array_load" || op == "string_load" {
                self.load(instruction.first!, "x0"); self.load(instruction.second!, "x1")
                if op == "string_load" { self.writer.line("    bl valen_string_address"); self.writer.line("    ldrb w9, [x0, #0]") }
                else { self.constant("x2", self.sizeOf(instruction.elementType!).toString()); self.writer.line("    bl valen_array_address"); self.writer.line("    " + self.loadMnemonic(instruction.elementType!) + " " + self.valueRegister("x9", instruction.elementType!) + ", [x0, #0]"); if instruction.elementOwnership != null { if instruction.elementOwnership! == "weak" { self.weakLoad("x9", "array") } }; self.normalize("x9", instruction.elementType!) }
                self.storeResult(instruction, "x9"); return
            }
            if op == "array_store" {
                self.load(instruction.first!, "x0"); self.load(instruction.second!, "x1"); self.constant("x2", self.sizeOf(instruction.elementType!).toString()); self.writer.line("    bl valen_array_address")
                if instruction.elementOwnership != null { if instruction.elementOwnership! == "owned" { if self.typeIndex.get(self.baseType(instruction.elementType!)) >= 0 { local empty = ".Larray_replace_empty_" + self.nextLabel.toString(); self.nextLabel = self.nextLabel + 1; self.writer.line("    ldr x9, [x0, #0]"); self.writer.line("    cbz x9, " + empty); self.writer.line("    str xzr, [x9, #8]"); self.writer.line(empty + ":") } } }
                self.load(instruction.third!, "x9"); self.writer.line("    " + self.storeMnemonic(instruction.elementType!) + " " + self.valueRegister("x9", instruction.elementType!) + ", [x0, #0]"); return
            }
            if op == "array_append" { self.load(instruction.first!, "x0"); self.load(instruction.second!, "x1"); self.constant("x2", self.sizeOf(instruction.elementType!).toString()); self.writer.line("    bl valen_array_append"); return }
            if op == "array_insert" { self.load(instruction.first!, "x0"); self.load(instruction.arguments[0], "x1"); self.load(instruction.second!, "x2"); self.constant("x3", self.sizeOf(instruction.elementType!).toString()); self.writer.line("    bl valen_array_insert"); return }
            if op == "array_remove" { self.load(instruction.first!, "x0"); self.load(instruction.second!, "x1"); self.constant("x2", self.sizeOf(instruction.elementType!).toString()); self.writer.line("    bl valen_array_remove"); self.normalize("x0", instruction.typeName!); self.storeResult(instruction, "x0"); return }
            if op == "array_reserve" { self.load(instruction.first!, "x0"); self.load(instruction.second!, "x1"); self.constant("x2", self.sizeOf(instruction.elementType!).toString()); self.writer.line("    bl valen_array_reserve"); return }
            if op == "array_shrink" { self.load(instruction.first!, "x0"); self.constant("x1", self.sizeOf(instruction.elementType!).toString()); self.writer.line("    bl valen_array_shrink_to_fit"); return }
            if op == "array_slice" { self.load(instruction.first!, "x0"); self.load(instruction.second!, "x1"); self.load(instruction.arguments[0], "x2"); if instruction.elementOwnership! == "owned" && self.isManagedReferenceType(instruction.elementType!) { self.address("x3", self.arraySliceLabel(instruction.typeName!)); self.writer.line("    bl valen_slice_with_context") } else { self.constant("x3", self.sizeOf(instruction.elementType!).toString()); self.gcArrayAddress("x4", instruction.typeName!, false); self.gcArrayAddress("x5", instruction.typeName!, true); self.writer.line("    bl valen_array_slice") }; self.storeResult(instruction, "x0"); return }
            if op == "string_codepoint_length" || op == "string_grapheme_length" { self.load(instruction.first!, "x0"); self.writer.line("    bl valen_" + op); self.storeResult(instruction, "x0"); return }
            if op == "string_codepoint_at" || op == "string_grapheme_at" { self.load(instruction.first!, "x0"); self.load(instruction.second!, "x1"); self.writer.line("    bl valen_" + op); self.storeResult(instruction, "x0"); return }
            if op == "string_concat" || op == "string_equal" { self.load(instruction.first!, "x0"); self.load(instruction.second!, "x1"); self.writer.line("    bl valen_" + op); if op == "string_equal" && instruction.operator! == "!=" { self.writer.line("    mov x9, #1"); self.writer.line("    eor x0, x0, x9") }; self.storeResult(instruction, "x0"); return }
            if op == "string_slice" { self.load(instruction.first!, "x0"); self.load(instruction.arguments[0], "x1"); self.load(instruction.arguments[1], "x2"); self.writer.line("    bl valen_string_slice"); self.storeResult(instruction, "x0"); return }
            if op == "string_to_bytes" || op == "bytes_to_string" { self.load(instruction.first!, "x0"); self.writer.line("    bl valen_" + op); self.storeResult(instruction, "x0"); return }
            if op == "integer_to_string" { self.load(instruction.first!, "x0"); if self.isUnsigned(instruction.first!.typeName) { self.writer.line("    mov x1, #0") } else { self.writer.line("    mov x1, #1") }; self.writer.line("    bl valen_integer_to_string"); self.storeResult(instruction, "x0"); return }
            if op == "builder_new" { self.constant("x0", "1"); self.constant("x1", "0"); self.constant("x2", "0"); self.constant("x3", "0"); self.writer.line("    bl valen_array_new"); self.storeResult(instruction, "x0"); return }
            if op == "builder_append_string" || op == "builder_append_bytes" { self.load(instruction.first!, "x0"); self.load(instruction.second!, "x1"); self.writer.line("    bl valen_" + op); return }
            if op == "builder_append_byte" { self.load(instruction.first!, "x0"); self.load(instruction.second!, "x1"); self.constant("x2", "1"); self.writer.line("    bl valen_array_append"); return }
            if op == "builder_build" { self.load(instruction.first!, "x0"); self.writer.line("    bl valen_builder_build"); self.storeResult(instruction, "x0"); return }
            if op == "structural_equal" { self.load(instruction.first!, "x0"); self.load(instruction.second!, "x1"); self.writer.line("    mov x2, #0"); self.writer.line("    bl " + self.equalityFunction(instruction.ownerType!)); if instruction.operator! == "!=" { self.writer.line("    mov x9, #1"); self.writer.line("    eor x0, x0, x9") }; self.storeResult(instruction, "x0"); return }
            if op == "structural_hash" { self.load(instruction.first!, "x0"); self.writer.line("    mov x1, #0"); self.writer.line("    bl " + self.hashFunction(instruction.ownerType!)); self.storeResult(instruction, "x0"); return }
            if op == "structural_copy" { self.load(instruction.first!, "x0"); self.address("x1", self.copyFunction(instruction.ownerType!)); self.writer.line("    bl valen_copy_with_context"); self.storeResult(instruction, "x0"); return }
            if op == "call" { self.generateCall(instruction, false); return }
            if op == "virtual_call" { self.generateCall(instruction, true); return }
            if op == "contract_call" { self.generateContractCall(instruction); return }
            if op == "type_test" || op == "checked_cast" { self.generateTypeRelationship(instruction); return }
            if op == "test_expect" { local done = ".Ltest_pass_" + self.nextLabel.toString(); self.nextLabel = self.nextLabel + 1; self.load(instruction.first!, "x9"); self.writer.line("    cbnz x9, " + done); self.address("x10", "valen_test_failures"); self.writer.line("    ldr x11, [x10, #0]"); self.writer.line("    add x11, x11, #1"); self.writer.line("    str x11, [x10, #0]"); self.writer.line("    mov x0, #2"); self.address("x1", "valen_test_failure_message"); self.writer.line("    mov x2, #12"); self.writer.line("    mov x8, #64"); self.writer.line("    svc #0"); self.writer.line(done + ":"); return }
            if op == "test_failures" { self.address("x9", "valen_test_failures"); self.writer.line("    ldr x9, [x9, #0]"); self.storeResult(instruction, "x9"); return }
            if op == "optional_box" { self.constant("x0", "24"); self.constant("x1", "0"); self.constant("x2", "0"); self.constant("x3", "0"); self.writer.line("    bl valen_gc_alloc"); self.writer.line("    str xzr, [x0, #0]"); self.writer.line("    mov x9, #1"); self.writer.line("    str x9, [x0, #8]"); self.writer.line("    str x0, " + self.temp(instruction.result!.name)); self.load(instruction.first!, "x9"); self.writer.line("    ldr x10, " + self.temp(instruction.result!.name)); self.writer.line("    str x9, [x10, #16]"); return }
            if op == "unwrap" { self.load(instruction.first!, "x9"); self.writer.line("    cbz x9, .Loptional_unwrap_error"); if instruction.ownerType != null { if self.isPrimitiveOptional(instruction.ownerType!) { self.writer.line("    ldr x9, [x9, #16]"); self.normalize("x9", instruction.typeName!) } }; self.storeResult(instruction, "x9"); return }
            if op == "convert" { self.generateConvert(instruction); return }
            if instruction.op == "jump" { self.writer.line("    b " + self.blockLabel(instruction.target!)); return }
            if instruction.op == "branch" { self.load(instruction.first!, "x9"); self.writer.line("    cbnz x9, " + self.blockLabel(instruction.target!)); self.writer.line("    b " + self.blockLabel(instruction.alternateTarget!)); return }
            if instruction.op == "return" { if instruction.first == null { self.writer.line("    mov x0, #0") } else if self.isFloat(instruction.first!.typeName) { self.load(instruction.first!, "x9"); if instruction.first!.typeName == "f32" { self.writer.line("    fmov s0, w9") } else { self.writer.line("    fmov d0, x9") } } else { self.load(instruction.first!, "x0") }; self.writer.line("    b " + endLabel); return }
            self.error = "aarch64-linux self-hosted backend does not support IR operation '" + instruction.op + "'"
        }

        loopValueCopies(function:Ir.Function, source:string, target:string) -> void {
            local blockIndex:i64 = 0; while blockIndex < function.blocks.length && function.blocks[blockIndex].label != target { blockIndex = blockIndex + 1 }
            if blockIndex >= function.blocks.length { return }
            local valueIndex:i64 = 0; local instructionIndex:i64 = 0
            while instructionIndex < function.blocks[blockIndex].instructions.length { local instruction = function.blocks[blockIndex].instructions[instructionIndex]; if instruction.op == "loop_value" { local incoming:Ir.Value? = null; if instruction.target! == source { incoming = instruction.first }; if instruction.alternateTarget! == source { incoming = instruction.second }; if incoming != null { self.load(incoming!, "x9"); self.writer.line("    str x9, " + self.slot("loop-scratch:" + valueIndex.toString())) }; valueIndex = valueIndex + 1 }; instructionIndex = instructionIndex + 1 }
            valueIndex = 0; instructionIndex = 0
            while instructionIndex < function.blocks[blockIndex].instructions.length { local instruction = function.blocks[blockIndex].instructions[instructionIndex]; if instruction.op == "loop_value" { self.writer.line("    ldr x9, " + self.slot("loop-scratch:" + valueIndex.toString())); self.storeResult(instruction, "x9"); valueIndex = valueIndex + 1 }; instructionIndex = instructionIndex + 1 }
        }

        generateUnary(instruction:Ir.Instruction) -> void { self.load(instruction.first!, "x9"); if instruction.operator! == "-" { if self.isFloat(instruction.typeName!) { if instruction.typeName! == "f32" { self.constant("x10", "2147483648") } else { self.constant("x10", "-9223372036854775808") }; self.writer.line("    eor x9, x9, x10") } else { self.writer.line("    neg x9, x9") } } else { self.writer.line("    cmp x9, #0"); self.writer.line("    cset x9, eq") }; self.normalize("x9", instruction.typeName!); self.storeResult(instruction, "x9") }

        generateCall(instruction:Ir.Instruction, dynamic:bool) -> void {
            self.loadCallArguments(instruction.arguments)
            if dynamic { self.writer.line("    ldr x9, [x0, #0]"); self.writer.line("    cbz x9, .Lcontract_dispatch_error"); self.writer.line("    ldr x9, [x9, #" + (40 + instruction.slot * 8).toString() + "]"); self.writer.line("    cbz x9, .Lcontract_dispatch_error"); self.writer.line("    blr x9") }
            else { self.writer.line("    bl " + self.functionSymbol(instruction.target!)) }
            self.storeCallResult(instruction)
        }

        generateContractCall(instruction:Ir.Instruction) -> void {
            local id = self.nextLabel; self.nextLabel = self.nextLabel + 1; local loop = ".Lcontract_call_" + id.toString(); local found = ".Lcontract_found_" + id.toString()
            self.load(instruction.arguments[0], "x9"); self.writer.line("    cbz x9, .Lcontract_dispatch_error"); self.writer.line("    ldr x10, [x9, #0]"); self.writer.line("    cbz x10, .Lcontract_dispatch_error"); self.writer.line("    ldr x10, [x10, #8]"); self.writer.line("    ldr x11, [x10, #0]"); self.writer.line("    add x10, x10, #8"); self.address("x12", self.typeLabel(instruction.ownerType!)); self.writer.line(loop + ":"); self.writer.line("    cbz x11, .Lcontract_dispatch_error"); self.writer.line("    ldr x13, [x10, #0]"); self.writer.line("    cmp x13, x12"); self.writer.line("    b.eq " + found); self.writer.line("    add x10, x10, #16"); self.writer.line("    sub x11, x11, #1"); self.writer.line("    b " + loop); self.writer.line(found + ":"); self.writer.line("    ldr x11, [x10, #8]"); self.writer.line("    ldr x11, [x11, #" + (instruction.slot * 8).toString() + "]"); self.writer.line("    cbz x11, .Lcontract_dispatch_error"); self.loadCallArguments(instruction.arguments); self.writer.line("    blr x11"); self.storeCallResult(instruction)
        }

        generateTypeRelationship(instruction:Ir.Instruction) -> void {
            local id = self.nextLabel; self.nextLabel = self.nextLabel + 1; local loop = ".Ltype_test_" + id.toString(); local scan = ".Ltype_contract_" + id.toString(); local next = ".Ltype_next_" + id.toString(); local matched = ".Ltype_match_" + id.toString(); local done = ".Ltype_done_" + id.toString()
            self.load(instruction.first!, "x9"); self.writer.line("    mov x0, #0"); self.writer.line("    cbz x9, " + done); self.writer.line("    ldr x11, [x9, #0]"); self.address("x10", self.typeLabel(instruction.ownerType!)); self.writer.line(loop + ":"); self.writer.line("    cbz x11, " + done); self.writer.line("    cmp x11, x10"); self.writer.line("    b.eq " + matched); self.writer.line("    ldr x12, [x11, #8]"); self.writer.line("    ldr x13, [x12, #0]"); self.writer.line("    add x12, x12, #8"); self.writer.line(scan + ":"); self.writer.line("    cbz x13, " + next); self.writer.line("    ldr x14, [x12, #0]"); self.writer.line("    cmp x14, x10"); self.writer.line("    b.eq " + matched); self.writer.line("    add x12, x12, #16"); self.writer.line("    sub x13, x13, #1"); self.writer.line("    b " + scan); self.writer.line(next + ":"); self.writer.line("    ldr x11, [x11, #0]"); self.writer.line("    b " + loop); self.writer.line(matched + ":"); if instruction.op == "type_test" { self.writer.line("    mov x0, #1") } else { self.writer.line("    mov x0, x9") }; self.writer.line(done + ":"); self.storeResult(instruction, "x0")
        }

        loadCallArguments(arguments:Array<ref Ir.Value>) -> void {
            local general:i64 = 0; local floating:i64 = 0; local stack:i64 = 0; local index:i64 = 0
            while index < arguments.length { local argument = arguments[index]; if self.isFloat(argument.typeName) && floating < 8 { self.load(argument, "x9"); if argument.typeName == "f32" { self.writer.line("    fmov s" + floating.toString() + ", w9") } else { self.writer.line("    fmov d" + floating.toString() + ", x9") }; floating = floating + 1 } else if !self.isFloat(argument.typeName) && general < 8 { self.load(argument, "x" + general.toString()); general = general + 1 } else { self.load(argument, "x9"); self.writer.line("    str x9, [sp, #" + (stack * 8).toString() + "]"); stack = stack + 1 }; index = index + 1 }
        }

        storeCallResult(instruction:Ir.Instruction) -> void { if instruction.result == null { return }; if self.isFloat(instruction.typeName!) { if instruction.typeName! == "f32" { self.writer.line("    fmov w9, s0") } else { self.writer.line("    fmov x9, d0") }; self.storeResult(instruction, "x9") } else { self.normalize("x0", instruction.typeName!); self.storeResult(instruction, "x0") } }

        generateConvert(instruction:Ir.Instruction) -> void {
            local fromType = instruction.first!.typeName; local toType = instruction.typeName!; self.load(instruction.first!, "x9")
            if self.isFloat(fromType) && self.isFloat(toType) { if fromType != toType { if fromType == "f32" { self.writer.line("    fmov s0, w9"); self.writer.line("    fcvt d0, s0"); self.writer.line("    fmov x9, d0") } else { self.writer.line("    fmov d0, x9"); self.writer.line("    fcvt s0, d0"); self.writer.line("    fmov w9, s0") } } }
            else if !self.isFloat(fromType) && self.isFloat(toType) { if self.isUnsigned(fromType) { self.writer.line("    ucvtf " + self.floatRegister("0", toType) + ", x9") } else { self.writer.line("    scvtf " + self.floatRegister("0", toType) + ", x9") }; if toType == "f32" { self.writer.line("    fmov w9, s0") } else { self.writer.line("    fmov x9, d0") } }
            else if self.isFloat(fromType) {
                if fromType == "f32" { self.writer.line("    fmov s0, w9"); self.writer.line("    fcvt d0, s0") } else { self.writer.line("    fmov d0, x9") }
                self.writer.line("    fcmp d0, d0"); self.writer.line("    b.vs .Lfloat_conversion_error")
                local boundary = self.integerBoundary(toType)
                if self.isUnsigned(toType) {
                    self.floatConstant("x10", "0.0", "f64"); self.writer.line("    fmov d1, x10"); self.writer.line("    fcmp d0, d1"); self.writer.line("    b.mi .Lfloat_conversion_error")
                    self.floatConstant("x10", boundary, "f64"); self.writer.line("    fmov d1, x10"); self.writer.line("    fcmp d0, d1"); self.writer.line("    b.ge .Lfloat_conversion_error"); self.writer.line("    fcvtzu x9, d0")
                } else {
                    self.floatConstant("x10", "-" + boundary, "f64"); self.writer.line("    fmov d1, x10"); self.writer.line("    fcmp d0, d1"); self.writer.line("    b.mi .Lfloat_conversion_error")
                    self.floatConstant("x10", boundary, "f64"); self.writer.line("    fmov d1, x10"); self.writer.line("    fcmp d0, d1"); self.writer.line("    b.ge .Lfloat_conversion_error"); self.writer.line("    fcvtzs x9, d0")
                }
                self.normalize("x9", toType)
            }
            else { self.normalize("x9", toType) }
            self.storeResult(instruction, "x9")
        }

        floatRegister(index:string, typeName:string) -> string { if typeName == "f32" { return "s" + index }; return "d" + index }

        integerBoundary(typeName:string) -> string {
            if typeName == "u8" { return "256.0" }; if typeName == "u16" { return "65536.0" }; if typeName == "u32" { return "4294967296.0" }; if typeName == "u64" { return "18446744073709551616.0" }
            if typeName == "i8" { return "128.0" }; if typeName == "i16" { return "32768.0" }; if typeName == "i32" { return "2147483648.0" }; return "9223372036854775808.0"
        }

        generateBinary(instruction:Ir.Instruction) -> void {
            if self.isFloat(instruction.first!.typeName) { self.generateFloatBinary(instruction); return }
            self.load(instruction.first!, "x9"); self.load(instruction.second!, "x10"); local operator = instruction.operator!; local operation:string? = null
            if operator == "+" { operation = "add" }; if operator == "-" { operation = "sub" }; if operator == "*" { operation = "mul" }; if operator == "&&" || operator == "&" { operation = "and" }; if operator == "||" || operator == "|" { operation = "orr" }; if operator == "^" { operation = "eor" }; if operator == "<<" { operation = "lsl" }; if operator == ">>" { if self.isUnsigned(instruction.first!.typeName) { operation = "lsr" } else { operation = "asr" } }
            if operation != null { self.writer.line("    " + operation! + " x9, x9, x10") }
            else if operator == "/" { self.writer.line("    cbz x10, .Ldivision_by_zero_error"); if self.isUnsigned(instruction.first!.typeName) { self.writer.line("    udiv x9, x9, x10") } else { self.writer.line("    sdiv x9, x9, x10") } }
            else { self.writer.line("    cmp x9, x10"); self.writer.line("    cset x9, " + self.condition(operator, self.isUnsigned(instruction.first!.typeName))) }
            self.normalize("x9", instruction.result!.typeName); self.writer.line("    str x9, " + self.temp(instruction.result!.name))
        }

        generateFloatBinary(instruction:Ir.Instruction) -> void {
            local typeName = instruction.first!.typeName; local width = "d"; local integerWidth = "x"; if typeName == "f32" { width = "s"; integerWidth = "w" }
            self.load(instruction.first!, "x9"); self.load(instruction.second!, "x10"); self.writer.line("    fmov " + width + "0, " + integerWidth + "9"); self.writer.line("    fmov " + width + "1, " + integerWidth + "10"); local operator = instruction.operator!
            if operator == "+" || operator == "-" || operator == "*" || operator == "/" { local operation = "fadd"; if operator == "-" { operation = "fsub" }; if operator == "*" { operation = "fmul" }; if operator == "/" { operation = "fdiv" }; self.writer.line("    " + operation + " " + width + "0, " + width + "0, " + width + "1"); self.writer.line("    fmov " + integerWidth + "9, " + width + "0") }
            else { self.writer.line("    fcmp " + width + "0, " + width + "1"); local condition = "eq"; if operator == "!=" { condition = "ne" }; if operator == "<" { condition = "mi" }; if operator == "<=" { condition = "ls" }; if operator == ">" { condition = "gt" }; if operator == ">=" { condition = "ge" }; self.writer.line("    cset x9, " + condition) }
            self.storeResult(instruction, "x9")
        }

        generateStart() -> void {
            local entry = self.findFunction(self.program.entry!)
            self.writer.line(".globl _start"); self.writer.line(".type _start, %function"); self.writer.line("_start:"); self.writer.line("    add x9, sp, #0"); self.writer.line("    ldr x10, [x9, #0]"); self.address("x11", "valen_process_argc"); self.writer.line("    str x10, [x11, #0]"); self.writer.line("    add x12, x9, #8"); self.address("x11", "valen_process_argv"); self.writer.line("    str x12, [x11, #0]"); self.writer.line("    add x13, x10, #1"); self.writer.line("    lsl x13, x13, #3"); self.writer.line("    add x13, x12, x13"); self.address("x11", "valen_process_envp"); self.writer.line("    str x13, [x11, #0]"); self.writer.line("    sub sp, sp, #16")
            if self.threading { self.writer.line("    bl valen_gc_mutator_register") }
            self.constant("x0", self.typeSize(entry!.ownerType).toString()); self.address("x1", self.gcTraceLabel(entry!.ownerType)); self.address("x2", self.gcWeakLabel(entry!.ownerType)); self.constant("x3", "0"); self.writer.line("    bl valen_gc_alloc"); self.address("x9", self.typeLabel(entry!.ownerType)); self.writer.line("    str x9, [x0, #0]"); self.writer.line("    mov x9, #1"); self.writer.line("    str x9, [x0, #8]"); self.writer.line("    str x0, [sp, #0]")
            local typeNode = self.findProgramType(entry!.ownerType); if typeNode != null { if typeNode!.initializer != null { self.writer.line("    bl " + self.functionSymbol(typeNode!.initializer!)); self.writer.line("    ldr x0, [sp, #0]") } }
            self.writer.line("    bl " + self.functionSymbol(entry!.name)); self.writer.line("    add sp, sp, #16"); self.writer.line("    mov x8, #93"); self.writer.line("    svc #0"); self.writer.line(".size _start, .-_start"); self.writer.line("")
        }
        runtime() -> void {
            local template = new AArch64Runtime.Template()
            if self.threading { template.appendThreadedAllocation(self.writer.builder) } else { template.appendAllocation(self.writer.builder) }
            template.append(self.writer.builder)
            if self.hasRuntime("valen_System_compileLlvm") { self.writer.line(".globl valen_System_compileLlvm"); self.writer.line("valen_System_compileLlvm:"); self.writer.line("    mov x0, #127"); self.writer.line("    ret") }
            if self.hasRuntime("valen_Operations_threadAvailable") { template.appendThreadAvailable(self.writer.builder) }
            if self.hasRuntime("valen_Operations_threadStart") { template.appendThreadStart(self.writer.builder) }
            if self.hasRuntime("valen_Operations_threadJoin") { template.appendThreadJoin(self.writer.builder) }
            if self.hasRuntime("valen_Operations_mutexLock") { template.appendMutexLock(self.writer.builder) }
            if self.hasRuntime("valen_Operations_mutexUnlock") { template.appendMutexUnlock(self.writer.builder) }
