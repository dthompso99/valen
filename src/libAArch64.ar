        objectHashLabel(name:string) -> string { return self.typeLabel(name) + "_hash" }
        objectCopyLabel(name:string) -> string { return self.typeLabel(name) + "_copy" }
        arrayEqualityLabel(name:string) -> string { return ".Lvalen_array_equal_" + self.mangle(name) }
        arrayHashLabel(name:string) -> string { return ".Lvalen_array_hash_" + self.mangle(name) }
        arrayCopyLabel(name:string) -> string { return ".Lvalen_array_copy_" + self.mangle(name) }
        equalityFunction(name:string) -> string { local base = self.baseType(name); if base == "string" { return "valen_string_equal_context" }; if self.isArray(base) { return self.arrayEqualityLabel(base) }; return "valen_object_equal" }
        hashFunction(name:string) -> string { local base = self.baseType(name); if base == "string" { return "valen_string_hash_context" }; if self.isArray(base) { return self.arrayHashLabel(base) }; return "valen_object_hash" }
        copyFunction(name:string) -> string { local base = self.baseType(name); if base == "string" { return "valen_string_copy_context" }; if self.isArray(base) { return self.arrayCopyLabel(base) }; return "valen_object_copy" }
        isArray(name:string) -> bool { return name.length > 7 && name.slice(0, 6) == "Array<" }
        isPrimitiveOptional(name:string) -> bool { if name.length < 2 || name[name.length - 1] != 63 { return false }; local base = name.slice(0, name.length - 1); return base == "bool" || base == "i8" || base == "u8" || base == "i16" || base == "u16" || base == "i32" || base == "u32" || base == "i64" || base == "u64" || base == "f32" || base == "f64" }
        isManagedReferenceType(name:string) -> bool { local base = self.baseType(name); if base == "string" || self.isArray(base) { return true }; return self.typeIndex.get(base) >= 0 }
        arrayElementType(name:string) -> string { if !self.isArray(name) { return name }; local element = name.slice(6, name.length - 7); if element.length > 4 && element.slice(0, 4) == "ref " { return element.slice(4, element.length - 4) }; if element.length > 5 && element.slice(0, 5) == "weak " { return element.slice(5, element.length - 5) }; return element }
        arrayOwnership(name:string) -> string { if !self.isArray(name) { return "owned" }; local element = name.slice(6, name.length - 7); if element.length > 4 && element.slice(0, 4) == "ref " { return "ref" }; if element.length > 5 && element.slice(0, 5) == "weak " { return "weak" }; return "owned" }
        gcArrayAddress(register:string, typeName:string, weakMode:bool) -> void { local element = self.arrayElementType(typeName); local ownership = self.arrayOwnership(typeName); local enabled = self.isManagedReferenceType(element); if weakMode { enabled = enabled && ownership == "weak" } else { enabled = enabled && ownership != "weak" }; if enabled { if weakMode { self.address(register, self.gcArrayWeakLabel(typeName)) } else { self.address(register, self.gcArrayTraceLabel(typeName)) } } else { self.constant(register, "0") } }
        internString(value:string) -> ref Literal { local index:i64 = 0; while index < self.literals.length { if self.literals[index].value == value { return self.literals[index] }; index = index + 1 }; local suffix = self.literals.length.toString(); self.literals.append(new Literal(value, ".Lvalen_string_data_" + suffix, ".Lvalen_string_" + suffix)); return self.literals[self.literals.length - 1] }
        outgoingStackSize(function:Ir.Function) -> i64 { local maximum:i64 = 0; local blockIndex:i64 = 0; while blockIndex < function.blocks.length { local instructionIndex:i64 = 0; while instructionIndex < function.blocks[blockIndex].instructions.length { local instruction = function.blocks[blockIndex].instructions[instructionIndex]; if instruction.op == "call" || instruction.op == "virtual_call" || instruction.op == "contract_call" { local count = instruction.arguments.length - 8; if count > maximum { maximum = count } }; instructionIndex = instructionIndex + 1 }; blockIndex = blockIndex + 1 }; if maximum < 0 { maximum = 0 }; return self.align(maximum * 8, 16) }
        condition(operator:string, unsigned:bool) -> string { if operator == "==" || operator == "===" { return "eq" }; if operator == "!=" || operator == "!==" { return "ne" }; if operator == "<" { if unsigned { return "cc" }; return "lt" }; if operator == "<=" { if unsigned { return "ls" }; return "le" }; if operator == ">" { if unsigned { return "hi" }; return "gt" }; if unsigned { return "cs" }; return "ge" }
        stableTypeHash(name:string) -> i64 { local hash:i64 = 1469598103934665603; local index:i64 = 0; while index < name.length { hash = (hash ^ name[index] as i64) * 1099511628211; index = index + 1 }; return hash }
        isUnsigned(name:string) -> bool { return name == "bool" || name == "u8" || name == "u16" || name == "u32" || name == "u64" }
        isFloat(name:string) -> bool { return name == "f32" || name == "f64" }
        align(value:i64, alignment:i64) -> i64 { return ((value + alignment - 1) / alignment) * alignment }
        mangle(name:string) -> string { local builder = new StringBuilder(); local index:i64 = 0; while index < name.length { local byte = name[index]; if (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95 { builder.appendByte(byte) } else { builder.appendByte(95) }; index = index + 1 }; return builder.build() }
    }}
}}
