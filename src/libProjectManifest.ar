import Json from 'libJson.ar'
import Target from './libTarget.ar'

library ProjectManifest {{
    Dependency {{
        member name:string
        member version:string
        member source:string?
        member metadata:string
        __(name:string, version:string, source:string?, metadata:string) -> void {
            self.name = name; self.version = version; self.source = source; self.metadata = metadata
        }
    }}

    Manifest {{
        member name:string
        member version:string
        member source:string
        member output:string
        member target:string?
        member optimization:i64
        member dependencies:Array<Dependency>
        __(name:string, version:string, source:string) -> void {
            self.name = name; self.version = version; self.source = source; self.output = "build/app"
            self.target = null; self.optimization = 1; self.dependencies = new Array<Dependency>(0)
        }
    }}

    Result {{
        member valid:bool
        member manifest:Manifest?
        member offset:i64
        member message:string
        __(valid:bool, manifest:Manifest?=null, offset:i64=0, message:string="") -> void {
            self.valid = valid; self.manifest = manifest; self.offset = offset; self.message = message
        }
    }}

    LockedDependency {{
        member name:string
        member version:string
        member source:string?
        member metadata:string
        member compiler:string
        member target:string
        member abi:string
        member interfaceFingerprint:string
        member implementationFingerprint:string
        member objectFingerprint:string
        __(name:string, version:string, source:string?, metadata:string, compiler:string, target:string, abi:string, interfaceFingerprint:string, implementationFingerprint:string, objectFingerprint:string) -> void {
            self.name = name; self.version = version; self.source = source; self.metadata = metadata; self.compiler = compiler
            self.target = target; self.abi = abi; self.interfaceFingerprint = interfaceFingerprint
            self.implementationFingerprint = implementationFingerprint; self.objectFingerprint = objectFingerprint
        }
    }}

    Lock {{
        member name:string
        member version:string
        member target:string
        member dependencies:Array<LockedDependency>
        __(name:string, version:string, target:string) -> void {
            self.name = name; self.version = version; self.target = target; self.dependencies = new Array<LockedDependency>(0)
        }
    }}

    LockResult {{
        member valid:bool
        member lock:Lock?
        member offset:i64
        member message:string
        __(valid:bool, lock:Lock?=null, offset:i64=0, message:string="") -> void {
            self.valid = valid; self.lock = lock; self.offset = offset; self.message = message
        }
    }}

    Codec {{
        error(message:string) -> Result { return new Result(false, null, 0, message) }

        parse(source:string) -> Result {
            local decoded = Json.parse(source)
            if !decoded.valid { return new Result(false, null, decoded.offset, "Malformed Valen project manifest: " + decoded.message) }
            local root = decoded.value!
            if root.kind != Json.Kind.Object { return self.error("Project manifest must be an object") }
            local unknown = self.unknown(root, "format|package|executable|dependencies")
            if unknown != null { return self.error("Unknown project manifest field '" + unknown! + "'") }
            local format = root.get("format")
            if format == null || format!.kind != Json.Kind.Integer || format!.integer != 1 { return self.error("Unsupported project manifest version") }

            local package = root.get("package")
            if package == null || package!.kind != Json.Kind.Object { return self.error("Project package must be an object") }
            unknown = self.unknown(package!, "name|version")
            if unknown != null { return self.error("Unknown project package field '" + unknown! + "'") }
            local name = self.requiredString(package!, "name", "Project package name")
            if name == null { return self.error("Project package name must be a non-empty string") }
            if !self.validName(name!) { return self.error("Invalid project package name '" + name! + "'") }
            local version = self.requiredString(package!, "version", "Project package version")
            if version == null || !self.validVersion(version!) { return self.error("Project package version must be a semantic version") }

            local executable = root.get("executable")
            if executable == null || executable!.kind != Json.Kind.Object { return self.error("Project executable must be an object") }
            unknown = self.unknown(executable!, "source|output|target|optimization")
            if unknown != null { return self.error("Unknown project executable field '" + unknown! + "'") }
            local executableSource = self.requiredString(executable!, "source", "Project executable source")
            if executableSource == null { return self.error("Project executable source must be a non-empty string") }
            if !self.validPath(executableSource!) { return self.error("Project executable source must stay within the project root") }
            local result = new Manifest(name!, version!, executableSource!)
            local output = executable!.get("output")
            if output != null {
                if output!.kind != Json.Kind.String || output!.text.length == 0 { return self.error("Project executable output must be a non-empty string") }
                if !self.validPath(output!.text) { return self.error("Project executable output must stay within the project root") }
                result.output = output!.text
            }
            local target = executable!.get("target")
            if target != null {
                if target!.kind != Json.Kind.String || target!.text.length == 0 { return self.error("Project executable target must be a non-empty string") }
                local resolved = (new Target.Resolver()).resolve(target!.text)
                if resolved == null { return self.error("Unsupported project executable target '" + target!.text + "'") }
                result.target = resolved!.name
            }
            local optimization = executable!.get("optimization")
            if optimization != null {
                if optimization!.kind != Json.Kind.Integer || optimization!.integer != 0 && optimization!.integer != 1 { return self.error("Project executable optimization must be 0 or 1") }
                result.optimization = optimization!.integer
            }

            local dependencies = root.get("dependencies")
            if dependencies != null {
                if dependencies!.kind != Json.Kind.Array { return self.error("Project dependencies must be an array") }
                local index:i64 = 0
                while index < dependencies!.values.length {
                    local dependency = dependencies!.values[index]
                    if dependency.kind != Json.Kind.Object { return self.error("Project dependency " + index.toString() + " must be an object") }
                    unknown = self.unknown(dependency, "name|version|source|metadata")
                    if unknown != null { return self.error("Unknown project dependency " + index.toString() + " field '" + unknown! + "'") }
                    local dependencyName = self.requiredString(dependency, "name", "dependency name")
                    local dependencyVersion = self.requiredString(dependency, "version", "dependency version")
                    local metadata = self.requiredString(dependency, "metadata", "dependency metadata")
                    if dependencyName == null || !self.validName(dependencyName!) { return self.error("Invalid project dependency name") }
                    if dependencyVersion == null || !self.validVersion(dependencyVersion!) { return self.error("Project dependency '" + dependencyName! + "' version must be a semantic version") }
                    if metadata == null || !self.validPath(metadata!) { return self.error("Project dependency '" + dependencyName! + "' metadata must stay within the project root") }
                    local dependencySource:string? = null
                    local sourceValue = dependency.get("source")
                    if sourceValue != null {
                        if sourceValue!.kind != Json.Kind.String || sourceValue!.text.length == 0 || !self.validPath(sourceValue!.text) { return self.error("Project dependency '" + dependencyName! + "' source must stay within the project root") }
                        dependencySource = sourceValue!.text
                    }
                    local insertion:i64 = 0
                    while insertion < result.dependencies.length && self.less(result.dependencies[insertion].name, dependencyName!) { insertion = insertion + 1 }
                    if insertion < result.dependencies.length && result.dependencies[insertion].name == dependencyName! { return self.error("Duplicate project dependency '" + dependencyName! + "'") }
                    result.dependencies.insert(insertion, new Dependency(dependencyName!, dependencyVersion!, dependencySource, metadata!))
                    index = index + 1
                }
            }
            return new Result(true, result)
        }

        parseLock(source:string) -> LockResult {
            local decoded = Json.parse(source)
            if !decoded.valid { return new LockResult(false, null, decoded.offset, "Malformed Valen project lockfile: " + decoded.message) }
            local root = decoded.value!
            if root.kind != Json.Kind.Object { return new LockResult(false, null, 0, "Project lockfile must be an object") }
            local unknown = self.unknown(root, "format|package|target|dependencies")
            if unknown != null { return new LockResult(false, null, 0, "Unknown project lockfile field '" + unknown! + "'") }
            local format = root.get("format")
            if format == null || format!.kind != Json.Kind.Integer || format!.integer != 1 { return new LockResult(false, null, 0, "Unsupported project lockfile version") }
            local package = root.get("package")
            if package == null || package!.kind != Json.Kind.Object { return new LockResult(false, null, 0, "Project lockfile package must be an object") }
            unknown = self.unknown(package!, "name|version")
            if unknown != null { return new LockResult(false, null, 0, "Unknown project lockfile package field '" + unknown! + "'") }
            local name = self.requiredString(package!, "name", "lockfile package name")
            local version = self.requiredString(package!, "version", "lockfile package version")
            local targetValue = self.requiredString(root, "target", "lockfile target")
            if name == null || !self.validName(name!) { return new LockResult(false, null, 0, "Invalid project lockfile package name") }
            if version == null || !self.validVersion(version!) { return new LockResult(false, null, 0, "Project lockfile package version must be a semantic version") }
            if targetValue == null || (new Target.Resolver()).resolve(targetValue!) == null { return new LockResult(false, null, 0, "Unsupported project lockfile target") }
            local resolvedTarget = (new Target.Resolver()).resolve(targetValue!)!
            local result = new Lock(name!, version!, resolvedTarget.name)
            local dependencies = root.get("dependencies")
            if dependencies == null || dependencies!.kind != Json.Kind.Array { return new LockResult(false, null, 0, "Project lockfile dependencies must be an array") }
            local index:i64 = 0
            while index < dependencies!.values.length {
                local dependency = dependencies!.values[index]
                if dependency.kind != Json.Kind.Object { return new LockResult(false, null, 0, "Project lockfile dependency " + index.toString() + " must be an object") }
                unknown = self.unknown(dependency, "name|version|source|metadata|compiler|target|abi|interfaceFingerprint|implementationFingerprint|objectFingerprint")
                if unknown != null { return new LockResult(false, null, 0, "Unknown project lockfile dependency " + index.toString() + " field '" + unknown! + "'") }
                local dependencyName = self.requiredString(dependency, "name", "name")
                local dependencyVersion = self.requiredString(dependency, "version", "version")
                local metadata = self.requiredString(dependency, "metadata", "metadata")
                local compiler = self.requiredString(dependency, "compiler", "compiler")
                local dependencyTarget = self.requiredString(dependency, "target", "target")
                local abi = self.requiredString(dependency, "abi", "abi")
                local interfaceFingerprint = self.requiredString(dependency, "interfaceFingerprint", "interface fingerprint")
                local implementationFingerprint = self.requiredString(dependency, "implementationFingerprint", "implementation fingerprint")
                local objectFingerprint = self.requiredString(dependency, "objectFingerprint", "object fingerprint")
                if dependencyName == null || !self.validName(dependencyName!) || dependencyVersion == null || !self.validVersion(dependencyVersion!) || metadata == null || !self.validPath(metadata!) || compiler == null || dependencyTarget == null || abi == null || interfaceFingerprint == null || implementationFingerprint == null || objectFingerprint == null { return new LockResult(false, null, 0, "Invalid project lockfile dependency " + index.toString()) }
                local sourcePath:string? = null; local sourceValue = dependency.get("source")
                if sourceValue != null {
                    if sourceValue!.kind == Json.Kind.Null { sourcePath = null }
                    else { if sourceValue!.kind != Json.Kind.String || sourceValue!.text.length == 0 || !self.validPath(sourceValue!.text) { return new LockResult(false, null, 0, "Invalid project lockfile dependency source") }; sourcePath = sourceValue!.text }
                }
                if dependencyTarget! != result.target || compiler! != "valen-interface-1" || abi! != "valen-native-1" { return new LockResult(false, null, 0, "Incompatible project lockfile dependency '" + dependencyName! + "'") }
                if result.dependencies.length > 0 && !self.less(result.dependencies[result.dependencies.length - 1].name, dependencyName!) { return new LockResult(false, null, 0, "Project lockfile dependencies must be sorted by name without duplicates") }
                result.dependencies.append(new LockedDependency(dependencyName!, dependencyVersion!, sourcePath, metadata!, compiler!, dependencyTarget!, abi!, interfaceFingerprint!, implementationFingerprint!, objectFingerprint!))
                index = index + 1
            }
            return new LockResult(true, result)
        }

        verify(manifest:Manifest, lock:Lock, selectedTarget:string) -> string? {
            local resolved = (new Target.Resolver()).resolve(selectedTarget)
            if resolved == null { return "Unsupported selected project target '" + selectedTarget + "'" }
            local expectedTarget = resolved!.name; if manifest.target != null { expectedTarget = manifest.target! }
            if lock.name != manifest.name || lock.version != manifest.version || lock.target != expectedTarget { return "Valen project lockfile is stale" }
            if lock.dependencies.length != manifest.dependencies.length { return "Valen project lockfile is stale" }
            local index:i64 = 0
            while index < manifest.dependencies.length {
                local expected = manifest.dependencies[index]; local actual = lock.dependencies[index]
                if actual.name != expected.name || actual.version != expected.version || actual.metadata != expected.metadata { return "Valen project lockfile is stale" }
                if actual.source == null && expected.source != null || actual.source != null && expected.source == null { return "Valen project lockfile is stale" }
                if actual.source != null && actual.source! != expected.source! { return "Valen project lockfile is stale" }
                index = index + 1
            }
            return null
        }

        serialize(manifest:Manifest) -> string {
            local output = new StringBuilder(); output.append("{\"format\":1,\"package\":{\"name\":"); output.append(Json.quote(manifest.name))
            output.append(",\"version\":"); output.append(Json.quote(manifest.version)); output.append("},\"executable\":{\"source\":"); output.append(Json.quote(manifest.source))
            output.append(",\"output\":"); output.append(Json.quote(manifest.output)); output.append(",\"target\":")
            if manifest.target == null { output.append("null") } else { output.append(Json.quote(manifest.target!)) }
            output.append(",\"optimization\":"); output.append(manifest.optimization); output.append("},\"dependencies\":[")
            local index:i64 = 0
            while index < manifest.dependencies.length {
                if index > 0 { output.append(",") }; local dependency = manifest.dependencies[index]
                output.append("{\"name\":"); output.append(Json.quote(dependency.name)); output.append(",\"version\":"); output.append(Json.quote(dependency.version)); output.append(",\"source\":")
                if dependency.source == null { output.append("null") } else { output.append(Json.quote(dependency.source!)) }
                output.append(",\"metadata\":"); output.append(Json.quote(dependency.metadata)); output.append("}"); index = index + 1
            }
            output.append("]}"); return output.build()
        }

        serializeLock(lock:Lock) -> string {
            local output = new StringBuilder(); output.append("{\"format\":1,\"package\":{\"name\":"); output.append(Json.quote(lock.name))
            output.append(",\"version\":"); output.append(Json.quote(lock.version)); output.append("},\"target\":"); output.append(Json.quote(lock.target)); output.append(",\"dependencies\":[")
            local index:i64 = 0
            while index < lock.dependencies.length {
                if index > 0 { output.append(",") }; local dependency = lock.dependencies[index]
                output.append("{\"name\":"); output.append(Json.quote(dependency.name)); output.append(",\"version\":"); output.append(Json.quote(dependency.version)); output.append(",\"source\":")
                if dependency.source == null { output.append("null") } else { output.append(Json.quote(dependency.source!)) }
                output.append(",\"metadata\":"); output.append(Json.quote(dependency.metadata)); output.append(",\"compiler\":"); output.append(Json.quote(dependency.compiler))
                output.append(",\"target\":"); output.append(Json.quote(dependency.target)); output.append(",\"abi\":"); output.append(Json.quote(dependency.abi))
                output.append(",\"interfaceFingerprint\":"); output.append(Json.quote(dependency.interfaceFingerprint)); output.append(",\"implementationFingerprint\":"); output.append(Json.quote(dependency.implementationFingerprint))
                output.append(",\"objectFingerprint\":"); output.append(Json.quote(dependency.objectFingerprint)); output.append("}"); index = index + 1
            }
            output.append("]}"); return output.build()
        }

        requiredString(value:Json.Value, key:string, where:string) -> string? {
            local selected = value.get(key)
            if selected == null || selected!.kind != Json.Kind.String || selected!.text.length == 0 { return null }
            return selected!.text
        }

        unknown(value:Json.Value, allowed:string) -> string? {
            local index:i64 = 0
            while index < value.keys.length {
                local key = value.keys[index]
                local surrounded = "|" + allowed + "|"; local needle = "|" + key + "|"
                if !self.contains(surrounded, needle) { return key }
                index = index + 1
            }
            return null
        }

        contains(value:string, needle:string) -> bool {
            if needle.length > value.length { return false }; local index:i64 = 0
            while index + needle.length <= value.length { if value.slice(index, needle.length) == needle { return true }; index = index + 1 }
            return false
        }

        validPath(value:string) -> bool {
            if value.length == 0 || value[0] == 47 || value[0] == 92 { return false }
            local start:i64 = 0; local index:i64 = 0
            while index <= value.length {
                if index == value.length || value[index] == 47 || value[index] == 92 {
                    if index - start == 2 && value[start] == 46 && value[start + 1] == 46 { return false }
                    start = index + 1
                }
                index = index + 1
            }
            return true
        }

        validName(value:string) -> bool {
            if value.length == 0 || !self.alpha(value[0]) && value[0] != 95 { return false }; local index:i64 = 1
            while index < value.length { if !self.alpha(value[index]) && !self.digit(value[index]) && value[index] != 95 && value[index] != 45 { return false }; index = index + 1 }
            return true
        }

        validVersion(value:string) -> bool {
            local coreEnd = value.length; local index:i64 = 0
            while index < value.length { if value[index] == 45 || value[index] == 43 { coreEnd = index; break }; index = index + 1 }
            local component:i64 = 0; local start:i64 = 0; index = 0
            while index <= coreEnd {
                if index == coreEnd || value[index] == 46 {
                    if index == start || component > 2 || index - start > 1 && value[start] == 48 { return false }
                    local digitIndex = start; while digitIndex < index { if !self.digit(value[digitIndex]) { return false }; digitIndex = digitIndex + 1 }
                    component = component + 1; start = index + 1
                }
                index = index + 1
            }
            if component != 3 { return false }
            if coreEnd < value.length {
                if coreEnd + 1 >= value.length { return false }; index = coreEnd + 1
                while index < value.length { local byte = value[index]; if !self.alpha(byte) && !self.digit(byte) && byte != 45 && byte != 46 && byte != 43 { return false }; index = index + 1 }
            }
            return true
        }

        alpha(value:u8) -> bool { return value >= 65 && value <= 90 || value >= 97 && value <= 122 }
        digit(value:u8) -> bool { return value >= 48 && value <= 57 }
        less(left:string, right:string) -> bool {
            local length = left.length; if right.length < length { length = right.length }; local index:i64 = 0
            while index < length { if left[index] < right[index] { return true }; if left[index] > right[index] { return false }; index = index + 1 }
            return left.length < right.length
        }
    }}
}}
