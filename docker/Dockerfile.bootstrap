FROM node:20-alpine AS bootstrap
RUN apk update && apk add --no-cache build-base
WORKDIR /app
COPY bootstrap/package.json ./
RUN npm install --omit=dev
COPY bootstrap/ ./
COPY src/ ./src/
COPY lib/ ./lib/
ENV VALEN_LIBRARY_PATH=/app/lib

RUN mkdir dist
RUN ["node", "compiler.js", "src/valen.ar", "dist/valen"]
CMD ["ls", "-l", "dist/valen"]

FROM alpine:3.20 AS stage2
RUN apk update && apk add --no-cache build-base
WORKDIR /app
COPY --from=bootstrap /app/dist/valen .
RUN chmod +x valen
COPY src/ ./src/
COPY lib/ ./lib/

ENV VALEN_LIBRARY_PATH=/app/lib
RUN mkdir dist
RUN ["./valen", "src/valen.ar", "-o", "dist/valen"]
RUN ls -al dist


FROM alpine:3.20 AS stage3
RUN apk update && apk add --no-cache build-base sqlite-dev
WORKDIR /app
COPY --from=stage2 /app/dist/valen .
#for now, we'll use stage3 as a testing stage.
COPY examples/ ./examples/
COPY native/ ./native/
COPY scripts/build-sqlite-adapter.sh ./scripts/build-sqlite-adapter.sh
COPY bootstrap/test/fixtures/native-tests.ar ./tests/native-tests.ar
COPY bootstrap/test/fixtures/native-tests-failing.ar ./tests/native-tests-failing.ar
COPY lib/ ./lib/
ENV VALEN_LIBRARY_PATH=/app/lib
ENV LIBRARY_PATH=/app/build/native
ENV LD_LIBRARY_PATH=/app/build/native
RUN mkdir dist
RUN ["scripts/build-sqlite-adapter.sh", "/app/build/native"]
RUN ls -al ./examples
RUN ["./valen", "examples/simple/simple.ar", "-o", "dist/simple"]
RUN ["dist/simple"]
RUN ["./valen", "examples/nested/nested.ar", "-o", "dist/nested"]
RUN ["dist/nested"]
RUN ["./valen", "examples/sqlite-native/server.ar", "-o", "dist/sqlite-service"]
RUN ["./valen", "tests/native-tests.ar", "-o", "dist/native-tests"]
RUN ["dist/native-tests"]
RUN ["./valen", "tests/native-tests-failing.ar", "-o", "dist/native-tests-failing"]
RUN /bin/sh -c 'dist/native-tests-failing >/tmp/test.stdout 2>/tmp/test.stderr; status=$?; test "$status" -eq 1; grep -q "test failed" /tmp/test.stderr'
RUN ls -al dist
CMD ["/bin/sh"]

FROM scratch AS scratch-runtime
COPY --from=stage3 /app/dist/simple /valen-smoke
ENTRYPOINT ["/valen-smoke"]
