Base {{
    member value:i64

    __(value:i64) -> void { self.value = value }
    __(value:string) -> void { self.value = value.length }

    add(left:i64, right:i64) -> i64 { return left + right }
    add(left:string, right:string) -> string { return left + right }
}}

Child inherits Base {{
    member name:string

    __(value:i64, name:string) -> void {
        super(value)
        self.name = name
    }

    add(left:i64, right:i64) -> i64 { return super.add(left, right) + 1 }
}}

Animal {{}}
Dog inherits Animal {{}}
Puppy inherits Dog {{}}

Chooser {{
    choose(value:Animal) -> i64 { return 1 }
    choose(value:Dog) -> i64 { return 2 }
}}

entry {{
    __() -> i32 {
        local number = new Base(7)
        local text = new Base("four")
        local child = new Child(10, "valen")
        if number.value != 7 { return 1 }
        if text.value != 4 { return 2 }
        if child.add(2, 3) != 6 { return 3 }
        if child.add("ar", "gon") != "valen" { return 4 }
        local chooser = new Chooser()
        if chooser.choose(new Puppy()) != 2 { return 5 }
        return 0
    }
}}
