import System from '/lib/libSystem.ar'

entry {{
    __() -> i32 {
        local cwd = System.currentDirectory()
        if cwd == null || cwd!.length == 0 {
            return 1
        }
        if System.resolvePath("/project", "/project/src/compiler.ar", "/lib/libSystem.ar") != "/project/lib/libSystem.ar" {
            return 2
        }
        if System.resolvePath("/project", "/project/src/compiler.ar", "parser.ar") != "/project/src/parser.ar" {
            return 3
        }

        local missing = System.openRead("/path/that/valen/does/not/have")
        if missing != null || System.lastError() == 0 {
            return 4
        }

        local source = new Array<u8>(4)
        source[0] = 10
        source[1] = 20
        source[2] = 30
        source[3] = 40
        local destination = new Array<u8>(6)
        if !System.memoryCopy(destination, 1, source, 1, 3) {
            return 5
        }
        if destination[1] != 20 || destination[2] != 30 || destination[3] != 40 {
            return 6
        }
        if System.memoryCompare(destination, 1, source, 1, 3) != 0 {
            return 7
        }
        destination[2] = 99
        if System.memoryCompare(destination, 1, source, 1, 3) == 0 {
            return 8
        }
        return 0
    }
}}
