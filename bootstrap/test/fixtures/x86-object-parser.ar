import X86Object from '../../../src/libX86Object.ar'

test X86ObjectParserTests {{
    parsesRegistersAndMemory() -> void {
        local parser = new X86Object.Parser()
        local register = parser.operand("r12d")
        expect(register.kind == "register")
        expect(register.code == 12)
        expect(register.size == 4)
        local memory = parser.operand("QWORD PTR [rax+r14*8-32]")
        expect(memory.kind == "memory")
        expect(memory.size == 8)
        expect(memory.base == 0)
        expect(memory.index == 14)
        expect(memory.scale == 8)
        expect(memory.displacement == -32)
        local relative = parser.operand("QWORD PTR [rip+target]")
        expect(relative.base == 16)
        expect(relative.symbol! == "target")
    }

    parsesAssemblerIntegers() -> void {
        local parser = new X86Object.Parser()
        expect(parser.integer("-128") == -128)
        expect(parser.integer("0x7fffffff") == 2147483647)
    }

    encodesCoreInstructionsAndRelocations() -> void {
        local parser = new X86Object.Parser()
        local encoder = new X86Object.Encoder(".text", 0)
        local move = new Array<X86Object.Operand>(0)
        move.append(parser.operand("rax")); move.append(parser.operand("rbx"))
        expect(encoder.instruction("mov", move))
        local subtract = new Array<X86Object.Operand>(0)
        subtract.append(parser.operand("rsp")); subtract.append(parser.operand("32"))
        expect(encoder.instruction("sub", subtract))
        expect(encoder.bytes.length() == 10)
        expect(encoder.bytes.values[0] == 72 && encoder.bytes.values[1] == 139 && encoder.bytes.values[2] == 195)
        expect(encoder.bytes.values[3] == 72 && encoder.bytes.values[4] == 129 && encoder.bytes.values[5] == 236)

        local relative = new X86Object.Encoder(".text", 20)
        local load = new Array<X86Object.Operand>(0)
        load.append(parser.operand("rax")); load.append(parser.operand("QWORD PTR [rip+value]"))
        expect(relative.instruction("mov", load))
        expect(relative.fixups.length == 1)
        expect(relative.fixups[0].symbol == "value")
        expect(relative.fixups[0].offset == 23)
        expect(relative.fixups[0].relocationType == 2)
        expect(relative.fixups[0].addend == -4)
    }
}}
