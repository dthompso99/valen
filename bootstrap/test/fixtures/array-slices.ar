Item {{
    member value:i64
}}

entry {{
    __() -> i64 {
        local values = [1, 2, 3, 4]
        local middle = values.slice(1, 2)
        if middle.length != 2 || middle[0] != 2 || middle[1] != 3 { return 1 }
        middle[0] = 20
        if values[1] != 2 { return 2 }
        local empty = values.slice(values.length, 0)
        if empty.length != 0 { return 3 }

        local items = new Array<Item?>(0)
        local item = new Item()
        item.value = 7
        items.append(item)
        local copied = items.slice(0, 1)
        items[0]!.value = 9
        if copied[0]!.value != 7 { return 4 }

        local rows = [[1, 2], [3, 4]]
        local second = rows.slice(1, 1)
        second[0][0] = 30
        if rows[1][0] != 3 || second[0][0] != 30 { return 5 }

        local aliases = new Array<ref Item>(0)
        local shared = new Item()
        shared.value = 11
        aliases.append(shared)
        local aliasSlice = aliases.slice(0, 1)
        shared.value = 12
        if aliasSlice[0].value != 12 { return 6 }
        return 0
    }
}}
