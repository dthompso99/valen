entry {{
    __() -> i64 {
        local bytes = "world".toBytes()
        if bytes.length != 5 || bytes[0] != 119 || bytes[4] != 100 { return 1 }
        bytes[0] = 87
        if bytes.toString() != "World" { return 2 }

        local builder = new StringBuilder()
        builder.append("hello ")
        builder.appendBytes(bytes)
        builder.append(" from a bulk copy")
        if builder.length != 28 { return 3 }
        if builder.build() != "hello World from a bulk copy" { return 4 }

        local empty = "".toBytes()
        builder.appendBytes(empty)
        if empty.length != 0 || builder.length != 28 { return 5 }
        return 0
    }
}}
