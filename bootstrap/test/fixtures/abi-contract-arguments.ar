Accumulator {{
    total(a:i64, b:i64, c:i64, d:i64, e:i64, f:i64, g:i64) -> i64 { return 0 }
}}

Calculator implements Accumulator {{
    total(a:i64, b:i64, c:i64, d:i64, e:i64, f:i64, g:i64) -> i64 {
        return a + b + c + d + e + f + g
    }
}}

entry {{
    __() -> i32 {
        local calculator = new Calculator()
        local accumulator:Accumulator = calculator
        if accumulator.total(1, 2, 4, 8, 16, 32, 64) != 127 { return 1 }
        return 0
    }
}}
