import Operations from '../../../src/libOperations.ar'
import System from '../../../src/libSystem.ar'

BackgroundWork implements Operations.Work {{
    run() -> Operations.OperationResult { return new Operations.Failed(42, "worker complete") }
}}

WorkerValue {{
    member value:i64
}}

WeakProbe {{
    member weak value:WorkerValue?

    watch(value:WorkerValue) -> void { self.value = value }
}}

AllocationWork implements Operations.Work {{
    member ref probe:WeakProbe

    __(probe:WeakProbe) -> void { self.probe = probe }

    seed() -> void {
        local value = new WorkerValue()
        self.probe.watch(value)
    }

    run() -> Operations.OperationResult {
        self.seed()
        local index:i64 = 0
        while index < 20000 {
            local garbage = new WorkerValue()
            garbage.value = index
            index = index + 1
        }
        if self.probe.value != null { return new Operations.Failed(98, "worker collection did not clear weak reference") }
        return new Operations.Succeeded()
    }
}}

BlockingWork implements Operations.Work {{
    member ref ready:Operations.Atomic
    member ref gate:Operations.Atomic
    member codeValue:i64

    __(ready:Operations.Atomic, gate:Operations.Atomic, code:i64) -> void {
        self.ready = ready
        self.gate = gate
        self.codeValue = code
    }

    run() -> Operations.OperationResult {
        local values = new Array<WorkerValue>(0)
        local index:i64 = 0
        while index < 256 {
            local value = new WorkerValue()
            value.value = self.codeValue + index
            values.append(value)
            index = index + 1
        }
        if values[255].value != self.codeValue + 255 { return new Operations.Failed(99, "allocation failure") }
        self.ready.add(1)
        while self.gate.load() == 0 {}
        return new Operations.Failed(self.codeValue, "pool complete")
    }
}}

entry {{
    __() -> i32 {
        local atomic = new Operations.Atomic(4)
        if atomic.load() != 4 { return 1 }
        if atomic.add(3) != 7 { return 2 }
        if !atomic.compareExchange(7, 11) { return 3 }
        if atomic.exchange(9) != 11 { return 4 }
        atomic.store(5)
        if atomic.load() != 5 { return 5 }

        local mutex = new Operations.Mutex()
        local condition = new Operations.Condition()
        mutex.lock()
        mutex.unlock()
        condition.notifyOne()
        condition.notifyAll()

        local executor = new Operations.ThreadExecutor()
        local operation = executor.submit(new BackgroundWork())
        local result = operation.wait()
        if !result.failed() { return 6 }
        if result.code() != 42 { return 7 }
        if result.detail()! != "worker complete" { return 8 }
        if result !== operation.result()! { return 9 }

        local ready = new Operations.Atomic(0)
        local gate = new Operations.Atomic(0)
        local pool = new Operations.ThreadPoolExecutor(2)
        if !pool.available() { return 10 }
        local first = pool.submit(new BlockingWork(ready, gate, 51))
        local second = pool.submit(new BlockingWork(ready, gate, 52))
        local cancelled = pool.submit(new BlockingWork(ready, gate, 53))
        while ready.load() < 2 {}
        System.collectGarbage()
        if !cancelled.cancel() { return 11 }
        gate.store(1)
        if first.wait().code() != 51 { return 12 }
        if second.wait().code() != 52 { return 13 }
        if !cancelled.wait().cancelled() { return 14 }
        local probe = new WeakProbe()
        if !pool.submit(new AllocationWork(probe)).wait().succeeded() { return 18 }
        if !pool.submit(new AllocationWork(probe)).wait().succeeded() { return 19 }
        pool.shutdown()
        pool.shutdown()
        if !pool.submit(new BackgroundWork()).wait().failed() { return 15 }

        local fallback = new Operations.ThreadPoolExecutor(0)
        if fallback.available() { return 16 }
        if fallback.submit(new BackgroundWork()).wait().code() != 42 { return 17 }
        return 0
    }
}}
