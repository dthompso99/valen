        local locked = codec.parseLock("{\"format\":1,\"package\":{\"name\":\"sample-app\",\"version\":\"0.1.0\"},\"target\":\"x86_64-linux\",\"dependencies\":[{\"name\":\"Alpha\",\"version\":\"1.0.0\",\"source\":\"deps/Alpha.ar\",\"metadata\":\"deps/Alpha.o.vmeta\",\"compiler\":\"valen-interface-1\",\"target\":\"x86_64-linux\",\"abi\":\"valen-native-1\",\"interfaceFingerprint\":\"11\",\"implementationFingerprint\":\"12\",\"objectFingerprint\":\"13\"},{\"name\":\"Zulu\",\"version\":\"2.0.0\",\"source\":null,\"metadata\":\"deps/Zulu.o.vmeta\",\"compiler\":\"valen-interface-1\",\"target\":\"x86_64-linux\",\"abi\":\"valen-native-1\",\"interfaceFingerprint\":\"21\",\"implementationFingerprint\":\"22\",\"objectFingerprint\":\"23\"}]}")
