Node {{
    member value:i64
    member next:Node?

    __(value:i64) -> void { self.value = value }
}}

Pair {{
    member left:Node
    member right:Node

    __(left:Node, right:Node) -> void {
        self.left = left
        self.right = right
    }
}}

entry {{
    __() -> i32 {
        local first = new Node(7)
        first.next = first
        local second = new Node(7)
        second.next = second
        if first === second { return 1 }
        if first != second { return 2 }
        if first.hash() != second.hash() { return 3 }

        local shared = new Node(9)
        local sharedPair = new Pair(shared, shared)
        local splitPair = new Pair(new Node(9), new Node(9))
        if sharedPair != splitPair { return 4 }
        if sharedPair.hash() != splitPair.hash() { return 5 }

        local copied = copy sharedPair
        if copied !== sharedPair { } else { return 7 }
        if copied != sharedPair { return 8 }
        if copied.left !== copied.right { return 9 }
        if copied.left === shared { return 10 }

        local cycleCopy = copy first
        if cycleCopy === first { return 11 }
        if cycleCopy.next! !== cycleCopy { return 12 }
        if cycleCopy != first { return 13 }

        local text = "engine"
        local textCopy = copy text
        if textCopy === text { return 14 }
        if textCopy != text { return 15 }

        local nodes = new Array<ref Node>(0)
        nodes.append(shared)
        nodes.append(shared)
        local nodeCopies = copy nodes
        if nodeCopies === nodes { return 16 }
        if nodeCopies != nodes { return 17 }
        if nodeCopies[0] !== shared { return 18 }
        if nodeCopies[0] === shared { return 19 }

        second.value = 8
        if first == second { return 6 }
        return 0
    }
}}
