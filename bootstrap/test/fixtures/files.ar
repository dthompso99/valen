import System from '/lib/libSystem.ar'

entry {{
    __() -> i32 {
        local arguments = System.arguments()
        if arguments.length != 2 {
            return 1
        }

        local output = System.openWrite(arguments[1])
        if output == null {
            return 2
        }
        if System.writeFile(output!, "argon file io\n") != 14 {
            return 3
        }
        if System.close(output!) != 0 {
            return 4
        }

        local input = System.openRead(arguments[1])
        if input == null {
            return 5
        }
        local contents = System.read(input!, 64)
        if contents == null {
            return 6
        }
        if System.close(input!) != 0 {
            return 7
        }
        if contents! != "argon file io\n" {
            return 8
        }
        return 0
    }
}}
