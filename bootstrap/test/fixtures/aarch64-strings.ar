entry {{
    __() -> i32 {
        local text = "hé🙂"
        if text.length != 7 { return 1 }
        if text[0] != 104 || text[1] != 195 || text[2] != 169 { return 2 }

        local joined:string = "va" + "len"
        if joined != "valen" || joined == "other" { return 3 }
        local sliced = joined.slice(1, 3)
        if sliced != "ale" { return 4 }
        local empty = joined.slice(joined.length, 0)
        if empty.length != 0 || empty != "" { return 5 }
        return 0
    }
}}
