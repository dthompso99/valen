Classifier {{
    classify(value:i64) -> i64 {
        if value < 0 {
            return 1
        } else if value == 0 {
            return 2
        } else if (value < 10) {
            return 3
        } else {
            return 4
        }
    }
}}

entry {{
    __() -> i64 {
        local classifier = new Classifier()
        if classifier.classify(-1) != 1 { return 1 }
        else if classifier.classify(0) != 2 { return 2 }
        else if classifier.classify(5) != 3 { return 3 }
        else if classifier.classify(10) != 4 { return 4 }
        return 0
    }
}}
