library System {{
    native memoryCopy(destination:Array<u8>, destinationOffset:i64, source:Array<u8>, sourceOffset:i64, count:i64) -> bool
    native memoryCompare(left:Array<u8>, leftOffset:i64, right:Array<u8>, rightOffset:i64, count:i64) -> i64
}}

entry {{
    __() -> i64 {
        local source = new Array<u8>(4)
        source[0] = 10; source[1] = 20; source[2] = 30; source[3] = 40
        local destination = new Array<u8>(6)
        if !System.memoryCopy(destination, 1, source, 1, 3) { return 1 }
        if destination[0] != 0 || destination[1] != 20 || destination[2] != 30 || destination[3] != 40 { return 2 }
        if System.memoryCompare(destination, 1, source, 1, 3) != 0 { return 3 }
        if System.memoryCompare(destination, 0, source, 0, 1) >= 0 { return 4 }
        if System.memoryCompare(source, 0, destination, 0, 1) <= 0 { return 5 }
        return 0
    }
}}
