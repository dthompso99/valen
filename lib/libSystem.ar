//this is intended to be a library, it has no entry point

library System {{
    native print(input:i64) -> void
    native arguments() -> Array < string >
    native exit(code:i32) -> void
    native write(input:string) -> void
    native writeError(input:string) -> void

    native openRead(path:string) -> File?
    native openWrite(path:string) -> File?
    native read(file:File, count:i64) -> string?
    native readDirectory(file:File, count:i64) -> string?
    native writeFile(file:File, input:string) -> i64
    native sync(file:File) -> i64
    native close(own file:File) -> i64
    native replaceFile(source:string, destination:string) -> i64
    native removeFile(path:string) -> i64
    native lastError() -> i64
    native currentDirectory() -> string?
    native environmentVariable(name:string) -> string?
    native collectGarbage() -> void
    native gcTrackedBytes() -> i64
    native gcTrackedAllocatedBytes() -> i64
    native gcHeapObjects() -> i64
    native gcRoots() -> i64
    native gcPeakRoots() -> i64
    native gcCollections() -> i64
    native gcReclaimedObjects() -> i64
    native gcTrackedReclaimedBytes() -> i64
    native gcWeakReferencesCleared() -> i64
    native gcWeakReferencesRetained() -> i64
    native gcNativeHandlesOpen() -> i64
    native gcNativeHandlesFinalized() -> i64
    native enableProcessArena() -> void
    native enableShutdownSignals() -> bool
    native shutdownRequested() -> bool
    native link(assemblyPath:string, outputPath:string, libraries:Array < string >) -> i64
    native memoryCopy(destination:Array < u8 >, destinationOffset:i64, source:Array < u8 >, sourceOffset:i64, count:i64) -> bool
    native memoryCompare(left:Array < u8 >, leftOffset:i64, right:Array < u8 >, rightOffset:i64, count:i64) -> i64
    native fileDescriptor(file:File) -> i64
    native makeFileNonblocking(file:File) -> bool

    listDirectory(path:string) -> DirectoryListing {
        local directory = openRead(path)
        if directory == null { return new DirectoryListing(false, new Array < DirectoryEntry >(0), lastError()) }
        local entries = new Array < DirectoryEntry >(0)
        local reading:bool = true
        while reading {
            local chunk = readDirectory(directory!, 32768)
            if chunk == null {
                local error = lastError()
                close(directory!)
                return new DirectoryListing(false, entries, error)
            }
            if chunk!.length == 0 { reading = false }
            else {
                local offset:i64 = 0
                while offset < chunk!.length {
                    if offset + 19 > chunk!.length {
                        close(directory!)
                        return new DirectoryListing(false, entries, 5)
                    }
                    local recordLength = chunk![offset + 16]as i64 +(chunk![offset + 17]as i64) * 256
                    if recordLength < 20 || offset + recordLength > chunk!.length {
                        close(directory!)
                        return new DirectoryListing(false, entries, 5)
                    }
                    local nameEnd = offset + 19
                    while nameEnd < offset + recordLength && chunk![nameEnd] != 0 { nameEnd = nameEnd + 1 }
                    if nameEnd == offset + recordLength {
                        close(directory!)
                        return new DirectoryListing(false, entries, 5)
                    }
                    local name = chunk!.slice(offset + 19, nameEnd - offset - 19)
                    if name != "." && name != ".." {
                        local kind = DirectoryEntryKind.Other
                        local nativeKind = chunk![offset + 18]
                        if nativeKind == 4 { kind = DirectoryEntryKind.Directory }
                        if nativeKind == 8 { kind = DirectoryEntryKind.File }
                        if nativeKind == 10 { kind = DirectoryEntryKind.SymbolicLink }
                        entries.append(new DirectoryEntry(name, kind))
                    }
                    offset = offset + recordLength
                }
            }
        }
        if close(directory!) != 0 { return new DirectoryListing(false, entries, lastError()) }
        return new DirectoryListing(true, entries, 0)
    }

    runtimeMetrics() -> RuntimeMetrics {
        return new RuntimeMetrics(gcTrackedBytes(), gcTrackedAllocatedBytes(), gcHeapObjects(), gcRoots(), gcPeakRoots(), gcCollections(), gcReclaimedObjects(), gcTrackedReclaimedBytes(), gcWeakReferencesCleared(), gcWeakReferencesRetained(), gcNativeHandlesOpen(), gcNativeHandlesFinalized())
    }

    RuntimeMetrics {{
        member trackedBytes:i64
        member trackedAllocatedBytes:i64
        member heapObjects:i64
        member roots:i64
        member peakRoots:i64
        member collections:i64
        member reclaimedObjects:i64
        member trackedReclaimedBytes:i64
        member weakReferencesCleared:i64
        member weakReferencesRetained:i64
        member nativeHandlesOpen:i64
        member nativeHandlesFinalized:i64

        __(trackedBytes:i64, trackedAllocatedBytes:i64, heapObjects:i64, roots:i64, peakRoots:i64, collections:i64, reclaimedObjects:i64, trackedReclaimedBytes:i64, weakReferencesCleared:i64, weakReferencesRetained:i64, nativeHandlesOpen:i64, nativeHandlesFinalized:i64) -> void {
            self.trackedBytes = trackedBytes; self.trackedAllocatedBytes = trackedAllocatedBytes; self.heapObjects = heapObjects
            self.roots = roots; self.peakRoots = peakRoots; self.collections = collections; self.reclaimedObjects = reclaimedObjects
            self.trackedReclaimedBytes = trackedReclaimedBytes; self.weakReferencesCleared = weakReferencesCleared
            self.weakReferencesRetained = weakReferencesRetained; self.nativeHandlesOpen = nativeHandlesOpen; self.nativeHandlesFinalized = nativeHandlesFinalized
        }
    }}

    parseInteger(input:string) -> IntegerParseResult {
        if input.length == 0 { return new IntegerParseResult(false, 0) }
        local negative:bool = false
        local index:i64 = 0
        if input[0] == 45 { negative = true; index = 1 }
        if index == input.length { return new IntegerParseResult(false, 0) }
        local value:i64 = 0
        local digits:i64 = 0
        while index < input.length {
            local byte = input[index]
            if byte < 48 || byte > 57 {
                while index < input.length {
                    local trailing = input[index]
                    if trailing != 9 && trailing != 10 && trailing != 13 && trailing != 32 { return new IntegerParseResult(false, 0) }
                    index = index + 1
                }
                if digits == 0 { return new IntegerParseResult(false, 0) }
                return new IntegerParseResult(true, value)
            }
            local digit =(byte - 48)as i64
            if negative {
                if value <(- 9223372036854775808 + digit) / 10 { return new IntegerParseResult(false, 0) }
                value = value * 10 - digit
            } else {
                if value >(9223372036854775807 - digit) / 10 { return new IntegerParseResult(false, 0) }
                value = value * 10 + digit
            }
            digits = digits + 1
            index = index + 1
        }
        return new IntegerParseResult(digits > 0, value)
    }

    resolvePath(sourceRoot:string, importer:string, specifier:string) -> string {
        if specifier.length > 0 {
            if specifier[0] == 47 {
                return sourceRoot + specifier
            }
        }
        local slash:i64 =- 1
        local index:i64 = 0
        while index < importer.length {
            if importer[index] == 47 {
                slash = index
            }
            index = index + 1
        }
        if slash < 0 {
            return specifier
        }
        return importer.slice(0, slash + 1) + specifier
    }

    File {{
        member descriptor:i64
    }}

    enum DirectoryEntryKind {{ Other, File, Directory, SymbolicLink }}

    DirectoryEntry {{
        member name:string
        member kind:DirectoryEntryKind

        __(name:string, kind:DirectoryEntryKind) -> void { self.name = name; self.kind = kind }
    }}

    DirectoryListing {{
        member valid:bool
        member entries:Array < DirectoryEntry >
        member error:i64

        __(valid:bool, entries:Array < DirectoryEntry >, error:i64) -> void {
            self.valid = valid
            self.entries = entries
            self.error = error
        }
    }}

    IntegerParseResult {{
        member valid:bool
        member value:i64

        __(valid:bool, value:i64) -> void {
            self.valid = valid
            self.value = value
        }
    }}
}}
